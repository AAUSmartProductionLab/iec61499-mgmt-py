<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_StateLogic" Comment="The PackML state machine itself: accepts a command only from the owner and only where PackML allows it; while Stopping it waits until no skill runs any more. Technical: PackML module state machine: commands only from the occupation owner and only where PackML allows them; runs the Resetting and Stopping procedures; Stopping waits until no skill is active">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="RESET_REQ" Type="Event" Comment="RESET(Session) was called">
        <With Var="ResetSession" />
      </Event>
      <Event Name="START_REQ" Type="Event" Comment="START(Session) was called">
        <With Var="StartSession" />
      </Event>
      <Event Name="STOP_REQ" Type="Event" Comment="STOP(Session) was called">
        <With Var="StopSession" />
      </Event>
      <Event Name="ABORT_REQ" Type="Event" Comment="ABORT(Session) was called">
        <With Var="AbortSession" />
      </Event>
      <Event Name="CLEAR_REQ" Type="Event" Comment="CLEAR(Session) was called">
        <With Var="ClearSession" />
      </Event>
      <Event Name="OWNER_CHG" Type="Event" Comment="The owner changed">
        <With Var="Owner" />
      </Event>
      <Event Name="ACT" Type="Event" Comment="The number of running skills changed (AllIdle)">
        <With Var="AllIdle" />
      </Event>
      <Event Name="RESETTING_DONE" Type="Event" Comment="The Resetting procedure ended" />
      <Event Name="RESETTING_FAILED" Type="Event" Comment="The Resetting procedure failed" />
      <Event Name="STOPPING_DONE" Type="Event" Comment="The Stopping procedure ended" />
      <Event Name="STOPPING_FAILED" Type="Event" Comment="The Stopping procedure failed" />
      <Event Name="STOP_TIMEOUT" Type="Event" Comment="Stopping took longer than StopTimeout" />
    </EventInputs>
    <EventOutputs>
      <Event Name="RESET_RSP" Type="Event" Comment="Answer to RESET: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="START_RSP" Type="Event" Comment="Answer to START: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="STOP_RSP" Type="Event" Comment="Answer to STOP: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="ABORT_RSP" Type="Event" Comment="Answer to ABORT: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="CLEAR_RSP" Type="Event" Comment="Answer to CLEAR: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="CNF" Type="Event" Comment="The state changed">
        <With Var="State" />
      </Event>
      <Event Name="RUN_RESETTING" Type="Event" Comment="Run the Resetting procedure" />
      <Event Name="RUN_STOPPING" Type="Event" Comment="Run the Stopping procedure" />
      <Event Name="WD_START" Type="Event" Comment="Start the stop timeout" />
      <Event Name="WD_STOP" Type="Event" Comment="Stop the stop timeout" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="ResetSession" Type="WSTRING" Comment="Session ID of the caller of Reset" />
      <VarDeclaration Name="StartSession" Type="WSTRING" Comment="Session ID of the caller of Start" />
      <VarDeclaration Name="StopSession" Type="WSTRING" Comment="Session ID of the caller of Stop" />
      <VarDeclaration Name="AbortSession" Type="WSTRING" Comment="Session ID of the caller of Abort" />
      <VarDeclaration Name="ClearSession" Type="WSTRING" Comment="Session ID of the caller of Clear" />
      <VarDeclaration Name="Owner" Type="WSTRING" Comment="Session ID of the module's owner (empty: free)" />
      <VarDeclaration Name="AllIdle" Type="BOOL" InitialValue="TRUE" Comment="No skill runs" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" InitialValue="2" Comment="PackML state: 1 Clearing, 2 Stopped, 3 Starting, 4 Idle, 6 Execute, 7 Stopping, 8 Aborting, 9 Aborted, 15 Resetting" />
      <VarDeclaration Name="Accepted" Type="BOOL" Comment="The call was accepted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Owned" Type="BOOL" />
      <VarDeclaration Name="Here" Type="USINT" />
    </InternalVars>
    <ECC>
      <ECState Name="Stopped" x="1828" y="0">
        <ECAction Algorithm="Alg_Stopped" Output="CNF" />
      </ECState>
      <ECState Name="Resetting" x="1512" y="2520">
        <ECAction Algorithm="Alg_Resetting" Output="CNF" />
        <ECAction Output="RUN_RESETTING" />
      </ECState>
      <ECState Name="ResettingW" x="1810" y="3880">
        <ECAction Algorithm="Alg_ResettingW" />
      </ECState>
      <ECState Name="Idle" x="3925" y="18040">
