    </ECC>
    <Algorithm Name="Alg_Stopped">
      <ST>State := 2;
Here := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Resetting">
      <ST>State := 15;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ResettingW">
      <ST>Here := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Idle">
      <ST>State := 4;
Here := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Starting">
      <ST>State := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Execute">
      <ST>State := 6;
Here := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Stopping">
      <ST>State := 7;</ST>
    </Algorithm>
    <Algorithm Name="Alg_StoppingW">
      <ST>Here := 4;</ST>
    </Algorithm>
    <Algorithm Name="Alg_StopProcW">
      <ST>Here := 5;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborting">
      <ST>State := 8;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborted">
      <ST>State := 9;
Here := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Clearing">
      <ST>State := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkReset">
      <ST>Owned := (ResetSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 0));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkStart">
      <ST>Owned := (StartSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 2));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkStop">
      <ST>Owned := (StopSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 1) OR (Here = 2) OR (Here = 3));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkAbort">
      <ST>Owned := (AbortSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 0) OR (Here = 1) OR (Here = 2) OR (Here = 3) OR (Here = 4) OR (Here = 5));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkClear">
      <ST>Owned := (ClearSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 6));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
  </BasicFB>
</FBType>