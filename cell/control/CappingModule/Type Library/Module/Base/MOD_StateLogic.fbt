      </ECState>
      <ECState Name="StopProc" x="748" y="12800">
        <ECAction Output="WD_STOP" />
        <ECAction Output="RUN_STOPPING" />
      </ECState>
      <ECState Name="StopProcW" x="0" y="18040">
        <ECAction Algorithm="Alg_StopProcW" />
      </ECState>
      <ECState Name="Aborting" x="1692" y="14160">
        <ECAction Algorithm="Alg_Aborting" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Aborted" x="1828" y="15520">
        <ECAction Algorithm="Alg_Aborted" Output="CNF" />
      </ECState>
      <ECState Name="Clearing" x="1890" y="18040">
        <ECAction Algorithm="Alg_Clearing" Output="CNF" />
      </ECState>
      <ECState Name="ChkReset" x="1648" y="1260">
        <ECAction Algorithm="Alg_ChkReset" Output="RESET_RSP" />
      </ECState>
      <ECState Name="ChkStart" x="1648" y="5140">
        <ECAction Algorithm="Alg_ChkStart" Output="START_RSP" />
      </ECState>
      <ECState Name="ChkStop" x="1715" y="8920">
        <ECAction Algorithm="Alg_ChkStop" Output="STOP_RSP" />
      </ECState>
      <ECState Name="ChkAbort" x="2548" y="12800">
        <ECAction Algorithm="Alg_ChkAbort" Output="ABORT_RSP" />
      </ECState>
      <ECState Name="ChkClear" x="1648" y="16780">
        <ECAction Algorithm="Alg_ChkClear" Output="CLEAR_RSP" />
      </ECState>
      <ECTransition Source="Stopped" Destination="ChkReset" Condition="RESET_REQ" x="2450" y="710" />
