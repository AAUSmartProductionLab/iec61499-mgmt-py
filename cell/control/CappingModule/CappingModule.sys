      </FB>
      <FB Name="MoveAxis" Type="capping::SK_MoveAxis" x="3845" y="150" Comment="Skill MoveAxis, offered on its own: Head to Position, measured down from the limit switch; the direction follows from where it is, using LinearAxis. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Capping/Skills/MoveAxis; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Capping&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Capping&quot;" />
        <Parameter Name="UaPath" Value="&quot;/Skills/MoveAxis&quot;" />
