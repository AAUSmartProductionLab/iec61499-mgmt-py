      <Group Name="EquipmentIO" Comment="Equipment IO: the only owners of the IO points; skills send them output values over local channels" x="1000" y="7540" width="6605" height="2280" locked="false" />
      <FB Name="Occupation" Type="modlib::MOD_Occupation" x="1110" y="150" Comment="Who may command the module. A client calls Occupy(Session) at /Objects/Capping/Occupation first; until it calls Release, only commands with that session id are accepted. Every block hears the owner on loc[Capping/owner].">
        <Parameter Name="Module" Value="&quot;Capping&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Capping&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="ModuleLevel" />
      </FB>
      <FB Name="Module" Type="modlib::MOD_StateManager" x="3800" y="150" Comment="The module's PackML state. The owner calls Reset, Start, Stop, Abort or Clear at /Objects/Capping/Module; State is at /Objects/Capping/Module/State and on loc[Capping/state]. Reset runs the Resetting procedure, Stop the Stopping procedure; skills may be started only in Execute.">
        <Parameter Name="Module" Value="&quot;Capping&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Capping&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="StopTimeout" Value="T#10000ms" />
        <Attribute Name="GroupName" Type="STRING" Value="ModuleLevel" />
      </FB>
      <FB Name="LinearAxis" Type="capping::EQ_LinearAxis" x="1700" y="150" Comment="Equipment LinearAxis: Lift of the crimping head, a stepper motor through a step and direction driver, with a limit switch at the top (home). The only block that touches its pins (AtHome = modbus[127.0.0.1:1504:1:10:d0:], Enable = modbus[127.0.0.1:1504:1:0::c0], Down = modbus[127.0.0.1:1504:1:0::c1], Step = modbus[127.0.0.1:1504:1:0::h0]). Skills send it what to switch on loc[Capping/LinearAxis/cmd]; it reports its inputs on loc[Capping/LinearAxis/state] and at /Objects/Capping/Equipment/LinearAxis.">
        <Parameter Name="Module" Value="&quot;Capping&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Capping&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="AtHome_Address" Value="'modbus[127.0.0.1:1504:1:10:d0:]'" />
        <Parameter Name="Enable_Address" Value="'modbus[127.0.0.1:1504:1:0::c0]'" />
        <Parameter Name="Down_Address" Value="'modbus[127.0.0.1:1504:1:0::c1]'" />
        <Parameter Name="Step_Address" Value="'modbus[127.0.0.1:1504:1:0::h0]'" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Crimper" Type="capping::EQ_Crimper" x="4985" y="150" Comment="Equipment Crimper: Crimping head that closes around the cap; simulated until it is chosen (no pin on the Pi yet). The only block that touches its pins (Close = modbus[127.0.0.1:1504:1:0::c2]). Skills send it what to switch on loc[Capping/Crimper/cmd]; it reports its inputs on loc[Capping/Crimper/state] and at /Objects/Capping/Equipment/Crimper.">
        <Parameter Name="Module" Value="&quot;Capping&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Capping&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="Close_Address" Value="'modbus[127.0.0.1:1504:1:0::c2]'" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Home" Type="capping::SK_Home" x="1110" y="150" Comment="Skill Home, offered on its own: Head up to the limit switch; from there its position is known, using LinearAxis. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Capping/Skills/Home; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Capping&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Capping&quot;" />
