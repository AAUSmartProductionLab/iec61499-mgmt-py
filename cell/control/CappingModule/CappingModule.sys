<System Name="CappingModule" Comment="Module Capping, generated from its module specification">
  <Identification Standard="61499-2" />
  <Application Name="Capping" Comment="Module Capping on target pc (localhost, IO modbus; generated by modgen)">
    <SubAppNetwork>
      <Group Name="ModuleLevel" Comment="Module level: occupation, PackML state manager, start-up and the target's IO lines" x="1000" y="1000" width="6155" height="1880" locked="false" />
