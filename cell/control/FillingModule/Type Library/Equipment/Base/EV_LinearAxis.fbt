<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EV_LinearAxis" Comment="Unpacks the equipment's state channel into named values (its inputs and who holds it) for a skill. Technical: Typed view of LinearAxis's state channel (inputs and holder)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event" Comment="The equipment's state arrived">
        <With Var="I_AtHome" />
        <With Var="I_ActualPosition" />
        <With Var="I_Homed" />
        <With Var="I_Moving" />
        <With Var="I_Holder" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event" Comment="The values below are updated">
        <With Var="AtHome" />
        <With Var="ActualPosition" />
        <With Var="Homed" />
        <With Var="Moving" />
        <With Var="Holder" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="I_AtHome" Type="BOOL" Comment="AtHome as read or received" />
      <VarDeclaration Name="I_ActualPosition" Type="LREAL" Comment="ActualPosition as read or received" />
      <VarDeclaration Name="I_Homed" Type="BOOL" Comment="Homed as read or received" />
      <VarDeclaration Name="I_Moving" Type="BOOL" Comment="Moving as read or received" />
      <VarDeclaration Name="I_Holder" Type="WSTRING" Comment="Holder as read or received" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="AtHome" Type="BOOL" Comment="LinearAxis: AtHome, an input" />
      <VarDeclaration Name="ActualPosition" Type="LREAL" Comment="LinearAxis: ActualPosition (mm), worked out by the equipment" />
      <VarDeclaration Name="Homed" Type="BOOL" Comment="LinearAxis: Homed, worked out by the equipment" />
      <VarDeclaration Name="Moving" Type="BOOL" Comment="LinearAxis: Moving, worked out by the equipment" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="Who holds the equipment (empty: free)" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="REQ">
      <ECAction Algorithm="REQ" Output="CNF" />
    </ECState>
    <Algorithm Name="REQ">
      <ST>AtHome := I_AtHome;
ActualPosition := I_ActualPosition;
Homed := I_Homed;
Moving := I_Moving;
Holder := I_Holder;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>