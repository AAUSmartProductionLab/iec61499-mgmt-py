<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_Scale" Comment="Scale; the hardware has none, so the weight is simulated; equipment IO: owns its IO points, writes the output values its holder sends, reads its inputs every cycle and reports changes">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="Weight_Address" />
        <With Var="Weight_Sim" />
        <With Var="Weight_Scale" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;Scale&quot;" Comment="The equipment item's name: its local channels and OPC UA folder" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" Comment="How often the inputs are read" />
      <VarDeclaration Name="Weight_Address" Type="STRING" Comment="Where Weight is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Weight_Sim" Type="LREAL" InitialValue="2.0" Comment="The value of Weight when simulated (address 'sim')" />
      <VarDeclaration Name="Weight_Scale" Type="LREAL" InitialValue="0.001" Comment="Engineering value per raw count of Weight" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <Group Name="Core" Comment="One holder at a time, break before make, all off on release or abort; scanned every CycleTime" x="1000" y="1000" width="2370" height="2500" locked="false" />
    <Group Name="Channels" Comment="Local channels to and from the skills (cmd, release, state), the module's state, and the inputs over OPC UA" x="3670" y="1000" width="4010" height="2700" locked="false" />
    <Group Name="Inputs" Comment="The equipment's sensors: read every cycle, one block per IO point" x="7980" y="1000" width="1190" height="1500" locked="false" />
    <FB Name="Logic" Type="filling::EL_Scale" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="1600" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_2" x="1710" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubRelease" Type="iec61499::net::SUBSCRIBE_1" x="3000" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_2" x="480" y="1600">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_1" x="1530" y="1600">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="In_Weight" Type="modlib::IO_AI" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="SubRelease.INIT" />
      <Connection Source="SubRelease.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="PubUa.INIT" />
      <Connection Source="PubUa.INITO" Destination="In_Weight.INIT" />
      <Connection Source="In_Weight.INITO" Destination="Cycle.START" />
      <Connection Source="In_Weight.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="SubRelease.IND" Destination="Logic.RELEASE" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="In_Weight.REQ" />
      <Connection Source="In_Weight.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.STATE" Destination="PubUa.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Logic.DRIVEN" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="UaRoot" Destination="Logic.UaRoot" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdRelease" Destination="SubRelease.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="Logic.IdPub" Destination="PubUa.ID" />
      <Connection Source="UaEnable" Destination="PubUa.QI" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Release" />
      <Connection Source="SubRelease.RD_1" Destination="Logic.R_Holder" />
      <Connection Source="Mode.State" Destination="Logic.ModuleState" />
      <Connection Source="Weight_Address" Destination="In_Weight.Address" />
      <Connection Source="Weight_Sim" Destination="In_Weight.SimValue" />
      <Connection Source="Weight_Scale" Destination="In_Weight.Scale" />
      <Connection Source="In_Weight.IN" Destination="Logic.I_Weight" />
      <Connection Source="Logic.Weight" Destination="PubState.SD_1" />
      <Connection Source="Logic.Weight" Destination="PubUa.SD_1" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_2" />
    </DataConnections>
  </FBNetwork>
</FBType>