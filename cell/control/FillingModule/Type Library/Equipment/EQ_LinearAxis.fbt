<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_LinearAxis" Comment="Needle lift, a stepper motor through a step and direction driver, with a limit switch at the top (home); equipment IO: owns its IO points, writes the output values its holder sends, reads its inputs every cycle and reports changes">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="AtHome_Address" />
        <With Var="AtHome_Sim" />
        <With Var="Enable_Address" />
        <With Var="Down_Address" />
        <With Var="Step_Address" />
        <With Var="Step_Gain" />
        <With Var="Step_Bias" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;LinearAxis&quot;" Comment="The equipment item's name: its local channels and OPC UA folder" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" Comment="How often the inputs are read" />
      <VarDeclaration Name="AtHome_Address" Type="STRING" Comment="Where AtHome is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="AtHome_Sim" Type="BOOL" InitialValue="FALSE" Comment="The value of AtHome when simulated (address 'sim')" />
      <VarDeclaration Name="Enable_Address" Type="STRING" Comment="Where Enable is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Down_Address" Type="STRING" Comment="Where Down is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Step_Address" Type="STRING" Comment="Where Step is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Step_Gain" Type="LREAL" InitialValue="655.35" Comment="Step: raw = Bias + value * Gain" />
      <VarDeclaration Name="Step_Bias" Type="LREAL" InitialValue="0.0" Comment="Step: raw = Bias + value * Gain" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <Group Name="Core" Comment="One holder at a time, break before make, all off on release or abort; scanned every CycleTime" x="1000" y="1000" width="7105" height="3180" locked="false" />
    <Group Name="Channels" Comment="Local channels to and from the skills (cmd, release, state), the module's state, and the inputs over OPC UA" x="1000" y="4480" width="7930" height="3580" locked="false" />
    <Group Name="Inputs" Comment="The equipment's sensors: read every cycle, one block per IO point" x="9230" y="4480" width="2910" height="1380" locked="false" />
    <Group Name="Outputs" Comment="The equipment's actuators: written on a change and every cycle, one block per IO point" x="1000" y="8360" width="7850" height="1680" locked="false" />
    <FB Name="Logic" Type="filling::EL_LinearAxis" x="950" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="3955" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="MoveT" Type="iec61499::events::E_DELAY" x="5705" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="950" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_8" x="3500" y="150">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubRelease" Type="iec61499::net::SUBSCRIBE_1" x="6210" y="150">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_5" x="1150" y="1850">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_4" x="3860" y="1850">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="In_AtHome" Type="modlib::IO_DI" x="1270" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="Out_Enable" Type="modlib::IO_DO" x="1270" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Down" Type="modlib::IO_DO" x="3880" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Step" Type="modlib::IO_AO" x="6380" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <EventConnections>
      <Connection Source="Logic.MOVE_START" Destination="MoveT.START">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.MOVE_STOP" Destination="MoveT.STOP">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="MoveT.EO" Destination="Logic.MOVE_T">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="INIT" Destination="Logic.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.INITO" Destination="Mode.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="SubCmd.INITO" Destination="SubRelease.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="SubRelease.INITO" Destination="PubState.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="PubState.INITO" Destination="PubUa.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="PubUa.INITO" Destination="In_AtHome.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="In_AtHome.INITO" Destination="Out_Enable.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Enable.INITO" Destination="Out_Down.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Down.INITO" Destination="Out_Step.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Step.INITO" Destination="Cycle.START">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Step.INITO" Destination="INITO">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="SubCmd.IND" Destination="Logic.CMD">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="SubRelease.IND" Destination="Logic.RELEASE">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Cycle.EO" Destination="In_AtHome.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="In_AtHome.CNF" Destination="Logic.SAMPLE">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.STATE" Destination="PubState.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.STATE" Destination="PubUa.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.DRIVE" Destination="Out_Enable.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Enable.CNF" Destination="Out_Down.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Down.CNF" Destination="Out_Step.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Out_Step.CNF" Destination="Logic.DRIVEN">
        <Attribute Name="Visible" Value="false" />
      </Connection>
    </EventConnections>
    <DataConnections>
      <Connection Source="Logic.MoveDT" Destination="MoveT.DT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Module" Destination="Logic.Module">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Name" Destination="Logic.Name">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="UaRoot" Destination="Logic.UaRoot">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Module" Destination="Mode.Module">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.IdRelease" Destination="SubRelease.ID">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.IdState" Destination="PubState.ID">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Logic.IdPub" Destination="PubUa.ID">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="UaEnable" Destination="PubUa.QI">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="CycleTime" Destination="Cycle.DT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder">
        <Attribute Name="Visible" Value="false" />
