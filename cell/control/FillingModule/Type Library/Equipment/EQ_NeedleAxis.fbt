<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_NeedleAxis" Comment="Needle lift, DC motor through an L298N (IN3 up, IN4 down, ENB speed), end switches top and bottom; equipment IO: owns its IO points, writes the output values its holder sends, reads its inputs every cycle and reports changes">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="AtTop_Backend" />
        <With Var="AtTop_Modbus" />
        <With Var="AtTop_Io" />
        <With Var="AtTop_Sim" />
        <With Var="AtBottom_Backend" />
        <With Var="AtBottom_Modbus" />
        <With Var="AtBottom_Io" />
        <With Var="AtBottom_Sim" />
        <With Var="Up_Backend" />
        <With Var="Up_Modbus" />
        <With Var="Up_Io" />
        <With Var="Down_Backend" />
        <With Var="Down_Modbus" />
        <With Var="Down_Io" />
        <With Var="Speed_Backend" />
        <With Var="Speed_Modbus" />
        <With Var="Speed_Io" />
        <With Var="Speed_Gain" />
        <With Var="Speed_Bias" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;NeedleAxis&quot;" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" />
      <VarDeclaration Name="AtTop_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="AtTop_Modbus" Type="WSTRING" />
      <VarDeclaration Name="AtTop_Io" Type="STRING" />
      <VarDeclaration Name="AtTop_Sim" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="AtBottom_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="AtBottom_Modbus" Type="WSTRING" />
      <VarDeclaration Name="AtBottom_Io" Type="STRING" />
      <VarDeclaration Name="AtBottom_Sim" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="Up_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Up_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Up_Io" Type="STRING" />
      <VarDeclaration Name="Down_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Down_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Down_Io" Type="STRING" />
      <VarDeclaration Name="Speed_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Speed_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Speed_Io" Type="STRING" />
      <VarDeclaration Name="Speed_Gain" Type="LREAL" InitialValue="257.0" />
      <VarDeclaration Name="Speed_Bias" Type="LREAL" InitialValue="0.0" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <Group Name="Core" Comment="One holder at a time, break before make, all off on release or abort; scanned every CycleTime" x="1000" y="1000" width="17800" height="6340" locked="false" />
    <Group Name="Channels" Comment="Local channels to and from the skills (cmd, release, state), the module's state, and the inputs over OPC UA" x="1000" y="8540" width="25800" height="5300" locked="false" />
    <Group Name="Inputs" Comment="The equipment's sensors: read every cycle, one block per IO point" x="1000" y="15040" width="12000" height="4700" locked="false" />
    <Group Name="Outputs" Comment="The equipment's actuators: written on a change and every cycle, one block per IO point" x="1000" y="20940" width="16600" height="4700" locked="false" />
    <FB Name="Logic" Type="filling::EL_NeedleAxis" x="2800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="10300" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="21200" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_6" x="2800" y="900">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubRelease" Type="iec61499::net::SUBSCRIBE_1" x="7400" y="900">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_3" x="12000" y="900">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_2" x="16600" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="In_AtTop" Type="modlib::IO_DI" x="2800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="In_AtBottom" Type="modlib::IO_DI" x="7400" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="Out_Up" Type="modlib::IO_DO" x="2800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Down" Type="modlib::IO_DO" x="7400" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Speed" Type="modlib::IO_AO" x="12000" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="SubRelease.INIT" />
      <Connection Source="SubRelease.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="PubUa.INIT" />
      <Connection Source="PubUa.INITO" Destination="In_AtTop.INIT" />
      <Connection Source="In_AtTop.INITO" Destination="In_AtBottom.INIT" />
      <Connection Source="In_AtBottom.INITO" Destination="Out_Up.INIT" />
      <Connection Source="Out_Up.INITO" Destination="Out_Down.INIT" />
      <Connection Source="Out_Down.INITO" Destination="Out_Speed.INIT" />
      <Connection Source="Out_Speed.INITO" Destination="Cycle.START" />
      <Connection Source="Out_Speed.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="SubRelease.IND" Destination="Logic.RELEASE" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="In_AtTop.REQ" />
      <Connection Source="In_AtTop.CNF" Destination="In_AtBottom.REQ" />
      <Connection Source="In_AtBottom.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.STATE" Destination="PubUa.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Out_Up.REQ" />
      <Connection Source="Out_Up.CNF" Destination="Out_Down.REQ" />
      <Connection Source="Out_Down.CNF" Destination="Out_Speed.REQ" />
      <Connection Source="Out_Speed.CNF" Destination="Logic.DRIVEN" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="UaRoot" Destination="Logic.UaRoot" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdRelease" Destination="SubRelease.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="Logic.IdPub" Destination="PubUa.ID" />
      <Connection Source="UaEnable" Destination="PubUa.QI" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Release" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Up" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Down" />
      <Connection Source="SubCmd.RD_5" Destination="Logic.C_Speed" />
      <Connection Source="SubCmd.RD_6" Destination="Logic.CE_Speed" />
      <Connection Source="SubRelease.RD_1" Destination="Logic.R_Holder" />
      <Connection Source="Mode.State" Destination="Logic.ModState" />
      <Connection Source="AtTop_Backend" Destination="In_AtTop.Backend" />
      <Connection Source="AtTop_Modbus" Destination="In_AtTop.ModbusId" />
      <Connection Source="AtTop_Io" Destination="In_AtTop.IoName" />
      <Connection Source="AtTop_Sim" Destination="In_AtTop.SimValue" />
      <Connection Source="In_AtTop.IN" Destination="Logic.I_AtTop" />
      <Connection Source="Logic.AtTop" Destination="PubState.SD_1" />
      <Connection Source="Logic.AtTop" Destination="PubUa.SD_1" />
      <Connection Source="AtBottom_Backend" Destination="In_AtBottom.Backend" />
      <Connection Source="AtBottom_Modbus" Destination="In_AtBottom.ModbusId" />
      <Connection Source="AtBottom_Io" Destination="In_AtBottom.IoName" />
      <Connection Source="AtBottom_Sim" Destination="In_AtBottom.SimValue" />
      <Connection Source="In_AtBottom.IN" Destination="Logic.I_AtBottom" />
      <Connection Source="Logic.AtBottom" Destination="PubState.SD_2" />
      <Connection Source="Logic.AtBottom" Destination="PubUa.SD_2" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_3" />
      <Connection Source="Up_Backend" Destination="Out_Up.Backend" />
      <Connection Source="Up_Modbus" Destination="Out_Up.ModbusId" />
      <Connection Source="Up_Io" Destination="Out_Up.IoName" />
      <Connection Source="Logic.O_Up" Destination="Out_Up.OUT" />
      <Connection Source="Down_Backend" Destination="Out_Down.Backend" />
      <Connection Source="Down_Modbus" Destination="Out_Down.ModbusId" />
      <Connection Source="Down_Io" Destination="Out_Down.IoName" />
      <Connection Source="Logic.O_Down" Destination="Out_Down.OUT" />
      <Connection Source="Speed_Backend" Destination="Out_Speed.Backend" />
      <Connection Source="Speed_Modbus" Destination="Out_Speed.ModbusId" />
      <Connection Source="Speed_Io" Destination="Out_Speed.IoName" />
      <Connection Source="Logic.O_Speed" Destination="Out_Speed.OUT" />
      <Connection Source="Logic.E_Speed" Destination="Out_Speed.EN" />
      <Connection Source="Speed_Gain" Destination="Out_Speed.Gain" />
      <Connection Source="Speed_Bias" Destination="Out_Speed.Bias" />
    </DataConnections>
  </FBNetwork>
</FBType>