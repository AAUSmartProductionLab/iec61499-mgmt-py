<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SL_Dwell" Comment="Dwell: Requires TRUE; waits Duration s; Invariant TRUE">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaPath" />
      </Event>
      <Event Name="START" Type="Event">
        <With Var="Duration" />
      </Event>
      <Event Name="HALT" Type="Event" />
      <Event Name="ABORT" Type="Event" />
      <Event Name="TIMER" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdParams" />
      </Event>
      <Event Name="DONE" Type="Event" />
      <Event Name="FAILED" Type="Event">
        <With Var="ErrorID" />
      </Event>
      <Event Name="HALTED" Type="Event">
        <With Var="ErrorID" />
      </Event>
      <Event Name="TIMER_START" Type="Event">
        <With Var="TimerDT" />
      </Event>
      <Event Name="TIMER_STOP" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="Duration" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ErrorID" Type="UINT" />
      <VarDeclaration Name="TimerDT" Type="TIME" />
      <VarDeclaration Name="IdParams" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="Idle" x="150" y="100" />
      <ECState Name="Init" x="570" y="100">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Check" x="990" y="100" />
      <ECState Name="Reject" x="1410" y="100">
        <ECAction Algorithm="Alg_Reject" Output="FAILED" />
      </ECState>
      <ECState Name="Run" x="150" y="330">
        <ECAction Algorithm="Alg_Run" Output="TIMER_START" />
      </ECState>
      <ECState Name="Done" x="570" y="330">
        <ECAction Output="DONE" />
      </ECState>
      <ECState Name="Halt" x="990" y="330">
        <ECAction Algorithm="Alg_Halt" Output="TIMER_STOP" />
        <ECAction Output="HALTED" />
      </ECState>
      <ECState Name="Abort" x="1410" y="330">
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Running" x="150" y="560" />
      <ECTransition Source="Idle" Destination="Init" Condition="INIT" x="0" y="0" />
      <ECTransition Source="Init" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Check" Condition="START" x="0" y="0" />
      <ECTransition Source="Check" Destination="Reject" Condition="NOT (TRUE)" x="0" y="0" />
      <ECTransition Source="Running" Destination="Done" Condition="TIMER" x="0" y="0" />
      <ECTransition Source="Done" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Halt" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Abort" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Check" Destination="Run" Condition="1" x="0" y="0" />
      <ECTransition Source="Run" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="Running" Destination="Halt" Condition="HALT" x="0" y="0" />
      <ECTransition Source="Running" Destination="Abort" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Reject" Destination="Idle" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>IdParams := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/Parameters/Duration"), "]");</ST>
    </Algorithm>
    <Algorithm Name="Alg_Reject">
      <ST>ErrorID := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Run">
      <ST>TimerDT := MUL_TIME(T#1s, Duration);</ST>
    </Algorithm>
    <Algorithm Name="Alg_Halt">
      <ST>ErrorID := 7;</ST>
    </Algorithm>
  </BasicFB>
</FBType>