<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SL_Tare" Comment="Tare: Requires TRUE; holds Scale.Tare until 2.0 s; Invariant TRUE">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: name the channels and OPC UA variables">
        <With Var="Module" />
        <With Var="Equipment" />
        <With Var="Holder" />
        <With Var="ReleaseAfter" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start the run with the parameters (checks Requires first)" />
      <Event Name="HALT" Type="Event" Comment="Stop the run (ErrorID Interrupted)" />
      <Event Name="ABORT" Type="Event" Comment="Abort the run: the equipment off and given up" />
      <Event Name="TIMER" Type="Event" Comment="The run's timer expired" />
      <Event Name="SAMPLE" Type="Event" Comment="The equipment's state arrived">
        <With Var="EqHolder" />
      </Event>
      <Event Name="WAIT_OVER" Type="Event" Comment="Waited long enough for another holder to let go" />
      <Event Name="PLAYED" Type="Event" Comment="The command's phases were played" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on">
        <With Var="IdEqState" />
        <With Var="IdEqCmd" />
      </Event>
      <Event Name="DONE" Type="Event" Comment="The run succeeded (results set)" />
      <Event Name="FAILED" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
      <Event Name="HALTED" Type="Event" Comment="The run was stopped">
        <With Var="ErrorID" />
      </Event>
      <Event Name="TIMER_START" Type="Event" Comment="Start the timer (TimerDT)">
        <With Var="TimerDT" />
      </Event>
      <Event Name="TIMER_STOP" Type="Event" Comment="Stop the timer" />
      <Event Name="WAIT_START" Type="Event" Comment="Start waiting for the equipment" />
      <Event Name="WAIT_STOP" Type="Event" Comment="Stop waiting" />
      <Event Name="CMD" Type="Event" Comment="Send a command to the equipment">
        <With Var="C_Holder" />
        <With Var="C_Command" />
        <With Var="C_Arg" />
        <With Var="C_Release" />
      </Event>
      <Event Name="EQ_FREE" Type="Event" Comment="EquipmentFree is updated">
        <With Var="EquipmentFree" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Equipment" Type="WSTRING" Comment="The equipment item it drives" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="The name the equipment is held under: the skill's own, or for a step the skill it belongs to" />
      <VarDeclaration Name="ReleaseAfter" Type="BOOL" Comment="Give up the equipment with the run's last command" />
      <VarDeclaration Name="EqHolder" Type="WSTRING" Comment="Who holds the equipment now (empty: free)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
      <VarDeclaration Name="TimerDT" Type="TIME" Comment="How long the timer runs" />
      <VarDeclaration Name="IdEqState" Type="WSTRING" Comment="Local channel of the equipment's state" />
      <VarDeclaration Name="IdEqCmd" Type="WSTRING" Comment="Local channel of the equipment's commands" />
      <VarDeclaration Name="C_Holder" Type="WSTRING" Comment="Sent with the command: who holds the equipment" />
      <VarDeclaration Name="C_Command" Type="USINT" Comment="Sent with the command: the command's code" />
      <VarDeclaration Name="C_Arg" Type="LREAL" Comment="Sent with the command: its argument (e.g. a position)" />
      <VarDeclaration Name="C_Release" Type="BOOL" Comment="Sent with the command: give up the equipment after it" />
      <VarDeclaration Name="EquipmentFree" Type="BOOL" Comment="The equipment is free, or held under Holder" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Outcome" Type="USINT" />
    </InternalVars>
    <ECC>
      <ECState Name="Idle" x="150" y="100" />
      <ECState Name="Init" x="570" y="100">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Check" x="990" y="100" />
      <ECState Name="Reject" x="1410" y="100">
        <ECAction Algorithm="Alg_Reject" Output="FAILED" />
      </ECState>
      <ECState Name="Sample" x="150" y="330">
        <ECAction Algorithm="Alg_Sample" Output="EQ_FREE" />
      </ECState>
      <ECState Name="Busy" x="570" y="330">
        <ECAction Algorithm="Alg_Busy" Output="FAILED" />
      </ECState>
      <ECState Name="WaitFree" x="990" y="330">
        <ECAction Output="WAIT_START" />
      </ECState>
      <ECState Name="WaitW" x="1410" y="330" />
      <ECState Name="Recheck" x="150" y="560">
        <ECAction Output="WAIT_STOP" />
      </ECState>
      <ECState Name="Run" x="990" y="330">
        <ECAction Algorithm="Alg_Run" Output="CMD" />
        <ECAction Output="TIMER_START" />
      </ECState>
      <ECState Name="RunSample" x="1410" y="330">
        <ECAction Algorithm="Alg_RunSample" Output="EQ_FREE" />
      </ECState>
      <ECState Name="Unsafe" x="150" y="560">
        <ECAction Algorithm="Alg_Unsafe" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Lost" x="570" y="560">
        <ECAction Algorithm="Alg_Lost" Output="TIMER_STOP" />
        <ECAction Output="FAILED" />
      </ECState>
      <ECState Name="Done" x="990" y="560">
        <ECAction Algorithm="Alg_Done" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Halt" x="1410" y="560">
        <ECAction Algorithm="Alg_Halt" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Abort" x="150" y="790">
        <ECAction Algorithm="Alg_Abort" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Ending" x="150" y="1020" />
      <ECState Name="EndDone" x="570" y="1020">
        <ECAction Output="DONE" />
      </ECState>
      <ECState Name="EndFailed" x="990" y="1020">
        <ECAction Output="FAILED" />
      </ECState>
      <ECState Name="EndHalted" x="1410" y="1020">
        <ECAction Output="HALTED" />
      </ECState>
      <ECState Name="Running" x="570" y="790" />
      <ECTransition Source="Idle" Destination="Init" Condition="INIT" x="0" y="0" />
      <ECTransition Source="Init" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Check" Condition="START" x="0" y="0" />
      <ECTransition Source="Check" Destination="Reject" Condition="NOT (TRUE)" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Sample" Condition="SAMPLE" x="0" y="0" />
      <ECTransition Source="Sample" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Check" Destination="WaitFree" Condition="(EqHolder &lt;&gt; &quot;&quot;) AND (EqHolder &lt;&gt; Holder)" x="0" y="0" />
      <ECTransition Source="WaitFree" Destination="WaitW" Condition="1" x="0" y="0" />
      <ECTransition Source="WaitW" Destination="Recheck" Condition="SAMPLE[NOT ((EqHolder &lt;&gt; &quot;&quot;) AND (EqHolder &lt;&gt; Holder))]" x="0" y="0" />
      <ECTransition Source="WaitW" Destination="Busy" Condition="WAIT_OVER" x="0" y="0" />
      <ECTransition Source="WaitW" Destination="Idle" Condition="HALT" x="0" y="0" />
      <ECTransition Source="WaitW" Destination="Idle" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Recheck" Destination="Check" Condition="1" x="0" y="0" />
      <ECTransition Source="Running" Destination="Unsafe" Condition="SAMPLE[NOT (TRUE)]" x="0" y="0" />
      <ECTransition Source="Running" Destination="Lost" Condition="SAMPLE[(EqHolder &lt;&gt; &quot;&quot;) AND (EqHolder &lt;&gt; Holder)]" x="0" y="0" />
      <ECTransition Source="Running" Destination="Done" Condition="TIMER" x="0" y="0" />
      <ECTransition Source="Running" Destination="RunSample" Condition="SAMPLE" x="0" y="0" />
      <ECTransition Source="RunSample" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="Busy" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Lost" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Unsafe" Destination="Ending" Condition="1" x="0" y="0" />
      <ECTransition Source="Done" Destination="Ending" Condition="1" x="0" y="0" />
      <ECTransition Source="Halt" Destination="Ending" Condition="1" x="0" y="0" />
      <ECTransition Source="Abort" Destination="Ending" Condition="1" x="0" y="0" />
      <ECTransition Source="Ending" Destination="EndDone" Condition="PLAYED[Outcome = 1]" x="0" y="0" />
      <ECTransition Source="Ending" Destination="EndFailed" Condition="PLAYED[Outcome = 2]" x="0" y="0" />
      <ECTransition Source="Ending" Destination="EndHalted" Condition="PLAYED[Outcome = 3]" x="0" y="0" />
      <ECTransition Source="Ending" Destination="Idle" Condition="PLAYED" x="0" y="0" />
      <ECTransition Source="Ending" Destination="Abort" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="EndDone" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="EndFailed" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="EndHalted" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Check" Destination="Run" Condition="1" x="0" y="0" />
      <ECTransition Source="Run" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="Running" Destination="Halt" Condition="HALT" x="0" y="0" />
      <ECTransition Source="Running" Destination="Abort" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Reject" Destination="Idle" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>IdEqState := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Module), "/"), Equipment), "/state]");
IdEqCmd := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Module), "/"), Equipment), "/cmd]");</ST>
    </Algorithm>
    <Algorithm Name="Alg_Reject">
      <ST>ErrorID := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Sample">
      <ST>EquipmentFree := (EqHolder = "") OR (EqHolder = Holder);</ST>
    </Algorithm>
    <Algorithm Name="Alg_Busy">
      <ST>ErrorID := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Run">
      <ST>C_Holder := Holder;
C_Command := 1;
C_Arg := 0.0;
C_Release := FALSE;
TimerDT := MUL_TIME(T#1s, 2.0);</ST>
    </Algorithm>
    <Algorithm Name="Alg_RunSample">
      <ST>EquipmentFree := (EqHolder = "") OR (EqHolder = Holder);</ST>
    </Algorithm>
    <Algorithm Name="Alg_Unsafe">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
ErrorID := 2;
Outcome := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Lost">
      <ST>ErrorID := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Done">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
Outcome := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Halt">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
ErrorID := 7;
Outcome := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Abort">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := TRUE;
Outcome := 0;</ST>
    </Algorithm>
  </BasicFB>
</FBType>