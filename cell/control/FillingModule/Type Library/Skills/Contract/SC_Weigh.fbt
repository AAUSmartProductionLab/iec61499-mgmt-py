<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SC_Weigh" Comment="The contract of a skill primitive, the only part that is its own: which command it sends (and with what argument, and which when it ends), how long it may run, and three conditions on the equipment's signals and its parameters: when it may start, when it is done, what must hold while it runs. Technical: Weigh: Precondition TRUE; Scale.Measure until 0.2 s; Invariant TRUE">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: name the OPC UA variables of the parameters and results">
        <With Var="UaRoot" />
        <With Var="UaPath" />
      </Event>
      <Event Name="START" Type="Event" Comment="A run starts, with the parameters: say what the skill does" />
      <Event Name="SAMPLE" Type="Event" Comment="The equipment's newest state arrived">
        <With Var="Weight" />
        <With Var="EqHolder" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on">
        <With Var="IdResults" />
      </Event>
      <Event Name="RESULTS" Type="Event" Comment="The results for the newest state (R_...)">
        <With Var="R_Weight" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="Weight" Type="LREAL" Comment="Scale: Weight (g), an input" />
      <VarDeclaration Name="EqHolder" Type="WSTRING" Comment="Who holds the equipment now (empty: free), passed on to the run" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="R_Weight" Type="LREAL" Comment="Result: Weight" />
      <VarDeclaration Name="IdResults" Type="WSTRING" Comment="OPC UA ID of the published results" />
    </OutputVars>
    <Plugs>
      <AdapterDeclaration Name="Run" Type="modlib::AContract" Comment="To the run (AContract): what the skill does and when it is done" />
    </Plugs>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="Wait" x="1968" y="0" />
      <ECState Name="Init" x="0" y="1260">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Start" x="1765" y="1260">
        <ECAction Algorithm="Alg_Start" />
      </ECState>
      <ECState Name="Started" x="220" y="2520">
        <ECAction Algorithm="Alg_Evaluate" Output="Run.START" />
        <ECAction Output="RESULTS" />
      </ECState>
      <ECState Name="Sample" x="3295" y="1260">
        <ECAction Algorithm="Alg_Sample" />
      </ECState>
      <ECState Name="Judge" x="2480" y="2520">
        <ECAction Algorithm="Alg_Evaluate" Output="Run.SAMPLE" />
        <ECAction Output="RESULTS" />
      </ECState>
      <ECTransition Source="Wait" Destination="Init" Condition="INIT" x="1320" y="710" />
      <ECTransition Source="Init" Destination="Wait" Condition="1" x="1800" y="870" />
      <ECTransition Source="Wait" Destination="Start" Condition="START" x="2144" y="710" />
      <ECTransition Source="Start" Destination="Started" Condition="1" x="1590" y="1995" />
      <ECTransition Source="Started" Destination="Wait" Condition="1" x="2954" y="1365" />
      <ECTransition Source="Wait" Destination="Sample" Condition="SAMPLE" x="2932" y="710" />
      <ECTransition Source="Sample" Destination="Judge" Condition="1" x="3496" y="1995" />
      <ECTransition Source="Judge" Destination="Wait" Condition="1" x="1273" y="1365" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>IdResults := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/Results/Weight"), "]");</ST>
    </Algorithm>
    <Algorithm Name="Alg_Start">
      <ST>Run.Timed := TRUE;
Run.RunTime := MUL_TIME(T#1s, 0.2);
Run.Command := 2;
Run.Arg := 0.0;
Run.StopCommand := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Evaluate">
      <ST>Run.Pre := TRUE;
Run.Post := FALSE;
Run.Inv := TRUE;
R_Weight := Weight;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Sample">
      <ST>Run.EqHolder := EqHolder;</ST>
    </Algorithm>
  </BasicFB>
</FBType>