<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_Dwell" Comment="Skill primitive Dwell: Wait at the current position (stands in for dispensing until there is a pump) (parameters: Duration [s] 0.0..60.0, default 1.0). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Token" />
        <With Var="LastUse" />
        <With Var="Duration" />
      </Event>
      <Event Name="START" Type="Event">
        <With Var="Duration" />
      </Event>
      <Event Name="HALT" Type="Event" />
      <Event Name="ABORT" Type="Event" />
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="SUCCESS" Type="Event" />
      <Event Name="FAILURE" Type="Event">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="Methods" Type="BOOL" />
      <VarDeclaration Name="Token" Type="WSTRING" />
      <VarDeclaration Name="LastUse" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration Name="Duration" Type="LREAL" InitialValue="1.0" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with the range check, Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="21200" height="5500" locked="false" />
    <Group Name="Execution" Comment="One run: the contract, the command to the equipment and the end condition" x="1000" y="7700" width="16800" height="6080" locked="false" />
    <FB Name="Control" Type="modlib::SKILL_Core" x="2800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Logic" Type="filling::SL_Dwell" x="2800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="UaStart" Type="iec61499::net::SERVER_2_2" x="7400" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Par_Duration" Type="modlib::SKILL_Param_LREAL" x="12000" y="900">
      <Parameter Name="Lower" Value="0.0" />
      <Parameter Name="Upper" Value="60.0" />
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="PubParams" Type="iec61499::net::PUBLISH_1" x="16600" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Timer" Type="iec61499::events::E_DELAY" x="9800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <EventConnections>
      <Connection Source="Control.RSP_START" Destination="UaStart.RSP" />
      <Connection Source="UaStart.IND" Destination="Par_Duration.CHECK" />
      <Connection Source="Control.GO" Destination="Par_Duration.LATCH" />
      <Connection Source="Par_Duration.CHECKED" Destination="Control.CMD_START" />
      <Connection Source="Par_Duration.LATCHED" Destination="PubParams.REQ" />
      <Connection Source="PubParams.INITO" Destination="PubParams.REQ" />
      <Connection Source="INIT" Destination="Control.INIT" />
      <Connection Source="Control.INITO" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="UaStart.INIT" />
      <Connection Source="UaStart.INITO" Destination="Par_Duration.INIT" />
      <Connection Source="Par_Duration.INITO" Destination="PubParams.INIT" />
      <Connection Source="PubParams.INITO" Destination="INITO" />
      <Connection Source="START" Destination="Control.START" />
      <Connection Source="HALT" Destination="Control.HALT" />
      <Connection Source="ABORT" Destination="Control.ABORT" />
      <Connection Source="RESET" Destination="Control.RESET" />
      <Connection Source="Control.SUCCESS" Destination="SUCCESS" />
      <Connection Source="Control.FAILURE" Destination="FAILURE" />
      <Connection Source="Par_Duration.LATCHED" Destination="Logic.START" />
      <Connection Source="Control.HALT_O" Destination="Logic.HALT" />
      <Connection Source="Control.ABORT_O" Destination="Logic.ABORT" />
      <Connection Source="Control.RUN_STOP" Destination="Control.STOP_DONE" />
      <Connection Source="Logic.DONE" Destination="Control.EXEC_DONE" />
      <Connection Source="Logic.FAILED" Destination="Control.EXEC_FAILED" />
      <Connection Source="Logic.HALTED" Destination="Control.EXEC_FAILED" />
      <Connection Source="Logic.TIMER_START" Destination="Timer.START" />
      <Connection Source="Logic.TIMER_STOP" Destination="Timer.STOP" />
      <Connection Source="Timer.EO" Destination="Logic.TIMER" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Control.IdStart" Destination="UaStart.ID" />
      <Connection Source="UaStart.RD_1" Destination="Control.S_Start" />
      <Connection Source="Control.Accepted" Destination="UaStart.SD_1" />
      <Connection Source="Control.RspError" Destination="UaStart.SD_2" />
      <Connection Source="UaStart.RD_2" Destination="Par_Duration.S" />
      <Connection Source="Control.FromUa" Destination="Par_Duration.FromUa" />
      <Connection Source="Par_Duration.P" Destination="PubParams.SD_1" />
      <Connection Source="Par_Duration.InRange" Destination="Control.InRange" />
      <Connection Source="Module" Destination="Control.Module" />
      <Connection Source="UaRoot" Destination="Control.UaRoot" />
      <Connection Source="UaPath" Destination="Control.UaPath" />
      <Connection Source="UaEnable" Destination="Control.UaEnable" />
      <Connection Source="Methods" Destination="Control.Methods" />
      <Connection Source="Methods" Destination="UaStart.QI" />
      <Connection Source="Control.State" Destination="State" />
      <Connection Source="Control.ErrorID" Destination="ErrorID" />
      <Connection Source="UaRoot" Destination="Logic.UaRoot" />
      <Connection Source="UaPath" Destination="Logic.UaPath" />
      <Connection Source="UaEnable" Destination="PubParams.QI" />
      <Connection Source="Logic.IdParams" Destination="PubParams.ID" />
      <Connection Source="Duration" Destination="Par_Duration.Default" />
      <Connection Source="Par_Duration.P" Destination="Logic.Duration" />
      <Connection Source="Logic.ErrorID" Destination="Control.ExecError" />
      <Connection Source="Logic.TimerDT" Destination="Timer.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>