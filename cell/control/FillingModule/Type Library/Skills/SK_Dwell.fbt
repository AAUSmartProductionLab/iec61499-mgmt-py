<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_Dwell" Comment="Skill primitive Dwell: Wait at the current position (stands in for dispensing until there is a pump) (parameters: Duration [s] 0.0..60.0, default 1.0). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Token" />
        <With Var="LastUse" />
        <With Var="Duration" />
      </Event>
      <Event Name="START" Type="Event">
        <With Var="Duration" />
      </Event>
      <Event Name="HALT" Type="Event" />
      <Event Name="ABORT" Type="Event" />
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="SUCCESS" Type="Event" />
      <Event Name="FAILURE" Type="Event">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="Methods" Type="BOOL" />
      <VarDeclaration Name="Token" Type="WSTRING" />
      <VarDeclaration Name="LastUse" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration Name="Duration" Type="LREAL" InitialValue="1.0" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Control" Type="modlib::SKILL_Control" x="400" y="200">
      <Parameter Name="EqFree" Value="TRUE" />
    </FB>
    <FB Name="Params" Type="filling::SP_Dwell" x="4000" y="200" />
    <FB Name="Owner" Type="modlib::MOD_OwnerView" x="7600" y="200" />
    <FB Name="Mode" Type="modlib::MOD_StateView" x="11200" y="200" />
    <FB Name="UaStart" Type="iec61499::net::SERVER_2_2" x="14800" y="200" />
    <FB Name="UaStop" Type="iec61499::net::SERVER_2_1" x="18400" y="200" />
    <FB Name="UaAbort" Type="iec61499::net::SERVER_2_1" x="22000" y="200" />
    <FB Name="UaReset" Type="iec61499::net::SERVER_2_1" x="25600" y="200" />
    <FB Name="PubState" Type="iec61499::net::PUBLISH_2" x="29200" y="200" />
    <FB Name="Act" Type="iec61499::net::PUBLISH_1" x="32800" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="Logic" Type="filling::SL_Dwell" x="36400" y="200" />
    <FB Name="PubParams" Type="iec61499::net::PUBLISH_1" x="40000" y="200" />
    <FB Name="Timer" Type="iec61499::events::E_DELAY" x="43600" y="200" />
    <EventConnections>
      <Connection Source="Control.RSP_START" Destination="UaStart.RSP" />
      <Connection Source="Control.RSP_STOP" Destination="UaStop.RSP" />
      <Connection Source="Control.RSP_ABORT" Destination="UaAbort.RSP" />
      <Connection Source="Control.RSP_RESET" Destination="UaReset.RSP" />
      <Connection Source="UaStop.IND" Destination="Control.CMD_STOP" />
      <Connection Source="UaAbort.IND" Destination="Control.CMD_ABORT" />
      <Connection Source="UaReset.IND" Destination="Control.CMD_RESET" />
      <Connection Source="UaStart.IND" Destination="Params.CHECK" />
      <Connection Source="Params.CHECKED" Destination="Control.CMD_START" />
      <Connection Source="Owner.CHG" Destination="Control.OWNER_CHG" />
      <Connection Source="Mode.CHG" Destination="Control.MOD_CHG" />
      <Connection Source="Control.PUB" Destination="PubState.REQ" />
      <Connection Source="Control.ACT" Destination="Act.REQ" />
      <Connection Source="START" Destination="Control.START" />
      <Connection Source="HALT" Destination="Control.HALT" />
      <Connection Source="ABORT" Destination="Control.ABORT" />
      <Connection Source="RESET" Destination="Control.RESET" />
      <Connection Source="Control.SUCCESS" Destination="SUCCESS" />
      <Connection Source="Control.FAILURE" Destination="FAILURE" />
      <Connection Source="INIT" Destination="Control.INIT" />
      <Connection Source="Control.INITO" Destination="Params.INIT" />
      <Connection Source="Params.INITO" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Owner.INIT" />
      <Connection Source="Owner.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="UaStart.INIT" />
      <Connection Source="UaStart.INITO" Destination="UaStop.INIT" />
      <Connection Source="UaStop.INITO" Destination="UaAbort.INIT" />
      <Connection Source="UaAbort.INITO" Destination="UaReset.INIT" />
      <Connection Source="UaReset.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="PubParams.INIT" />
      <Connection Source="PubParams.INITO" Destination="Act.INIT" />
      <Connection Source="Act.INITO" Destination="PubState.REQ" />
      <Connection Source="Act.INITO" Destination="PubParams.REQ" />
      <Connection Source="Act.INITO" Destination="INITO" />
      <Connection Source="Control.GO_UA" Destination="Params.LATCH_UA" />
      <Connection Source="Control.GO_PARENT" Destination="Params.LATCH_DEF" />
      <Connection Source="Params.LATCHED" Destination="Logic.START" />
      <Connection Source="Params.LATCHED" Destination="PubParams.REQ" />
      <Connection Source="Control.HALT_O" Destination="Logic.HALT" />
      <Connection Source="Control.ABORT_O" Destination="Logic.ABORT" />
      <Connection Source="Control.RUN_STOP" Destination="Control.STOP_DONE" />
      <Connection Source="Logic.DONE" Destination="Control.EXEC_DONE" />
      <Connection Source="Logic.FAILED" Destination="Control.EXEC_FAILED" />
      <Connection Source="Logic.HALTED" Destination="Control.EXEC_FAILED" />
      <Connection Source="Logic.TIMER_START" Destination="Timer.START" />
      <Connection Source="Logic.TIMER_STOP" Destination="Timer.STOP" />
      <Connection Source="Timer.EO" Destination="Logic.TIMER" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Control.Module" />
      <Connection Source="Module" Destination="Owner.Module" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="UaRoot" Destination="Control.UaRoot" />
      <Connection Source="UaPath" Destination="Control.UaPath" />
      <Connection Source="UaRoot" Destination="Params.UaRoot" />
      <Connection Source="UaPath" Destination="Params.UaPath" />
      <Connection Source="Duration" Destination="Params.D_Duration" />
      <Connection Source="Methods" Destination="UaStart.QI" />
      <Connection Source="Methods" Destination="UaStop.QI" />
      <Connection Source="Methods" Destination="UaAbort.QI" />
      <Connection Source="Methods" Destination="UaReset.QI" />
      <Connection Source="UaEnable" Destination="PubState.QI" />
      <Connection Source="Control.IdStart" Destination="UaStart.ID" />
      <Connection Source="Control.Accepted" Destination="UaStart.SD_1" />
      <Connection Source="Control.RspError" Destination="UaStart.SD_2" />
      <Connection Source="UaStart.RD_1" Destination="Control.S_Start" />
      <Connection Source="Control.IdStop" Destination="UaStop.ID" />
      <Connection Source="Control.Accepted" Destination="UaStop.SD_1" />
      <Connection Source="Control.RspError" Destination="UaStop.SD_2" />
      <Connection Source="UaStop.RD_1" Destination="Control.S_Stop" />
      <Connection Source="Control.IdAbort" Destination="UaAbort.ID" />
      <Connection Source="Control.Accepted" Destination="UaAbort.SD_1" />
      <Connection Source="Control.RspError" Destination="UaAbort.SD_2" />
      <Connection Source="UaAbort.RD_1" Destination="Control.S_Abort" />
      <Connection Source="Control.IdReset" Destination="UaReset.ID" />
      <Connection Source="Control.Accepted" Destination="UaReset.SD_1" />
      <Connection Source="Control.RspError" Destination="UaReset.SD_2" />
      <Connection Source="UaReset.RD_1" Destination="Control.S_Reset" />
      <Connection Source="UaStart.RD_2" Destination="Params.S_Duration" />
      <Connection Source="Params.InRange" Destination="Control.InRange" />
      <Connection Source="Owner.Owner" Destination="Control.Owner" />
      <Connection Source="Mode.State" Destination="Control.ModState" />
      <Connection Source="Control.IdPub" Destination="PubState.ID" />
      <Connection Source="Control.State" Destination="PubState.SD_1" />
      <Connection Source="Control.State" Destination="State" />
      <Connection Source="Control.ErrorID" Destination="PubState.SD_2" />
      <Connection Source="Control.ErrorID" Destination="ErrorID" />
      <Connection Source="Control.IdAct" Destination="Act.ID" />
      <Connection Source="Control.Delta" Destination="Act.SD_1" />
      <Connection Source="UaEnable" Destination="PubParams.QI" />
      <Connection Source="Params.IdParams" Destination="PubParams.ID" />
      <Connection Source="Params.P_Duration" Destination="Logic.Duration" />
      <Connection Source="Params.P_Duration" Destination="PubParams.SD_1" />
      <Connection Source="Logic.ErrorID" Destination="Control.ExecError" />
      <Connection Source="Logic.TimerDT" Destination="Timer.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>