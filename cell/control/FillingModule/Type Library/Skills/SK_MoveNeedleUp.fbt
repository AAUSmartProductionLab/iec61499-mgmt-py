<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_MoveNeedleUp" Comment="Skill primitive MoveNeedleUp: Needle up to the top end switch (parameters: none). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Token" />
        <With Var="LastUse" />
        <With Var="Timeout" />
      </Event>
      <Event Name="START" Type="Event" />
      <Event Name="HALT" Type="Event" />
      <Event Name="ABORT" Type="Event" />
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="SUCCESS" Type="Event" />
      <Event Name="FAILURE" Type="Event">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="Methods" Type="BOOL" />
      <VarDeclaration Name="Token" Type="WSTRING" />
      <VarDeclaration Name="LastUse" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration Name="Timeout" Type="TIME" InitialValue="T#8000ms" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with the range check, Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="12000" height="5500" locked="false" />
    <Group Name="Execution" Comment="One run: the contract, the command to the equipment and the end condition" x="1000" y="7700" width="23800" height="6340" locked="false" />
    <Group Name="Equipment" Comment="The equipment's state in, the command as output values out (the command table and its timed phases are in Driver)" x="1000" y="15240" width="28800" height="5820" locked="false" />
    <FB Name="Control" Type="modlib::SKILL_Core" x="2800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Logic" Type="filling::SL_MoveNeedleUp" x="2800" y="900">
      <Parameter Name="Equipment" Value="&quot;NeedleAxis&quot;" />
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="UaStart" Type="iec61499::net::SERVER_2_1" x="7400" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="EqState" Type="iec61499::net::SUBSCRIBE_3" x="2800" y="900">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="EqView" Type="filling::EV_NeedleAxis" x="8000" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="WaitT" Type="iec61499::events::E_DELAY" x="16800" y="900">
      <Parameter Name="DT" Value="T#500ms" />
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="Driver" Type="filling::EC_NeedleAxis" x="13200" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="18400" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="EqCmd" Type="iec61499::net::PUBLISH_6" x="23600" y="900">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="Timer" Type="iec61499::events::E_DELAY" x="9800" y="900">
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
