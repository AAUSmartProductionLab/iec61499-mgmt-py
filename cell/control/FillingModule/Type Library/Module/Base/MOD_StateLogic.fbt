<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_StateLogic" Comment="The PackML state machine itself: Reset, Start, Stop, Abort and Clear take it from state to state (MOD_StateGate has already checked who sent them, and that PackML allows them now); while Stopping it waits until no skill runs any more. Technical: PackML module state machine: RESET, START, STOP, ABORT, CLEAR (decided by MOD_StateGate); runs the Resetting and Stopping procedures; Stopping waits until no skill is active">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="RESET" Type="Event" Comment="Reset the module (accepted by MOD_StateGate)" />
      <Event Name="START" Type="Event" Comment="Start the module (accepted by MOD_StateGate)" />
      <Event Name="STOP" Type="Event" Comment="Stop the module (accepted by MOD_StateGate)" />
      <Event Name="ABORT" Type="Event" Comment="Abort the module (accepted by MOD_StateGate)" />
      <Event Name="CLEAR" Type="Event" Comment="Clear the module (accepted by MOD_StateGate)" />
      <Event Name="ACT" Type="Event" Comment="The number of running skills changed (AllIdle)">
        <With Var="AllIdle" />
      </Event>
      <Event Name="RESETTING_DONE" Type="Event" Comment="The Resetting procedure ended" />
      <Event Name="RESETTING_FAILED" Type="Event" Comment="The Resetting procedure failed" />
      <Event Name="STOPPING_DONE" Type="Event" Comment="The Stopping procedure ended" />
      <Event Name="STOPPING_FAILED" Type="Event" Comment="The Stopping procedure failed" />
      <Event Name="STOP_TIMEOUT" Type="Event" Comment="Stopping took longer than StopTimeout" />
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event" Comment="The state changed">
        <With Var="State" />
      </Event>
      <Event Name="RUN_RESETTING" Type="Event" Comment="Run the Resetting procedure" />
      <Event Name="RUN_STOPPING" Type="Event" Comment="Run the Stopping procedure" />
      <Event Name="WD_START" Type="Event" Comment="Start the stop timeout" />
      <Event Name="WD_STOP" Type="Event" Comment="Stop the stop timeout" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="AllIdle" Type="BOOL" InitialValue="TRUE" Comment="No skill runs" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" InitialValue="2" Comment="PackML state: 1 Clearing, 2 Stopped, 3 Starting, 4 Idle, 6 Execute, 7 Stopping, 8 Aborting, 9 Aborted, 15 Resetting" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="Stopped" x="315" y="0">
        <ECAction Algorithm="Alg_Stopped" Output="CNF" />
      </ECState>
      <ECState Name="Resetting" x="0" y="1260">
        <ECAction Algorithm="Alg_Resetting" Output="CNF" />
        <ECAction Output="RUN_RESETTING" />
      </ECState>
      <ECState Name="ResettingW" x="662" y="2620" />
      <ECState Name="Idle" x="450" y="3880">
        <ECAction Algorithm="Alg_Idle" Output="CNF" />
      </ECState>
      <ECState Name="Starting" x="270" y="5140">
        <ECAction Algorithm="Alg_Starting" Output="CNF" />
      </ECState>
      <ECState Name="Execute" x="315" y="6400">
        <ECAction Algorithm="Alg_Execute" Output="CNF" />
      </ECState>
      <ECState Name="Stopping" x="158" y="7660">
        <ECAction Algorithm="Alg_Stopping" Output="CNF" />
        <ECAction Output="WD_START" />
      </ECState>
      <ECState Name="StoppingW" x="685" y="9020" />
      <ECState Name="StopProc" x="388" y="10280">
        <ECAction Output="WD_STOP" />
        <ECAction Output="RUN_STOPPING" />
      </ECState>
      <ECState Name="StopProcW" x="685" y="11640" />
      <ECState Name="Aborting" x="180" y="12900">
        <ECAction Algorithm="Alg_Aborting" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Aborted" x="315" y="14260">
        <ECAction Algorithm="Alg_Aborted" Output="CNF" />
      </ECState>
      <ECState Name="Clearing" x="270" y="15520">
        <ECAction Algorithm="Alg_Clearing" Output="CNF" />
      </ECState>
      <ECTransition Source="Stopped" Destination="Resetting" Condition="RESET" x="938" y="735" />
      <ECTransition Source="Idle" Destination="Starting" Condition="START" x="938" y="4590" />
      <ECTransition Source="ResettingW" Destination="Stopping" Condition="STOP" x="2338" y="5245" />
      <ECTransition Source="Idle" Destination="Stopping" Condition="STOP" x="-462" y="5875" />
      <ECTransition Source="Execute" Destination="Stopping" Condition="STOP" x="938" y="7135" />
      <ECTransition Source="Stopped" Destination="Aborting" Condition="ABORT" x="2838" y="6555" />
      <ECTransition Source="ResettingW" Destination="Aborting" Condition="ABORT" x="-963" y="7865" />
      <ECTransition Source="Idle" Destination="Aborting" Condition="ABORT" x="3338" y="8495" />
      <ECTransition Source="Execute" Destination="Aborting" Condition="ABORT" x="-1462" y="9755" />
      <ECTransition Source="StoppingW" Destination="Aborting" Condition="ABORT" x="3838" y="11065" />
      <ECTransition Source="StopProcW" Destination="Aborting" Condition="ABORT" x="938" y="12375" />
      <ECTransition Source="Aborted" Destination="Clearing" Condition="CLEAR" x="938" y="14970" />
      <ECTransition Source="Resetting" Destination="ResettingW" Condition="1" x="937" y="2045" />
      <ECTransition Source="ResettingW" Destination="Idle" Condition="RESETTING_DONE" x="937" y="3330" />
      <ECTransition Source="ResettingW" Destination="Aborting" Condition="RESETTING_FAILED" x="-1963" y="7865" />
      <ECTransition Source="Starting" Destination="Execute" Condition="1" x="938" y="5850" />
      <ECTransition Source="Stopping" Destination="StoppingW" Condition="1" x="938" y="8445" />
      <ECTransition Source="StoppingW" Destination="StopProc" Condition="[AllIdle]" x="938" y="9755" />
      <ECTransition Source="StoppingW" Destination="Aborting" Condition="STOP_TIMEOUT" x="4338" y="11065" />
      <ECTransition Source="StopProc" Destination="StopProcW" Condition="1" x="938" y="11065" />
      <ECTransition Source="StopProcW" Destination="Stopped" Condition="STOPPING_DONE" x="-2462" y="5900" />
      <ECTransition Source="StopProcW" Destination="Aborting" Condition="STOPPING_FAILED" x="1418" y="12535" />
      <ECTransition Source="Aborting" Destination="Aborted" Condition="1" x="938" y="13685" />
      <ECTransition Source="Clearing" Destination="Stopped" Condition="1" x="4838" y="7840" />
    </ECC>
    <Algorithm Name="Alg_Stopped">
      <ST>State := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Resetting">
      <ST>State := 15;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Idle">
      <ST>State := 4;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Starting">
      <ST>State := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Execute">
      <ST>State := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Stopping">
      <ST>State := 7;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborting">
      <ST>State := 8;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborted">
      <ST>State := 9;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Clearing">
      <ST>State := 1;</ST>
    </Algorithm>
  </BasicFB>
</FBType>