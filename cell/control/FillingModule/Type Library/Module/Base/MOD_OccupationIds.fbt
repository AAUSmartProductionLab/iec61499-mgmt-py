<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_OccupationIds" Comment="OPC UA and local channel IDs of the occupation">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdOccupy" />
        <With Var="IdRelease" />
        <With Var="IdPub" />
        <With Var="IdOwner" />
        <With Var="IdQuery" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdOccupy" Type="WSTRING" />
      <VarDeclaration Name="IdRelease" Type="WSTRING" />
      <VarDeclaration Name="IdPub" Type="WSTRING" />
      <VarDeclaration Name="IdOwner" Type="WSTRING" />
      <VarDeclaration Name="IdQuery" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdOccupy := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Occupation/")), "Occupy"), "]");
IdRelease := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Occupation/")), "Release"), "]");
IdPub := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, "/Occupation/")), "Occupied"), "]");
IdOwner := CONCAT(CONCAT("loc[", Module), "/owner]");
IdQuery := CONCAT(CONCAT("loc[", Module), "/owner/query]");</ST>
    </Algorithm>
  </SimpleFB>
</FBType>