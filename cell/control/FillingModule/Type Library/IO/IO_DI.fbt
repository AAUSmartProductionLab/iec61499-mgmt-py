<?xml version='1.0' encoding='utf-8'?>
<FBType Name="IO_DI" Comment="Digital input; Address: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]' or 'pwm[chip:channel:period_ns]' a Raspberry Pi's line, set up here; 'modbus[...]' a Modbus CLIENT ID; 'sim' simulated; another name a local IO handle set up elsewhere (IX PARAMS); empty: not connected (QO = FALSE)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Set up the point from Address (at start-up)">
        <With Var="Address" />
      </Event>
      <Event Name="REQ" Type="Event" Comment="Read the point, or write OUT to it">
        <With Var="SimValue" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Set up: QO says whether the point is reachable">
        <With Var="QO" />
      </Event>
      <Event Name="CNF" Type="Event" Comment="Done: QO says whether it worked (an input: IN is the value read)">
        <With Var="QO" />
        <With Var="IN" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Address" Type="STRING" Comment="Where the point is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="SimValue" Type="BOOL" Comment="The value read when the address is 'sim'" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="QO" Type="BOOL" Comment="The point is reachable, the last access worked" />
      <VarDeclaration Name="IN" Type="BOOL" Comment="The value read (an analog one scaled)" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Route" Type="modlib::IO_RouteDI" x="1100" y="1000" />
    <FB Name="Line" Type="eclipse4diac::io::gpiochip::GPIOChip" x="2265" y="1000">
      <Parameter Name="ReadWriteMode" Value="0" />
    </FB>
    <FB Name="Local" Type="eclipse4diac::io::IX" x="3520" y="1000" />
    <FB Name="Bus" Type="iec61499::net::CLIENT_0_1" x="4460" y="1000" />
    <EventConnections>
      <Connection Source="INIT" Destination="Route.INIT" />
      <Connection Source="Route.INIT_IO" Destination="Line.INIT" />
      <Connection Source="Line.INITO" Destination="Local.INIT" />
      <Connection Source="Local.INITO" Destination="Bus.INIT" />
      <Connection Source="Bus.INITO" Destination="Route.IO_READY" />
      <Connection Source="Route.INITO" Destination="INITO" />
      <Connection Source="REQ" Destination="Route.REQ" />
      <Connection Source="Route.REQ_G" Destination="Local.REQ" />
      <Connection Source="Route.REQ_M" Destination="Bus.REQ" />
      <Connection Source="Local.CNF" Destination="Route.CNF_G" />
      <Connection Source="Bus.CNF" Destination="Route.CNF_M" />
      <Connection Source="Route.CNF" Destination="CNF" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Route.LineQI" Destination="Line.QI" />
      <Connection Source="Route.LineName" Destination="Line.VALUE" />
      <Connection Source="Route.ChipNo" Destination="Line.ChipNumber" />
      <Connection Source="Route.LineNo" Destination="Line.LineNumber" />
      <Connection Source="Route.LineBias" Destination="Line.BiasMode" />
      <Connection Source="Route.LineLow" Destination="Line.ActiveLow" />
      <Connection Source="Address" Destination="Route.Address" />
      <Connection Source="Route.IoName" Destination="Local.PARAMS" />
      <Connection Source="Route.ModbusId" Destination="Bus.ID" />
      <Connection Source="Route.GQI" Destination="Local.QI" />
      <Connection Source="Route.MQI" Destination="Bus.QI" />
      <Connection Source="Local.QO" Destination="Route.QO_G" />
      <Connection Source="Bus.QO" Destination="Route.QO_M" />
      <Connection Source="Route.QO" Destination="QO" />
      <Connection Source="SimValue" Destination="Route.SimValue" />
      <Connection Source="Local.IN" Destination="Route.IN_G" />
      <Connection Source="Bus.RD_1" Destination="Route.IN_M" />
      <Connection Source="Route.IN" Destination="IN" />
    </DataConnections>
  </FBNetwork>
</FBType>