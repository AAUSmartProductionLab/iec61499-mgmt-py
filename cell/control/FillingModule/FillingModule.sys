      <SubApp Name="Dispensing" x="2800" y="900" Comment="Module level skill Dispensing: Needle down, dispense the volume, needle up, weigh (runFillingCycle)">
        <SubAppInterfaceList>
          <SubAppEventInputs>
            <SubAppEvent Name="INIT" Type="EInit" />
          </SubAppEventInputs>
          <SubAppEventOutputs>
            <SubAppEvent Name="INITO" Type="EInit" />
          </SubAppEventOutputs>
        </SubAppInterfaceList>
        <SubAppNetwork>
          <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with one block per parameter (range check, value for this run), Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="25800" height="5500" locked="false" />
          <Group Name="Sequences" Comment="What the skill does: Execute, and Stop when it is interrupted; private skill primitives in order" x="1000" y="7700" width="14800" height="4100" locked="false" />
          <Group Name="Releasing" Comment="After a failure or an abort: gives up the equipment the skill holds (all off, free again)" x="1000" y="13000" width="21200" height="3500" locked="false" />
          <FB Name="Control" Type="modlib::SKILL_Core" x="2800" y="900">
            <Parameter Name="Module" Value="&quot;Filling&quot;" />
            <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
            <Parameter Name="UaPath" Value="&quot;/Skills/Dispensing&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="Methods" Value="TRUE" />
            <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
          </FB>
          <FB Name="UaStart" Type="iec61499::net::SERVER_2_2" x="7400" y="900">
            <Parameter Name="QI" Value="TRUE" />
            <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
          </FB>
          <FB Name="Volume" Type="modlib::SKILL_Param_LREAL" x="12000" y="900">
            <Parameter Name="Default" Value="1.0" />
            <Parameter Name="Lower" Value="0.5" />
            <Parameter Name="Upper" Value="10.0" />
            <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
          </FB>
          <FB Name="PubParams" Type="iec61499::net::PUBLISH_1" x="16600" y="900">
