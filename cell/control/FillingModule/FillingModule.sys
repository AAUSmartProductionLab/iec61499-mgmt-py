<?xml version='1.0' encoding='utf-8'?>
<System Name="FillingModule" Comment="Module Filling, generated from its module specification">
  <Identification Standard="61499-2" />
  <Application Name="Filling" Comment="Module Filling on target pc (localhost, IO modbus; generated by modgen)">
    <SubAppNetwork>
      <Group Name="ModuleLevel" Comment="Module level: occupation, PackML state manager, start-up and the target's IO lines" x="1000" y="1000" width="17800" height="3900" locked="false" />
      <Group Name="ModuleLevelSkills" Comment="Module level skills: Control, Sequences (Execute, Stop) of skill primitives and Release; OPC UA /Skills/&lt;name&gt;" x="1000" y="6100" width="7800" height="3100" locked="false" />
      <Group Name="Procedures" Comment="Procedures the module state manager runs while Resetting and Stopping" x="1000" y="10400" width="12800" height="3100" locked="false" />
      <Group Name="SkillPrimitives" Comment="Skill primitives: one equipment command until a sensor or a time; OPC UA /Skills/&lt;name&gt;" x="1000" y="14700" width="24800" height="8500" locked="false" />
      <Group Name="EquipmentIO" Comment="Equipment IO: the only owners of the IO points; skills send them output values over local channels" x="1000" y="24400" width="22300" height="5900" locked="false" />
