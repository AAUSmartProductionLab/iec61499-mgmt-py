<?xml version='1.0' encoding='utf-8'?>
<System Name="FillingModule" Comment="Module Filling, generated from its module specification">
  <Identification Standard="61499-2" />
  <Application Name="Filling" Comment="Module Filling on target pc (localhost, IO modbus; generated by modgen)">
    <SubAppNetwork>
      <Group Name="ModuleLevel" Comment="Module level: occupation, PackML state manager, start-up and the target's IO lines" x="1000" y="1000" width="7445" height="2993.33" locked="false" />
      <Group Name="ModuleLevelSkills" Comment="Module level skills: Control, Sequences (Execute, Stop) of skill primitives and Release; OPC UA /Skills/&lt;name&gt;" x="1000" y="4100" width="2500" height="2493.33" locked="false" />
      <Group Name="Procedures" Comment="Procedures the module state manager runs while Resetting and Stopping" x="4000" y="4400" width="3193.33" height="2123" locked="false" />
      <Group Name="SkillPrimitives" Comment="Skill primitives: one equipment command until a sensor or a time; OPC UA /Skills/&lt;name&gt;" x="1000" y="6800" width="5920" height="6423" locked="false" />
      <Group Name="EquipmentIO" Comment="Equipment IO: the only owners of the IO points; skills send them output values over local channels" x="7220" y="6900" width="6530" height="3323" locked="false" />
      <FB Name="Occupation" Type="modlib::MOD_Occupation" x="2400" y="893.33" Comment="Who may command the module. A client calls Occupy(Session) at /Objects/Filling/Occupation first; until it calls Release, only commands with that session id are accepted. Every block hears the owner on loc[Filling/owner].">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="ModuleLevel" />
      </FB>
      <FB Name="Module" Type="modlib::MOD_StateManager" x="5090" y="293.33" Comment="The module's PackML state. The owner calls Reset, Start, Stop, Abort or Clear at /Objects/Filling/Module; State is at /Objects/Filling/Module/State and on loc[Filling/state]. Reset runs the Resetting procedure, Stop the Stopping procedure; skills may be started only in Execute.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="StopTimeout" Value="T#10000ms" />
        <Attribute Name="GroupName" Type="STRING" Value="ModuleLevel" />
      </FB>
      <FB Name="LinearAxis" Type="filling::EQ_LinearAxis" x="1700" y="793.33" Comment="Equipment LinearAxis: Needle lift, a stepper motor through a step and direction driver, with a limit switch at the top (home). The only block that touches its pins (AtHome = modbus[127.0.0.1:1502:1:10:d0:], Enable = modbus[127.0.0.1:1502:1:0::c0], Down = modbus[127.0.0.1:1502:1:0::c1], Step = modbus[127.0.0.1:1502:1:0::h0]). Skills send it what to switch on loc[Filling/LinearAxis/cmd]; it reports its inputs on loc[Filling/LinearAxis/state] and at /Objects/Filling/Equipment/LinearAxis.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="AtHome_Address" Value="'modbus[127.0.0.1:1502:1:10:d0:]'" />
        <Parameter Name="Enable_Address" Value="'modbus[127.0.0.1:1502:1:0::c0]'" />
        <Parameter Name="Down_Address" Value="'modbus[127.0.0.1:1502:1:0::c1]'" />
        <Parameter Name="Step_Address" Value="'modbus[127.0.0.1:1502:1:0::h0]'" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Pump" Type="filling::EQ_Pump" x="4500" y="393.33" Comment="Equipment Pump: Filling pump; none is wired yet, so it has no outputs and dispensing is a time at the station's flow rate. The only block that touches its pins (no pins). Skills send it what to switch on loc[Filling/Pump/cmd]; it reports its inputs on loc[Filling/Pump/state] and at /Objects/Filling/Equipment/Pump.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Scale" Type="filling::EQ_Scale" x="4865" y="1593.33" Comment="Equipment Scale: Scale; the hardware has none, so the weight is simulated. The only block that touches its pins (Weight = modbus[127.0.0.1:1502:1:10:i0:]). Skills send it what to switch on loc[Filling/Scale/cmd]; it reports its inputs on loc[Filling/Scale/state] and at /Objects/Filling/Equipment/Scale.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="Weight_Address" Value="'modbus[127.0.0.1:1502:1:10:i0:]'" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Home" Type="filling::SK_Home" x="1360" y="393.33" Comment="Skill Home, offered on its own: Needle up to the limit switch; from there its position is known, using LinearAxis. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Filling/Skills/Home; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaPath" Value="&quot;/Skills/Home&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="Methods" Value="TRUE" />
        <Parameter Name="Holder" Value="&quot;Home&quot;" />
        <Parameter Name="ReleaseAfter" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="SkillPrimitives" />
      </FB>
      <FB Name="MoveAxis" Type="filling::SK_MoveAxis" x="4095" y="393.33" Comment="Skill MoveAxis, offered on its own: Needle to Position, measured down from the limit switch; the direction follows from where it is, using LinearAxis. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Filling/Skills/MoveAxis; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaPath" Value="&quot;/Skills/MoveAxis&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="Methods" Value="TRUE" />
        <Parameter Name="Holder" Value="&quot;MoveAxis&quot;" />
        <Parameter Name="ReleaseAfter" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="SkillPrimitives" />
      </FB>
      <FB Name="Dispense" Type="filling::SK_Dispense" x="1360" y="4193.33" Comment="Skill Dispense, offered on its own: Dispense a volume at the station's flow rate (open loop, by time, until a pump is wired), using Pump. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Filling/Skills/Dispense; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
        <Parameter Name="UaPath" Value="&quot;/Skills/Dispense&quot;" />
