      </FB>
      <FB Name="Tare" Type="filling::SK_Tare" x="4180" y="2293.33" Comment="Skill Tare, offered on its own: Tare the scale, using Scale. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Filling/Skills/Tare; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
