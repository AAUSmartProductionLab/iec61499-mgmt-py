      </FB>
      <FB Name="Weigh" Type="filling::SK_Weigh" x="1360" y="2293.33" Comment="Skill Weigh, offered on its own: Read the weight, using Scale. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Filling/Skills/Weigh; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Filling&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
