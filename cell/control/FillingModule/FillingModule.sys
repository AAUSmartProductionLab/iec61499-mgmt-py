        </SubAppInterfaceList>
        <SubAppNetwork>
          <Group Name="Core" Comment="The skill's state machine: Stop, Abort, Reset, State and ErrorID over OPC UA; gives up everything the skill holds when a run ends" x="1000" y="3000" width="3750" height="3440" locked="false" />
          <Group Name="Start" Comment="The Start method: one block per parameter (range check, value for this run), the values published" x="1000" y="6740" width="8955" height="2230" locked="false" />
          <Group Name="Sequences" Comment="What the skill does: Execute, and Stop when it is interrupted; private skill primitives in order" x="7990" y="1000" width="5725" height="2030" locked="false" />
          <Group Name="Results" Comment="The results published when Execute is done" x="1000" y="9270" width="3280" height="1830" locked="false" />
          <FB Name="Control" Type="modlib::SKILL_Core" x="1200" y="500" Comment="The state machine of the skill Dispensing: checks a client's Start (occupation, module in Execute, not running, values in range), publishes State and ErrorID at /Objects/Filling/Skills/Dispensing, offers Stop, Abort and Reset there, starts Execute and runs Stop when the skill is stopped.">
            <Parameter Name="Module" Value="&quot;Filling&quot;" />
            <Parameter Name="UaRoot" Value="&quot;/Objects/Filling&quot;" />
            <Parameter Name="UaPath" Value="&quot;/Skills/Dispensing&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="Methods" Value="TRUE" />
            <Parameter Name="Holder" Value="&quot;Dispensing&quot;" />
            <Parameter Name="ReleaseAll" Value="TRUE" />
            <Attribute Name="GroupName" Type="STRING" Value="Core" />
          </FB>
          <FB Name="UaStart" Type="iec61499::net::SERVER_2_2" x="1190" y="500" Comment="The OPC UA method Start of Dispensing: a client's call (session id and parameters) arrives here; the parameters are checked, then Control answers Accepted or an error code.">
            <Parameter Name="QI" Value="TRUE" />
            <Attribute Name="GroupName" Type="STRING" Value="Start" />
          </FB>
          <FB Name="Volume" Type="modlib::SKILL_Param_LREAL" x="3960" y="500" Comment="The parameter Volume of Dispensing: default 1.0 (Lower 0.5, Upper 10.0); checks a client's value, then holds it for the run and hands it to the steps.">
            <Parameter Name="Default" Value="1.0" />
            <Parameter Name="Lower" Value="0.5" />
            <Parameter Name="Upper" Value="10.0" />
            <Attribute Name="GroupName" Type="STRING" Value="Start" />
          </FB>
          <FB Name="PubParams" Type="iec61499::net::PUBLISH_1" x="7875" y="500" Comment="Writes the parameters of the run to OPC UA: /Objects/Filling/Skills/Dispensing/Parameters/Volume">
            <Parameter Name="QI" Value="TRUE" />
            <Parameter Name="ID" Value="&quot;opc_ua[WRITE;/Objects/Filling/Skills/Dispensing/Parameters/Volume]&quot;" />
            <Attribute Name="GroupName" Type="STRING" Value="Start" />
          </FB>
          <FB Name="PubResults" Type="iec61499::net::PUBLISH_1" x="1700" y="500" Comment="Writes the results of the run to OPC UA: /Objects/Filling/Skills/Dispensing/Results/Weight">
            <Parameter Name="QI" Value="TRUE" />
            <Parameter Name="ID" Value="&quot;opc_ua[WRITE;/Objects/Filling/Skills/Dispensing/Results/Weight]&quot;" />
            <Attribute Name="GroupName" Type="STRING" Value="Results" />
