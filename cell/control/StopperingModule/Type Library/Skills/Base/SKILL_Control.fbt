<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SKILL_Control" Comment="Skill state machine: Start/Stop/Abort/Reset over OPC UA (owner only, Start only in module Execute) and START/HALT/ABORT from a parent; Idle 0, Running 1, Stopping 2, Succeeded 3, Failed 4, Aborted 5; RUN starts the execution (CalledByClient: with the Start arguments, else with the parent's values)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
      </Event>
      <Event Name="START_REQ" Type="Event" Comment="Start(Session, parameters) was called: check Session, ParamsInRange, EquipmentFree">
        <With Var="Session" />
        <With Var="ParamsInRange" />
        <With Var="EquipmentFree" />
      </Event>
      <Event Name="STOP_REQ" Type="Event" Comment="Stop(Session) was called">
        <With Var="StopSession" />
      </Event>
      <Event Name="ABORT_REQ" Type="Event" Comment="Abort(Session) was called">
        <With Var="AbortSession" />
      </Event>
      <Event Name="RESET_REQ" Type="Event" Comment="Reset(Session) was called">
        <With Var="ResetSession" />
      </Event>
      <Event Name="OWNER_CHG" Type="Event" Comment="The module's owner changed">
        <With Var="Owner" />
      </Event>
      <Event Name="MOD_CHG" Type="Event" Comment="The module's state changed (its Stopping halts, its Aborting aborts the skill)">
        <With Var="ModuleState" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start a run, from the parent (a step of a sequence): no session check" />
      <Event Name="HALT" Type="Event" Comment="Stop the run, from the parent" />
      <Event Name="ABORT" Type="Event" Comment="Abort: everything off at once" />
      <Event Name="RESET" Type="Event" Comment="Reset from Failed or Aborted to Idle" />
      <Event Name="EXECUTE_DONE" Type="Event" Comment="The execution ended successfully" />
      <Event Name="EXECUTE_FAILED" Type="Event" Comment="The execution failed (ExecuteError)">
        <With Var="ExecuteError" />
      </Event>
      <Event Name="STOPPING_DONE" Type="Event" Comment="The stop sequence ended" />
      <Event Name="TO_IDLE" Type="Event" Comment="Succeeded long enough: back to Idle" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on">
        <With Var="StartMethodId" />
        <With Var="StopMethodId" />
        <With Var="AbortMethodId" />
        <With Var="ResetMethodId" />
        <With Var="StateId" />
        <With Var="ActivityId" />
        <With Var="ReleaseId" />
      </Event>
      <Event Name="START_RSP" Type="Event" Comment="Answer to Start">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="STOP_RSP" Type="Event" Comment="Answer to Stop">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="ABORT_RSP" Type="Event" Comment="Answer to Abort">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="RESET_RSP" Type="Event" Comment="Answer to Reset">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="PUB" Type="Event" Comment="Publish State and ErrorID">
        <With Var="State" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="RUN" Type="Event" Comment="Run: latch the parameters, start the execution">
        <With Var="CalledByClient" />
      </Event>
      <Event Name="HALT_SEQ" Type="Event" Comment="Halt the execute sequence" />
      <Event Name="ABORT_SEQ" Type="Event" Comment="Abort the sequences" />
      <Event Name="RESET_SEQ" Type="Event" Comment="Reset the sequences" />
      <Event Name="RUN_STOPPING" Type="Event" Comment="Run the stop sequence (the skill was stopped)" />
      <Event Name="SUCCESS" Type="Event" Comment="The run succeeded (the results are set)" />
      <Event Name="FAILURE" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
      <Event Name="RELEASE" Type="Event" Comment="A run ended: give up what the skill holds (published if ReleaseAll)" />
      <Event Name="ACT" Type="Event" Comment="Count the module's activity (ActivityDelta)">
        <With Var="ActivityDelta" />
      </Event>
      <Event Name="TO_IDLE_START" Type="Event" Comment="Start the timer back to Idle" />
      <Event Name="TO_IDLE_STOP" Type="Event" Comment="Stop the timer back to Idle" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="Session" Type="WSTRING" Comment="Session ID of the caller of Start (must be the module's owner)" />
      <VarDeclaration Name="ParamsInRange" Type="BOOL" Comment="Every Start argument lies within its limits" />
      <VarDeclaration Name="EquipmentFree" Type="BOOL" Comment="The equipment is free, or held by this skill" />
      <VarDeclaration Name="StopSession" Type="WSTRING" Comment="Session ID of the caller of Stop" />
      <VarDeclaration Name="AbortSession" Type="WSTRING" Comment="Session ID of the caller of Abort" />
      <VarDeclaration Name="ResetSession" Type="WSTRING" Comment="Session ID of the caller of Reset" />
      <VarDeclaration Name="Owner" Type="WSTRING" Comment="Session ID of the module's owner (empty: free)" />
      <VarDeclaration Name="ModuleState" Type="USINT" Comment="PackML state: 1 Clearing, 2 Stopped, 3 Starting, 4 Idle, 6 Execute, 7 Stopping, 8 Aborting, 9 Aborted, 15 Resetting" />
      <VarDeclaration Name="ExecuteError" Type="UINT" Comment="Why the execution failed" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="StartMethodId" Type="WSTRING" Comment="OPC UA ID of the Start method, for its SERVER block" />
      <VarDeclaration Name="StopMethodId" Type="WSTRING" Comment="OPC UA ID of the Stop method" />
      <VarDeclaration Name="AbortMethodId" Type="WSTRING" Comment="OPC UA ID of the Abort method" />
      <VarDeclaration Name="ResetMethodId" Type="WSTRING" Comment="OPC UA ID of the Reset method" />
      <VarDeclaration Name="StateId" Type="WSTRING" Comment="OPC UA ID of the published State and ErrorID" />
      <VarDeclaration Name="ActivityId" Type="WSTRING" Comment="Local channel of the module's activity count" />
      <VarDeclaration Name="ReleaseId" Type="WSTRING" Comment="Local channel the module's equipment is released on" />
      <VarDeclaration Name="Accepted" Type="BOOL" Comment="The call was accepted" />
      <VarDeclaration Name="ResponseError" Type="UINT" Comment="Why a call was refused (error code)" />
      <VarDeclaration Name="State" Type="USINT" Comment="Skill state: 0 Idle, 1 Running, 2 Stopping, 3 Succeeded, 4 Failed, 5 Aborted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
      <VarDeclaration Name="ActivityDelta" Type="INT" Comment="+1 when the run starts, -1 when it ends" />
      <VarDeclaration Name="CalledByClient" Type="BOOL" Comment="Started over OPC UA (take the Start arguments), not by a parent (take the defaults)" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Owned" Type="BOOL" />
      <VarDeclaration Name="Here" Type="USINT" />
      <VarDeclaration Name="Active" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Init" x="570" y="100">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Idle" x="990" y="100">
        <ECAction Algorithm="Alg_Idle" Output="PUB" />
      </ECState>
      <ECState Name="Running" x="1410" y="100">
        <ECAction Algorithm="Alg_Running" Output="PUB" />
      </ECState>
      <ECState Name="Stopping" x="150" y="330">
        <ECAction Algorithm="Alg_Stopping" Output="PUB" />
      </ECState>
      <ECState Name="StopProc" x="570" y="330">
        <ECAction Algorithm="Alg_StopProc" Output="PUB" />
      </ECState>
      <ECState Name="Succeeded" x="990" y="330">
        <ECAction Algorithm="Alg_Succeeded" Output="PUB" />
        <ECAction Output="TO_IDLE_START" />
      </ECState>
      <ECState Name="Failed" x="1410" y="330">
        <ECAction Algorithm="Alg_Failed" Output="PUB" />
      </ECState>
      <ECState Name="Aborted" x="150" y="560">
        <ECAction Algorithm="Alg_Aborted" Output="PUB" />
      </ECState>
      <ECState Name="GoUa" x="570" y="560">
        <ECAction Algorithm="Alg_GoUa" Output="ACT" />
        <ECAction Output="TO_IDLE_STOP" />
        <ECAction Output="RUN" />
      </ECState>
      <ECState Name="GoParent" x="990" y="560">
        <ECAction Algorithm="Alg_GoParent" Output="ACT" />
        <ECAction Output="TO_IDLE_STOP" />
        <ECAction Output="RUN" />
      </ECState>
      <ECState Name="Halt" x="1410" y="560">
        <ECAction Output="HALT_SEQ" />
      </ECState>
      <ECState Name="RunStop" x="150" y="790">
        <ECAction Output="RUN_STOPPING" />
      </ECState>
      <ECState Name="Succeed" x="570" y="790">
        <ECAction Algorithm="Alg_Succeed" Output="ACT" />
        <ECAction Output="RELEASE" />
        <ECAction Output="SUCCESS" />
      </ECState>
      <ECState Name="Fail" x="990" y="790">
        <ECAction Algorithm="Alg_Fail" Output="ACT" />
        <ECAction Output="RELEASE" />
        <ECAction Output="FAILURE" />
      </ECState>
      <ECState Name="Interrupted" x="1410" y="790">
        <ECAction Algorithm="Alg_Interrupted" Output="ACT" />
        <ECAction Output="RELEASE" />
        <ECAction Output="FAILURE" />
      </ECState>
      <ECState Name="AbortChk" x="150" y="1020" />
      <ECState Name="AbortActive" x="570" y="1020">
        <ECAction Algorithm="Alg_AbortActive" Output="ABORT_SEQ" />
        <ECAction Output="ACT" />
        <ECAction Output="RELEASE" />
      </ECState>
      <ECState Name="AbortIdle" x="990" y="1020">
        <ECAction Output="ABORT_SEQ" />
      </ECState>
      <ECState Name="StartRefused" x="1410" y="1020">
        <ECAction Algorithm="Alg_StartRefused" Output="FAILURE" />
      </ECState>
      <ECState Name="ResetOk" x="150" y="1250">
        <ECAction Output="RESET_SEQ" />
      </ECState>
      <ECState Name="ChkStart" x="570" y="1250">
        <ECAction Algorithm="Alg_ChkStart" Output="START_RSP" />
      </ECState>
      <ECState Name="ChkStop" x="990" y="1250">
        <ECAction Algorithm="Alg_ChkStop" Output="STOP_RSP" />
      </ECState>
      <ECState Name="ChkAbort" x="1410" y="1250">
        <ECAction Algorithm="Alg_ChkAbort" Output="ABORT_RSP" />
      </ECState>
      <ECState Name="ChkReset" x="150" y="1480">
        <ECAction Algorithm="Alg_ChkReset" Output="RESET_RSP" />
      </ECState>
      <ECTransition Source="START" Destination="Init" Condition="INIT" x="0" y="0" />
      <ECTransition Source="Init" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Running" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Running" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Running" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Running" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Failed" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Failed" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Failed" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Failed" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="GoParent" Condition="START" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="GoParent" Condition="START" x="0" y="0" />
      <ECTransition Source="Failed" Destination="GoParent" Condition="START" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="StartRefused" Condition="START" x="0" y="0" />
      <ECTransition Source="StartRefused" Destination="Aborted" Condition="1" x="0" y="0" />
      <ECTransition Source="Running" Destination="Succeed" Condition="EXECUTE_DONE" x="0" y="0" />
      <ECTransition Source="Running" Destination="Fail" Condition="EXECUTE_FAILED" x="0" y="0" />
      <ECTransition Source="Running" Destination="Halt" Condition="HALT" x="0" y="0" />
      <ECTransition Source="Running" Destination="Halt" Condition="MOD_CHG[(ModuleState = 7) AND CalledByClient]" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="RunStop" Condition="EXECUTE_DONE" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="RunStop" Condition="EXECUTE_FAILED" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="Interrupted" Condition="STOPPING_DONE" x="0" y="0" />
      <ECTransition Source="Idle" Destination="AbortChk" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Idle" Destination="AbortChk" Condition="MOD_CHG[(ModuleState = 8) OR (ModuleState = 9)]" x="0" y="0" />
      <ECTransition Source="Running" Destination="AbortChk" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Running" Destination="AbortChk" Condition="MOD_CHG[(ModuleState = 8) OR (ModuleState = 9)]" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="AbortChk" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="AbortChk" Condition="MOD_CHG[(ModuleState = 8) OR (ModuleState = 9)]" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="AbortChk" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="AbortChk" Condition="MOD_CHG[(ModuleState = 8) OR (ModuleState = 9)]" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="AbortChk" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="AbortChk" Condition="MOD_CHG[(ModuleState = 8) OR (ModuleState = 9)]" x="0" y="0" />
      <ECTransition Source="Failed" Destination="AbortChk" Condition="ABORT" x="0" y="0" />
      <ECTransition Source="Failed" Destination="AbortChk" Condition="MOD_CHG[(ModuleState = 8) OR (ModuleState = 9)]" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ResetOk" Condition="MOD_CHG[(ModuleState = 1) OR (ModuleState = 2)]" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ResetOk" Condition="RESET" x="0" y="0" />
      <ECTransition Source="ResetOk" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="GoUa" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="GoParent" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="Halt" Destination="Stopping" Condition="1" x="0" y="0" />
      <ECTransition Source="RunStop" Destination="StopProc" Condition="1" x="0" y="0" />
      <ECTransition Source="Succeed" Destination="Succeeded" Condition="1" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="Idle" Condition="TO_IDLE" x="0" y="0" />
      <ECTransition Source="Fail" Destination="Failed" Condition="1" x="0" y="0" />
      <ECTransition Source="Interrupted" Destination="Failed" Condition="1" x="0" y="0" />
      <ECTransition Source="AbortChk" Destination="AbortActive" Condition="Active" x="0" y="0" />
      <ECTransition Source="AbortChk" Destination="AbortIdle" Condition="1" x="0" y="0" />
      <ECTransition Source="AbortActive" Destination="Aborted" Condition="1" x="0" y="0" />
      <ECTransition Source="AbortIdle" Destination="Aborted" Condition="1" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="GoUa" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Idle" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Running" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Stopping" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="StopProc" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Succeeded" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Failed" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Halt" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Idle" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Running" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Stopping" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="StopProc" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Succeeded" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Failed" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="AbortChk" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Idle" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Running" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Stopping" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="StopProc" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Succeeded" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Failed" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="ResetOk" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Idle" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Running" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Stopping" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="StopProc" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Succeeded" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Failed" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>StartMethodId := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, UaPath)), "/Start"), "]");
StopMethodId := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, UaPath)), "/Stop"), "]");
AbortMethodId := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, UaPath)), "/Abort"), "]");
ResetMethodId := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, UaPath)), "/Reset"), "]");
StateId := CONCAT(CONCAT(CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/State;"), CONCAT(UaRoot, UaPath)), "/ErrorID"), "]");
ActivityId := CONCAT(CONCAT("loc[", Module), "/activity]");
ReleaseId := CONCAT(CONCAT("loc[", Module), "/release]");</ST>
    </Algorithm>
    <Algorithm Name="Alg_Idle">
      <ST>State := 0;
Here := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Running">
      <ST>State := 1;
Here := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Stopping">
      <ST>State := 2;
Here := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_StopProc">
      <ST>State := 2;
Here := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Succeeded">
      <ST>State := 3;
Here := 4;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Failed">
      <ST>State := 4;
Here := 5;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborted">
      <ST>State := 5;
Here := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_GoUa">
      <ST>Active := TRUE;
ActivityDelta := 1;
ErrorID := 0;
CalledByClient := TRUE;</ST>
    </Algorithm>
    <Algorithm Name="Alg_GoParent">
      <ST>Active := TRUE;
ActivityDelta := 1;
ErrorID := 0;
CalledByClient := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Succeed">
      <ST>Active := FALSE;
ActivityDelta := -1;
ErrorID := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Fail">
      <ST>Active := FALSE;
ActivityDelta := -1;
ErrorID := ExecuteError;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Interrupted">
      <ST>Active := FALSE;
ActivityDelta := -1;
ErrorID := 7;</ST>
    </Algorithm>
    <Algorithm Name="Alg_AbortActive">
      <ST>Active := FALSE;
ActivityDelta := -1;
ErrorID := 7;</ST>
    </Algorithm>
    <Algorithm Name="Alg_StartRefused">
      <ST>ErrorID := 4;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkStart">
      <ST>Owned := (Session = Owner) AND (Owner &lt;&gt; "");
Accepted := FALSE;
IF NOT Owned THEN
  ResponseError := 5;
ELSIF ModuleState &lt;&gt; 6 THEN
  ResponseError := 4;
ELSIF (Here = 1) OR (Here = 2) OR (Here = 3) THEN
  ResponseError := 6;
ELSIF Here = 6 THEN
  ResponseError := 4;
ELSIF NOT ParamsInRange THEN
  ResponseError := 8;
ELSIF NOT EquipmentFree THEN
  ResponseError := 6;
ELSE
  Accepted := TRUE;
  ResponseError := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkStop">
      <ST>Owned := (StopSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND (Here = 1);
IF NOT Owned THEN
  ResponseError := 5;
ELSIF NOT Accepted THEN
  ResponseError := 4;
ELSE
  ResponseError := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkAbort">
      <ST>Owned := (AbortSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND (Here &lt;&gt; 6);
IF NOT Owned THEN
  ResponseError := 5;
ELSIF NOT Accepted THEN
  ResponseError := 4;
ELSE
  ResponseError := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkReset">
      <ST>Owned := (ResetSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND (Here = 6);
IF NOT Owned THEN
  ResponseError := 5;
ELSIF NOT Accepted THEN
  ResponseError := 4;
ELSE
  ResponseError := 0;
END_IF;</ST>
    </Algorithm>
  </BasicFB>
</FBType>