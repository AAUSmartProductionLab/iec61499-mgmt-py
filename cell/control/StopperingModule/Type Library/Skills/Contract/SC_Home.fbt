<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SC_Home" Comment="The contract of a skill primitive, the only part that is its own: which command it sends (and with what argument, and which when it ends), how long it may run, and three conditions on the equipment's signals and its parameters: when it may start, when it is done, what must hold while it runs. Technical: Home: Precondition TRUE; LinearAxis.Up until AtHome; Invariant TRUE">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: name the OPC UA variables of the parameters and results" />
      <Event Name="START" Type="Event" Comment="A run starts, with the parameters: say what the skill does">
        <With Var="Timeout" />
      </Event>
      <Event Name="SAMPLE" Type="Event" Comment="The equipment's newest state arrived">
        <With Var="AtHome" />
        <With Var="EqHolder" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Timeout" Type="TIME" Comment="How long the run may take before it fails with Timeout (3)" />
      <VarDeclaration Name="AtHome" Type="BOOL" Comment="LinearAxis: AtHome, an input" />
      <VarDeclaration Name="EqHolder" Type="WSTRING" Comment="Who holds the equipment now (empty: free), passed on to the run" />
    </InputVars>
    <OutputVars />
    <Plugs>
      <AdapterDeclaration Name="Run" Type="modlib::AContract" Comment="To the run (AContract): what the skill does and when it is done" />
    </Plugs>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="Wait" x="1748" y="0" />
      <ECState Name="Init" x="10" y="1260">
        <ECAction Output="INITO" />
      </ECState>
      <ECState Name="Start" x="1315" y="1260">
        <ECAction Algorithm="Alg_Start" />
      </ECState>
      <ECState Name="Started" x="0" y="2520">
        <ECAction Algorithm="Alg_Evaluate" Output="Run.START" />
      </ECState>
      <ECState Name="Sample" x="2845" y="1260">
        <ECAction Algorithm="Alg_Sample" />
      </ECState>
      <ECState Name="Judge" x="2260" y="2520">
        <ECAction Algorithm="Alg_Evaluate" Output="Run.SAMPLE" />
      </ECState>
      <ECTransition Source="Wait" Destination="Init" Condition="INIT" x="1100" y="710" />
      <ECTransition Source="Init" Destination="Wait" Condition="1" x="1580" y="870" />
      <ECTransition Source="Wait" Destination="Start" Condition="START" x="1809" y="710" />
      <ECTransition Source="Start" Destination="Started" Condition="1" x="1255" y="1970" />
      <ECTransition Source="Started" Destination="Wait" Condition="1" x="2734" y="1340" />
      <ECTransition Source="Wait" Destination="Sample" Condition="SAMPLE" x="2596" y="710" />
      <ECTransition Source="Sample" Destination="Judge" Condition="1" x="3161" y="1970" />
      <ECTransition Source="Judge" Destination="Wait" Condition="1" x="1053" y="1340" />
    </ECC>
    <Algorithm Name="Alg_Start">
      <ST>Run.Timed := FALSE;
Run.RunTime := Timeout;
Run.Command := 1;
Run.Arg := 0.0;
Run.StopCommand := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Evaluate">
      <ST>Run.Pre := TRUE;
Run.Post := AtHome;
Run.Inv := TRUE;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Sample">
      <ST>Run.EqHolder := EqHolder;</ST>
    </Algorithm>
  </BasicFB>
</FBType>