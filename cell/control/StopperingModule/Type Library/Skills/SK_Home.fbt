<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_Home" Comment="Skill primitive Home: Head up to the limit switch; from there its position is known (parameters: none). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: its OPC UA nodes and its equipment's channels">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Holder" />
        <With Var="ReleaseAfter" />
        <With Var="Timeout" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start a run, from the parent (a step of a sequence): no session check" />
      <Event Name="HALT" Type="Event" Comment="Stop the run, from the parent" />
      <Event Name="ABORT" Type="Event" Comment="Abort: everything off at once" />
      <Event Name="RESET" Type="Event" Comment="Reset from Failed or Aborted to Idle" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
      <Event Name="SUCCESS" Type="Event" Comment="The run succeeded (the results are set)" />
      <Event Name="FAILURE" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="Methods" Type="BOOL" Comment="Offer the OPC UA methods Start, Stop, Abort, Reset (FALSE: a step, run by its parent)" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="The name the equipment is held under: the skill's own, or for a step the skill it belongs to" />
      <VarDeclaration Name="ReleaseAfter" Type="BOOL" InitialValue="TRUE" Comment="Give up the equipment when the run ends (FALSE: the next step keeps it)" />
      <VarDeclaration Name="Timeout" Type="TIME" InitialValue="T#8000ms" Comment="How long the run may take before it fails with Timeout (3)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" Comment="Skill state: 0 Idle, 1 Running, 2 Stopping, 3 Succeeded, 4 Failed, 5 Aborted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with the range check, Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="2910" height="3000" locked="false" />
    <Group Name="Execution" Comment="One run: the contract, the command to the equipment and the end condition" x="4210" y="1000" width="4320" height="2900" locked="false" />
    <Group Name="Equipment" Comment="The equipment's state in, the command as output values out (the command table and its timed phases are in Driver)" x="1000" y="4300" width="4470" height="4000" locked="false" />
    <FB Name="Control" Type="modlib::SKILL_Core" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Logic" Type="stoppering::SL_Home" x="840" y="500">
      <Parameter Name="Equipment" Value="&quot;LinearAxis&quot;" />
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="UaStart" Type="iec61499::net::SERVER_2_1" x="1960" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="EqState" Type="iec61499::net::SUBSCRIBE_5" x="480" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="EqView" Type="stoppering::EV_LinearAxis" x="1590" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="WaitT" Type="iec61499::events::E_DELAY" x="2680" y="500">
      <Parameter Name="DT" Value="T#500ms" />
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="Driver" Type="stoppering::EC_LinearAxis" x="3340" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="300" y="2300">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="EqCmd" Type="iec61499::net::PUBLISH_8" x="1770" y="2300">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="Timer" Type="iec61499::events::E_DELAY" x="3550" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <EventConnections>
      <Connection Source="Control.START_RSP" Destination="UaStart.RSP" />
      <Connection Source="UaStart.IND" Destination="Control.START_REQ" />
      <Connection Source="INIT" Destination="Control.INIT" />
      <Connection Source="Control.INITO" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="UaStart.INIT" />
      <Connection Source="UaStart.INITO" Destination="EqState.INIT" />
      <Connection Source="EqState.INITO" Destination="EqCmd.INIT" />
      <Connection Source="EqCmd.INITO" Destination="INITO" />
      <Connection Source="START" Destination="Control.START" />
      <Connection Source="HALT" Destination="Control.HALT" />
      <Connection Source="ABORT" Destination="Control.ABORT" />
      <Connection Source="RESET" Destination="Control.RESET" />
      <Connection Source="Control.SUCCESS" Destination="SUCCESS" />
      <Connection Source="Control.FAILURE" Destination="FAILURE" />
      <Connection Source="Control.RUN" Destination="Logic.START" />
      <Connection Source="Control.HALT_SEQ" Destination="Logic.HALT" />
      <Connection Source="Control.ABORT_SEQ" Destination="Logic.ABORT" />
      <Connection Source="Control.RUN_STOPPING" Destination="Control.STOPPING_DONE" />
      <Connection Source="Logic.DONE" Destination="Control.EXECUTE_DONE" />
      <Connection Source="Logic.FAILED" Destination="Control.EXECUTE_FAILED" />
      <Connection Source="Logic.HALTED" Destination="Control.EXECUTE_FAILED" />
      <Connection Source="EqState.IND" Destination="EqView.REQ" />
      <Connection Source="EqView.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.CMD" Destination="Driver.PLAY" />
      <Connection Source="Driver.OUT" Destination="EqCmd.REQ" />
      <Connection Source="Driver.PHASE_START" Destination="PhaseT.START" />
      <Connection Source="Driver.PHASE_STOP" Destination="PhaseT.STOP" />
      <Connection Source="PhaseT.EO" Destination="Driver.PHASE_T" />
      <Connection Source="Driver.PLAYED" Destination="Logic.PLAYED" />
      <Connection Source="Logic.WAIT_START" Destination="WaitT.START" />
      <Connection Source="Logic.WAIT_STOP" Destination="WaitT.STOP" />
      <Connection Source="WaitT.EO" Destination="Logic.WAIT_OVER" />
      <Connection Source="Logic.TIMER_START" Destination="Timer.START" />
      <Connection Source="Logic.TIMER_STOP" Destination="Timer.STOP" />
      <Connection Source="Timer.EO" Destination="Logic.TIMER" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Control.StartMethodId" Destination="UaStart.ID" />
      <Connection Source="UaStart.RD_1" Destination="Control.Session" />
      <Connection Source="Control.Accepted" Destination="UaStart.SD_1" />
      <Connection Source="Control.StartError" Destination="UaStart.SD_2" />
      <Connection Source="Module" Destination="Control.Module" />
      <Connection Source="UaRoot" Destination="Control.UaRoot" />
      <Connection Source="UaPath" Destination="Control.UaPath" />
      <Connection Source="UaEnable" Destination="Control.UaEnable" />
      <Connection Source="Methods" Destination="Control.Methods" />
      <Connection Source="Methods" Destination="UaStart.QI" />
      <Connection Source="Control.State" Destination="State" />
      <Connection Source="Control.ErrorID" Destination="ErrorID" />
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Holder" Destination="Logic.Holder" />
      <Connection Source="ReleaseAfter" Destination="Logic.ReleaseAfter" />
      <Connection Source="Timeout" Destination="Logic.Timeout" />
      <Connection Source="Logic.ErrorID" Destination="Control.ExecuteError" />
      <Connection Source="Logic.EquipmentFree" Destination="Control.EquipmentFree" />
      <Connection Source="Logic.IdEqState" Destination="EqState.ID" />
      <Connection Source="EqState.RD_1" Destination="EqView.I_AtHome" />
      <Connection Source="EqState.RD_2" Destination="EqView.I_ActualPosition" />
      <Connection Source="EqState.RD_3" Destination="EqView.I_Homed" />
      <Connection Source="EqState.RD_4" Destination="EqView.I_Moving" />
      <Connection Source="EqState.RD_5" Destination="EqView.I_Holder" />
      <Connection Source="EqView.AtHome" Destination="Logic.AtHome" />
      <Connection Source="EqView.Holder" Destination="Logic.EqHolder" />
      <Connection Source="Logic.IdEqCmd" Destination="EqCmd.ID" />
      <Connection Source="Logic.C_Holder" Destination="Driver.Holder" />
      <Connection Source="Logic.C_Command" Destination="Driver.Command" />
      <Connection Source="Logic.C_Arg" Destination="Driver.Arg" />
      <Connection Source="Logic.C_Release" Destination="Driver.Release" />
      <Connection Source="Driver.O_Holder" Destination="EqCmd.SD_1" />
      <Connection Source="Driver.O_Release" Destination="EqCmd.SD_2" />
      <Connection Source="Driver.N_Enable" Destination="EqCmd.SD_3" />
      <Connection Source="Driver.N_Down" Destination="EqCmd.SD_4" />
      <Connection Source="Driver.N_Step" Destination="EqCmd.SD_5" />
      <Connection Source="Driver.NE_Step" Destination="EqCmd.SD_6" />
      <Connection Source="Driver.N_Move" Destination="EqCmd.SD_7" />
      <Connection Source="Driver.N_Goal" Destination="EqCmd.SD_8" />
      <Connection Source="Driver.PhaseDT" Destination="PhaseT.DT" />
      <Connection Source="Logic.TimerDT" Destination="Timer.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>