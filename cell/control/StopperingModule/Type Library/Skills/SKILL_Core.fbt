<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SKILL_Core" Comment="Skill core: state machine, OPC UA Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID], State and ErrorID published, activity counted; the Start method (with the skill's parameters) is wired to START_REQ and START_RSP; RUN starts the execution, SUCCESS or FAILURE(ErrorID) ends it">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Holder" />
        <With Var="ReleaseAll" />
      </Event>
      <Event Name="START_REQ" Type="Event" Comment="Start(Session, parameters) was called: check Session, ParamsInRange, EquipmentFree">
        <With Var="Session" />
        <With Var="ParamsInRange" />
        <With Var="EquipmentFree" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start a run, from the parent (a step of a sequence): no session check" />
      <Event Name="HALT" Type="Event" Comment="Stop the run, from the parent" />
      <Event Name="ABORT" Type="Event" Comment="Abort: everything off at once" />
      <Event Name="RESET" Type="Event" Comment="Reset from Failed or Aborted to Idle" />
      <Event Name="EXECUTE_DONE" Type="Event" Comment="The execution ended successfully" />
      <Event Name="EXECUTE_FAILED" Type="Event" Comment="The execution failed (ExecuteError)">
        <With Var="ExecuteError" />
      </Event>
      <Event Name="STOPPING_DONE" Type="Event" Comment="The stop sequence ended" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on">
        <With Var="StartMethodId" />
      </Event>
      <Event Name="START_RSP" Type="Event" Comment="Answer to Start">
        <With Var="Accepted" />
        <With Var="StartError" />
      </Event>
      <Event Name="RUN" Type="Event" Comment="Run: latch the parameters, start the execution">
        <With Var="CalledByClient" />
      </Event>
      <Event Name="HALT_SEQ" Type="Event" Comment="Halt the execute sequence" />
      <Event Name="ABORT_SEQ" Type="Event" Comment="Abort the sequences" />
      <Event Name="RESET_SEQ" Type="Event" Comment="Reset the sequences" />
      <Event Name="RUN_STOPPING" Type="Event" Comment="Run the stop sequence (the skill was stopped)" />
      <Event Name="SUCCESS" Type="Event" Comment="The run succeeded (the results are set)" />
      <Event Name="FAILURE" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="Methods" Type="BOOL" Comment="Offer the OPC UA methods Start, Stop, Abort, Reset (FALSE: a step, run by its parent)" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="The name the equipment is held under: the skill's own, or for a step the skill it belongs to" />
      <VarDeclaration Name="ReleaseAll" Type="BOOL" InitialValue="FALSE" Comment="When a run ends, give up everything held under Holder (a module level skill)" />
      <VarDeclaration Name="Session" Type="WSTRING" Comment="Session ID of the caller of Start (must be the module's owner)" />
      <VarDeclaration Name="ParamsInRange" Type="BOOL" InitialValue="TRUE" Comment="Every Start argument lies within its limits" />
      <VarDeclaration Name="EquipmentFree" Type="BOOL" InitialValue="TRUE" Comment="The equipment is free, or held by this skill" />
      <VarDeclaration Name="ExecuteError" Type="UINT" Comment="Why the execution failed" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="StartMethodId" Type="WSTRING" Comment="OPC UA ID of the Start method, for its SERVER block" />
      <VarDeclaration Name="Accepted" Type="BOOL" Comment="The call was accepted" />
      <VarDeclaration Name="StartError" Type="UINT" Comment="Why Start was refused (error code)" />
      <VarDeclaration Name="CalledByClient" Type="BOOL" Comment="Started over OPC UA (take the Start arguments), not by a parent (take the defaults)" />
      <VarDeclaration Name="State" Type="USINT" Comment="Skill state: 0 Idle, 1 Running, 2 Stopping, 3 Succeeded, 4 Failed, 5 Aborted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <Group Name="StateMachine" Comment="The skill's states and when a Succeeded returns to Idle" x="1000" y="1000" width="3090" height="4000" locked="false" />
    <Group Name="ModuleViews" Comment="The module's owner and state in, the activity count out" x="4390" y="1000" width="3830" height="1500" locked="false" />
    <Group Name="OpcUa" Comment="The methods Stop, Abort and Reset, and the published State and ErrorID" x="8520" y="1000" width="2300" height="2700" locked="false" />
    <Group Name="Release" Comment="At the end of a run of a module level skill: everything it holds given up" x="11120" y="1000" width="1250" height="1500" locked="false" />
    <FB Name="Control" Type="modlib::SKILL_Control" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="StateMachine" />
    </FB>
    <FB Name="Owner" Type="modlib::MOD_OwnerView" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="ModuleViews" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="1530" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="ModuleViews" />
    </FB>
    <FB Name="UaStop" Type="iec61499::net::SERVER_2_1" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="OpcUa" />
    </FB>
    <FB Name="UaAbort" Type="iec61499::net::SERVER_2_1" x="1350" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="OpcUa" />
    </FB>
    <FB Name="UaReset" Type="iec61499::net::SERVER_2_1" x="300" y="1600">
      <Attribute Name="GroupName" Type="STRING" Value="OpcUa" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_2" x="1350" y="1600">
      <Attribute Name="GroupName" Type="STRING" Value="OpcUa" />
    </FB>
    <FB Name="Act" Type="iec61499::net::PUBLISH_1" x="2940" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="ModuleViews" />
    </FB>
    <FB Name="ToIdle" Type="iec61499::events::E_DELAY" x="2320" y="500">
      <Parameter Name="DT" Value="T#1500ms" />
      <Attribute Name="GroupName" Type="STRING" Value="StateMachine" />
    </FB>
    <FB Name="PubRelease" Type="iec61499::net::PUBLISH_1" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Release" />
    </FB>
