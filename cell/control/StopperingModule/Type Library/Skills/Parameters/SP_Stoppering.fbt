<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SP_Stoppering" Comment="Stoppering parameters (none): OPC UA IDs, range check and latching">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdRel_Piston" />
        <With Var="IdRel_StopperArm" />
        <With Var="IdRel_Plunger" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdRel_Piston" Type="WSTRING" />
      <VarDeclaration Name="IdRel_StopperArm" Type="WSTRING" />
      <VarDeclaration Name="IdRel_Plunger" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdRel_Piston := CONCAT(CONCAT("loc[", Module), "/Piston/cmd]");
IdRel_StopperArm := CONCAT(CONCAT("loc[", Module), "/StopperArm/cmd]");
IdRel_Plunger := CONCAT(CONCAT("loc[", Module), "/Plunger/cmd]");</ST>
    </Algorithm>
  </SimpleFB>
</FBType>