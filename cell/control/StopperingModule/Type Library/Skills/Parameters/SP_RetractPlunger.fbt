<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SP_RetractPlunger" Comment="RetractPlunger parameters (Duration [s] 0.0..20.0, default 6.5): OPC UA IDs, range check and latching">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="D_Duration" />
      </Event>
      <Event Name="CHECK" Type="Event">
        <With Var="S_Duration" />
      </Event>
      <Event Name="LATCH_UA" Type="Event" />
      <Event Name="LATCH_DEF" Type="Event">
        <With Var="D_Duration" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdParams" />
        <With Var="IdResults" />
        <With Var="P_Duration" />
      </Event>
      <Event Name="CHECKED" Type="Event">
        <With Var="InRange" />
      </Event>
      <Event Name="LATCHED" Type="Event">
        <With Var="P_Duration" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="D_Duration" Type="LREAL" />
      <VarDeclaration Name="S_Duration" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdParams" Type="WSTRING" />
      <VarDeclaration Name="IdResults" Type="WSTRING" />
      <VarDeclaration Name="P_Duration" Type="LREAL" />
      <VarDeclaration Name="InRange" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <ECState Name="CHECK">
      <ECAction Algorithm="CHECK" Output="CHECKED" />
    </ECState>
    <ECState Name="LATCH_UA">
      <ECAction Algorithm="LATCH_UA" Output="LATCHED" />
    </ECState>
    <ECState Name="LATCH_DEF">
      <ECAction Algorithm="LATCH_DEF" Output="LATCHED" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdParams := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/Parameters/Duration"), "]");
IdResults := "";
P_Duration := D_Duration;</ST>
    </Algorithm>
    <Algorithm Name="CHECK">
      <ST>InRange := (S_Duration &gt;= 0.0) AND (S_Duration &lt;= 20.0);</ST>
    </Algorithm>
    <Algorithm Name="LATCH_UA">
      <ST>P_Duration := S_Duration;</ST>
    </Algorithm>
    <Algorithm Name="LATCH_DEF">
      <ST>P_Duration := D_Duration;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>