<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_Plunger" Comment="Linear actuator through an L298N (IN1 retract, IN2 extend); no sensors. ENA (200/255 on the ESP32) is tied to 3.3 V on the Pi, which has only two hardware PWM channels, so it runs at full speed; equipment IO: owns its IO points; commands Stop=0, Extend=1, Retract=2">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="Retract_Backend" />
        <With Var="Retract_Modbus" />
        <With Var="Retract_Io" />
        <With Var="Extend_Backend" />
        <With Var="Extend_Modbus" />
        <With Var="Extend_Io" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;Plunger&quot;" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" />
      <VarDeclaration Name="Retract_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Retract_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Retract_Io" Type="STRING" />
      <VarDeclaration Name="Extend_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Extend_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Extend_Io" Type="STRING" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <FB Name="Logic" Type="stoppering::EL_Plunger" x="400" y="200" />
    <FB Name="Mode" Type="modlib::MOD_StateView" x="4000" y="200" />
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="7600" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_1" x="11200" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="Out_Retract" Type="modlib::IO_DO" x="14800" y="200" />
    <FB Name="Out_Extend" Type="modlib::IO_DO" x="18400" y="200" />
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="22000" y="200" />
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="25600" y="200" />
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="Out_Retract.INIT" />
      <Connection Source="Out_Retract.INITO" Destination="Out_Extend.INIT" />
      <Connection Source="Out_Extend.INITO" Destination="Cycle.START" />
      <Connection Source="Out_Extend.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Out_Retract.REQ" />
      <Connection Source="Out_Retract.CNF" Destination="Out_Extend.REQ" />
      <Connection Source="Out_Extend.CNF" Destination="Logic.DRIVEN" />
      <Connection Source="Logic.PHASE_START" Destination="PhaseT.START" />
      <Connection Source="Logic.PHASE_STOP" Destination="PhaseT.STOP" />
      <Connection Source="PhaseT.EO" Destination="Logic.PHASE_T" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Command" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Arg" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Release" />
      <Connection Source="Mode.State" Destination="Logic.ModState" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_1" />
      <Connection Source="Retract_Backend" Destination="Out_Retract.Backend" />
      <Connection Source="Retract_Modbus" Destination="Out_Retract.ModbusId" />
      <Connection Source="Retract_Io" Destination="Out_Retract.IoName" />
      <Connection Source="Logic.O_Retract" Destination="Out_Retract.OUT" />
      <Connection Source="Extend_Backend" Destination="Out_Extend.Backend" />
      <Connection Source="Extend_Modbus" Destination="Out_Extend.ModbusId" />
      <Connection Source="Extend_Io" Destination="Out_Extend.IoName" />
      <Connection Source="Logic.O_Extend" Destination="Out_Extend.OUT" />
      <Connection Source="Logic.PhaseDT" Destination="PhaseT.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>