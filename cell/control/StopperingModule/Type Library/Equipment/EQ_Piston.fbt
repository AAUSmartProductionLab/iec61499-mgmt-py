<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_Piston" Comment="Small linear actuator that presses the stopper in, through an L298N (IN1 retract, IN2 extend); no sensors; equipment IO: owns its IO points, writes the output values its holder sends, reads its inputs every cycle and reports changes">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="Retract_Address" />
        <With Var="Extend_Address" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;Piston&quot;" Comment="The equipment item's name: its local channels and OPC UA folder" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" Comment="How often the inputs are read" />
      <VarDeclaration Name="Retract_Address" Type="STRING" Comment="Where Retract is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Extend_Address" Type="STRING" Comment="Where Extend is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <Group Name="Core" Comment="One holder at a time, break before make, all off on release or abort; scanned every CycleTime" x="1000" y="1000" width="2370" height="2500" locked="false" />
    <Group Name="Channels" Comment="Local channels to and from the skills (cmd, release, state), the module's state, and the inputs over OPC UA" x="3670" y="1000" width="2780" height="2800" locked="false" />
    <Group Name="Outputs" Comment="The equipment's actuators: written on a change and every cycle, one block per IO point" x="6750" y="1000" width="2360" height="1400" locked="false" />
    <FB Name="Logic" Type="stoppering::EL_Piston" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="1600" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="1770" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubRelease" Type="iec61499::net::SUBSCRIBE_1" x="480" y="1800">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_1" x="1770" y="1800">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="Out_Retract" Type="modlib::IO_DO" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Extend" Type="modlib::IO_DO" x="1410" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="SubRelease.INIT" />
      <Connection Source="SubRelease.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="Out_Retract.INIT" />
      <Connection Source="Out_Retract.INITO" Destination="Out_Extend.INIT" />
      <Connection Source="Out_Extend.INITO" Destination="Cycle.START" />
      <Connection Source="Out_Extend.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="SubRelease.IND" Destination="Logic.RELEASE" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Out_Retract.REQ" />
      <Connection Source="Out_Retract.CNF" Destination="Out_Extend.REQ" />
      <Connection Source="Out_Extend.CNF" Destination="Logic.DRIVEN" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdRelease" Destination="SubRelease.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Release" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Retract" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Extend" />
      <Connection Source="SubRelease.RD_1" Destination="Logic.R_Holder" />
      <Connection Source="Mode.State" Destination="Logic.ModuleState" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_1" />
      <Connection Source="Retract_Address" Destination="Out_Retract.Address" />
      <Connection Source="Logic.O_Retract" Destination="Out_Retract.OUT" />
      <Connection Source="Extend_Address" Destination="Out_Extend.Address" />
      <Connection Source="Logic.O_Extend" Destination="Out_Extend.OUT" />
    </DataConnections>
  </FBNetwork>
</FBType>