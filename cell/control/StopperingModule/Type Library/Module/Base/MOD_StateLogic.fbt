<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_StateLogic" Comment="PackML module state machine: commands only from the occupation owner and only where PackML allows them; runs the Resetting and Stopping procedures; Stopping waits until no skill is active">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="RESET_REQ" Type="Event" Comment="RESET(Session) was called">
        <With Var="ResetSession" />
      </Event>
      <Event Name="START_REQ" Type="Event" Comment="START(Session) was called">
        <With Var="StartSession" />
      </Event>
      <Event Name="STOP_REQ" Type="Event" Comment="STOP(Session) was called">
        <With Var="StopSession" />
      </Event>
      <Event Name="ABORT_REQ" Type="Event" Comment="ABORT(Session) was called">
        <With Var="AbortSession" />
      </Event>
      <Event Name="CLEAR_REQ" Type="Event" Comment="CLEAR(Session) was called">
        <With Var="ClearSession" />
      </Event>
      <Event Name="OWNER_CHG" Type="Event" Comment="The owner changed">
        <With Var="Owner" />
      </Event>
      <Event Name="ACT" Type="Event" Comment="The number of running skills changed (AllIdle)">
        <With Var="AllIdle" />
      </Event>
      <Event Name="RESETTING_DONE" Type="Event" Comment="The Resetting procedure ended" />
      <Event Name="RESETTING_FAILED" Type="Event" Comment="The Resetting procedure failed" />
      <Event Name="STOPPING_DONE" Type="Event" Comment="The Stopping procedure ended" />
      <Event Name="STOPPING_FAILED" Type="Event" Comment="The Stopping procedure failed" />
      <Event Name="STOP_TIMEOUT" Type="Event" Comment="Stopping took longer than StopTimeout" />
    </EventInputs>
    <EventOutputs>
      <Event Name="RESET_RSP" Type="Event" Comment="Answer to RESET: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="START_RSP" Type="Event" Comment="Answer to START: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="STOP_RSP" Type="Event" Comment="Answer to STOP: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="ABORT_RSP" Type="Event" Comment="Answer to ABORT: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="CLEAR_RSP" Type="Event" Comment="Answer to CLEAR: Accepted, ErrorID">
        <With Var="Accepted" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="CNF" Type="Event" Comment="The state changed">
        <With Var="State" />
      </Event>
      <Event Name="RUN_RESETTING" Type="Event" Comment="Run the Resetting procedure" />
      <Event Name="RUN_STOPPING" Type="Event" Comment="Run the Stopping procedure" />
      <Event Name="WD_START" Type="Event" Comment="Start the stop timeout" />
      <Event Name="WD_STOP" Type="Event" Comment="Stop the stop timeout" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="ResetSession" Type="WSTRING" Comment="Session ID of the caller of Reset" />
      <VarDeclaration Name="StartSession" Type="WSTRING" Comment="Session ID of the caller of Start" />
      <VarDeclaration Name="StopSession" Type="WSTRING" Comment="Session ID of the caller of Stop" />
      <VarDeclaration Name="AbortSession" Type="WSTRING" Comment="Session ID of the caller of Abort" />
      <VarDeclaration Name="ClearSession" Type="WSTRING" Comment="Session ID of the caller of Clear" />
      <VarDeclaration Name="Owner" Type="WSTRING" Comment="Session ID of the module's owner (empty: free)" />
      <VarDeclaration Name="AllIdle" Type="BOOL" InitialValue="TRUE" Comment="No skill runs" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" InitialValue="2" Comment="PackML state: 1 Clearing, 2 Stopped, 3 Starting, 4 Idle, 6 Execute, 7 Stopping, 8 Aborting, 9 Aborted, 15 Resetting" />
      <VarDeclaration Name="Accepted" Type="BOOL" Comment="The call was accepted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Owned" Type="BOOL" />
      <VarDeclaration Name="Here" Type="USINT" />
    </InternalVars>
    <ECC>
      <ECState Name="Stopped" x="150" y="100">
        <ECAction Algorithm="Alg_Stopped" Output="CNF" />
      </ECState>
      <ECState Name="Resetting" x="570" y="100">
        <ECAction Algorithm="Alg_Resetting" Output="CNF" />
        <ECAction Output="RUN_RESETTING" />
      </ECState>
      <ECState Name="ResettingW" x="990" y="100">
        <ECAction Algorithm="Alg_ResettingW" />
      </ECState>
      <ECState Name="Idle" x="1410" y="100">
        <ECAction Algorithm="Alg_Idle" Output="CNF" />
      </ECState>
      <ECState Name="Starting" x="150" y="330">
        <ECAction Algorithm="Alg_Starting" Output="CNF" />
      </ECState>
      <ECState Name="Execute" x="570" y="330">
        <ECAction Algorithm="Alg_Execute" Output="CNF" />
      </ECState>
      <ECState Name="Stopping" x="990" y="330">
        <ECAction Algorithm="Alg_Stopping" Output="CNF" />
        <ECAction Output="WD_START" />
      </ECState>
      <ECState Name="StoppingW" x="1410" y="330">
        <ECAction Algorithm="Alg_StoppingW" />
      </ECState>
      <ECState Name="StopProc" x="150" y="560">
        <ECAction Output="WD_STOP" />
        <ECAction Output="RUN_STOPPING" />
      </ECState>
      <ECState Name="StopProcW" x="570" y="560">
        <ECAction Algorithm="Alg_StopProcW" />
      </ECState>
      <ECState Name="Aborting" x="990" y="560">
        <ECAction Algorithm="Alg_Aborting" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Aborted" x="1410" y="560">
        <ECAction Algorithm="Alg_Aborted" Output="CNF" />
      </ECState>
      <ECState Name="Clearing" x="150" y="790">
        <ECAction Algorithm="Alg_Clearing" Output="CNF" />
      </ECState>
      <ECState Name="ChkReset" x="570" y="790">
        <ECAction Algorithm="Alg_ChkReset" Output="RESET_RSP" />
      </ECState>
      <ECState Name="ChkStart" x="990" y="790">
        <ECAction Algorithm="Alg_ChkStart" Output="START_RSP" />
      </ECState>
      <ECState Name="ChkStop" x="1410" y="790">
        <ECAction Algorithm="Alg_ChkStop" Output="STOP_RSP" />
      </ECState>
      <ECState Name="ChkAbort" x="150" y="1020">
        <ECAction Algorithm="Alg_ChkAbort" Output="ABORT_RSP" />
      </ECState>
      <ECState Name="ChkClear" x="570" y="1020">
        <ECAction Algorithm="Alg_ChkClear" Output="CLEAR_RSP" />
      </ECState>
      <ECTransition Source="Stopped" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Execute" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkReset" Condition="RESET_REQ" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Resetting" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Stopped" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="ResettingW" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Idle" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Execute" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="StoppingW" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="StopProcW" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkReset" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="Stopped" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Execute" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkStart" Condition="START_REQ" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Starting" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Stopped" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="ResettingW" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Idle" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Execute" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="StoppingW" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="StopProcW" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkStart" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="Stopped" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Execute" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkStop" Condition="STOP_REQ" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Stopping" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Stopped" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="ResettingW" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Idle" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Execute" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="StoppingW" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="StopProcW" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkStop" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="Stopped" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Execute" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkAbort" Condition="ABORT_REQ" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Aborting" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Stopped" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="ResettingW" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Idle" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Execute" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="StoppingW" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="StopProcW" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkAbort" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="Stopped" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="Idle" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="Execute" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="ChkClear" Condition="CLEAR_REQ" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="Clearing" Condition="Accepted" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="Stopped" Condition="Here = 0" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="ResettingW" Condition="Here = 1" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="Idle" Condition="Here = 2" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="Execute" Condition="Here = 3" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="StoppingW" Condition="Here = 4" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="StopProcW" Condition="Here = 5" x="0" y="0" />
      <ECTransition Source="ChkClear" Destination="Aborted" Condition="Here = 6" x="0" y="0" />
      <ECTransition Source="Resetting" Destination="ResettingW" Condition="1" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="Idle" Condition="RESETTING_DONE" x="0" y="0" />
      <ECTransition Source="ResettingW" Destination="Aborting" Condition="RESETTING_FAILED" x="0" y="0" />
      <ECTransition Source="Starting" Destination="Execute" Condition="1" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="StoppingW" Condition="1" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="StopProc" Condition="AllIdle" x="0" y="0" />
      <ECTransition Source="StoppingW" Destination="Aborting" Condition="STOP_TIMEOUT" x="0" y="0" />
      <ECTransition Source="StopProc" Destination="StopProcW" Condition="1" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="Stopped" Condition="STOPPING_DONE" x="0" y="0" />
      <ECTransition Source="StopProcW" Destination="Aborting" Condition="STOPPING_FAILED" x="0" y="0" />
      <ECTransition Source="Aborting" Destination="Aborted" Condition="1" x="0" y="0" />
      <ECTransition Source="Clearing" Destination="Stopped" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Stopped">
      <ST>State := 2;
Here := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Resetting">
      <ST>State := 15;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ResettingW">
      <ST>Here := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Idle">
      <ST>State := 4;
Here := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Starting">
      <ST>State := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Execute">
      <ST>State := 6;
Here := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Stopping">
      <ST>State := 7;</ST>
    </Algorithm>
    <Algorithm Name="Alg_StoppingW">
      <ST>Here := 4;</ST>
    </Algorithm>
    <Algorithm Name="Alg_StopProcW">
      <ST>Here := 5;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborting">
      <ST>State := 8;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Aborted">
      <ST>State := 9;
Here := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Clearing">
      <ST>State := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkReset">
      <ST>Owned := (ResetSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 0));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkStart">
      <ST>Owned := (StartSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 2));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkStop">
      <ST>Owned := (StopSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 1) OR (Here = 2) OR (Here = 3));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkAbort">
      <ST>Owned := (AbortSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 0) OR (Here = 1) OR (Here = 2) OR (Here = 3) OR (Here = 4) OR (Here = 5));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_ChkClear">
      <ST>Owned := (ClearSession = Owner) AND (Owner &lt;&gt; "");
Accepted := Owned AND ((Here = 6));
IF NOT Owned THEN
  ErrorID := 5;
ELSIF NOT Accepted THEN
  ErrorID := 4;
ELSE
  ErrorID := 0;
END_IF;</ST>
    </Algorithm>
  </BasicFB>
</FBType>