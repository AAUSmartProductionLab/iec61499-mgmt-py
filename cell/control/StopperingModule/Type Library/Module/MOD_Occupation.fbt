<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_Occupation" Comment="Module occupation: OPC UA methods Occupy(Session) and Release(Session) answer [Accepted, ErrorID]; publishes Occupied (never the session ID) and shares the owner on a local channel">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <FB Name="Ids" Type="modlib::MOD_OccupationIds" x="1100" y="1000" />
    <FB Name="Occupy" Type="iec61499::net::SERVER_2_1" x="2690" y="1000" />
    <FB Name="Release" Type="iec61499::net::SERVER_2_1" x="3860" y="1000" />
    <FB Name="Logic" Type="modlib::MOD_OccupationLogic" x="1100" y="2100" />
    <FB Name="PubOwner" Type="iec61499::net::PUBLISH_1" x="2870" y="2100">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="SubQuery" Type="iec61499::net::SUBSCRIBE_0" x="4040" y="2100">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_1" x="1100" y="3300" />
    <EventConnections>
      <Connection Source="INIT" Destination="Ids.INIT" />
      <Connection Source="Ids.INITO" Destination="Occupy.INIT" />
      <Connection Source="Occupy.INITO" Destination="Release.INIT" />
      <Connection Source="Release.INITO" Destination="PubOwner.INIT" />
      <Connection Source="PubOwner.INITO" Destination="SubQuery.INIT" />
      <Connection Source="SubQuery.INITO" Destination="PubUa.INIT" />
      <Connection Source="PubUa.INITO" Destination="PubUa.REQ" />
      <Connection Source="PubUa.INITO" Destination="INITO" />
      <Connection Source="Occupy.IND" Destination="Logic.OCCUPY_REQ" />
      <Connection Source="Logic.OCCUPY_RSP" Destination="Occupy.RSP" />
      <Connection Source="Release.IND" Destination="Logic.RELEASE_REQ" />
      <Connection Source="Logic.RELEASE_RSP" Destination="Release.RSP" />
      <Connection Source="SubQuery.IND" Destination="Logic.QUERY_REQ" />
      <Connection Source="Logic.CHG" Destination="PubOwner.REQ" />
      <Connection Source="Logic.CHG" Destination="PubUa.REQ" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Ids.Module" />
      <Connection Source="UaRoot" Destination="Ids.UaRoot" />
      <Connection Source="UaEnable" Destination="Occupy.QI" />
      <Connection Source="UaEnable" Destination="Release.QI" />
      <Connection Source="UaEnable" Destination="PubUa.QI" />
      <Connection Source="Ids.IdOccupy" Destination="Occupy.ID" />
      <Connection Source="Ids.IdRelease" Destination="Release.ID" />
      <Connection Source="Ids.IdPub" Destination="PubUa.ID" />
      <Connection Source="Ids.IdOwner" Destination="PubOwner.ID" />
      <Connection Source="Ids.IdQuery" Destination="SubQuery.ID" />
      <Connection Source="Occupy.RD_1" Destination="Logic.OccupySession" />
      <Connection Source="Logic.Accepted" Destination="Occupy.SD_1" />
      <Connection Source="Logic.ErrorID" Destination="Occupy.SD_2" />
      <Connection Source="Release.RD_1" Destination="Logic.ReleaseSession" />
      <Connection Source="Logic.Accepted" Destination="Release.SD_1" />
      <Connection Source="Logic.ErrorID" Destination="Release.SD_2" />
      <Connection Source="Logic.Owner" Destination="PubOwner.SD_1" />
      <Connection Source="Logic.Occupied" Destination="PubUa.SD_1" />
    </DataConnections>
  </FBNetwork>
</FBType>