        <SubAppNetwork>
          <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with one block per parameter (range check, value for this run), Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="21200" height="5500" locked="false" />
          <Group Name="Sequences" Comment="What the skill does: Execute, and Stop when it is interrupted; private skill primitives in order" x="1000" y="7700" width="14800" height="4100" locked="false" />
          <Group Name="Releasing" Comment="After a failure or an abort: gives up the equipment the skill holds (all off, free again)" x="1000" y="13000" width="12000" height="3500" locked="false" />
          <FB Name="Control" Type="modlib::SKILL_Core" x="2800" y="900">
