      <SubApp Name="GpioLines" x="7800" y="900" Comment="GPIO lines of the equipment's IO points (Linux /dev/gpiochip)">
        <SubAppInterfaceList>
          <SubAppEventInputs>
            <SubAppEvent Name="INIT" Type="EInit" />
          </SubAppEventInputs>
          <SubAppEventOutputs>
