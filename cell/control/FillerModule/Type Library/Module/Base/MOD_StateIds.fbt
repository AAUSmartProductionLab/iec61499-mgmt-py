<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_StateIds" Comment="OPC UA and local channel IDs of the module state manager">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdReset" />
        <With Var="IdStart" />
        <With Var="IdStop" />
        <With Var="IdAbort" />
        <With Var="IdClear" />
        <With Var="IdPub" />
        <With Var="IdState" />
        <With Var="IdQuery" />
        <With Var="IdAct" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdReset" Type="WSTRING" />
      <VarDeclaration Name="IdStart" Type="WSTRING" />
      <VarDeclaration Name="IdStop" Type="WSTRING" />
      <VarDeclaration Name="IdAbort" Type="WSTRING" />
      <VarDeclaration Name="IdClear" Type="WSTRING" />
      <VarDeclaration Name="IdPub" Type="WSTRING" />
      <VarDeclaration Name="IdState" Type="WSTRING" />
      <VarDeclaration Name="IdQuery" Type="WSTRING" />
      <VarDeclaration Name="IdAct" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdReset := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Module/")), "Reset"), "]");
IdStart := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Module/")), "Start"), "]");
IdStop := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Module/")), "Stop"), "]");
IdAbort := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Module/")), "Abort"), "]");
IdClear := CONCAT(CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, "/Module/")), "Clear"), "]");
IdPub := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, "/Module/")), "State"), "]");
IdState := CONCAT(CONCAT("loc[", Module), "/state]");
IdQuery := CONCAT(CONCAT("loc[", Module), "/state/query]");
IdAct := CONCAT(CONCAT("loc[", Module), "/activity]");</ST>
    </Algorithm>
  </SimpleFB>
</FBType>