<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SP_Fill" Comment="Fill parameters (Depth [mm] 0.0..50.0, default 50.0): OPC UA IDs, range check and latching">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="D_Depth" />
      </Event>
      <Event Name="CHECK" Type="Event">
        <With Var="S_Depth" />
      </Event>
      <Event Name="LATCH_UA" Type="Event" />
      <Event Name="LATCH_DEF" Type="Event">
        <With Var="D_Depth" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdParams" />
        <With Var="IdResults" />
        <With Var="IdRel_NeedleAxis" />
        <With Var="P_Depth" />
      </Event>
      <Event Name="CHECKED" Type="Event">
        <With Var="InRange" />
      </Event>
      <Event Name="LATCHED" Type="Event">
        <With Var="P_Depth" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="D_Depth" Type="LREAL" />
      <VarDeclaration Name="S_Depth" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdParams" Type="WSTRING" />
      <VarDeclaration Name="IdResults" Type="WSTRING" />
      <VarDeclaration Name="IdRel_NeedleAxis" Type="WSTRING" />
      <VarDeclaration Name="P_Depth" Type="LREAL" />
      <VarDeclaration Name="InRange" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <ECState Name="CHECK">
      <ECAction Algorithm="CHECK" Output="CHECKED" />
    </ECState>
    <ECState Name="LATCH_UA">
      <ECAction Algorithm="LATCH_UA" Output="LATCHED" />
    </ECState>
    <ECState Name="LATCH_DEF">
      <ECAction Algorithm="LATCH_DEF" Output="LATCHED" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdParams := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/Parameters/Depth"), "]");
IdResults := "";
IdRel_NeedleAxis := CONCAT(CONCAT("loc[", Module), "/NeedleAxis/cmd]");
P_Depth := D_Depth;</ST>
    </Algorithm>
    <Algorithm Name="CHECK">
      <ST>InRange := (S_Depth &gt;= 0.0) AND (S_Depth &lt;= 50.0);</ST>
    </Algorithm>
    <Algorithm Name="LATCH_UA">
      <ST>P_Depth := S_Depth;</ST>
    </Algorithm>
    <Algorithm Name="LATCH_DEF">
      <ST>P_Depth := D_Depth;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>