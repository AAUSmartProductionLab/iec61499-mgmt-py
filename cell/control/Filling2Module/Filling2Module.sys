  <Application Name="Filling2_pi" Comment="Module Filling2 on target pi (filling-module-2, IO gpio; generated by modgen)">
    <SubAppNetwork>
      <Group Name="ModuleLevel" Comment="Module level: occupation, PackML state manager, start-up and the target's IO lines" x="1000" y="1000" width="6245" height="1880" locked="false" />
