      <Group Name="Procedures" Comment="Procedures the module state manager runs while Resetting and Stopping" x="1000" y="3180" width="5890" height="1380" locked="false" />
      <Group Name="SkillPrimitives" Comment="Skill primitives: one equipment command until a sensor or a time; OPC UA /Skills/&lt;name&gt;" x="1000" y="4860" width="8465" height="4080" locked="false" />
      <Group Name="EquipmentIO" Comment="Equipment IO: the only owners of the IO points; skills send them output values over local channels" x="1000" y="9240" width="8420" height="2280" locked="false" />
      <FB Name="Occupation" Type="modlib::MOD_Occupation" x="1155" y="150" Comment="Who may command the module. A client calls Occupy(Session) at /Objects/Filling2/Occupation first; until it calls Release, only commands with that session id are accepted. Every block hears the owner on loc[Filling2/owner].">
        <Parameter Name="Module" Value="&quot;Filling2&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling2&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="ModuleLevel" />
      </FB>
      <FB Name="Module" Type="modlib::MOD_StateManager" x="3890" y="150" Comment="The module's PackML state. The owner calls Reset, Start, Stop, Abort or Clear at /Objects/Filling2/Module; State is at /Objects/Filling2/Module/State and on loc[Filling2/state]. Reset runs the Resetting procedure, Stop the Stopping procedure; skills may be started only in Execute.">
        <Parameter Name="Module" Value="&quot;Filling2&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling2&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="StopTimeout" Value="T#10000ms" />
        <Attribute Name="GroupName" Type="STRING" Value="ModuleLevel" />
      </FB>
      <FB Name="LinearAxis" Type="filling::EQ_LinearAxis" x="1700" y="150" Comment="Equipment LinearAxis: Needle lift, a stepper motor through a step and direction driver, with a limit switch at the top (home). The only block that touches its pins (AtHome = gpio[0:23:pull_up], Enable = gpio[0:17:active_low], Down = gpio[0:27:active_low], Step = pwm[0:2:500000:/hostsys/class/pwm]). Skills send it what to switch on loc[Filling2/LinearAxis/cmd]; it reports its inputs on loc[Filling2/LinearAxis/state] and at /Objects/Filling2/Equipment/LinearAxis.">
        <Parameter Name="Module" Value="&quot;Filling2&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling2&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="AtHome_Address" Value="'gpio[0:23:pull_up]'" />
        <Parameter Name="Enable_Address" Value="'gpio[0:17:active_low]'" />
        <Parameter Name="Down_Address" Value="'gpio[0:27:active_low]'" />
        <Parameter Name="Step_Address" Value="'pwm[0:2:500000:/hostsys/class/pwm]'" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Pump" Type="filling::EQ_Pump" x="4320" y="150" Comment="Equipment Pump: Filling pump; none is wired yet, so it has no outputs and dispensing is a time at the station's flow rate. The only block that touches its pins (no pins). Skills send it what to switch on loc[Filling2/Pump/cmd]; it reports its inputs on loc[Filling2/Pump/state] and at /Objects/Filling2/Equipment/Pump.">
        <Parameter Name="Module" Value="&quot;Filling2&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling2&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Scale" Type="filling::EQ_Scale" x="6755" y="150" Comment="Equipment Scale: Scale; the hardware has none, so the weight is simulated. The only block that touches its pins (Weight = sim). Skills send it what to switch on loc[Filling2/Scale/cmd]; it reports its inputs on loc[Filling2/Scale/state] and at /Objects/Filling2/Equipment/Scale.">
        <Parameter Name="Module" Value="&quot;Filling2&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling2&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="Weight_Address" Value="'sim'" />
        <Attribute Name="GroupName" Type="STRING" Value="EquipmentIO" />
      </FB>
      <FB Name="Home" Type="filling::SK_Home" x="1155" y="150" Comment="Skill Home, offered on its own: Needle up to the limit switch; from there its position is known, using LinearAxis. A client calls Start (with the parameters), Stop, Abort or Reset at /Objects/Filling2/Skills/Home; State, ErrorID, Parameters and Results are there too.">
        <Parameter Name="Module" Value="&quot;Filling2&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filling2&quot;" />
        <Parameter Name="UaPath" Value="&quot;/Skills/Home&quot;" />
