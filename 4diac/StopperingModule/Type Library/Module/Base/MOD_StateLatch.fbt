<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MOD_StateLatch" Comment="Local channel IDs of the PackML state and its refresh query; types and forwards the received PackML state">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
      </Event>
      <Event Name="REQ" Type="Event">
        <With Var="Received" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdSub" />
        <With Var="IdQuery" />
      </Event>
      <Event Name="CNF" Type="Event">
        <With Var="State" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="Received" Type="USINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdSub" Type="WSTRING" />
      <VarDeclaration Name="IdQuery" Type="WSTRING" />
      <VarDeclaration Name="State" Type="USINT" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <ECState Name="REQ">
      <ECAction Algorithm="REQ" Output="CNF" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdSub := CONCAT(CONCAT("loc[", Module), "/state]");
IdQuery := CONCAT(CONCAT("loc[", Module), "/state/query]");</ST>
    </Algorithm>
    <Algorithm Name="REQ">
      <ST>State := Received;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>