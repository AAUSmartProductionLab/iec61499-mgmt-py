<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_MoveArm" Comment="Skill primitive MoveArm: Servo to Angle and wait Settle seconds (no feedback) (parameters: Angle [deg] 0.0..180.0, default 120.0; Settle [s] 0.0..5.0, default 2.0). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Token" />
        <With Var="LastUse" />
        <With Var="Angle" />
        <With Var="Settle" />
      </Event>
      <Event Name="START" Type="Event">
        <With Var="Angle" />
        <With Var="Settle" />
      </Event>
      <Event Name="HALT" Type="Event" />
      <Event Name="ABORT" Type="Event" />
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="SUCCESS" Type="Event" />
      <Event Name="FAILURE" Type="Event">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="Methods" Type="BOOL" />
      <VarDeclaration Name="Token" Type="WSTRING" />
      <VarDeclaration Name="LastUse" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration Name="Angle" Type="LREAL" InitialValue="120.0" />
      <VarDeclaration Name="Settle" Type="LREAL" InitialValue="2.0" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Control" Type="modlib::SKILL_Control" x="400" y="200" />
