    <FB Name="UaAbort" Type="iec61499::net::SERVER_2_1" x="22000" y="200" />
    <FB Name="UaReset" Type="iec61499::net::SERVER_2_1" x="25600" y="200" />
    <FB Name="PubState" Type="iec61499::net::PUBLISH_2" x="29200" y="200" />
    <FB Name="Act" Type="iec61499::net::PUBLISH_1" x="32800" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="Logic" Type="stoppering::SL_MoveArm" x="36400" y="200">
      <Parameter Name="Equipment" Value="&quot;StopperArm&quot;" />
    </FB>
    <FB Name="PubParams" Type="iec61499::net::PUBLISH_2" x="40000" y="200" />
    <FB Name="EqState" Type="iec61499::net::SUBSCRIBE_1" x="43600" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="EqView" Type="stoppering::EV_StopperArm" x="47200" y="200" />
    <FB Name="WaitT" Type="iec61499::events::E_DELAY" x="50800" y="200">
      <Parameter Name="DT" Value="T#500ms" />
    </FB>
    <FB Name="EqCmd" Type="iec61499::net::PUBLISH_4" x="54400" y="200">
