<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SP_MoveArm" Comment="MoveArm parameters (Angle [deg] 0.0..180.0, default 120.0; Settle [s] 0.0..5.0, default 2.0): OPC UA IDs, range check and latching">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="D_Angle" />
        <With Var="D_Settle" />
      </Event>
      <Event Name="CHECK" Type="Event">
        <With Var="S_Angle" />
        <With Var="S_Settle" />
      </Event>
      <Event Name="LATCH_UA" Type="Event" />
      <Event Name="LATCH_DEF" Type="Event">
        <With Var="D_Angle" />
        <With Var="D_Settle" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdParams" />
        <With Var="IdResults" />
        <With Var="P_Angle" />
        <With Var="P_Settle" />
      </Event>
      <Event Name="CHECKED" Type="Event">
        <With Var="InRange" />
      </Event>
      <Event Name="LATCHED" Type="Event">
        <With Var="P_Angle" />
        <With Var="P_Settle" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="D_Angle" Type="LREAL" />
      <VarDeclaration Name="D_Settle" Type="LREAL" />
      <VarDeclaration Name="S_Angle" Type="LREAL" />
      <VarDeclaration Name="S_Settle" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdParams" Type="WSTRING" />
      <VarDeclaration Name="IdResults" Type="WSTRING" />
      <VarDeclaration Name="P_Angle" Type="LREAL" />
      <VarDeclaration Name="P_Settle" Type="LREAL" />
      <VarDeclaration Name="InRange" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <ECState Name="CHECK">
      <ECAction Algorithm="CHECK" Output="CHECKED" />
    </ECState>
    <ECState Name="LATCH_UA">
      <ECAction Algorithm="LATCH_UA" Output="LATCHED" />
    </ECState>
    <ECState Name="LATCH_DEF">
      <ECAction Algorithm="LATCH_DEF" Output="LATCHED" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdParams := CONCAT(CONCAT(CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/Parameters/Angle;"), CONCAT(UaRoot, UaPath)), "/Parameters/Settle"), "]");
IdResults := "";
P_Angle := D_Angle;
P_Settle := D_Settle;</ST>
    </Algorithm>
    <Algorithm Name="CHECK">
      <ST>InRange := (S_Angle &gt;= 0.0) AND (S_Settle &gt;= 0.0) AND (S_Angle &lt;= 180.0) AND (S_Settle &lt;= 5.0);</ST>
    </Algorithm>
    <Algorithm Name="LATCH_UA">
      <ST>P_Angle := S_Angle;
P_Settle := S_Settle;</ST>
    </Algorithm>
    <Algorithm Name="LATCH_DEF">
      <ST>P_Angle := D_Angle;
P_Settle := D_Settle;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>