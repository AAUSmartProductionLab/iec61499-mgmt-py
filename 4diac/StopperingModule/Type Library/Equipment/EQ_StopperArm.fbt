<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_StopperArm" Comment="Servo that places the stopper; 0..180 degrees (outer home 120, inner 1), no feedback; equipment IO: owns its IO points; commands Detach=0, MoveTo=1">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="stoppering" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="Angle_Backend" />
        <With Var="Angle_Modbus" />
        <With Var="Angle_Io" />
        <With Var="Angle_Gain" />
        <With Var="Angle_Bias" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;StopperArm&quot;" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" />
      <VarDeclaration Name="Angle_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Angle_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Angle_Io" Type="STRING" />
      <VarDeclaration Name="Angle_Gain" Type="LREAL" InitialValue="36.408" />
      <VarDeclaration Name="Angle_Bias" Type="LREAL" InitialValue="1638.4" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <FB Name="Logic" Type="stoppering::EL_StopperArm" x="400" y="200" />
    <FB Name="Mode" Type="modlib::MOD_StateView" x="4000" y="200" />
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="7600" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_1" x="11200" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="Out_Angle" Type="modlib::IO_AO" x="14800" y="200" />
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="18400" y="200" />
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="22000" y="200" />
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="Out_Angle.INIT" />
      <Connection Source="Out_Angle.INITO" Destination="Cycle.START" />
      <Connection Source="Out_Angle.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Out_Angle.REQ" />
      <Connection Source="Out_Angle.CNF" Destination="Logic.DRIVEN" />
      <Connection Source="Logic.PHASE_START" Destination="PhaseT.START" />
      <Connection Source="Logic.PHASE_STOP" Destination="PhaseT.STOP" />
      <Connection Source="PhaseT.EO" Destination="Logic.PHASE_T" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Command" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Arg" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Release" />
      <Connection Source="Mode.State" Destination="Logic.ModState" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_1" />
      <Connection Source="Angle_Backend" Destination="Out_Angle.Backend" />
      <Connection Source="Angle_Modbus" Destination="Out_Angle.ModbusId" />
      <Connection Source="Angle_Io" Destination="Out_Angle.IoName" />
      <Connection Source="Logic.O_Angle" Destination="Out_Angle.OUT" />
      <Connection Source="Logic.E_Angle" Destination="Out_Angle.EN" />
      <Connection Source="Angle_Gain" Destination="Out_Angle.Gain" />
      <Connection Source="Angle_Bias" Destination="Out_Angle.Bias" />
      <Connection Source="Logic.PhaseDT" Destination="PhaseT.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>