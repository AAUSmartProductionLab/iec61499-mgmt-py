<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EL_NeedleAxis" Comment="NeedleAxis logic: command -&gt; outputs (break before make), inputs -&gt; state channel">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Unit" />
        <With Var="Name" />
        <With Var="UaRoot" />
      </Event>
      <Event Name="CMD" Type="Event">
        <With Var="Command" />
      </Event>
      <Event Name="SAMPLE" Type="Event">
        <With Var="I_AtTop" />
        <With Var="I_AtBottom" />
        <With Var="I_Position" />
      </Event>
      <Event Name="DRIVEN" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdCmd" />
        <With Var="IdState" />
        <With Var="IdPub" />
      </Event>
      <Event Name="DRIVE" Type="Event">
        <With Var="O_Down" />
        <With Var="O_Up" />
      </Event>
      <Event Name="STATE" Type="Event">
        <With Var="AtTop" />
        <With Var="AtBottom" />
        <With Var="Position" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Unit" Type="WSTRING" />
      <VarDeclaration Name="Name" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="Command" Type="USINT" />
      <VarDeclaration Name="I_AtTop" Type="BOOL" />
      <VarDeclaration Name="I_AtBottom" Type="BOOL" />
      <VarDeclaration Name="I_Position" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdCmd" Type="WSTRING" />
      <VarDeclaration Name="IdState" Type="WSTRING" />
      <VarDeclaration Name="IdPub" Type="WSTRING" />
      <VarDeclaration Name="O_Down" Type="BOOL" />
      <VarDeclaration Name="O_Up" Type="BOOL" />
      <VarDeclaration Name="AtTop" Type="BOOL" />
      <VarDeclaration Name="AtBottom" Type="BOOL" />
      <VarDeclaration Name="Position" Type="LREAL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="N_Down" Type="BOOL" />
      <VarDeclaration Name="N_Up" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Init" x="570" y="100">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Sample" x="990" y="100">
        <ECAction Algorithm="Alg_Sample" Output="STATE" />
        <ECAction Output="DRIVE" />
      </ECState>
      <ECState Name="Break" x="1410" y="100">
        <ECAction Algorithm="Alg_Break" Output="DRIVE" />
      </ECState>
      <ECState Name="Make" x="150" y="330">
        <ECAction Algorithm="Alg_Make" Output="DRIVE" />
      </ECState>
      <ECTransition Source="START" Destination="Init" Condition="INIT" x="0" y="0" />
      <ECTransition Source="START" Destination="Sample" Condition="SAMPLE" x="0" y="0" />
      <ECTransition Source="START" Destination="Break" Condition="CMD" x="0" y="0" />
      <ECTransition Source="Init" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Sample" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Break" Destination="Make" Condition="DRIVEN" x="0" y="0" />
      <ECTransition Source="Make" Destination="START" Condition="DRIVEN" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>IdCmd := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Unit), "/"), Name), "/cmd]");
IdState := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Unit), "/"), Name), "/state]");
IdPub := CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", UaRoot), "/Equipment/"), Name), "/AtTop;"), UaRoot), "/Equipment/"), Name), "/AtBottom;"), UaRoot), "/Equipment/"), Name), "/Position]");</ST>
    </Algorithm>
    <Algorithm Name="Alg_Sample">
      <ST>AtTop := I_AtTop;
AtBottom := I_AtBottom;
Position := I_Position;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Break">
      <ST>N_Down := (Command = 1);
N_Up := (Command = 2);
O_Down := O_Down AND N_Down;
O_Up := O_Up AND N_Up;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Make">
      <ST>N_Down := (Command = 1);
N_Up := (Command = 2);
O_Down := N_Down;
O_Up := N_Up;</ST>
    </Algorithm>
  </BasicFB>
</FBType>