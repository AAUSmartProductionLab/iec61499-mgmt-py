<?xml version='1.0' encoding='utf-8'?>
<FBType Name="UNIT_OwnerView" Comment="Subscribes to the unit's occupation owner (local channel) and asks for the current owner at INIT">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="unitlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Unit" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="CHG" Type="Event">
        <With Var="Owner" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Unit" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Owner" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Latch" Type="unitlib::UNIT_OwnerLatch" x="400" y="200" />
    <FB Name="OwnerSub" Type="iec61499::net::SUBSCRIBE_1" x="3000" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="Query" Type="iec61499::net::PUBLISH_0" x="5600" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <EventConnections>
      <Connection Source="INIT" Destination="Latch.INIT" />
      <Connection Source="Latch.INITO" Destination="OwnerSub.INIT" />
      <Connection Source="OwnerSub.INITO" Destination="Query.INIT" />
      <Connection Source="Query.INITO" Destination="Query.REQ" />
      <Connection Source="Query.INITO" Destination="INITO" />
      <Connection Source="OwnerSub.IND" Destination="Latch.REQ" />
      <Connection Source="Latch.CNF" Destination="CHG" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Unit" Destination="Latch.Unit" />
      <Connection Source="Latch.IdOwner" Destination="OwnerSub.ID" />
      <Connection Source="Latch.IdQuery" Destination="Query.ID" />
      <Connection Source="OwnerSub.RD_1" Destination="Latch.Received" />
      <Connection Source="Latch.Owner" Destination="Owner" />
    </DataConnections>
  </FBNetwork>
</FBType>