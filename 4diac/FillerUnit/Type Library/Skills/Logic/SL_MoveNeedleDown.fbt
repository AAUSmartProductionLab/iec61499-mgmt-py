<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SL_MoveNeedleDown" Comment="MoveNeedleDown: Requires NOT (AtTop AND AtBottom); Ensures (Position &gt;= Distance) OR AtBottom; Invariant NOT (AtTop AND AtBottom); holds NeedleAxis.Down while running">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Unit" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="Equipment" />
        <With Var="D_Distance" />
      </Event>
      <Event Name="OWNER_CHG" Type="Event">
        <With Var="Owner" />
      </Event>
      <Event Name="SETP" Type="Event">
        <With Var="Session" />
        <With Var="S_Distance" />
      </Event>
      <Event Name="START" Type="Event" />
      <Event Name="SAMPLE" Type="Event">
        <With Var="AtTop" />
        <With Var="AtBottom" />
        <With Var="Position" />
      </Event>
      <Event Name="TIMEOUT" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdSetp" />
        <With Var="IdPub" />
        <With Var="IdEqState" />
        <With Var="IdEqCmd" />
      </Event>
      <Event Name="CMD" Type="Event">
        <With Var="Command" />
      </Event>
      <Event Name="WD_START" Type="Event" />
      <Event Name="WD_STOP" Type="Event" />
      <Event Name="PUB" Type="Event">
        <With Var="State" />
        <With Var="ErrorID" />
        <With Var="Distance" />
      </Event>
      <Event Name="RSP_SETP" Type="Event">
        <With Var="Accepted" />
        <With Var="SetpError" />
      </Event>
      <Event Name="SUCCESS" Type="Event" />
      <Event Name="FAILURE" Type="Event">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Unit" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="Equipment" Type="WSTRING" />
      <VarDeclaration Name="D_Distance" Type="LREAL" />
      <VarDeclaration Name="Owner" Type="WSTRING" />
      <VarDeclaration Name="Session" Type="WSTRING" />
      <VarDeclaration Name="S_Distance" Type="LREAL" />
      <VarDeclaration Name="AtTop" Type="BOOL" />
      <VarDeclaration Name="AtBottom" Type="BOOL" />
      <VarDeclaration Name="Position" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdSetp" Type="WSTRING" />
      <VarDeclaration Name="IdPub" Type="WSTRING" />
      <VarDeclaration Name="IdEqState" Type="WSTRING" />
      <VarDeclaration Name="IdEqCmd" Type="WSTRING" />
      <VarDeclaration Name="Command" Type="USINT" />
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
      <VarDeclaration Name="Accepted" Type="BOOL" />
      <VarDeclaration Name="SetpError" Type="UINT" />
      <VarDeclaration Name="Distance" Type="LREAL" InitialValue="50.0" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Owned" Type="BOOL" />
      <VarDeclaration Name="InRange" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Init" x="570" y="100">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Setp" x="990" y="100">
        <ECAction Algorithm="Alg_Setp" Output="RSP_SETP" />
        <ECAction Output="PUB" />
      </ECState>
      <ECState Name="SetpBusy" x="1410" y="100">
        <ECAction Algorithm="Alg_SetpBusy" Output="RSP_SETP" />
      </ECState>
      <ECState Name="Check" x="150" y="330" />
      <ECState Name="Rejected" x="570" y="330">
        <ECAction Algorithm="Alg_Rejected" Output="FAILURE" />
        <ECAction Output="PUB" />
      </ECState>
      <ECState Name="Run" x="990" y="330">
        <ECAction Algorithm="Alg_Run" Output="CMD" />
        <ECAction Output="WD_START" />
        <ECAction Output="PUB" />
      </ECState>
      <ECState Name="Running" x="1410" y="330" />
      <ECState Name="Succeeded" x="150" y="560">
        <ECAction Algorithm="Alg_Succeeded" Output="CMD" />
        <ECAction Output="WD_STOP" />
        <ECAction Output="SUCCESS" />
        <ECAction Output="PUB" />
      </ECState>
      <ECState Name="Unsafe" x="570" y="560">
        <ECAction Algorithm="Alg_Unsafe" Output="CMD" />
        <ECAction Output="WD_STOP" />
        <ECAction Output="FAILURE" />
        <ECAction Output="PUB" />
      </ECState>
      <ECState Name="TimedOut" x="990" y="560">
        <ECAction Algorithm="Alg_TimedOut" Output="CMD" />
        <ECAction Output="FAILURE" />
        <ECAction Output="PUB" />
      </ECState>
      <ECTransition Source="START" Destination="Init" Condition="INIT" x="0" y="0" />
      <ECTransition Source="START" Destination="Setp" Condition="SETP" x="0" y="0" />
      <ECTransition Source="START" Destination="Check" Condition="START" x="0" y="0" />
      <ECTransition Source="Check" Destination="Rejected" Condition="NOT (NOT (AtTop AND AtBottom))" x="0" y="0" />
      <ECTransition Source="Check" Destination="Succeeded" Condition="(Position &gt;= Distance) OR AtBottom" x="0" y="0" />
      <ECTransition Source="Check" Destination="Run" Condition="1" x="0" y="0" />
      <ECTransition Source="Run" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="Running" Destination="Unsafe" Condition="SAMPLE[NOT (NOT (AtTop AND AtBottom))]" x="0" y="0" />
      <ECTransition Source="Running" Destination="Succeeded" Condition="SAMPLE[(Position &gt;= Distance) OR AtBottom]" x="0" y="0" />
      <ECTransition Source="Running" Destination="TimedOut" Condition="TIMEOUT" x="0" y="0" />
      <ECTransition Source="Running" Destination="SetpBusy" Condition="SETP" x="0" y="0" />
      <ECTransition Source="SetpBusy" Destination="Running" Condition="1" x="0" y="0" />
      <ECTransition Source="Init" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Setp" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Rejected" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Succeeded" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Unsafe" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="TimedOut" Destination="START" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>IdSetp := CONCAT(CONCAT("opc_ua[CREATE_METHOD;", CONCAT(UaRoot, UaPath)), "/SetParameters]");
IdPub := CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/State;"), CONCAT(UaRoot, UaPath)), "/ErrorID"), ";"), CONCAT(UaRoot, UaPath)), "/Parameters/Distance"), "]");
IdEqState := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Unit), "/"), Equipment), "/state]");
IdEqCmd := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Unit), "/"), Equipment), "/cmd]");
Distance := D_Distance;
State := 0;
ErrorID := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Setp">
      <ST>Owned := (Session = Owner) AND (Owner &lt;&gt; "");
InRange := (S_Distance &gt;= 0.0) AND (S_Distance &lt;= 50.0);
Accepted := FALSE;
IF NOT Owned THEN
  SetpError := 5;
ELSIF NOT InRange THEN
  SetpError := 8;
ELSE
  Distance := S_Distance;
  Accepted := TRUE;
  SetpError := 0;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="Alg_SetpBusy">
      <ST>Accepted := FALSE;
SetpError := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Rejected">
      <ST>State := 3;
ErrorID := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Run">
      <ST>Command := 1;
State := 1;
ErrorID := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Succeeded">
      <ST>Command := 0;
State := 2;
ErrorID := 0;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Unsafe">
      <ST>Command := 0;
State := 3;
ErrorID := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_TimedOut">
      <ST>Command := 0;
State := 3;
ErrorID := 3;</ST>
    </Algorithm>
  </BasicFB>
</FBType>