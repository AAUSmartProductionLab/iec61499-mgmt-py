<?xml version='1.0' encoding='utf-8'?>
<System Name="FillerUnit" Comment="Unit Filler, generated from its unit specification">
  <Identification Standard="61499-2" />
  <Application Name="Filler" Comment="Unit Filler (generated by unitgen)">
    <SubAppNetwork>
      <FB Name="Boot" Type="iec61499::events::E_RESTART" x="2000" y="200" />
      <FB Name="Occupation" Type="unitlib::UNIT_Occupation" x="5000" y="200">
        <Parameter Name="Unit" Value="&quot;Filler&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filler&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
      </FB>
      <FB Name="Unit" Type="unitlib::UNIT_StateManager" x="9000" y="200">
        <Parameter Name="Unit" Value="&quot;Filler&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filler&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
      </FB>
      <FB Name="NeedleAxis" Type="filler::EQ_NeedleAxis" x="2000" y="3000">
        <Parameter Name="Unit" Value="&quot;Filler&quot;" />
        <Parameter Name="UaRoot" Value="&quot;/Objects/Filler&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="AtTop_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:10:d0:]&quot;" />
        <Parameter Name="AtTop_Gpio" Value="'NeedleAxis_AtTop'" />
        <Parameter Name="AtBottom_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:10:d1:]&quot;" />
        <Parameter Name="AtBottom_Gpio" Value="'NeedleAxis_AtBottom'" />
        <Parameter Name="Position_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:10:i1:]&quot;" />
        <Parameter Name="Position_Gpio" Value="'NeedleAxis_Position'" />
        <Parameter Name="Down_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c0]&quot;" />
        <Parameter Name="Down_Gpio" Value="'NeedleAxis_Down'" />
        <Parameter Name="Up_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c2]&quot;" />
        <Parameter Name="Up_Gpio" Value="'NeedleAxis_Up'" />
      </FB>
      <SubApp Name="Execute" x="2000" y="7000" Comment="PackML Execute procedure: skill instances chained SUCCESS -&gt; START; any FAILURE fails the procedure">
        <SubAppInterfaceList>
          <SubAppEventInputs>
            <SubAppEvent Name="INIT" Type="EInit" />
            <SubAppEvent Name="START" Type="Event" />
          </SubAppEventInputs>
          <SubAppEventOutputs>
            <SubAppEvent Name="INITO" Type="EInit" />
            <SubAppEvent Name="DONE" Type="Event" />
            <SubAppEvent Name="FAILED" Type="Event" />
          </SubAppEventOutputs>
          <InputVars />
          <OutputVars />
        </SubAppInterfaceList>
        <SubAppNetwork>
          <FB Name="MoveNeedleDown" Type="filler::SK_MoveNeedleDown" x="1000" y="1000">
            <Parameter Name="Unit" Value="&quot;Filler&quot;" />
            <Parameter Name="UaRoot" Value="&quot;/Objects/Filler&quot;" />
            <Parameter Name="UaPath" Value="&quot;/Execute/MoveNeedleDown&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
          </FB>
          <EventConnections>
            <Connection Source="INIT" Destination="MoveNeedleDown.INIT" />
            <Connection Source="START" Destination="MoveNeedleDown.START" />
            <Connection Source="MoveNeedleDown.INITO" Destination="INITO" />
            <Connection Source="MoveNeedleDown.SUCCESS" Destination="DONE" />
            <Connection Source="MoveNeedleDown.FAILURE" Destination="FAILED" />
          </EventConnections>
          <DataConnections />
        </SubAppNetwork>
      </SubApp>
      <EventConnections>
        <Connection Source="Boot.COLD" Destination="Occupation.INIT" />
        <Connection Source="Boot.WARM" Destination="Occupation.INIT" />
        <Connection Source="Unit.EXECUTE" Destination="Execute.START" />
        <Connection Source="Execute.DONE" Destination="Unit.EXECUTE_DONE" />
        <Connection Source="Execute.FAILED" Destination="Unit.EXECUTE_FAILED" />
        <Connection Source="Occupation.INITO" Destination="Unit.INIT" />
        <Connection Source="Unit.INITO" Destination="NeedleAxis.INIT" />
        <Connection Source="NeedleAxis.INITO" Destination="Execute.INIT" />
      </EventConnections>
      <DataConnections />
    </SubAppNetwork>
  </Application>
  <Device Name="FORTE_PC" Type="iec61499::system::FORTE_PC" x="1000" y="1000">
    <Parameter Name="MGR_ID" Value="&quot;localhost:61499&quot;" />
    <Attribute Name="Profile" Type="STRING" Value="HOLOBLOC" Comment="device profile" />
    <Attribute Name="Color" Type="STRING" Value="255,190,111" />
    <Resource Name="RES" Type="iec61499::system::EMB_RES" x="0" y="0">
      <FBNetwork />
    </Resource>
  </Device>
  <Mapping From="Filler.Boot" To="FORTE_PC.RES" />
  <Mapping From="Filler.Occupation" To="FORTE_PC.RES" />
  <Mapping From="Filler.Unit" To="FORTE_PC.RES" />
  <Mapping From="Filler.NeedleAxis" To="FORTE_PC.RES" />
  <Mapping From="Filler.Execute" To="FORTE_PC.RES" />
</System>