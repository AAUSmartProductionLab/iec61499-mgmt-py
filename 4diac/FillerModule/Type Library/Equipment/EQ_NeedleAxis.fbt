<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_NeedleAxis" Comment="Needle lift with down/up valves, end switches and a position sensor; equipment IO: owns its IO points; commands Stop=0, Down=1, Up=2">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="AtTop_Backend" />
        <With Var="AtTop_Modbus" />
        <With Var="AtTop_Io" />
        <With Var="AtTop_Sim" />
        <With Var="AtBottom_Backend" />
        <With Var="AtBottom_Modbus" />
        <With Var="AtBottom_Io" />
        <With Var="AtBottom_Sim" />
        <With Var="Position_Backend" />
        <With Var="Position_Modbus" />
        <With Var="Position_Io" />
        <With Var="Position_Sim" />
        <With Var="Position_Scale" />
        <With Var="Down_Backend" />
        <With Var="Down_Modbus" />
        <With Var="Down_Io" />
        <With Var="Up_Backend" />
        <With Var="Up_Modbus" />
        <With Var="Up_Io" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;NeedleAxis&quot;" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" />
      <VarDeclaration Name="AtTop_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="AtTop_Modbus" Type="WSTRING" />
      <VarDeclaration Name="AtTop_Io" Type="STRING" />
      <VarDeclaration Name="AtTop_Sim" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="AtBottom_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="AtBottom_Modbus" Type="WSTRING" />
      <VarDeclaration Name="AtBottom_Io" Type="STRING" />
      <VarDeclaration Name="AtBottom_Sim" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="Position_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Position_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Position_Io" Type="STRING" />
      <VarDeclaration Name="Position_Sim" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="Position_Scale" Type="LREAL" InitialValue="0.1" />
      <VarDeclaration Name="Down_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Down_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Down_Io" Type="STRING" />
      <VarDeclaration Name="Up_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Up_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Up_Io" Type="STRING" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <FB Name="Logic" Type="filler::EL_NeedleAxis" x="400" y="200" />
    <FB Name="Mode" Type="modlib::MOD_StateView" x="4000" y="200" />
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="7600" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_4" x="11200" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_3" x="14800" y="200" />
    <FB Name="In_AtTop" Type="modlib::IO_DI" x="18400" y="200" />
    <FB Name="In_AtBottom" Type="modlib::IO_DI" x="22000" y="200" />
    <FB Name="In_Position" Type="modlib::IO_AI" x="25600" y="200" />
    <FB Name="Out_Down" Type="modlib::IO_DO" x="29200" y="200" />
    <FB Name="Out_Up" Type="modlib::IO_DO" x="32800" y="200" />
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="36400" y="200" />
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="40000" y="200" />
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="PubUa.INIT" />
      <Connection Source="PubUa.INITO" Destination="In_AtTop.INIT" />
      <Connection Source="In_AtTop.INITO" Destination="In_AtBottom.INIT" />
      <Connection Source="In_AtBottom.INITO" Destination="In_Position.INIT" />
      <Connection Source="In_Position.INITO" Destination="Out_Down.INIT" />
      <Connection Source="Out_Down.INITO" Destination="Out_Up.INIT" />
      <Connection Source="Out_Up.INITO" Destination="Cycle.START" />
      <Connection Source="Out_Up.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="In_AtTop.REQ" />
      <Connection Source="In_AtTop.CNF" Destination="In_AtBottom.REQ" />
      <Connection Source="In_AtBottom.CNF" Destination="In_Position.REQ" />
      <Connection Source="In_Position.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.STATE" Destination="PubUa.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Out_Down.REQ" />
      <Connection Source="Out_Down.CNF" Destination="Out_Up.REQ" />
      <Connection Source="Out_Up.CNF" Destination="Logic.DRIVEN" />
      <Connection Source="Logic.PHASE_START" Destination="PhaseT.START" />
      <Connection Source="Logic.PHASE_STOP" Destination="PhaseT.STOP" />
      <Connection Source="PhaseT.EO" Destination="Logic.PHASE_T" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="UaRoot" Destination="Logic.UaRoot" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="Logic.IdPub" Destination="PubUa.ID" />
      <Connection Source="UaEnable" Destination="PubUa.QI" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Command" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Arg" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Release" />
      <Connection Source="Mode.State" Destination="Logic.ModState" />
      <Connection Source="AtTop_Backend" Destination="In_AtTop.Backend" />
      <Connection Source="AtTop_Modbus" Destination="In_AtTop.ModbusId" />
      <Connection Source="AtTop_Io" Destination="In_AtTop.IoName" />
      <Connection Source="AtTop_Sim" Destination="In_AtTop.SimValue" />
      <Connection Source="In_AtTop.IN" Destination="Logic.I_AtTop" />
      <Connection Source="Logic.AtTop" Destination="PubState.SD_1" />
      <Connection Source="Logic.AtTop" Destination="PubUa.SD_1" />
      <Connection Source="AtBottom_Backend" Destination="In_AtBottom.Backend" />
      <Connection Source="AtBottom_Modbus" Destination="In_AtBottom.ModbusId" />
      <Connection Source="AtBottom_Io" Destination="In_AtBottom.IoName" />
      <Connection Source="AtBottom_Sim" Destination="In_AtBottom.SimValue" />
      <Connection Source="In_AtBottom.IN" Destination="Logic.I_AtBottom" />
      <Connection Source="Logic.AtBottom" Destination="PubState.SD_2" />
      <Connection Source="Logic.AtBottom" Destination="PubUa.SD_2" />
      <Connection Source="Position_Backend" Destination="In_Position.Backend" />
      <Connection Source="Position_Modbus" Destination="In_Position.ModbusId" />
      <Connection Source="Position_Io" Destination="In_Position.IoName" />
      <Connection Source="Position_Sim" Destination="In_Position.SimValue" />
      <Connection Source="Position_Scale" Destination="In_Position.Scale" />
      <Connection Source="In_Position.IN" Destination="Logic.I_Position" />
      <Connection Source="Logic.Position" Destination="PubState.SD_3" />
      <Connection Source="Logic.Position" Destination="PubUa.SD_3" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_4" />
      <Connection Source="Down_Backend" Destination="Out_Down.Backend" />
      <Connection Source="Down_Modbus" Destination="Out_Down.ModbusId" />
      <Connection Source="Down_Io" Destination="Out_Down.IoName" />
      <Connection Source="Logic.O_Down" Destination="Out_Down.OUT" />
      <Connection Source="Up_Backend" Destination="Out_Up.Backend" />
      <Connection Source="Up_Modbus" Destination="Out_Up.ModbusId" />
      <Connection Source="Up_Io" Destination="Out_Up.IoName" />
      <Connection Source="Logic.O_Up" Destination="Out_Up.OUT" />
      <Connection Source="Logic.PhaseDT" Destination="PhaseT.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>