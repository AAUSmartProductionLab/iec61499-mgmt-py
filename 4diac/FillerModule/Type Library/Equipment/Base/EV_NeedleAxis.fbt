<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EV_NeedleAxis" Comment="Typed view of NeedleAxis's state channel (inputs and holder)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event">
        <With Var="I_AtTop" />
        <With Var="I_AtBottom" />
        <With Var="I_Position" />
        <With Var="I_Holder" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="AtTop" />
        <With Var="AtBottom" />
        <With Var="Position" />
        <With Var="Holder" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="I_AtTop" Type="BOOL" />
      <VarDeclaration Name="I_AtBottom" Type="BOOL" />
      <VarDeclaration Name="I_Position" Type="LREAL" />
      <VarDeclaration Name="I_Holder" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="AtTop" Type="BOOL" />
      <VarDeclaration Name="AtBottom" Type="BOOL" />
      <VarDeclaration Name="Position" Type="LREAL" />
      <VarDeclaration Name="Holder" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="REQ">
      <ECAction Algorithm="REQ" Output="CNF" />
    </ECState>
    <Algorithm Name="REQ">
      <ST>AtTop := I_AtTop;
AtBottom := I_AtBottom;
Position := I_Position;
Holder := I_Holder;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>