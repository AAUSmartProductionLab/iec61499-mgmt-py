  </Application>
  <Application Name="SkillBench" Comment="Demo: SK_Dose is called periodically with P1 = 0.3 mL; watch Dose.State, Plant.FilledMl, Done.CV and Failed.CV in the IDE monitoring">
    <SubAppNetwork>
      <FB Name="Boot" Type="iec61499::events::E_RESTART" x="100" y="100" />
      <FB Name="Plant" Type="fillingcell::DEMO_Plant" x="100" y="900">
        <Parameter Name="StartDown" Value="TRUE" />
      </FB>
      <FB Name="PlantClock" Type="iec61499::events::E_CYCLE" x="100" y="1700">
        <Parameter Name="DT" Value="T#20ms" />
      </FB>
      <FB Name="Observer" Type="fillingcell::UNIT_Observer" x="1400" y="900">
        <Parameter Name="UaRoot" Value="&quot;/Objects/Demo/Bench&quot;" />
        <Parameter Name="UaEnable" Value="FALSE" />
        <Parameter Name="IoBackend" Value="0" />
        <Parameter Name="CycleTime" Value="T#50ms" />
      </FB>
      <FB Name="Dose" Type="fillingcell::SK_Dose" x="2800" y="500">
        <Parameter Name="UaRoot" Value="&quot;/Objects/Demo/Bench/Dose&quot;" />
        <Parameter Name="UaEnable" Value="FALSE" />
        <Parameter Name="IoBackend" Value="0" />
        <Parameter Name="Timeout" Value="T#5s" />
        <Parameter Name="UnitRunning" Value="TRUE" />
        <Parameter Name="P1" Value="0.3" />
      </FB>
      <FB Name="Caller" Type="iec61499::events::E_CYCLE" x="1400" y="100">
        <Parameter Name="DT" Value="T#2s" />
      </FB>
      <FB Name="Done" Type="iec61499::events::E_CTU" x="4200" y="300" />
      <FB Name="Failed" Type="iec61499::events::E_CTU" x="4200" y="900" />
      <EventConnections>
        <Connection Source="Boot.COLD" Destination="Plant.INIT" />
        <Connection Source="Boot.WARM" Destination="Plant.INIT" />
        <Connection Source="Boot.COLD" Destination="PlantClock.START" />
        <Connection Source="Boot.WARM" Destination="PlantClock.START" />
        <Connection Source="Boot.COLD" Destination="Observer.INIT" />
        <Connection Source="Boot.WARM" Destination="Observer.INIT" />
        <Connection Source="PlantClock.EO" Destination="Plant.TICK" />
        <Connection Source="Plant.CNF" Destination="Observer.SIM" />
        <Connection Source="Observer.INITO" Destination="Dose.INIT" />
        <Connection Source="Dose.INITO" Destination="Dose.UNIT_STAT" />
        <Connection Source="Dose.INITO" Destination="Caller.START" />
        <Connection Source="Observer.SAMPLE" Destination="Dose.SAMPLE" />
        <Connection Source="Caller.EO" Destination="Dose.CALL" />
        <Connection Source="Dose.DONE" Destination="Done.CU" />
        <Connection Source="Dose.DONE" Destination="Plant.NEW_VIAL" />
        <Connection Source="Dose.FAILED" Destination="Failed.CU" />
      </EventConnections>
      <DataConnections>
        <Connection Source="Plant.NeedleUp" Destination="Observer.Sim_NeedleUp" />
        <Connection Source="Plant.NeedleDown" Destination="Observer.Sim_NeedleDown" />
        <Connection Source="Plant.VialPresent" Destination="Observer.Sim_VialPresent" />
        <Connection Source="Plant.FilledMl" Destination="Observer.Sim_FilledMl" />
        <Connection Source="Plant.Stoppered" Destination="Observer.Sim_Stoppered" />
        <Connection Source="Plant.Checked" Destination="Observer.Sim_Checked" />
        <Connection Source="Plant.DoorClosed" Destination="Observer.Sim_DoorClosed" />
        <Connection Source="Observer.Cell" Destination="Dose.Cell" />
        <Connection Source="Dose.Drive" Destination="Plant.DriveDose" />
      </DataConnections>
    </SubAppNetwork>
  </Application>
  <Application Name="PatternDemo" Comment="Demo of the procedure patterns: every 3 s a fork waits 0.3 s and 0.8 s, the join starts a 3-iteration loop, then a choice alternates; watch the Ctu* counters">
    <SubAppNetwork>
      <FB Name="Boot" Type="iec61499::events::E_RESTART" x="100" y="100" />
      <FB Name="Clock" Type="iec61499::events::E_CYCLE" x="100" y="700">
        <Parameter Name="DT" Value="T#3s" />
      </FB>
      <FB Name="Fork" Type="fillingcell::P_Fork" x="1200" y="700" />
      <FB Name="WaitA" Type="fillingcell::P_Wait" x="2300" y="300">
        <Parameter Name="DT" Value="T#300ms" />
      </FB>
      <FB Name="WaitB" Type="fillingcell::P_Wait" x="2300" y="1100">
        <Parameter Name="DT" Value="T#800ms" />
      </FB>
      <FB Name="Join" Type="fillingcell::P_Join" x="3400" y="700">
        <Parameter Name="N" Value="2" />
      </FB>
      <FB Name="Loop" Type="fillingcell::P_Loop" x="4500" y="700">
        <Parameter Name="Count" Value="3" />
      </FB>
      <FB Name="WaitC" Type="fillingcell::P_Wait" x="4500" y="1600">
        <Parameter Name="DT" Value="T#200ms" />
      </FB>
      <FB Name="Toggle" Type="iec61499::events::E_T_FF" x="5600" y="700" />
      <FB Name="Choice" Type="fillingcell::P_Choice" x="6700" y="700" />
      <FB Name="CtuJoin" Type="iec61499::events::E_CTU" x="7800" y="300" />
      <FB Name="CtuBody" Type="iec61499::events::E_CTU" x="7800" y="1000" />
      <FB Name="CtuTrue" Type="iec61499::events::E_CTU" x="7800" y="1700" />
      <FB Name="CtuFalse" Type="iec61499::events::E_CTU" x="7800" y="2400" />
      <EventConnections>
        <Connection Source="Boot.COLD" Destination="Clock.START" />
        <Connection Source="Boot.WARM" Destination="Clock.START" />
        <Connection Source="Clock.EO" Destination="Fork.EI" />
        <Connection Source="Fork.EO1" Destination="WaitA.EI" />
        <Connection Source="Fork.EO2" Destination="WaitB.EI" />
        <Connection Source="WaitA.EO" Destination="Join.EI1" />
        <Connection Source="WaitB.EO" Destination="Join.EI2" />
        <Connection Source="Join.EO" Destination="CtuJoin.CU" />
        <Connection Source="Join.EO" Destination="Loop.EI" />
        <Connection Source="Loop.BODY" Destination="WaitC.EI" />
        <Connection Source="Loop.BODY" Destination="CtuBody.CU" />
        <Connection Source="WaitC.EO" Destination="Loop.NEXT" />
        <Connection Source="Loop.EO" Destination="Toggle.CLK" />
        <Connection Source="Toggle.EO" Destination="Choice.EI" />
        <Connection Source="Choice.EO_TRUE" Destination="CtuTrue.CU" />
        <Connection Source="Choice.EO_FALSE" Destination="CtuFalse.CU" />
      </EventConnections>
      <DataConnections>
        <Connection Source="Toggle.Q" Destination="Choice.Cond" />
      </DataConnections>
    </SubAppNetwork>
  </Application>
  <Application Name="PiIoConfig" Comment="GPIOChip line configuration for a Raspberry Pi; handle names match IX/QX PARAMS in FillingCell. Map it together with FillingCell (IoBackend = 1) onto a Pi device">
    <SubAppNetwork>
      <FB Name="Boot" Type="iec61499::events::E_RESTART" x="100" y="100" />
      <FB Name="FC_NeedleUp" Type="eclipse4diac::io::gpiochip::GPIOChip" x="600" y="100">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="VALUE" Value="&quot;FC_NeedleUp&quot;" />
        <Parameter Name="ChipNumber" Value="0" />
        <Parameter Name="LineNumber" Value="17" />
        <Parameter Name="ReadWriteMode" Value="0" />
      </FB>
      <FB Name="FC_NeedleDown" Type="eclipse4diac::io::gpiochip::GPIOChip" x="1500" y="100">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="VALUE" Value="&quot;FC_NeedleDown&quot;" />
        <Parameter Name="ChipNumber" Value="0" />
        <Parameter Name="LineNumber" Value="27" />
        <Parameter Name="ReadWriteMode" Value="0" />
      </FB>
      <FB Name="FC_VialPresent" Type="eclipse4diac::io::gpiochip::GPIOChip" x="2400" y="100">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="VALUE" Value="&quot;FC_VialPresent&quot;" />
        <Parameter Name="ChipNumber" Value="0" />
        <Parameter Name="LineNumber" Value="22" />
        <Parameter Name="ReadWriteMode" Value="0" />
      </FB>
      <FB Name="FC_Stoppered" Type="eclipse4diac::io::gpiochip::GPIOChip" x="3300" y="100">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="VALUE" Value="&quot;FC_Stoppered&quot;" />
        <Parameter Name="ChipNumber" Value="0" />
        <Parameter Name="LineNumber" Value="23" />
        <Parameter Name="ReadWriteMode" Value="0" />
      </FB>
      <FB Name="FC_Checked" Type="eclipse4diac::io::gpiochip::GPIOChip" x="600" y="800">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="VALUE" Value="&quot;FC_Checked&quot;" />
        <Parameter Name="ChipNumber" Value="0" />
        <Parameter Name="LineNumber" Value="24" />
        <Parameter Name="ReadWriteMode" Value="0" />
      </FB>
      <FB Name="FC_DoorClosed" Type="eclipse4diac::io::gpiochip::GPIOChip" x="1500" y="800">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="VALUE" Value="&quot;FC_DoorClosed&quot;" />
        <Parameter Name="ChipNumber" Value="0" />
        <Parameter Name="LineNumber" Value="25" />
        <Parameter Name="ReadWriteMode" Value="0" />
      </FB>
