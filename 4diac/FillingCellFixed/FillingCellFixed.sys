      </FBNetwork>
    </Resource>
    <Resource Name="PATTERNS" Type="iec61499::system::EMB_RES" x="0" y="0">
      <FBNetwork>
        <FB Name="Boot" Type="iec61499::events::E_RESTART" x="100" y="100" />
