  <Application Name="FillingCellDemo" Comment="Self-running demo: plant model and automatic operator cycle the whole cell through the PROC procedure; watch Operator.Cycles, Unit.State, Plant.* in the IDE monitoring (no OPC UA: FORTE 3.3 serves OPC UA for one resource only, used by FillingCell)">
    <SubAppNetwork>
      <FB Name="Boot" Type="iec61499::events::E_RESTART" x="100" y="100" />
      <FB Name="Observer" Type="fillingcell::UNIT_Observer" x="100" y="1400">
        <Parameter Name="UaRoot" Value="&quot;/Objects/Demo/Filler&quot;" />
        <Parameter Name="UaEnable" Value="FALSE" />
        <Parameter Name="IoBackend" Value="0" />
        <Parameter Name="CycleTime" Value="T#50ms" />
      </FB>
      <FB Name="Occupation" Type="fillingcell::FC_Occupation" x="1500" y="100" />
      <FB Name="Unit" Type="fillingcell::FC_Unit" x="1500" y="700" />
      <FB Name="Facade" Type="fillingcell::FC_ProcedureFacade" x="2600" y="100">
        <Parameter Name="Installed" Value="TRUE" />
      </FB>
      <SubApp Name="EM_Filler" x="3600" y="700" Comment="Equipment module: one composite per skill, chained for status; instances and chain may be changed online while the unit is quiescent">
        <InterfaceList>
          <EventInputs>
            <Event Name="INIT" Type="Event" />
            <Event Name="UNIT_CTL" Type="Event">
              <With Var="ControlCode" />
            </Event>
            <Event Name="UNIT_STAT" Type="Event">
              <With Var="UnitRunning" />
              <With Var="UnitQuiescent" />
              <With Var="UnitState" />
              <With Var="Mode" />
              <With Var="Owner" />
              <With Var="RemoteAllowed" />
            </Event>
            <Event Name="SAMPLE" Type="Event">
              <With Var="Cell" />
            </Event>
            <Event Name="CALL_MoveDown" Type="Event">
              <With Var="P1_MoveDown" />
              <With Var="P2_MoveDown" />
              <With Var="P3_MoveDown" />
              <With Var="P4_MoveDown" />
            </Event>
            <Event Name="CALL_Dose" Type="Event">
              <With Var="P1_Dose" />
              <With Var="P2_Dose" />
              <With Var="P3_Dose" />
              <With Var="P4_Dose" />
            </Event>
            <Event Name="CALL_MoveUp" Type="Event">
              <With Var="P1_MoveUp" />
              <With Var="P2_MoveUp" />
              <With Var="P3_MoveUp" />
              <With Var="P4_MoveUp" />
            </Event>
            <Event Name="CALL_Stopper" Type="Event">
              <With Var="P1_Stopper" />
              <With Var="P2_Stopper" />
              <With Var="P3_Stopper" />
              <With Var="P4_Stopper" />
            </Event>
            <Event Name="CALL_Inspect" Type="Event">
              <With Var="P1_Inspect" />
              <With Var="P2_Inspect" />
              <With Var="P3_Inspect" />
              <With Var="P4_Inspect" />
            </Event>
          </EventInputs>
          <EventOutputs>
            <Event Name="INITO" Type="Event" />
            <Event Name="STAT_OUT" Type="Event">
              <With Var="Busy" />
              <With Var="HeldAll" />
              <With Var="RunAll" />
            </Event>
            <Event Name="DONE_MoveDown" Type="Event" />
            <Event Name="DONE_Dose" Type="Event" />
            <Event Name="DONE_MoveUp" Type="Event" />
            <Event Name="DONE_Stopper" Type="Event" />
            <Event Name="DONE_Inspect" Type="Event" />
            <Event Name="FAILED_MoveDown" Type="Event">
              <With Var="CallError_MoveDown" />
            </Event>
            <Event Name="FAILED_Dose" Type="Event">
              <With Var="CallError_Dose" />
            </Event>
            <Event Name="FAILED_MoveUp" Type="Event">
              <With Var="CallError_MoveUp" />
            </Event>
            <Event Name="FAILED_Stopper" Type="Event">
              <With Var="CallError_Stopper" />
            </Event>
            <Event Name="FAILED_Inspect" Type="Event">
              <With Var="CallError_Inspect" />
            </Event>
          </EventOutputs>
          <InputVars>
            <VarDeclaration Name="ControlCode" Type="USINT" />
            <VarDeclaration Name="UnitRunning" Type="BOOL" />
            <VarDeclaration Name="UnitQuiescent" Type="BOOL" />
            <VarDeclaration Name="UnitState" Type="USINT" />
            <VarDeclaration Name="Mode" Type="USINT" />
            <VarDeclaration Name="Owner" Type="UDINT" />
            <VarDeclaration Name="RemoteAllowed" Type="BOOL" />
            <VarDeclaration Name="Cell" Type="fillingcell::ST_CellState" />
            <VarDeclaration Name="P1_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P2_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P3_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P4_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P1_Dose" Type="LREAL" />
            <VarDeclaration Name="P2_Dose" Type="LREAL" />
            <VarDeclaration Name="P3_Dose" Type="LREAL" />
            <VarDeclaration Name="P4_Dose" Type="LREAL" />
            <VarDeclaration Name="P1_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P2_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P3_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P4_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P1_Stopper" Type="LREAL" />
            <VarDeclaration Name="P2_Stopper" Type="LREAL" />
            <VarDeclaration Name="P3_Stopper" Type="LREAL" />
            <VarDeclaration Name="P4_Stopper" Type="LREAL" />
            <VarDeclaration Name="P1_Inspect" Type="LREAL" />
            <VarDeclaration Name="P2_Inspect" Type="LREAL" />
            <VarDeclaration Name="P3_Inspect" Type="LREAL" />
            <VarDeclaration Name="P4_Inspect" Type="LREAL" />
          </InputVars>
          <OutputVars>
            <VarDeclaration Name="Busy" Type="BOOL" />
            <VarDeclaration Name="HeldAll" Type="BOOL" />
            <VarDeclaration Name="RunAll" Type="BOOL" />
            <VarDeclaration Name="CallError_MoveDown" Type="UINT" />
            <VarDeclaration Name="CallError_Dose" Type="UINT" />
            <VarDeclaration Name="CallError_MoveUp" Type="UINT" />
            <VarDeclaration Name="CallError_Stopper" Type="UINT" />
            <VarDeclaration Name="CallError_Inspect" Type="UINT" />
            <VarDeclaration Name="Drive_MoveDown" Type="BOOL" />
