      <SubApp Name="PROC" x="2600" y="1400" Comment="Demo procedure: MoveDown, Dose x2 (P_Loop), MoveUp, Stopper, Inspect">
        <InterfaceList>
          <EventInputs>
            <Event Name="START" Type="Event" />
            <Event Name="RESET" Type="Event" />
            <Event Name="CMD" Type="Event">
              <With Var="Command" />
            </Event>
            <Event Name="DONE_MoveDown" Type="Event" />
            <Event Name="DONE_Dose" Type="Event" />
            <Event Name="DONE_MoveUp" Type="Event" />
            <Event Name="DONE_Stopper" Type="Event" />
            <Event Name="DONE_Inspect" Type="Event" />
            <Event Name="FAILED_MoveDown" Type="Event">
              <With Var="CallError_MoveDown" />
            </Event>
            <Event Name="FAILED_Dose" Type="Event">
              <With Var="CallError_Dose" />
            </Event>
            <Event Name="FAILED_MoveUp" Type="Event">
              <With Var="CallError_MoveUp" />
            </Event>
            <Event Name="FAILED_Stopper" Type="Event">
              <With Var="CallError_Stopper" />
            </Event>
            <Event Name="FAILED_Inspect" Type="Event">
              <With Var="CallError_Inspect" />
            </Event>
          </EventInputs>
          <EventOutputs>
            <Event Name="FINISHED" Type="Event" />
            <Event Name="FAILED" Type="Event" />
            <Event Name="CALL_MoveDown" Type="Event">
              <With Var="P1_MoveDown" />
              <With Var="P2_MoveDown" />
              <With Var="P3_MoveDown" />
              <With Var="P4_MoveDown" />
            </Event>
            <Event Name="CALL_Dose" Type="Event">
              <With Var="P1_Dose" />
              <With Var="P2_Dose" />
              <With Var="P3_Dose" />
              <With Var="P4_Dose" />
            </Event>
            <Event Name="CALL_MoveUp" Type="Event">
              <With Var="P1_MoveUp" />
              <With Var="P2_MoveUp" />
              <With Var="P3_MoveUp" />
              <With Var="P4_MoveUp" />
            </Event>
            <Event Name="CALL_Stopper" Type="Event">
              <With Var="P1_Stopper" />
              <With Var="P2_Stopper" />
              <With Var="P3_Stopper" />
              <With Var="P4_Stopper" />
            </Event>
            <Event Name="CALL_Inspect" Type="Event">
              <With Var="P1_Inspect" />
              <With Var="P2_Inspect" />
              <With Var="P3_Inspect" />
              <With Var="P4_Inspect" />
            </Event>
          </EventOutputs>
          <InputVars>
            <VarDeclaration Name="Command" Type="USINT" />
            <VarDeclaration Name="CallError_MoveDown" Type="UINT" />
            <VarDeclaration Name="CallError_Dose" Type="UINT" />
            <VarDeclaration Name="CallError_MoveUp" Type="UINT" />
            <VarDeclaration Name="CallError_Stopper" Type="UINT" />
            <VarDeclaration Name="CallError_Inspect" Type="UINT" />
          </InputVars>
          <OutputVars>
            <VarDeclaration Name="P1_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P2_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P3_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P4_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P1_Dose" Type="LREAL" />
            <VarDeclaration Name="P2_Dose" Type="LREAL" />
            <VarDeclaration Name="P3_Dose" Type="LREAL" />
            <VarDeclaration Name="P4_Dose" Type="LREAL" />
            <VarDeclaration Name="P1_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P2_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P3_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P4_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P1_Stopper" Type="LREAL" />
            <VarDeclaration Name="P2_Stopper" Type="LREAL" />
            <VarDeclaration Name="P3_Stopper" Type="LREAL" />
            <VarDeclaration Name="P4_Stopper" Type="LREAL" />
            <VarDeclaration Name="P1_Inspect" Type="LREAL" />
            <VarDeclaration Name="P2_Inspect" Type="LREAL" />
            <VarDeclaration Name="P3_Inspect" Type="LREAL" />
            <VarDeclaration Name="P4_Inspect" Type="LREAL" />
          </OutputVars>
        </InterfaceList>
        <SubAppNetwork>
          <FB Name="MoveDown" Type="fillingcell::P_Call" x="400" y="300" />
          <FB Name="Dose" Type="fillingcell::P_Call" x="2000" y="300">
            <Parameter Name="P1" Value="0.3" />
          </FB>
          <FB Name="MoveUp" Type="fillingcell::P_Call" x="3600" y="300" />
          <FB Name="Stopper" Type="fillingcell::P_Call" x="5200" y="300" />
          <FB Name="Inspect" Type="fillingcell::P_Call" x="6800" y="300" />
          <FB Name="DoseLoop" Type="fillingcell::P_Loop" x="2000" y="1400">
            <Parameter Name="Count" Value="2" />
          </FB>
          <EventConnections>
            <Connection Source="START" Destination="MoveDown.EI" />
            <Connection Source="MoveDown.EO" Destination="DoseLoop.EI" />
            <Connection Source="DoseLoop.BODY" Destination="Dose.EI" />
            <Connection Source="Dose.EO" Destination="DoseLoop.NEXT" />
            <Connection Source="DoseLoop.EO" Destination="MoveUp.EI" />
            <Connection Source="MoveUp.EO" Destination="Stopper.EI" />
            <Connection Source="Stopper.EO" Destination="Inspect.EI" />
            <Connection Source="Inspect.EO" Destination="FINISHED" />
            <Connection Source="RESET" Destination="DoseLoop.RESET" />
            <Connection Source="MoveDown.CALL" Destination="CALL_MoveDown" />
            <Connection Source="DONE_MoveDown" Destination="MoveDown.DONE" />
            <Connection Source="FAILED_MoveDown" Destination="MoveDown.FAILED" />
            <Connection Source="MoveDown.ERR" Destination="FAILED" />
            <Connection Source="RESET" Destination="MoveDown.RESET" />
            <Connection Source="Dose.CALL" Destination="CALL_Dose" />
            <Connection Source="DONE_Dose" Destination="Dose.DONE" />
            <Connection Source="FAILED_Dose" Destination="Dose.FAILED" />
            <Connection Source="Dose.ERR" Destination="FAILED" />
            <Connection Source="RESET" Destination="Dose.RESET" />
            <Connection Source="MoveUp.CALL" Destination="CALL_MoveUp" />
            <Connection Source="DONE_MoveUp" Destination="MoveUp.DONE" />
            <Connection Source="FAILED_MoveUp" Destination="MoveUp.FAILED" />
            <Connection Source="MoveUp.ERR" Destination="FAILED" />
            <Connection Source="RESET" Destination="MoveUp.RESET" />
            <Connection Source="Stopper.CALL" Destination="CALL_Stopper" />
            <Connection Source="DONE_Stopper" Destination="Stopper.DONE" />
            <Connection Source="FAILED_Stopper" Destination="Stopper.FAILED" />
            <Connection Source="Stopper.ERR" Destination="FAILED" />
            <Connection Source="RESET" Destination="Stopper.RESET" />
            <Connection Source="Inspect.CALL" Destination="CALL_Inspect" />
            <Connection Source="DONE_Inspect" Destination="Inspect.DONE" />
            <Connection Source="FAILED_Inspect" Destination="Inspect.FAILED" />
            <Connection Source="Inspect.ERR" Destination="FAILED" />
            <Connection Source="RESET" Destination="Inspect.RESET" />
          </EventConnections>
          <DataConnections>
            <Connection Source="Dose.CP1" Destination="P1_Dose" />
            <Connection Source="CallError_MoveDown" Destination="MoveDown.CallError" />
            <Connection Source="CallError_Dose" Destination="Dose.CallError" />
            <Connection Source="CallError_MoveUp" Destination="MoveUp.CallError" />
            <Connection Source="CallError_Stopper" Destination="Stopper.CallError" />
            <Connection Source="CallError_Inspect" Destination="Inspect.CallError" />
          </DataConnections>
        </SubAppNetwork>
      </SubApp>
      <FB Name="Plant" Type="fillingcell::DEMO_Plant" x="100" y="2600" />
      <FB Name="PlantClock" Type="iec61499::events::E_CYCLE" x="100" y="3400">
        <Parameter Name="DT" Value="T#20ms" />
      </FB>
      <FB Name="Operator" Type="fillingcell::DEMO_Operator" x="4800" y="100" />
      <FB Name="OpDelay" Type="iec61499::events::E_DELAY" x="4800" y="900" />
      <EventConnections>
        <Connection Source="Boot.COLD" Destination="Observer.INIT" />
        <Connection Source="Boot.WARM" Destination="Observer.INIT" />
        <Connection Source="Unit.CNF" Destination="EM_Filler.UNIT_STAT" />
        <Connection Source="Occupation.CNF" Destination="EM_Filler.UNIT_STAT" />
        <Connection Source="Unit.CONTROL" Destination="EM_Filler.UNIT_CTL" />
        <Connection Source="EM_Filler.STAT_OUT" Destination="Unit.STATUS" />
        <Connection Source="Observer.SAMPLE" Destination="EM_Filler.SAMPLE" />
        <Connection Source="Observer.UNSAFE" Destination="Unit.UNSAFE" />
        <Connection Source="Unit.PROC_CMD" Destination="Facade.CMD" />
        <Connection Source="Facade.EXEC" Destination="PROC.CMD" />
        <Connection Source="Facade.START" Destination="PROC.START" />
        <Connection Source="Facade.RESET" Destination="PROC.RESET" />
        <Connection Source="PROC.FINISHED" Destination="Facade.FINISHED" />
        <Connection Source="PROC.FAILED" Destination="Facade.FAILED" />
        <Connection Source="Facade.DONE" Destination="Unit.PROC_DONE" />
