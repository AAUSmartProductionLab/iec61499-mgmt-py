        <SubApp Name="PROC" x="2600" y="1400" Comment="INTENTIONALLY EMPTY: generated procedure (P_* pattern instances) calls skills via CALL_*/DONE_*/FAILED_*">
          <InterfaceList>
            <EventInputs>
              <Event Name="START" Type="Event" />
              <Event Name="RESET" Type="Event" />
              <Event Name="CMD" Type="Event">
                <With Var="Command" />
