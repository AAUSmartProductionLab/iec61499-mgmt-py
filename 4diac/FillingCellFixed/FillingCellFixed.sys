            <VarDeclaration Name="Drive_MoveUp" Type="BOOL" />
            <VarDeclaration Name="Drive_Stopper" Type="BOOL" />
            <VarDeclaration Name="Drive_Inspect" Type="BOOL" />
          </OutputVars>
        </InterfaceList>
        <SubAppNetwork>
          <FB Name="MoveDown" Type="fillingcell::SK_MoveDown" x="300" y="300">
            <Parameter Name="UaRoot" Value="&quot;/Objects/Demo/Filler/Skills/MoveDown&quot;" />
            <Parameter Name="UaEnable" Value="FALSE" />
            <Parameter Name="IoBackend" Value="0" />
