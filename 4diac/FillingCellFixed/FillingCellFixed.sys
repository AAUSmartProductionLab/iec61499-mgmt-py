<?xml version='1.0' encoding='utf-8'?>
<System Name="FillingCellFixed" Comment="FillingCell (production, OPC UA driven), FillingCellDemo (self-running), SkillBench and PatternDemo run on one FORTE_PC device; PiIoConfig is for a Raspberry Pi">
  <Identification Standard="61499-2" />
  <Application Name="FillingCell" Comment="Production cell driven over OPC UA (/Objects/FillingCell/Filler). IoBackend 0 = simulated (force Observer.Sim_*), 1 = GPIO (add PiIoConfig), 2 = Modbus (4diac/tools/cell_sim.py)">
    <SubAppNetwork>
      <FB Name="Boot" Type="iec61499::events::E_RESTART" x="100" y="100" />
      <FB Name="Observer" Type="fillingcell::UNIT_Observer" x="100" y="1400">
        <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
        <Parameter Name="IoBackend" Value="0" />
        <Parameter Name="NeedleUp_Gpio" Value="'FC_NeedleUp'" />
        <Parameter Name="NeedleUp_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:d0:]&quot;" />
        <Parameter Name="NeedleDown_Gpio" Value="'FC_NeedleDown'" />
        <Parameter Name="NeedleDown_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:d1:]&quot;" />
        <Parameter Name="VialPresent_Gpio" Value="'FC_VialPresent'" />
        <Parameter Name="VialPresent_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:d2:]&quot;" />
        <Parameter Name="Stoppered_Gpio" Value="'FC_Stoppered'" />
        <Parameter Name="Stoppered_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:d3:]&quot;" />
        <Parameter Name="Checked_Gpio" Value="'FC_Checked'" />
        <Parameter Name="Checked_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:d4:]&quot;" />
        <Parameter Name="DoorClosed_Gpio" Value="'FC_DoorClosed'" />
        <Parameter Name="DoorClosed_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:d5:]&quot;" />
        <Parameter Name="FilledMl_Gpio" Value="''" />
        <Parameter Name="FilledMl_Modbus" Value="&quot;modbus[127.0.0.1:1502:1:50:i0:]&quot;" />
        <Parameter Name="Sim_NeedleUp" Value="TRUE" />
        <Parameter Name="Sim_VialPresent" Value="TRUE" />
        <Parameter Name="Sim_DoorClosed" Value="TRUE" />
      </FB>
      <FB Name="UaFacade" Type="fillingcell::UNIT_Facade" x="100" y="500">
        <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler&quot;" />
        <Parameter Name="UaEnable" Value="TRUE" />
      </FB>
      <FB Name="Occupation" Type="fillingcell::FC_Occupation" x="1500" y="100" />
      <FB Name="Unit" Type="fillingcell::FC_Unit" x="1500" y="700" />
      <FB Name="Facade" Type="fillingcell::FC_ProcedureFacade" x="2600" y="100" />
      <SubApp Name="EM_Filler" x="3600" y="700" Comment="Equipment module: one composite per skill, chained for status; instances and chain may be changed online while the unit is quiescent">
        <InterfaceList>
          <EventInputs>
            <Event Name="INIT" Type="Event" />
            <Event Name="UNIT_CTL" Type="Event">
              <With Var="ControlCode" />
            </Event>
            <Event Name="UNIT_STAT" Type="Event">
              <With Var="UnitRunning" />
              <With Var="UnitQuiescent" />
              <With Var="UnitState" />
              <With Var="Mode" />
              <With Var="Owner" />
              <With Var="RemoteAllowed" />
            </Event>
            <Event Name="SAMPLE" Type="Event">
              <With Var="Cell" />
            </Event>
            <Event Name="CALL_MoveDown" Type="Event">
              <With Var="P1_MoveDown" />
              <With Var="P2_MoveDown" />
              <With Var="P3_MoveDown" />
              <With Var="P4_MoveDown" />
            </Event>
            <Event Name="CALL_Dose" Type="Event">
              <With Var="P1_Dose" />
              <With Var="P2_Dose" />
              <With Var="P3_Dose" />
              <With Var="P4_Dose" />
            </Event>
            <Event Name="CALL_MoveUp" Type="Event">
              <With Var="P1_MoveUp" />
              <With Var="P2_MoveUp" />
              <With Var="P3_MoveUp" />
              <With Var="P4_MoveUp" />
            </Event>
            <Event Name="CALL_Stopper" Type="Event">
              <With Var="P1_Stopper" />
              <With Var="P2_Stopper" />
              <With Var="P3_Stopper" />
              <With Var="P4_Stopper" />
            </Event>
            <Event Name="CALL_Inspect" Type="Event">
              <With Var="P1_Inspect" />
              <With Var="P2_Inspect" />
              <With Var="P3_Inspect" />
              <With Var="P4_Inspect" />
            </Event>
          </EventInputs>
          <EventOutputs>
            <Event Name="INITO" Type="Event" />
            <Event Name="STAT_OUT" Type="Event">
              <With Var="Busy" />
              <With Var="HeldAll" />
              <With Var="RunAll" />
            </Event>
            <Event Name="DONE_MoveDown" Type="Event" />
            <Event Name="DONE_Dose" Type="Event" />
            <Event Name="DONE_MoveUp" Type="Event" />
            <Event Name="DONE_Stopper" Type="Event" />
            <Event Name="DONE_Inspect" Type="Event" />
            <Event Name="FAILED_MoveDown" Type="Event">
              <With Var="CallError_MoveDown" />
            </Event>
            <Event Name="FAILED_Dose" Type="Event">
              <With Var="CallError_Dose" />
            </Event>
            <Event Name="FAILED_MoveUp" Type="Event">
              <With Var="CallError_MoveUp" />
            </Event>
            <Event Name="FAILED_Stopper" Type="Event">
              <With Var="CallError_Stopper" />
            </Event>
            <Event Name="FAILED_Inspect" Type="Event">
              <With Var="CallError_Inspect" />
            </Event>
          </EventOutputs>
          <InputVars>
            <VarDeclaration Name="ControlCode" Type="USINT" />
            <VarDeclaration Name="UnitRunning" Type="BOOL" />
            <VarDeclaration Name="UnitQuiescent" Type="BOOL" />
            <VarDeclaration Name="UnitState" Type="USINT" />
            <VarDeclaration Name="Mode" Type="USINT" />
            <VarDeclaration Name="Owner" Type="UDINT" />
            <VarDeclaration Name="RemoteAllowed" Type="BOOL" />
            <VarDeclaration Name="Cell" Type="fillingcell::ST_CellState" />
            <VarDeclaration Name="P1_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P2_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P3_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P4_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P1_Dose" Type="LREAL" />
            <VarDeclaration Name="P2_Dose" Type="LREAL" />
            <VarDeclaration Name="P3_Dose" Type="LREAL" />
            <VarDeclaration Name="P4_Dose" Type="LREAL" />
            <VarDeclaration Name="P1_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P2_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P3_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P4_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P1_Stopper" Type="LREAL" />
            <VarDeclaration Name="P2_Stopper" Type="LREAL" />
            <VarDeclaration Name="P3_Stopper" Type="LREAL" />
            <VarDeclaration Name="P4_Stopper" Type="LREAL" />
            <VarDeclaration Name="P1_Inspect" Type="LREAL" />
            <VarDeclaration Name="P2_Inspect" Type="LREAL" />
            <VarDeclaration Name="P3_Inspect" Type="LREAL" />
            <VarDeclaration Name="P4_Inspect" Type="LREAL" />
          </InputVars>
          <OutputVars>
            <VarDeclaration Name="Busy" Type="BOOL" />
            <VarDeclaration Name="HeldAll" Type="BOOL" />
            <VarDeclaration Name="RunAll" Type="BOOL" />
            <VarDeclaration Name="CallError_MoveDown" Type="UINT" />
            <VarDeclaration Name="CallError_Dose" Type="UINT" />
            <VarDeclaration Name="CallError_MoveUp" Type="UINT" />
            <VarDeclaration Name="CallError_Stopper" Type="UINT" />
            <VarDeclaration Name="CallError_Inspect" Type="UINT" />
            <VarDeclaration Name="Drive_MoveDown" Type="BOOL" />
            <VarDeclaration Name="Drive_Dose" Type="BOOL" />
            <VarDeclaration Name="Drive_MoveUp" Type="BOOL" />
            <VarDeclaration Name="Drive_Stopper" Type="BOOL" />
            <VarDeclaration Name="Drive_Inspect" Type="BOOL" />
          </OutputVars>
        </InterfaceList>
        <SubAppNetwork>
          <FB Name="MoveDown" Type="fillingcell::SK_MoveDown" x="300" y="300">
            <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler/Skills/MoveDown&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="IoBackend" Value="0" />
            <Parameter Name="DoGpio" Value="'FC_MoveDown'" />
            <Parameter Name="DoModbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c0]&quot;" />
          </FB>
          <FB Name="Dose" Type="fillingcell::SK_Dose" x="1800" y="300">
            <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler/Skills/Dose&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="IoBackend" Value="0" />
            <Parameter Name="DoGpio" Value="'FC_Dose'" />
            <Parameter Name="DoModbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c1]&quot;" />
          </FB>
          <FB Name="MoveUp" Type="fillingcell::SK_MoveUp" x="3300" y="300">
            <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler/Skills/MoveUp&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="IoBackend" Value="0" />
            <Parameter Name="DoGpio" Value="'FC_MoveUp'" />
            <Parameter Name="DoModbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c2]&quot;" />
          </FB>
          <FB Name="Stopper" Type="fillingcell::SK_Stopper" x="4800" y="300">
            <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler/Skills/Stopper&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="IoBackend" Value="0" />
            <Parameter Name="DoGpio" Value="'FC_Stopper'" />
            <Parameter Name="DoModbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c3]&quot;" />
          </FB>
          <FB Name="Inspect" Type="fillingcell::SK_Inspect" x="6300" y="300">
            <Parameter Name="UaRoot" Value="&quot;/Objects/FillingCell/Filler/Skills/Inspect&quot;" />
            <Parameter Name="UaEnable" Value="TRUE" />
            <Parameter Name="IoBackend" Value="0" />
            <Parameter Name="DoGpio" Value="'FC_Inspect'" />
            <Parameter Name="DoModbus" Value="&quot;modbus[127.0.0.1:1502:1:0::c4]&quot;" />
          </FB>
          <EventConnections>
            <Connection Source="INIT" Destination="MoveDown.INIT" />
            <Connection Source="MoveDown.INITO" Destination="Dose.INIT" />
            <Connection Source="MoveDown.STAT_OUT" Destination="Dose.STAT_IN" />
            <Connection Source="Dose.INITO" Destination="MoveUp.INIT" />
            <Connection Source="Dose.STAT_OUT" Destination="MoveUp.STAT_IN" />
            <Connection Source="MoveUp.INITO" Destination="Stopper.INIT" />
            <Connection Source="MoveUp.STAT_OUT" Destination="Stopper.STAT_IN" />
            <Connection Source="Stopper.INITO" Destination="Inspect.INIT" />
            <Connection Source="Stopper.STAT_OUT" Destination="Inspect.STAT_IN" />
            <Connection Source="Inspect.INITO" Destination="INITO" />
            <Connection Source="Inspect.STAT_OUT" Destination="STAT_OUT" />
            <Connection Source="UNIT_CTL" Destination="MoveDown.UNIT_CTL" />
            <Connection Source="UNIT_STAT" Destination="MoveDown.UNIT_STAT" />
            <Connection Source="SAMPLE" Destination="MoveDown.SAMPLE" />
            <Connection Source="CALL_MoveDown" Destination="MoveDown.CALL" />
            <Connection Source="MoveDown.DONE" Destination="DONE_MoveDown" />
            <Connection Source="MoveDown.FAILED" Destination="FAILED_MoveDown" />
            <Connection Source="UNIT_CTL" Destination="Dose.UNIT_CTL" />
            <Connection Source="UNIT_STAT" Destination="Dose.UNIT_STAT" />
            <Connection Source="SAMPLE" Destination="Dose.SAMPLE" />
            <Connection Source="CALL_Dose" Destination="Dose.CALL" />
            <Connection Source="Dose.DONE" Destination="DONE_Dose" />
            <Connection Source="Dose.FAILED" Destination="FAILED_Dose" />
            <Connection Source="UNIT_CTL" Destination="MoveUp.UNIT_CTL" />
            <Connection Source="UNIT_STAT" Destination="MoveUp.UNIT_STAT" />
            <Connection Source="SAMPLE" Destination="MoveUp.SAMPLE" />
            <Connection Source="CALL_MoveUp" Destination="MoveUp.CALL" />
            <Connection Source="MoveUp.DONE" Destination="DONE_MoveUp" />
            <Connection Source="MoveUp.FAILED" Destination="FAILED_MoveUp" />
            <Connection Source="UNIT_CTL" Destination="Stopper.UNIT_CTL" />
            <Connection Source="UNIT_STAT" Destination="Stopper.UNIT_STAT" />
            <Connection Source="SAMPLE" Destination="Stopper.SAMPLE" />
            <Connection Source="CALL_Stopper" Destination="Stopper.CALL" />
            <Connection Source="Stopper.DONE" Destination="DONE_Stopper" />
            <Connection Source="Stopper.FAILED" Destination="FAILED_Stopper" />
            <Connection Source="UNIT_CTL" Destination="Inspect.UNIT_CTL" />
            <Connection Source="UNIT_STAT" Destination="Inspect.UNIT_STAT" />
            <Connection Source="SAMPLE" Destination="Inspect.SAMPLE" />
            <Connection Source="CALL_Inspect" Destination="Inspect.CALL" />
            <Connection Source="Inspect.DONE" Destination="DONE_Inspect" />
            <Connection Source="Inspect.FAILED" Destination="FAILED_Inspect" />
          </EventConnections>
          <DataConnections>
            <Connection Source="MoveDown.BusyOut" Destination="Dose.BusyIn" />
            <Connection Source="MoveDown.HeldOut" Destination="Dose.HeldIn" />
            <Connection Source="MoveDown.RunOut" Destination="Dose.RunIn" />
            <Connection Source="Dose.BusyOut" Destination="MoveUp.BusyIn" />
            <Connection Source="Dose.HeldOut" Destination="MoveUp.HeldIn" />
            <Connection Source="Dose.RunOut" Destination="MoveUp.RunIn" />
            <Connection Source="MoveUp.BusyOut" Destination="Stopper.BusyIn" />
            <Connection Source="MoveUp.HeldOut" Destination="Stopper.HeldIn" />
            <Connection Source="MoveUp.RunOut" Destination="Stopper.RunIn" />
            <Connection Source="Stopper.BusyOut" Destination="Inspect.BusyIn" />
            <Connection Source="Stopper.HeldOut" Destination="Inspect.HeldIn" />
            <Connection Source="Stopper.RunOut" Destination="Inspect.RunIn" />
            <Connection Source="Inspect.BusyOut" Destination="Busy" />
            <Connection Source="Inspect.HeldOut" Destination="HeldAll" />
            <Connection Source="Inspect.RunOut" Destination="RunAll" />
            <Connection Source="ControlCode" Destination="MoveDown.ControlCode" />
            <Connection Source="Cell" Destination="MoveDown.Cell" />
            <Connection Source="MoveDown.CallError" Destination="CallError_MoveDown" />
            <Connection Source="MoveDown.Drive" Destination="Drive_MoveDown" />
            <Connection Source="UnitRunning" Destination="MoveDown.UnitRunning" />
            <Connection Source="UnitQuiescent" Destination="MoveDown.UnitQuiescent" />
            <Connection Source="UnitState" Destination="MoveDown.UnitState" />
            <Connection Source="Mode" Destination="MoveDown.Mode" />
            <Connection Source="Owner" Destination="MoveDown.Owner" />
            <Connection Source="RemoteAllowed" Destination="MoveDown.RemoteAllowed" />
            <Connection Source="P1_MoveDown" Destination="MoveDown.P1" />
            <Connection Source="P2_MoveDown" Destination="MoveDown.P2" />
            <Connection Source="P3_MoveDown" Destination="MoveDown.P3" />
            <Connection Source="P4_MoveDown" Destination="MoveDown.P4" />
            <Connection Source="ControlCode" Destination="Dose.ControlCode" />
            <Connection Source="Cell" Destination="Dose.Cell" />
            <Connection Source="Dose.CallError" Destination="CallError_Dose" />
            <Connection Source="Dose.Drive" Destination="Drive_Dose" />
            <Connection Source="UnitRunning" Destination="Dose.UnitRunning" />
            <Connection Source="UnitQuiescent" Destination="Dose.UnitQuiescent" />
            <Connection Source="UnitState" Destination="Dose.UnitState" />
            <Connection Source="Mode" Destination="Dose.Mode" />
            <Connection Source="Owner" Destination="Dose.Owner" />
            <Connection Source="RemoteAllowed" Destination="Dose.RemoteAllowed" />
            <Connection Source="P1_Dose" Destination="Dose.P1" />
            <Connection Source="P2_Dose" Destination="Dose.P2" />
            <Connection Source="P3_Dose" Destination="Dose.P3" />
            <Connection Source="P4_Dose" Destination="Dose.P4" />
            <Connection Source="ControlCode" Destination="MoveUp.ControlCode" />
            <Connection Source="Cell" Destination="MoveUp.Cell" />
            <Connection Source="MoveUp.CallError" Destination="CallError_MoveUp" />
            <Connection Source="MoveUp.Drive" Destination="Drive_MoveUp" />
            <Connection Source="UnitRunning" Destination="MoveUp.UnitRunning" />
            <Connection Source="UnitQuiescent" Destination="MoveUp.UnitQuiescent" />
            <Connection Source="UnitState" Destination="MoveUp.UnitState" />
            <Connection Source="Mode" Destination="MoveUp.Mode" />
            <Connection Source="Owner" Destination="MoveUp.Owner" />
            <Connection Source="RemoteAllowed" Destination="MoveUp.RemoteAllowed" />
            <Connection Source="P1_MoveUp" Destination="MoveUp.P1" />
            <Connection Source="P2_MoveUp" Destination="MoveUp.P2" />
            <Connection Source="P3_MoveUp" Destination="MoveUp.P3" />
            <Connection Source="P4_MoveUp" Destination="MoveUp.P4" />
            <Connection Source="ControlCode" Destination="Stopper.ControlCode" />
            <Connection Source="Cell" Destination="Stopper.Cell" />
            <Connection Source="Stopper.CallError" Destination="CallError_Stopper" />
            <Connection Source="Stopper.Drive" Destination="Drive_Stopper" />
            <Connection Source="UnitRunning" Destination="Stopper.UnitRunning" />
            <Connection Source="UnitQuiescent" Destination="Stopper.UnitQuiescent" />
            <Connection Source="UnitState" Destination="Stopper.UnitState" />
            <Connection Source="Mode" Destination="Stopper.Mode" />
            <Connection Source="Owner" Destination="Stopper.Owner" />
            <Connection Source="RemoteAllowed" Destination="Stopper.RemoteAllowed" />
            <Connection Source="P1_Stopper" Destination="Stopper.P1" />
            <Connection Source="P2_Stopper" Destination="Stopper.P2" />
            <Connection Source="P3_Stopper" Destination="Stopper.P3" />
            <Connection Source="P4_Stopper" Destination="Stopper.P4" />
            <Connection Source="ControlCode" Destination="Inspect.ControlCode" />
            <Connection Source="Cell" Destination="Inspect.Cell" />
            <Connection Source="Inspect.CallError" Destination="CallError_Inspect" />
            <Connection Source="Inspect.Drive" Destination="Drive_Inspect" />
            <Connection Source="UnitRunning" Destination="Inspect.UnitRunning" />
            <Connection Source="UnitQuiescent" Destination="Inspect.UnitQuiescent" />
            <Connection Source="UnitState" Destination="Inspect.UnitState" />
            <Connection Source="Mode" Destination="Inspect.Mode" />
            <Connection Source="Owner" Destination="Inspect.Owner" />
            <Connection Source="RemoteAllowed" Destination="Inspect.RemoteAllowed" />
            <Connection Source="P1_Inspect" Destination="Inspect.P1" />
            <Connection Source="P2_Inspect" Destination="Inspect.P2" />
            <Connection Source="P3_Inspect" Destination="Inspect.P3" />
            <Connection Source="P4_Inspect" Destination="Inspect.P4" />
          </DataConnections>
        </SubAppNetwork>
      </SubApp>
      <SubApp Name="PROC" x="2600" y="1400" Comment="INTENTIONALLY EMPTY: generated procedure (P_* pattern instances) calls skills via CALL_*/DONE_*/FAILED_*">
        <InterfaceList>
          <EventInputs>
            <Event Name="START" Type="Event" />
            <Event Name="RESET" Type="Event" />
            <Event Name="CMD" Type="Event">
              <With Var="Command" />
            </Event>
            <Event Name="DONE_MoveDown" Type="Event" />
            <Event Name="DONE_Dose" Type="Event" />
            <Event Name="DONE_MoveUp" Type="Event" />
            <Event Name="DONE_Stopper" Type="Event" />
            <Event Name="DONE_Inspect" Type="Event" />
            <Event Name="FAILED_MoveDown" Type="Event">
              <With Var="CallError_MoveDown" />
            </Event>
            <Event Name="FAILED_Dose" Type="Event">
              <With Var="CallError_Dose" />
            </Event>
            <Event Name="FAILED_MoveUp" Type="Event">
              <With Var="CallError_MoveUp" />
            </Event>
            <Event Name="FAILED_Stopper" Type="Event">
              <With Var="CallError_Stopper" />
            </Event>
            <Event Name="FAILED_Inspect" Type="Event">
              <With Var="CallError_Inspect" />
            </Event>
          </EventInputs>
          <EventOutputs>
            <Event Name="FINISHED" Type="Event" />
            <Event Name="FAILED" Type="Event" />
            <Event Name="CALL_MoveDown" Type="Event">
              <With Var="P1_MoveDown" />
              <With Var="P2_MoveDown" />
              <With Var="P3_MoveDown" />
              <With Var="P4_MoveDown" />
            </Event>
            <Event Name="CALL_Dose" Type="Event">
              <With Var="P1_Dose" />
              <With Var="P2_Dose" />
              <With Var="P3_Dose" />
              <With Var="P4_Dose" />
            </Event>
            <Event Name="CALL_MoveUp" Type="Event">
              <With Var="P1_MoveUp" />
              <With Var="P2_MoveUp" />
              <With Var="P3_MoveUp" />
              <With Var="P4_MoveUp" />
            </Event>
            <Event Name="CALL_Stopper" Type="Event">
              <With Var="P1_Stopper" />
              <With Var="P2_Stopper" />
              <With Var="P3_Stopper" />
              <With Var="P4_Stopper" />
            </Event>
            <Event Name="CALL_Inspect" Type="Event">
              <With Var="P1_Inspect" />
              <With Var="P2_Inspect" />
              <With Var="P3_Inspect" />
              <With Var="P4_Inspect" />
            </Event>
          </EventOutputs>
          <InputVars>
            <VarDeclaration Name="Command" Type="USINT" />
            <VarDeclaration Name="CallError_MoveDown" Type="UINT" />
            <VarDeclaration Name="CallError_Dose" Type="UINT" />
            <VarDeclaration Name="CallError_MoveUp" Type="UINT" />
            <VarDeclaration Name="CallError_Stopper" Type="UINT" />
            <VarDeclaration Name="CallError_Inspect" Type="UINT" />
          </InputVars>
          <OutputVars>
            <VarDeclaration Name="P1_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P2_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P3_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P4_MoveDown" Type="LREAL" />
            <VarDeclaration Name="P1_Dose" Type="LREAL" />
            <VarDeclaration Name="P2_Dose" Type="LREAL" />
            <VarDeclaration Name="P3_Dose" Type="LREAL" />
            <VarDeclaration Name="P4_Dose" Type="LREAL" />
            <VarDeclaration Name="P1_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P2_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P3_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P4_MoveUp" Type="LREAL" />
            <VarDeclaration Name="P1_Stopper" Type="LREAL" />
            <VarDeclaration Name="P2_Stopper" Type="LREAL" />
            <VarDeclaration Name="P3_Stopper" Type="LREAL" />
            <VarDeclaration Name="P4_Stopper" Type="LREAL" />
            <VarDeclaration Name="P1_Inspect" Type="LREAL" />
            <VarDeclaration Name="P2_Inspect" Type="LREAL" />
            <VarDeclaration Name="P3_Inspect" Type="LREAL" />
            <VarDeclaration Name="P4_Inspect" Type="LREAL" />
          </OutputVars>
        </InterfaceList>
        <SubAppNetwork />
      </SubApp>
      <EventConnections>
        <Connection Source="Boot.COLD" Destination="Observer.INIT" />
        <Connection Source="Boot.WARM" Destination="Observer.INIT" />
        <Connection Source="Unit.CNF" Destination="EM_Filler.UNIT_STAT" />
        <Connection Source="Occupation.CNF" Destination="EM_Filler.UNIT_STAT" />
        <Connection Source="Unit.CONTROL" Destination="EM_Filler.UNIT_CTL" />
        <Connection Source="EM_Filler.STAT_OUT" Destination="Unit.STATUS" />
        <Connection Source="Observer.SAMPLE" Destination="EM_Filler.SAMPLE" />
        <Connection Source="Observer.UNSAFE" Destination="Unit.UNSAFE" />
        <Connection Source="Unit.PROC_CMD" Destination="Facade.CMD" />
        <Connection Source="Facade.EXEC" Destination="PROC.CMD" />
        <Connection Source="Facade.START" Destination="PROC.START" />
        <Connection Source="Facade.RESET" Destination="PROC.RESET" />
        <Connection Source="PROC.FINISHED" Destination="Facade.FINISHED" />
        <Connection Source="PROC.FAILED" Destination="Facade.FAILED" />
        <Connection Source="Facade.DONE" Destination="Unit.PROC_DONE" />
