        <Connection Source="EM_Filler.DONE_MoveDown" Destination="PROC.DONE_MoveDown" />
        <Connection Source="EM_Filler.FAILED_MoveDown" Destination="PROC.FAILED_MoveDown" />
        <Connection Source="PROC.CALL_Dose" Destination="EM_Filler.CALL_Dose" />
        <Connection Source="EM_Filler.DONE_Dose" Destination="PROC.DONE_Dose" />
        <Connection Source="EM_Filler.FAILED_Dose" Destination="PROC.FAILED_Dose" />
        <Connection Source="PROC.CALL_MoveUp" Destination="EM_Filler.CALL_MoveUp" />
        <Connection Source="EM_Filler.DONE_MoveUp" Destination="PROC.DONE_MoveUp" />
        <Connection Source="EM_Filler.FAILED_MoveUp" Destination="PROC.FAILED_MoveUp" />
        <Connection Source="PROC.CALL_Stopper" Destination="EM_Filler.CALL_Stopper" />
        <Connection Source="EM_Filler.DONE_Stopper" Destination="PROC.DONE_Stopper" />
        <Connection Source="EM_Filler.FAILED_Stopper" Destination="PROC.FAILED_Stopper" />
        <Connection Source="PROC.CALL_Inspect" Destination="EM_Filler.CALL_Inspect" />
        <Connection Source="EM_Filler.DONE_Inspect" Destination="PROC.DONE_Inspect" />
        <Connection Source="EM_Filler.FAILED_Inspect" Destination="PROC.FAILED_Inspect" />
        <Connection Source="Boot.COLD" Destination="Plant.INIT" />
        <Connection Source="Boot.WARM" Destination="Plant.INIT" />
        <Connection Source="Boot.COLD" Destination="PlantClock.START" />
        <Connection Source="Boot.WARM" Destination="PlantClock.START" />
        <Connection Source="PlantClock.EO" Destination="Plant.TICK" />
        <Connection Source="Plant.CNF" Destination="Observer.SIM" />
        <Connection Source="Observer.INITO" Destination="EM_Filler.INIT" />
        <Connection Source="EM_Filler.INITO" Destination="Facade.CONFIG" />
        <Connection Source="Facade.CNF" Destination="Operator.START" />
        <Connection Source="Operator.O_CMD" Destination="Occupation.CMD" />
        <Connection Source="Operator.U_CMD" Destination="Unit.CMD" />
        <Connection Source="Operator.NEW_VIAL" Destination="Plant.NEW_VIAL" />
        <Connection Source="Operator.WAIT" Destination="OpDelay.START" />
        <Connection Source="OpDelay.EO" Destination="Operator.TIMER" />
        <Connection Source="Unit.CNF" Destination="Operator.UNIT" />
        <Connection Source="Unit.CMD_REJ" Destination="Operator.REJ" />
      </EventConnections>
      <DataConnections>
        <Connection Source="Occupation.Owner" Destination="Unit.Owner" />
        <Connection Source="Occupation.RemoteAllowed" Destination="Unit.RemoteAllowed" />
        <Connection Source="Occupation.Owner" Destination="EM_Filler.Owner" />
        <Connection Source="Occupation.RemoteAllowed" Destination="EM_Filler.RemoteAllowed" />
        <Connection Source="Unit.Running" Destination="EM_Filler.UnitRunning" />
        <Connection Source="Unit.Quiescent" Destination="EM_Filler.UnitQuiescent" />
