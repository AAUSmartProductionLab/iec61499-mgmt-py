<?xml version='1.0' encoding='utf-8'?>
<FBType Name="UNIT_Facade" Comment="OPC UA object of the unit (composite skill): PackML unit commands, occupation commands, published unit/occupation state. Replaces the former FC_ControlPort">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaEnable" />
      </Event>
      <Event Name="U_ACK" Type="Event" />
      <Event Name="U_REJ" Type="Event">
        <With Var="U_Err" />
      </Event>
      <Event Name="O_ACK" Type="Event" />
      <Event Name="O_REJ" Type="Event">
        <With Var="O_Err" />
      </Event>
      <Event Name="PUB" Type="Event">
        <With Var="UnitState" />
        <With Var="UnitMode" />
        <With Var="OccState" />
        <With Var="Owner" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
