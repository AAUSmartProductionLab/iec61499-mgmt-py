    <OutputVars>
      <VarDeclaration Name="Requester" Type="UDINT" />
      <VarDeclaration Name="U_Code" Type="USINT" />
      <VarDeclaration Name="U_Mode" Type="USINT" />
      <VarDeclaration Name="O_Code" Type="USINT" />
    </OutputVars>
  </InterfaceList>
