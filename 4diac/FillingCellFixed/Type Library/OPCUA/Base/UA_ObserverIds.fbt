<?xml version='1.0' encoding='utf-8'?>
<FBType Name="UA_ObserverIds" Comment="OPC UA node IDs of the published state variables, below UaRoot">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdPub" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdPub" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <Algorithm Name="INIT">
      <ST Text="IdPub := CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(&quot;opc_ua[WRITE;&quot;, UaRoot), &quot;/State/NeedleUp;&quot;), UaRoot), &quot;/State/NeedleDown;&quot;), UaRoot), &quot;/State/VialPresent;&quot;), UaRoot), &quot;/State/FilledMl;&quot;), UaRoot), &quot;/State/Stoppered;&quot;), UaRoot), &quot;/State/Checked;&quot;), UaRoot), &quot;/State/DoorClosed;&quot;), UaRoot), &quot;/State/Valid;&quot;), UaRoot), &quot;/State/Safe]&quot;);" />
    </Algorithm>
  </SimpleFB>
</FBType>