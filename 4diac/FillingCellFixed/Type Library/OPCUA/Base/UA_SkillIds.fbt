<?xml version='1.0' encoding='utf-8'?>
<FBType Name="UA_SkillIds" Comment="OPC UA node IDs of one skill facade, below UaRoot">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="Id_Reset" />
        <With Var="Id_Start" />
        <With Var="Id_Hold" />
        <With Var="Id_Unhold" />
        <With Var="Id_Stop" />
        <With Var="Id_Abort" />
        <With Var="Id_Clear" />
        <With Var="IdPub" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Id_Reset" Type="WSTRING" />
      <VarDeclaration Name="Id_Start" Type="WSTRING" />
      <VarDeclaration Name="Id_Hold" Type="WSTRING" />
      <VarDeclaration Name="Id_Unhold" Type="WSTRING" />
      <VarDeclaration Name="Id_Stop" Type="WSTRING" />
      <VarDeclaration Name="Id_Abort" Type="WSTRING" />
      <VarDeclaration Name="Id_Clear" Type="WSTRING" />
      <VarDeclaration Name="IdPub" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <Algorithm Name="INIT">
      <ST Text="Id_Reset := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Reset]&quot;);&#10;Id_Start := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Start]&quot;);&#10;Id_Hold := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Hold]&quot;);&#10;Id_Unhold := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Unhold]&quot;);&#10;Id_Stop := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Stop]&quot;);&#10;Id_Abort := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Abort]&quot;);&#10;Id_Clear := CONCAT(CONCAT(&quot;opc_ua[CREATE_METHOD;&quot;, UaRoot), &quot;/Clear]&quot;);&#10;IdPub := CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(CONCAT(&quot;opc_ua[WRITE;&quot;, UaRoot), &quot;/State;&quot;), UaRoot), &quot;/ErrorID;&quot;), UaRoot), &quot;/P1;&quot;), UaRoot), &quot;/P2;&quot;), UaRoot), &quot;/P3;&quot;), UaRoot), &quot;/P4]&quot;);" />
    </Algorithm>
  </SimpleFB>
</FBType>