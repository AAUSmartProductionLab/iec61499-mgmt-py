<?xml version='1.0' encoding='utf-8'?>
<FBType Name="UA_SkillFacade" Comment="OPC UA object of one skill: one method per PackML command (answered synchronously with Accepted/ErrorID) and published State, ErrorID and latched parameters">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaEnable" />
      </Event>
      <Event Name="PUB" Type="Event">
        <With Var="State" />
        <With Var="ErrorID" />
        <With Var="P1" />
        <With Var="P2" />
        <With Var="P3" />
        <With Var="P4" />
      </Event>
      <Event Name="M_ACK" Type="Event" />
      <Event Name="M_REJ" Type="Event">
        <With Var="MErr" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="MCMD" Type="Event">
        <With Var="Requester" />
        <With Var="MCode" />
        <With Var="MP1" />
        <With Var="MP2" />
        <With Var="MP3" />
        <With Var="MP4" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
      <VarDeclaration Name="P1" Type="LREAL" />
      <VarDeclaration Name="P2" Type="LREAL" />
      <VarDeclaration Name="P3" Type="LREAL" />
      <VarDeclaration Name="P4" Type="LREAL" />
      <VarDeclaration Name="MErr" Type="UINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Requester" Type="UDINT" />
      <VarDeclaration Name="MCode" Type="USINT" />
      <VarDeclaration Name="MP1" Type="LREAL" />
      <VarDeclaration Name="MP2" Type="LREAL" />
      <VarDeclaration Name="MP3" Type="LREAL" />
      <VarDeclaration Name="MP4" Type="LREAL" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Ids" Type="fillingcell::UA_SkillIds" x="400" y="200" />
    <FB Name="Calls" Type="fillingcell::UA_SkillMux" x="3000" y="200" />
    <FB Name="Srv_Reset" Type="iec61499::net::SERVER_2_1" x="5600" y="200" />
    <FB Name="Srv_Start" Type="iec61499::net::SERVER_2_5" x="8200" y="200" />
    <FB Name="Srv_Hold" Type="iec61499::net::SERVER_2_1" x="400" y="2000" />
    <FB Name="Srv_Unhold" Type="iec61499::net::SERVER_2_1" x="3000" y="2000" />
    <FB Name="Srv_Stop" Type="iec61499::net::SERVER_2_1" x="5600" y="2000" />
    <FB Name="Srv_Abort" Type="iec61499::net::SERVER_2_1" x="8200" y="2000" />
    <FB Name="Srv_Clear" Type="iec61499::net::SERVER_2_1" x="400" y="3800" />
    <FB Name="Publisher" Type="iec61499::net::PUBLISH_6" x="3000" y="3800" />
    <EventConnections>
      <Connection Source="Srv_Reset.IND" Destination="Calls.IND_Reset" />
      <Connection Source="Calls.RSP_Reset" Destination="Srv_Reset.RSP" />
      <Connection Source="Srv_Start.IND" Destination="Calls.IND_Start" />
      <Connection Source="Calls.RSP_Start" Destination="Srv_Start.RSP" />
      <Connection Source="Srv_Hold.IND" Destination="Calls.IND_Hold" />
      <Connection Source="Calls.RSP_Hold" Destination="Srv_Hold.RSP" />
      <Connection Source="Srv_Unhold.IND" Destination="Calls.IND_Unhold" />
      <Connection Source="Calls.RSP_Unhold" Destination="Srv_Unhold.RSP" />
      <Connection Source="Srv_Stop.IND" Destination="Calls.IND_Stop" />
      <Connection Source="Calls.RSP_Stop" Destination="Srv_Stop.RSP" />
      <Connection Source="Srv_Abort.IND" Destination="Calls.IND_Abort" />
      <Connection Source="Calls.RSP_Abort" Destination="Srv_Abort.RSP" />
      <Connection Source="Srv_Clear.IND" Destination="Calls.IND_Clear" />
      <Connection Source="Calls.RSP_Clear" Destination="Srv_Clear.RSP" />
      <Connection Source="INIT" Destination="Ids.INIT" />
      <Connection Source="Ids.INITO" Destination="Srv_Reset.INIT" />
      <Connection Source="Srv_Reset.INITO" Destination="Srv_Start.INIT" />
      <Connection Source="Srv_Start.INITO" Destination="Srv_Hold.INIT" />
      <Connection Source="Srv_Hold.INITO" Destination="Srv_Unhold.INIT" />
      <Connection Source="Srv_Unhold.INITO" Destination="Srv_Stop.INIT" />
      <Connection Source="Srv_Stop.INITO" Destination="Srv_Abort.INIT" />
      <Connection Source="Srv_Abort.INITO" Destination="Srv_Clear.INIT" />
      <Connection Source="Srv_Clear.INITO" Destination="Publisher.INIT" />
      <Connection Source="Publisher.INITO" Destination="INITO" />
      <Connection Source="PUB" Destination="Publisher.REQ" />
      <Connection Source="Calls.S_CMD" Destination="MCMD" />
      <Connection Source="M_ACK" Destination="Calls.S_ACK" />
      <Connection Source="M_REJ" Destination="Calls.S_REJ" />
    </EventConnections>
    <DataConnections>
      <Connection Source="UaEnable" Destination="Srv_Reset.QI" />
      <Connection Source="Ids.Id_Reset" Destination="Srv_Reset.ID" />
      <Connection Source="Srv_Reset.RD_1" Destination="Calls.Req_Reset" />
      <Connection Source="Calls.Accepted" Destination="Srv_Reset.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Reset.SD_2" />
      <Connection Source="UaEnable" Destination="Srv_Start.QI" />
      <Connection Source="Ids.Id_Start" Destination="Srv_Start.ID" />
      <Connection Source="Srv_Start.RD_1" Destination="Calls.Req_Start" />
      <Connection Source="Srv_Start.RD_2" Destination="Calls.Start_P1" />
      <Connection Source="Srv_Start.RD_3" Destination="Calls.Start_P2" />
      <Connection Source="Srv_Start.RD_4" Destination="Calls.Start_P3" />
      <Connection Source="Srv_Start.RD_5" Destination="Calls.Start_P4" />
      <Connection Source="Calls.Accepted" Destination="Srv_Start.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Start.SD_2" />
      <Connection Source="UaEnable" Destination="Srv_Hold.QI" />
      <Connection Source="Ids.Id_Hold" Destination="Srv_Hold.ID" />
      <Connection Source="Srv_Hold.RD_1" Destination="Calls.Req_Hold" />
      <Connection Source="Calls.Accepted" Destination="Srv_Hold.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Hold.SD_2" />
      <Connection Source="UaEnable" Destination="Srv_Unhold.QI" />
      <Connection Source="Ids.Id_Unhold" Destination="Srv_Unhold.ID" />
      <Connection Source="Srv_Unhold.RD_1" Destination="Calls.Req_Unhold" />
      <Connection Source="Calls.Accepted" Destination="Srv_Unhold.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Unhold.SD_2" />
      <Connection Source="UaEnable" Destination="Srv_Stop.QI" />
      <Connection Source="Ids.Id_Stop" Destination="Srv_Stop.ID" />
      <Connection Source="Srv_Stop.RD_1" Destination="Calls.Req_Stop" />
      <Connection Source="Calls.Accepted" Destination="Srv_Stop.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Stop.SD_2" />
      <Connection Source="UaEnable" Destination="Srv_Abort.QI" />
      <Connection Source="Ids.Id_Abort" Destination="Srv_Abort.ID" />
      <Connection Source="Srv_Abort.RD_1" Destination="Calls.Req_Abort" />
      <Connection Source="Calls.Accepted" Destination="Srv_Abort.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Abort.SD_2" />
      <Connection Source="UaEnable" Destination="Srv_Clear.QI" />
      <Connection Source="Ids.Id_Clear" Destination="Srv_Clear.ID" />
      <Connection Source="Srv_Clear.RD_1" Destination="Calls.Req_Clear" />
      <Connection Source="Calls.Accepted" Destination="Srv_Clear.SD_1" />
      <Connection Source="Calls.ErrorID" Destination="Srv_Clear.SD_2" />
      <Connection Source="UaRoot" Destination="Ids.UaRoot" />
      <Connection Source="UaEnable" Destination="Publisher.QI" />
      <Connection Source="Ids.IdPub" Destination="Publisher.ID" />
      <Connection Source="State" Destination="Publisher.SD_1" />
      <Connection Source="ErrorID" Destination="Publisher.SD_2" />
      <Connection Source="P1" Destination="Publisher.SD_3" />
      <Connection Source="P2" Destination="Publisher.SD_4" />
      <Connection Source="P3" Destination="Publisher.SD_5" />
      <Connection Source="P4" Destination="Publisher.SD_6" />
      <Connection Source="MErr" Destination="Calls.S_Err" />
      <Connection Source="Calls.Requester" Destination="Requester" />
      <Connection Source="Calls.S_Code" Destination="MCode" />
      <Connection Source="Calls.S_P1" Destination="MP1" />
      <Connection Source="Calls.S_P2" Destination="MP2" />
      <Connection Source="Calls.S_P3" Destination="MP3" />
      <Connection Source="Calls.S_P4" Destination="MP4" />
    </DataConnections>
  </FBNetwork>
</FBType>