<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_Dose" Comment="Atomic skill Dose (parameters: P1 = VolumeMl [mL] 0.1..2.0); owns its actuator output; uniform skill interface: CALL/DONE/FAILED, unit control, cell sample, status chain, OPC UA facade">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="IoBackend" />
        <With Var="DoGpio" />
        <With Var="DoModbus" />
        <With Var="Timeout" />
      </Event>
      <Event Name="CALL" Type="Event">
        <With Var="P1" />
        <With Var="P2" />
        <With Var="P3" />
        <With Var="P4" />
      </Event>
      <Event Name="UNIT_CTL" Type="Event">
        <With Var="ControlCode" />
      </Event>
      <Event Name="UNIT_STAT" Type="Event">
        <With Var="UnitRunning" />
        <With Var="UnitQuiescent" />
        <With Var="UnitState" />
        <With Var="Mode" />
        <With Var="Owner" />
        <With Var="RemoteAllowed" />
      </Event>
      <Event Name="SAMPLE" Type="Event">
        <With Var="Cell" />
      </Event>
      <Event Name="STAT_IN" Type="Event">
        <With Var="BusyIn" />
        <With Var="HeldIn" />
        <With Var="RunIn" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="DONE" Type="Event" />
      <Event Name="FAILED" Type="Event">
        <With Var="CallError" />
      </Event>
      <Event Name="STAT_OUT" Type="Event">
        <With Var="BusyOut" />
        <With Var="HeldOut" />
        <With Var="RunOut" />
        <With Var="State" />
        <With Var="SkillError" />
        <With Var="Drive" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="IoBackend" Type="USINT" />
      <VarDeclaration Name="DoGpio" Type="STRING" />
      <VarDeclaration Name="DoModbus" Type="WSTRING" />
      <VarDeclaration Name="Timeout" Type="TIME" InitialValue="T#10s" />
      <VarDeclaration Name="P1" Type="LREAL" />
      <VarDeclaration Name="P2" Type="LREAL" />
      <VarDeclaration Name="P3" Type="LREAL" />
      <VarDeclaration Name="P4" Type="LREAL" />
      <VarDeclaration Name="ControlCode" Type="USINT" />
      <VarDeclaration Name="UnitRunning" Type="BOOL" />
      <VarDeclaration Name="UnitQuiescent" Type="BOOL" />
      <VarDeclaration Name="UnitState" Type="USINT" />
      <VarDeclaration Name="Mode" Type="USINT" />
      <VarDeclaration Name="Owner" Type="UDINT" />
      <VarDeclaration Name="RemoteAllowed" Type="BOOL" />
      <VarDeclaration Name="Cell" Type="fillingcell::ST_CellState" />
      <VarDeclaration Name="BusyIn" Type="BOOL" />
      <VarDeclaration Name="HeldIn" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration Name="RunIn" Type="BOOL" InitialValue="TRUE" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="CallError" Type="UINT" />
      <VarDeclaration Name="BusyOut" Type="BOOL" />
      <VarDeclaration Name="HeldOut" Type="BOOL" />
      <VarDeclaration Name="RunOut" Type="BOOL" />
      <VarDeclaration Name="State" Type="USINT" InitialValue="4" />
      <VarDeclaration Name="SkillError" Type="UINT" />
      <VarDeclaration Name="Drive" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Gate" Type="fillingcell::SKILL_Gate" x="400" y="200" />
    <FB Name="Pml" Type="fillingcell::SKILL_PackML" x="3000" y="200" />
    <FB Name="Logic" Type="fillingcell::SL_Dose" x="5600" y="200" />
    <FB Name="Wd" Type="iec61499::events::E_DELAY" x="8200" y="200" />
    <FB Name="Chain" Type="fillingcell::SKILL_Chain" x="400" y="2000" />
    <FB Name="Ua" Type="fillingcell::UA_SkillFacade" x="3000" y="2000" />
    <FB Name="Out" Type="fillingcell::IO_DO" x="5600" y="2000" />
    <EventConnections>
      <Connection Source="INIT" Destination="Ua.INIT" />
      <Connection Source="Ua.INITO" Destination="Out.INIT" />
      <Connection Source="Out.INITO" Destination="INITO" />
      <Connection Source="CALL" Destination="Gate.CALL" />
      <Connection Source="UNIT_CTL" Destination="Gate.UNIT_CTL" />
      <Connection Source="UNIT_STAT" Destination="Gate.UNIT_STAT" />
      <Connection Source="Ua.MCMD" Destination="Gate.MCMD" />
      <Connection Source="Gate.CMD" Destination="Pml.CMD" />
      <Connection Source="Gate.START" Destination="Logic.CHECK" />
      <Connection Source="Logic.CHECKED" Destination="Pml.CMD" />
      <Connection Source="Gate.DONE" Destination="DONE" />
      <Connection Source="Gate.FAILED" Destination="FAILED" />
      <Connection Source="Gate.M_ACK" Destination="Ua.M_ACK" />
      <Connection Source="Gate.M_REJ" Destination="Ua.M_REJ" />
      <Connection Source="SAMPLE" Destination="Logic.EVAL" />
      <Connection Source="Logic.COND" Destination="Pml.COND" />
      <Connection Source="Pml.LATCH" Destination="Logic.LATCH" />
      <Connection Source="Pml.REJECTED" Destination="Gate.REJ" />
      <Connection Source="Pml.WD_START" Destination="Wd.START" />
      <Connection Source="Pml.WD_STOP" Destination="Wd.STOP" />
      <Connection Source="Wd.EO" Destination="Pml.TIMEOUT" />
      <Connection Source="Pml.CNF" Destination="Gate.TRACK" />
      <Connection Source="Pml.CNF" Destination="Chain.REQ" />
      <Connection Source="Pml.CNF" Destination="Ua.PUB" />
      <Connection Source="Pml.CNF" Destination="Out.REQ" />
      <Connection Source="Logic.LATCHED" Destination="Ua.PUB" />
      <Connection Source="STAT_IN" Destination="Chain.REQ" />
      <Connection Source="Gate.POKE" Destination="Chain.REQ" />
      <Connection Source="Chain.CNF" Destination="STAT_OUT" />
    </EventConnections>
    <DataConnections>
      <Connection Source="UaRoot" Destination="Ua.UaRoot" />
      <Connection Source="UaEnable" Destination="Ua.UaEnable" />
      <Connection Source="IoBackend" Destination="Out.Backend" />
      <Connection Source="DoGpio" Destination="Out.GpioName" />
      <Connection Source="DoModbus" Destination="Out.ModbusId" />
      <Connection Source="Timeout" Destination="Wd.DT" />
      <Connection Source="P1" Destination="Gate.P1" />
      <Connection Source="P2" Destination="Gate.P2" />
      <Connection Source="P3" Destination="Gate.P3" />
      <Connection Source="P4" Destination="Gate.P4" />
      <Connection Source="ControlCode" Destination="Gate.ControlCode" />
      <Connection Source="UnitRunning" Destination="Gate.UnitRunning" />
      <Connection Source="UnitQuiescent" Destination="Gate.UnitQuiescent" />
      <Connection Source="UnitState" Destination="Gate.UnitState" />
      <Connection Source="Mode" Destination="Gate.Mode" />
      <Connection Source="Owner" Destination="Gate.Owner" />
      <Connection Source="RemoteAllowed" Destination="Gate.RemoteAllowed" />
      <Connection Source="Ua.Requester" Destination="Gate.Requester" />
      <Connection Source="Ua.MCode" Destination="Gate.MCode" />
      <Connection Source="Ua.MP1" Destination="Gate.MP1" />
      <Connection Source="Ua.MP2" Destination="Gate.MP2" />
      <Connection Source="Ua.MP3" Destination="Gate.MP3" />
      <Connection Source="Ua.MP4" Destination="Gate.MP4" />
      <Connection Source="Gate.Command" Destination="Pml.Command" />
      <Connection Source="Gate.PO1" Destination="Logic.P1" />
      <Connection Source="Gate.PO2" Destination="Logic.P2" />
      <Connection Source="Gate.PO3" Destination="Logic.P3" />
      <Connection Source="Gate.PO4" Destination="Logic.P4" />
      <Connection Source="Logic.RequiresOK" Destination="Pml.RequiresOK" />
      <Connection Source="Gate.CallError" Destination="CallError" />
      <Connection Source="Gate.MErr" Destination="Ua.MErr" />
      <Connection Source="Cell" Destination="Logic.Cell" />
      <Connection Source="Logic.EnsuresOK" Destination="Pml.EnsuresOK" />
      <Connection Source="Logic.InvariantOK" Destination="Pml.InvariantOK" />
      <Connection Source="Pml.State" Destination="Gate.State" />
      <Connection Source="Pml.State" Destination="Chain.State" />
      <Connection Source="Pml.State" Destination="Ua.State" />
      <Connection Source="Pml.State" Destination="State" />
      <Connection Source="Pml.ErrorID" Destination="Gate.SkillError" />
      <Connection Source="Pml.ErrorID" Destination="Ua.ErrorID" />
      <Connection Source="Pml.ErrorID" Destination="SkillError" />
      <Connection Source="Pml.Active" Destination="Out.OUT" />
      <Connection Source="Pml.Active" Destination="Drive" />
      <Connection Source="Logic.P1L" Destination="Ua.P1" />
      <Connection Source="Logic.P2L" Destination="Ua.P2" />
      <Connection Source="Logic.P3L" Destination="Ua.P3" />
      <Connection Source="Logic.P4L" Destination="Ua.P4" />
      <Connection Source="BusyIn" Destination="Chain.BusyIn" />
      <Connection Source="HeldIn" Destination="Chain.HeldIn" />
      <Connection Source="RunIn" Destination="Chain.RunIn" />
      <Connection Source="Chain.BusyOut" Destination="BusyOut" />
      <Connection Source="Chain.HeldOut" Destination="HeldOut" />
      <Connection Source="Chain.RunOut" Destination="RunOut" />
    </DataConnections>
  </FBNetwork>
</FBType>