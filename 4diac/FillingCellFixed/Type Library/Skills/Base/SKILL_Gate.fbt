<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SKILL_Gate" Comment="Command authority for one skill: procedure calls only while the unit runs; OPC UA commands only from the occupation owner outside Production; unit control always">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="CALL" Type="Event">
        <With Var="P1" />
        <With Var="P2" />
        <With Var="P3" />
        <With Var="P4" />
      </Event>
      <Event Name="UNIT_CTL" Type="Event">
        <With Var="ControlCode" />
      </Event>
      <Event Name="UNIT_STAT" Type="Event">
        <With Var="UnitRunning" />
        <With Var="UnitQuiescent" />
        <With Var="UnitState" />
        <With Var="Mode" />
        <With Var="Owner" />
        <With Var="RemoteAllowed" />
      </Event>
      <Event Name="MCMD" Type="Event">
        <With Var="Requester" />
        <With Var="MCode" />
        <With Var="MP1" />
        <With Var="MP2" />
        <With Var="MP3" />
        <With Var="MP4" />
      </Event>
      <Event Name="TRACK" Type="Event">
        <With Var="State" />
        <With Var="SkillError" />
      </Event>
      <Event Name="REJ" Type="Event">
        <With Var="SkillError" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CMD" Type="Event">
        <With Var="Command" />
      </Event>
      <Event Name="START" Type="Event">
        <With Var="Command" />
        <With Var="PO1" />
        <With Var="PO2" />
        <With Var="PO3" />
        <With Var="PO4" />
      </Event>
      <Event Name="DONE" Type="Event" />
      <Event Name="FAILED" Type="Event">
        <With Var="CallError" />
      </Event>
      <Event Name="M_ACK" Type="Event" />
      <Event Name="M_REJ" Type="Event">
        <With Var="MErr" />
      </Event>
      <Event Name="POKE" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="P1" Type="LREAL" />
      <VarDeclaration Name="P2" Type="LREAL" />
      <VarDeclaration Name="P3" Type="LREAL" />
      <VarDeclaration Name="P4" Type="LREAL" />
      <VarDeclaration Name="ControlCode" Type="USINT" />
      <VarDeclaration Name="UnitRunning" Type="BOOL" />
      <VarDeclaration Name="UnitQuiescent" Type="BOOL" />
      <VarDeclaration Name="UnitState" Type="USINT" />
      <VarDeclaration Name="Mode" Type="USINT" />
      <VarDeclaration Name="Owner" Type="UDINT" />
      <VarDeclaration Name="RemoteAllowed" Type="BOOL" />
      <VarDeclaration Name="Requester" Type="UDINT" />
      <VarDeclaration Name="MCode" Type="USINT" />
      <VarDeclaration Name="MP1" Type="LREAL" />
      <VarDeclaration Name="MP2" Type="LREAL" />
      <VarDeclaration Name="MP3" Type="LREAL" />
      <VarDeclaration Name="MP4" Type="LREAL" />
      <VarDeclaration Name="State" Type="USINT" InitialValue="4" />
      <VarDeclaration Name="SkillError" Type="UINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Command" Type="USINT" />
      <VarDeclaration Name="PO1" Type="LREAL" />
      <VarDeclaration Name="PO2" Type="LREAL" />
      <VarDeclaration Name="PO3" Type="LREAL" />
      <VarDeclaration Name="PO4" Type="LREAL" />
      <VarDeclaration Name="CallError" Type="UINT" />
      <VarDeclaration Name="MErr" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="CallPending" Type="BOOL" />
      <VarDeclaration Name="PendingStart" Type="BOOL" />
      <VarDeclaration Name="MPending" Type="BOOL" />
      <VarDeclaration Name="ManualOK" Type="BOOL" />
      <VarDeclaration Name="Valid" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Call" x="570" y="100">
        <ECAction Algorithm="Alg_Call" />
      </ECState>
      <ECState Name="CallFail" x="990" y="100">
        <ECAction Output="FAILED" />
      </ECState>
      <ECState Name="CallStart" x="1410" y="100">
        <ECAction Algorithm="Alg_CallStart" Output="START" />
      </ECState>
      <ECState Name="CallReset" x="150" y="330">
        <ECAction Algorithm="Alg_CallReset" Output="CMD" />
      </ECState>
      <ECState Name="CallNotReady" x="570" y="330">
        <ECAction Algorithm="Alg_CallNotReady" Output="FAILED" />
      </ECState>
      <ECState Name="Control" x="990" y="330">
        <ECAction Algorithm="Alg_Control" Output="CMD" />
        <ECAction Output="POKE" />
      </ECState>
      <ECState Name="Manual" x="1410" y="330">
        <ECAction Algorithm="Alg_Manual" />
      </ECState>
      <ECState Name="MReject" x="150" y="560">
        <ECAction Output="M_REJ" />
      </ECState>
      <ECState Name="MStart" x="570" y="560">
        <ECAction Algorithm="Alg_MStart" Output="START" />
      </ECState>
      <ECState Name="MForward" x="990" y="560">
        <ECAction Output="CMD" />
        <ECAction Output="M_ACK" />
      </ECState>
      <ECState Name="MStarted" x="1410" y="560">
        <ECAction Algorithm="Alg_MStarted" Output="M_ACK" />
      </ECState>
      <ECState Name="StartAfterReset" x="150" y="790">
        <ECAction Algorithm="Alg_StartAfterReset" Output="START" />
      </ECState>
      <ECState Name="CallDone" x="570" y="790">
        <ECAction Algorithm="Alg_CallDone" Output="DONE" />
      </ECState>
      <ECState Name="CallAborted" x="990" y="790">
        <ECAction Algorithm="Alg_CallAborted" Output="FAILED" />
      </ECState>
      <ECState Name="MStartRejected" x="1410" y="790">
        <ECAction Algorithm="Alg_MStartRejected" Output="M_REJ" />
      </ECState>
      <ECState Name="CallRejected" x="150" y="1020">
        <ECAction Algorithm="Alg_CallRejected" Output="FAILED" />
      </ECState>
      <ECTransition Source="START" Destination="Call" Condition="CALL" x="0" y="0" />
      <ECTransition Source="Call" Destination="CallFail" Condition="CallError &lt;&gt; 0" x="0" y="0" />
      <ECTransition Source="Call" Destination="CallStart" Condition="State = 4" x="0" y="0" />
      <ECTransition Source="Call" Destination="CallReset" Condition="(State = 17) OR (State = 2)" x="0" y="0" />
      <ECTransition Source="Call" Destination="CallNotReady" Condition="1" x="0" y="0" />
      <ECTransition Source="CallFail" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="CallStart" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="CallReset" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="CallNotReady" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Control" Condition="UNIT_CTL" x="0" y="0" />
      <ECTransition Source="Control" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Manual" Condition="MCMD" x="0" y="0" />
      <ECTransition Source="Manual" Destination="MReject" Condition="MErr &lt;&gt; 0" x="0" y="0" />
      <ECTransition Source="Manual" Destination="MStart" Condition="MCode = 2" x="0" y="0" />
      <ECTransition Source="Manual" Destination="MForward" Condition="1" x="0" y="0" />
      <ECTransition Source="MReject" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="MStart" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="MForward" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="MStarted" Condition="TRACK[MPending AND (State &lt;&gt; 4)]" x="0" y="0" />
      <ECTransition Source="START" Destination="StartAfterReset" Condition="TRACK[PendingStart AND (State = 4)]" x="0" y="0" />
      <ECTransition Source="START" Destination="CallDone" Condition="TRACK[CallPending AND (State = 17)]" x="0" y="0" />
      <ECTransition Source="START" Destination="CallAborted" Condition="TRACK[CallPending AND ((State = 9) OR ((State = 2) AND NOT PendingStart))]" x="0" y="0" />
      <ECTransition Source="START" Destination="MStartRejected" Condition="REJ[MPending]" x="0" y="0" />
      <ECTransition Source="START" Destination="CallRejected" Condition="REJ[CallPending]" x="0" y="0" />
      <ECTransition Source="MStarted" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="StartAfterReset" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="CallDone" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="CallAborted" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="MStartRejected" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="CallRejected" Destination="START" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Call">
      <ST Text="CallError := 0;&#10;IF NOT UnitRunning THEN CallError := 5;&#10;ELSIF CallPending OR MPending THEN CallError := 6;&#10;END_IF;&#10;PO1 := P1;&#10;PO2 := P2;&#10;PO3 := P3;&#10;PO4 := P4;" />
    </Algorithm>
    <Algorithm Name="Alg_CallStart">
      <ST Text="CallPending := TRUE;&#10;Command := 2;" />
    </Algorithm>
    <Algorithm Name="Alg_CallReset">
      <ST Text="CallPending := TRUE;&#10;PendingStart := TRUE;&#10;Command := 1;" />
    </Algorithm>
    <Algorithm Name="Alg_CallNotReady">
      <ST Text="CallError := 4;" />
    </Algorithm>
    <Algorithm Name="Alg_Control">
      <ST Text="Command := ControlCode;&#10;IF (ControlCode = 5) OR (ControlCode = 6) THEN PendingStart := FALSE; END_IF;" />
    </Algorithm>
    <Algorithm Name="Alg_Manual">
      <ST Text="MErr := 0;&#10;Valid := FALSE;&#10;CASE MCode OF&#10;1: Valid := (State = 4) OR (State = 17) OR (State = 2);&#10;2: Valid := State = 4;&#10;3: Valid := State = 6;&#10;4: Valid := State = 11;&#10;5: Valid := (State = 4) OR (State = 6) OR (State = 11) OR (State = 17);&#10;6: Valid := (State = 4) OR (State = 6) OR (State = 11) OR (State = 17) OR (State = 2);&#10;7: Valid := State = 9;&#10;END_CASE;&#10;ManualOK := RemoteAllowed AND (Requester = Owner) AND (Requester &lt;&gt; 0) AND (Mode &lt;&gt; 0) AND NOT CallPending AND NOT MPending;&#10;IF MCode = 2 THEN ManualOK := ManualOK AND UnitQuiescent AND (UnitState &lt;&gt; 9); END_IF;&#10;IF NOT ManualOK THEN MErr := 5;&#10;ELSIF NOT Valid THEN MErr := 4;&#10;END_IF;&#10;Command := MCode;&#10;PO1 := MP1;&#10;PO2 := MP2;&#10;PO3 := MP3;&#10;PO4 := MP4;" />
    </Algorithm>
    <Algorithm Name="Alg_MStart">
      <ST Text="MPending := TRUE;" />
    </Algorithm>
    <Algorithm Name="Alg_MStarted">
      <ST Text="MPending := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_StartAfterReset">
      <ST Text="PendingStart := FALSE;&#10;Command := 2;" />
    </Algorithm>
    <Algorithm Name="Alg_CallDone">
      <ST Text="CallPending := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_CallAborted">
      <ST Text="CallPending := FALSE;&#10;PendingStart := FALSE;&#10;CallError := SkillError;&#10;IF CallError = 0 THEN CallError := 7; END_IF;" />
    </Algorithm>
    <Algorithm Name="Alg_MStartRejected">
      <ST Text="MPending := FALSE;&#10;MErr := SkillError;" />
    </Algorithm>
    <Algorithm Name="Alg_CallRejected">
      <ST Text="CallPending := FALSE;&#10;CallError := SkillError;" />
    </Algorithm>
  </BasicFB>
</FBType>