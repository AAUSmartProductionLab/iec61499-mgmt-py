<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SKILL_PackML" Comment="Reduced PackML skill state machine shared by all skills; completion by Ensures, abort on Invariant violation or watchdog timeout">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="CMD" Type="Event">
        <With Var="Command" />
        <With Var="RequiresOK" />
      </Event>
      <Event Name="COND" Type="Event">
        <With Var="EnsuresOK" />
        <With Var="InvariantOK" />
      </Event>
      <Event Name="TIMEOUT" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="State" />
        <With Var="ErrorID" />
        <With Var="Active" />
      </Event>
      <Event Name="LATCH" Type="Event" />
      <Event Name="REJECTED" Type="Event">
        <With Var="ErrorID" />
      </Event>
      <Event Name="WD_START" Type="Event" />
      <Event Name="WD_STOP" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Command" Type="USINT" />
      <VarDeclaration Name="RequiresOK" Type="BOOL" />
      <VarDeclaration Name="EnsuresOK" Type="BOOL" />
      <VarDeclaration Name="InvariantOK" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" InitialValue="4" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
      <VarDeclaration Name="Active" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="Idle" x="150" y="100">
        <ECAction Algorithm="Alg_Idle" Output="CNF" />
      </ECState>
      <ECState Name="Starting" x="570" y="100">
        <ECAction Algorithm="Alg_Starting" Output="LATCH" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="Execute" x="990" y="100">
        <ECAction Algorithm="Alg_Execute" Output="CNF" />
        <ECAction Output="WD_START" />
      </ECState>
      <ECState Name="Completing" x="1410" y="100">
        <ECAction Algorithm="Alg_Completing" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Complete" x="150" y="330">
        <ECAction Algorithm="Alg_Complete" Output="CNF" />
      </ECState>
      <ECState Name="Resetting" x="570" y="330">
        <ECAction Algorithm="Alg_Resetting" Output="CNF" />
      </ECState>
      <ECState Name="Holding" x="990" y="330">
        <ECAction Algorithm="Alg_Holding" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Held" x="1410" y="330">
        <ECAction Algorithm="Alg_Held" Output="CNF" />
      </ECState>
      <ECState Name="Unholding" x="150" y="560">
        <ECAction Algorithm="Alg_Unholding" Output="CNF" />
      </ECState>
      <ECState Name="Stopping" x="570" y="560">
        <ECAction Algorithm="Alg_Stopping" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Stopped" x="990" y="560">
        <ECAction Algorithm="Alg_Stopped" Output="CNF" />
      </ECState>
      <ECState Name="Aborting" x="1410" y="560">
        <ECAction Algorithm="Alg_Aborting" Output="CNF" />
        <ECAction Output="WD_STOP" />
      </ECState>
      <ECState Name="Aborted" x="150" y="790">
        <ECAction Algorithm="Alg_Aborted" Output="CNF" />
      </ECState>
      <ECState Name="Clearing" x="570" y="790">
        <ECAction Algorithm="Alg_Clearing" Output="CNF" />
      </ECState>
      <ECState Name="Rejected" x="990" y="790">
        <ECAction Algorithm="Alg_Rejected" Output="REJECTED" />
      </ECState>
      <ECState Name="Unsafe" x="1410" y="790">
        <ECAction Algorithm="Alg_Unsafe" />
      </ECState>
      <ECState Name="Timeout" x="150" y="1020">
        <ECAction Algorithm="Alg_Timeout" />
      </ECState>
      <ECTransition Source="Idle" Destination="Starting" Condition="CMD[(Command = 2) AND RequiresOK]" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Rejected" Condition="CMD[Command = 2]" x="0" y="0" />
      <ECTransition Source="Rejected" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Starting" Destination="Execute" Condition="1" x="0" y="0" />
      <ECTransition Source="Execute" Destination="Unsafe" Condition="COND[NOT InvariantOK]" x="0" y="0" />
      <ECTransition Source="Execute" Destination="Completing" Condition="COND[EnsuresOK]" x="0" y="0" />
      <ECTransition Source="Execute" Destination="Timeout" Condition="TIMEOUT" x="0" y="0" />
      <ECTransition Source="Unsafe" Destination="Aborting" Condition="1" x="0" y="0" />
      <ECTransition Source="Timeout" Destination="Aborting" Condition="1" x="0" y="0" />
      <ECTransition Source="Execute" Destination="Holding" Condition="CMD[Command = 3]" x="0" y="0" />
      <ECTransition Source="Holding" Destination="Held" Condition="1" x="0" y="0" />
      <ECTransition Source="Held" Destination="Unholding" Condition="CMD[(Command = 4) AND InvariantOK]" x="0" y="0" />
      <ECTransition Source="Held" Destination="Unsafe" Condition="COND[NOT InvariantOK]" x="0" y="0" />
      <ECTransition Source="Unholding" Destination="Execute" Condition="1" x="0" y="0" />
      <ECTransition Source="Completing" Destination="Complete" Condition="1" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Resetting" Condition="CMD[Command = 1]" x="0" y="0" />
      <ECTransition Source="Complete" Destination="Resetting" Condition="CMD[Command = 1]" x="0" y="0" />
      <ECTransition Source="Stopped" Destination="Resetting" Condition="CMD[Command = 1]" x="0" y="0" />
      <ECTransition Source="Resetting" Destination="Idle" Condition="1" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Aborting" Condition="CMD[Command = 6]" x="0" y="0" />
      <ECTransition Source="Idle" Destination="Stopping" Condition="CMD[Command = 5]" x="0" y="0" />
      <ECTransition Source="Execute" Destination="Aborting" Condition="CMD[Command = 6]" x="0" y="0" />
      <ECTransition Source="Execute" Destination="Stopping" Condition="CMD[Command = 5]" x="0" y="0" />
      <ECTransition Source="Held" Destination="Aborting" Condition="CMD[Command = 6]" x="0" y="0" />
      <ECTransition Source="Held" Destination="Stopping" Condition="CMD[Command = 5]" x="0" y="0" />
      <ECTransition Source="Complete" Destination="Aborting" Condition="CMD[Command = 6]" x="0" y="0" />
      <ECTransition Source="Complete" Destination="Stopping" Condition="CMD[Command = 5]" x="0" y="0" />
      <ECTransition Source="Stopped" Destination="Aborting" Condition="CMD[Command = 6]" x="0" y="0" />
      <ECTransition Source="Stopping" Destination="Stopped" Condition="1" x="0" y="0" />
      <ECTransition Source="Aborting" Destination="Aborted" Condition="1" x="0" y="0" />
      <ECTransition Source="Aborted" Destination="Clearing" Condition="CMD[Command = 7]" x="0" y="0" />
      <ECTransition Source="Clearing" Destination="Stopped" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Idle">
      <ST Text="State := 4;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Starting">
      <ST Text="State := 3;&#10;Active := FALSE;&#10;ErrorID := 0;" />
    </Algorithm>
    <Algorithm Name="Alg_Execute">
      <ST Text="State := 6;&#10;Active := TRUE;" />
    </Algorithm>
    <Algorithm Name="Alg_Completing">
      <ST Text="State := 16;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Complete">
      <ST Text="State := 17;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Resetting">
      <ST Text="State := 15;&#10;Active := FALSE;&#10;ErrorID := 0;" />
    </Algorithm>
    <Algorithm Name="Alg_Holding">
      <ST Text="State := 10;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Held">
      <ST Text="State := 11;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Unholding">
      <ST Text="State := 12;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Stopping">
      <ST Text="State := 7;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Stopped">
      <ST Text="State := 2;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Aborting">
      <ST Text="State := 8;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Aborted">
      <ST Text="State := 9;&#10;Active := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Clearing">
      <ST Text="State := 1;&#10;Active := FALSE;&#10;ErrorID := 0;" />
    </Algorithm>
    <Algorithm Name="Alg_Rejected">
      <ST Text="ErrorID := 1;" />
    </Algorithm>
    <Algorithm Name="Alg_Unsafe">
      <ST Text="ErrorID := 2;" />
    </Algorithm>
    <Algorithm Name="Alg_Timeout">
      <ST Text="ErrorID := 3;" />
    </Algorithm>
  </BasicFB>
</FBType>