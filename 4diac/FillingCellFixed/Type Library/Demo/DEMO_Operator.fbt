<?xml version='1.0' encoding='utf-8'?>
<FBType Name="DEMO_Operator" Comment="Automatic operator for demos: occupy, reset in Production, start, wait for Complete, new vial, pause, repeat while Enable; clears the unit after an abort">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="START" Type="Event">
        <With Var="Enable" />
        <With Var="Pause" />
      </Event>
      <Event Name="UNIT" Type="Event">
        <With Var="UnitState" />
      </Event>
      <Event Name="REJ" Type="Event" />
      <Event Name="TIMER" Type="Event">
        <With Var="Enable" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="O_CMD" Type="Event">
        <With Var="Requester" />
        <With Var="O_Code" />
      </Event>
      <Event Name="U_CMD" Type="Event">
        <With Var="Requester" />
        <With Var="U_Code" />
        <With Var="U_Mode" />
      </Event>
      <Event Name="NEW_VIAL" Type="Event" />
      <Event Name="WAIT" Type="Event">
        <With Var="Delay" />
      </Event>
      <Event Name="CNF" Type="Event">
        <With Var="Phase" />
        <With Var="Cycles" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UnitState" Type="USINT" />
      <VarDeclaration Name="Enable" Type="BOOL" InitialValue="TRUE" />
      <VarDeclaration Name="Pause" Type="TIME" InitialValue="T#2s" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Requester" Type="UDINT" InitialValue="1" />
      <VarDeclaration Name="O_Code" Type="USINT" />
      <VarDeclaration Name="U_Code" Type="USINT" />
      <VarDeclaration Name="U_Mode" Type="USINT" />
      <VarDeclaration Name="Delay" Type="TIME" />
      <VarDeclaration Name="Phase" Type="USINT" />
      <VarDeclaration Name="Cycles" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="Off" x="150" y="100">
        <ECAction Algorithm="Alg_Off" Output="CNF" />
      </ECState>
      <ECState Name="Begin" x="570" y="100">
        <ECAction Algorithm="Alg_Begin" Output="WAIT" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="Settle" x="990" y="100" />
      <ECState Name="Occupy" x="1410" y="100">
        <ECAction Algorithm="Alg_Occupy" Output="O_CMD" />
      </ECState>
      <ECState Name="Reset" x="150" y="330">
        <ECAction Algorithm="Alg_Reset" Output="U_CMD" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="WaitIdle" x="570" y="330" />
      <ECState Name="Start" x="990" y="330">
        <ECAction Algorithm="Alg_Start" Output="U_CMD" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="WaitDone" x="1410" y="330" />
      <ECState Name="Done" x="150" y="560">
        <ECAction Algorithm="Alg_Done" Output="NEW_VIAL" />
        <ECAction Output="WAIT" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="Rest" x="570" y="560" />
      <ECState Name="Clear" x="990" y="560">
        <ECAction Algorithm="Alg_Clear" Output="U_CMD" />
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="WaitStopped" x="1410" y="560" />
      <ECState Name="Retry" x="150" y="790">
        <ECAction Algorithm="Alg_Retry" Output="WAIT" />
      </ECState>
      <ECTransition Source="Off" Destination="Begin" Condition="START" x="0" y="0" />
      <ECTransition Source="Begin" Destination="Settle" Condition="1" x="0" y="0" />
      <ECTransition Source="Settle" Destination="Occupy" Condition="TIMER" x="0" y="0" />
      <ECTransition Source="Occupy" Destination="Reset" Condition="1" x="0" y="0" />
      <ECTransition Source="Reset" Destination="WaitIdle" Condition="1" x="0" y="0" />
      <ECTransition Source="WaitIdle" Destination="Start" Condition="UNIT[UnitState = 4]" x="0" y="0" />
      <ECTransition Source="WaitIdle" Destination="Clear" Condition="UNIT[UnitState = 9]" x="0" y="0" />
      <ECTransition Source="WaitIdle" Destination="Retry" Condition="REJ" x="0" y="0" />
      <ECTransition Source="Start" Destination="WaitDone" Condition="1" x="0" y="0" />
      <ECTransition Source="WaitDone" Destination="Done" Condition="UNIT[UnitState = 17]" x="0" y="0" />
      <ECTransition Source="WaitDone" Destination="Clear" Condition="UNIT[UnitState = 9]" x="0" y="0" />
      <ECTransition Source="WaitDone" Destination="Retry" Condition="REJ" x="0" y="0" />
      <ECTransition Source="Done" Destination="Rest" Condition="1" x="0" y="0" />
      <ECTransition Source="Rest" Destination="Reset" Condition="TIMER[Enable]" x="0" y="0" />
      <ECTransition Source="Rest" Destination="Off" Condition="TIMER" x="0" y="0" />
      <ECTransition Source="Clear" Destination="WaitStopped" Condition="1" x="0" y="0" />
      <ECTransition Source="WaitStopped" Destination="Reset" Condition="UNIT[UnitState = 2]" x="0" y="0" />
      <ECTransition Source="WaitStopped" Destination="Retry" Condition="REJ" x="0" y="0" />
      <ECTransition Source="Retry" Destination="Settle" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Off">
      <ST Text="Phase := 0;" />
    </Algorithm>
    <Algorithm Name="Alg_Begin">
      <ST Text="Phase := 1;&#10;Delay := T#1s;" />
    </Algorithm>
    <Algorithm Name="Alg_Occupy">
      <ST Text="O_Code := 1;" />
    </Algorithm>
    <Algorithm Name="Alg_Reset">
      <ST Text="U_Code := 1;&#10;U_Mode := 0;&#10;Phase := 2;" />
    </Algorithm>
    <Algorithm Name="Alg_Start">
      <ST Text="U_Code := 2;&#10;Phase := 3;" />
    </Algorithm>
    <Algorithm Name="Alg_Done">
      <ST Text="Cycles := Cycles + 1;&#10;Delay := Pause;&#10;Phase := 4;" />
    </Algorithm>
    <Algorithm Name="Alg_Clear">
      <ST Text="U_Code := 7;&#10;Phase := 5;" />
    </Algorithm>
    <Algorithm Name="Alg_Retry">
      <ST Text="Delay := T#1s;" />
    </Algorithm>
  </BasicFB>
</FBType>