<?xml version='1.0' encoding='utf-8'?>
<FBType Name="P_Join" Comment="Parallel gateway join: EO once the first N branch inputs have all arrived">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="EI1" Type="Event">
        <With Var="N" />
      </Event>
      <Event Name="EI2" Type="Event">
        <With Var="N" />
      </Event>
      <Event Name="EI3" Type="Event">
        <With Var="N" />
      </Event>
      <Event Name="EI4" Type="Event">
        <With Var="N" />
      </Event>
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="EO" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="N" Type="USINT" InitialValue="2" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="A1" Type="BOOL" />
      <VarDeclaration Name="A2" Type="BOOL" />
      <VarDeclaration Name="A3" Type="BOOL" />
      <VarDeclaration Name="A4" Type="BOOL" />
      <VarDeclaration Name="Arrived" Type="USINT" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Check" x="570" y="100">
        <ECAction Algorithm="Alg_Check" />
      </ECState>
      <ECState Name="Out" x="990" y="100">
        <ECAction Algorithm="Alg_Out" Output="EO" />
      </ECState>
      <ECState Name="Reset" x="1410" y="100">
        <ECAction Algorithm="Alg_Reset" />
      </ECState>
      <ECState Name="Mark1" x="150" y="330">
        <ECAction Algorithm="Alg_Mark1" />
      </ECState>
      <ECState Name="Mark2" x="570" y="330">
        <ECAction Algorithm="Alg_Mark2" />
      </ECState>
      <ECState Name="Mark3" x="990" y="330">
        <ECAction Algorithm="Alg_Mark3" />
      </ECState>
      <ECState Name="Mark4" x="1410" y="330">
        <ECAction Algorithm="Alg_Mark4" />
      </ECState>
      <ECTransition Source="START" Destination="Mark1" Condition="EI1" x="0" y="0" />
      <ECTransition Source="Mark1" Destination="Check" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Mark2" Condition="EI2" x="0" y="0" />
      <ECTransition Source="Mark2" Destination="Check" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Mark3" Condition="EI3" x="0" y="0" />
      <ECTransition Source="Mark3" Destination="Check" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Mark4" Condition="EI4" x="0" y="0" />
      <ECTransition Source="Mark4" Destination="Check" Condition="1" x="0" y="0" />
      <ECTransition Source="Check" Destination="Out" Condition="Arrived &gt;= N" x="0" y="0" />
      <ECTransition Source="Check" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Out" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Reset" Condition="RESET" x="0" y="0" />
      <ECTransition Source="Reset" Destination="START" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Check">
      <ST Text="Arrived := 0;&#10;IF A1 THEN Arrived := Arrived + 1; END_IF;&#10;IF A2 THEN Arrived := Arrived + 1; END_IF;&#10;IF A3 THEN Arrived := Arrived + 1; END_IF;&#10;IF A4 THEN Arrived := Arrived + 1; END_IF;" />
    </Algorithm>
    <Algorithm Name="Alg_Out">
      <ST Text="A1 := FALSE;&#10;A2 := FALSE;&#10;A3 := FALSE;&#10;A4 := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Reset">
      <ST Text="A1 := FALSE;&#10;A2 := FALSE;&#10;A3 := FALSE;&#10;A4 := FALSE;" />
    </Algorithm>
    <Algorithm Name="Alg_Mark1">
      <ST Text="A1 := TRUE;" />
    </Algorithm>
    <Algorithm Name="Alg_Mark2">
      <ST Text="A2 := TRUE;" />
    </Algorithm>
    <Algorithm Name="Alg_Mark3">
      <ST Text="A3 := TRUE;" />
    </Algorithm>
    <Algorithm Name="Alg_Mark4">
      <ST Text="A4 := TRUE;" />
    </Algorithm>
  </BasicFB>
</FBType>