<?xml version='1.0' encoding='utf-8'?>
<FBType Name="P_Wait" Comment="Timer event: EO after DT; RESET cancels">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="EI" Type="Event">
        <With Var="DT" />
      </Event>
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="EO" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="DT" Type="TIME" InitialValue="T#1s" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <FB Name="Delay" Type="iec61499::events::E_DELAY" x="400" y="200" />
    <EventConnections>
      <Connection Source="EI" Destination="Delay.START" />
      <Connection Source="RESET" Destination="Delay.STOP" />
      <Connection Source="Delay.EO" Destination="EO" />
    </EventConnections>
    <DataConnections>
      <Connection Source="DT" Destination="Delay.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>