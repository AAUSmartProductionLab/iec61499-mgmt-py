<?xml version='1.0' encoding='utf-8'?>
<FBType Name="P_Loop" Comment="Runs its body Count times (0 skips it): BODY starts an iteration, NEXT reports its end">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="EI" Type="Event">
        <With Var="Count" />
      </Event>
      <Event Name="NEXT" Type="Event" />
      <Event Name="RESET" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="BODY" Type="Event">
        <With Var="Iteration" />
      </Event>
      <Event Name="EO" Type="Event">
        <With Var="Iteration" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Count" Type="UINT" InitialValue="1" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Iteration" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Init" x="570" y="100">
        <ECAction Algorithm="Alg_Init" />
      </ECState>
      <ECState Name="Check" x="990" y="100" />
      <ECState Name="Body" x="1410" y="100">
        <ECAction Algorithm="Alg_Body" Output="BODY" />
      </ECState>
      <ECState Name="Leave" x="150" y="330">
        <ECAction Output="EO" />
      </ECState>
      <ECState Name="Reset" x="570" y="330">
        <ECAction Algorithm="Alg_Reset" />
      </ECState>
      <ECTransition Source="START" Destination="Init" Condition="EI" x="0" y="0" />
      <ECTransition Source="START" Destination="Check" Condition="NEXT" x="0" y="0" />
      <ECTransition Source="START" Destination="Reset" Condition="RESET" x="0" y="0" />
      <ECTransition Source="Init" Destination="Check" Condition="1" x="0" y="0" />
      <ECTransition Source="Check" Destination="Body" Condition="Iteration &lt; Count" x="0" y="0" />
      <ECTransition Source="Check" Destination="Leave" Condition="1" x="0" y="0" />
      <ECTransition Source="Body" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Leave" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Reset" Destination="START" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST Text="Iteration := 0;" />
    </Algorithm>
    <Algorithm Name="Alg_Body">
      <ST Text="Iteration := Iteration + 1;" />
    </Algorithm>
    <Algorithm Name="Alg_Reset">
      <ST Text="Iteration := 0;" />
    </Algorithm>
  </BasicFB>
</FBType>