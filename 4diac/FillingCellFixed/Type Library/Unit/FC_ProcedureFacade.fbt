<?xml version='1.0' encoding='utf-8'?>
<FBType Name="FC_ProcedureFacade" Comment="Fixed procedure boundary; unavailable until composition is installed; never invents completion">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="CONFIG" Type="Event">
        <With Var="Installed" />
        <With Var="Quiescent" />
      </Event>
      <Event Name="CMD" Type="Event">
        <With Var="Command" />
      </Event>
      <Event Name="FINISHED" Type="Event" />
      <Event Name="FAILED" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="Ready" />
      </Event>
      <Event Name="START" Type="Event" />
      <Event Name="RESET" Type="Event" />
      <Event Name="EXEC" Type="Event">
        <With Var="CommandOut" />
      </Event>
      <Event Name="DONE" Type="Event" />
      <Event Name="FAULT" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Installed" Type="BOOL" />
      <VarDeclaration Name="Quiescent" Type="BOOL" />
      <VarDeclaration Name="Command" Type="USINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Ready" Type="BOOL" />
      <VarDeclaration Name="CommandOut" Type="USINT" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Configure" x="570" y="100">
        <ECAction Algorithm="Alg_Configure" Output="CNF" />
      </ECState>
      <ECState Name="Forward" x="990" y="100">
        <ECAction Algorithm="Alg_Forward" />
      </ECState>
      <ECState Name="Start" x="1410" y="100">
        <ECAction Output="START" />
      </ECState>
      <ECState Name="Reset" x="150" y="330">
        <ECAction Output="RESET" />
      </ECState>
      <ECState Name="Exec" x="570" y="330">
        <ECAction Output="EXEC" />
      </ECState>
      <ECState Name="Done" x="990" y="330">
        <ECAction Output="DONE" />
      </ECState>
      <ECState Name="Fault" x="1410" y="330">
        <ECAction Output="FAULT" />
      </ECState>
      <ECTransition Source="Forward" Destination="Start" Condition="Command = 2" x="0" y="0" />
      <ECTransition Source="Forward" Destination="Reset" Condition="Command = 1" x="0" y="0" />
      <ECTransition Source="Forward" Destination="Exec" Condition="1" x="0" y="0" />
      <ECTransition Source="Start" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Reset" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Exec" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Configure" Condition="CONFIG[Quiescent]" x="0" y="0" />
      <ECTransition Source="Configure" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Forward" Condition="CMD" x="0" y="0" />
      <ECTransition Source="START" Destination="Done" Condition="FINISHED" x="0" y="0" />
      <ECTransition Source="Done" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="START" Destination="Fault" Condition="FAILED" x="0" y="0" />
      <ECTransition Source="Fault" Destination="START" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Configure">
      <ST Text="Ready := Installed;" />
    </Algorithm>
    <Algorithm Name="Alg_Forward">
      <ST Text="CommandOut := Command;" />
    </Algorithm>
  </BasicFB>
</FBType>