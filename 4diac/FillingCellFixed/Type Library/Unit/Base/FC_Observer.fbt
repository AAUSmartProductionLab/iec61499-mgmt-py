<?xml version='1.0' encoding='utf-8'?>
<FBType Name="FC_Observer" Comment="State observer: one coherent Cell snapshot; invalid or unsafe states inhibit skills">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Filling cell reference model" Version="2.0" Author="Project contributors" Date="2026-09-27" />
  <CompilerInfo packageName="fillingcell" />
  <InterfaceList>
    <EventInputs>
      <Event Name="SAMPLE" Type="Event">
        <With Var="NeedleUp" />
        <With Var="NeedleDown" />
        <With Var="VialPresent" />
        <With Var="FilledMl" />
        <With Var="Stoppered" />
        <With Var="Checked" />
        <With Var="DoorClosed" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="Cell" />
        <With Var="Safe" />
        <With Var="O_NeedleUp" />
        <With Var="O_NeedleDown" />
        <With Var="O_VialPresent" />
        <With Var="O_FilledMl" />
        <With Var="O_Stoppered" />
        <With Var="O_Checked" />
        <With Var="O_DoorClosed" />
        <With Var="O_Valid" />
        <With Var="O_Safe" />
      </Event>
      <Event Name="UNSAFE" Type="Event">
        <With Var="Safe" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="NeedleUp" Type="BOOL" />
      <VarDeclaration Name="NeedleDown" Type="BOOL" />
      <VarDeclaration Name="VialPresent" Type="BOOL" />
      <VarDeclaration Name="FilledMl" Type="LREAL" />
      <VarDeclaration Name="Stoppered" Type="BOOL" />
      <VarDeclaration Name="Checked" Type="BOOL" />
      <VarDeclaration Name="DoorClosed" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Cell" Type="fillingcell::ST_CellState" />
      <VarDeclaration Name="Safe" Type="BOOL" />
      <VarDeclaration Name="O_NeedleUp" Type="BOOL" />
      <VarDeclaration Name="O_NeedleDown" Type="BOOL" />
      <VarDeclaration Name="O_VialPresent" Type="BOOL" />
      <VarDeclaration Name="O_FilledMl" Type="LREAL" />
      <VarDeclaration Name="O_Stoppered" Type="BOOL" />
      <VarDeclaration Name="O_Checked" Type="BOOL" />
      <VarDeclaration Name="O_DoorClosed" Type="BOOL" />
      <VarDeclaration Name="O_Valid" Type="BOOL" />
      <VarDeclaration Name="O_Safe" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="START" x="150" y="100" />
      <ECState Name="Observe" x="570" y="100">
        <ECAction Algorithm="Alg_Observe" Output="CNF" />
      </ECState>
      <ECState Name="Unsafe" x="990" y="100">
        <ECAction Output="UNSAFE" />
      </ECState>
      <ECTransition Source="START" Destination="Observe" Condition="SAMPLE" x="0" y="0" />
      <ECTransition Source="Observe" Destination="Unsafe" Condition="NOT O_Safe" x="0" y="0" />
      <ECTransition Source="Observe" Destination="START" Condition="1" x="0" y="0" />
      <ECTransition Source="Unsafe" Destination="START" Condition="1" x="0" y="0" />
    </ECC>
    <Algorithm Name="Alg_Observe">
      <ST Text="O_NeedleUp := NeedleUp;&#10;O_NeedleDown := NeedleDown;&#10;O_VialPresent := VialPresent;&#10;O_FilledMl := FilledMl;&#10;O_Stoppered := Stoppered;&#10;O_Checked := Checked;&#10;O_DoorClosed := DoorClosed;&#10;O_Valid := (FilledMl &gt;= 0.0) AND NOT (NeedleUp AND NeedleDown);&#10;O_Safe := O_Valid AND DoorClosed;&#10;Cell.NeedleUp := O_NeedleUp;&#10;Cell.NeedleDown := O_NeedleDown;&#10;Cell.VialPresent := O_VialPresent;&#10;Cell.FilledMl := O_FilledMl;&#10;Cell.Stoppered := O_Stoppered;&#10;Cell.Checked := O_Checked;&#10;Cell.DoorClosed := O_DoorClosed;&#10;Cell.Valid := O_Valid;&#10;Cell.Safe := O_Safe;&#10;Safe := O_Safe;" />
    </Algorithm>
  </BasicFB>
</FBType>