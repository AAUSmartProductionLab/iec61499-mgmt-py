<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SP_Weigh" Comment="Weigh parameters (none): OPC UA IDs, range check and latching">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="UaRoot" />
        <With Var="UaPath" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit">
        <With Var="IdParams" />
        <With Var="IdResults" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="IdParams" Type="WSTRING" />
      <VarDeclaration Name="IdResults" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="INIT">
      <ECAction Algorithm="INIT" Output="INITO" />
    </ECState>
    <Algorithm Name="INIT">
      <ST>IdParams := "";
IdResults := CONCAT(CONCAT(CONCAT("opc_ua[WRITE;", CONCAT(UaRoot, UaPath)), "/Results/Weight"), "]");</ST>
    </Algorithm>
  </SimpleFB>
</FBType>