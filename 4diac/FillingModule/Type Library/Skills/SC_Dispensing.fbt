<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SC_Dispensing" Comment="Control of module level skill Dispensing: OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; GO starts the Execute sequence with the parameters P_*; releases its equipment at the end">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Token" />
      </Event>
      <Event Name="START" Type="Event" />
      <Event Name="HALT" Type="Event" />
      <Event Name="ABORT" Type="Event" />
      <Event Name="RESET" Type="Event" />
      <Event Name="EXEC_DONE" Type="Event">
        <With Var="RI_Weight" />
      </Event>
      <Event Name="EXEC_FAILED" Type="Event">
        <With Var="ExecError" />
      </Event>
      <Event Name="STOP_DONE" Type="Event" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
      <Event Name="GO" Type="Event" />
      <Event Name="HALT_O" Type="Event" />
      <Event Name="ABORT_O" Type="Event" />
      <Event Name="RESET_O" Type="Event" />
      <Event Name="RUN_STOP" Type="Event" />
      <Event Name="SUCCESS" Type="Event" />
      <Event Name="FAILURE" Type="Event">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaPath" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="Methods" Type="BOOL" />
      <VarDeclaration Name="Token" Type="WSTRING" />
      <VarDeclaration Name="RI_Weight" Type="LREAL" />
      <VarDeclaration Name="ExecError" Type="UINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" />
      <VarDeclaration Name="ErrorID" Type="UINT" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB Name="Control" Type="modlib::SKILL_Control" x="400" y="200">
      <Parameter Name="InRange" Value="TRUE" />
      <Parameter Name="EqFree" Value="TRUE" />
    </FB>
    <FB Name="Params" Type="filling::SP_Dispensing" x="4000" y="200" />
    <FB Name="Owner" Type="modlib::MOD_OwnerView" x="7600" y="200" />
