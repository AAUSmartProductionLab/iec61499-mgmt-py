<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_Scale" Comment="Scale; the hardware has none yet (the ESP32 publishes a random weight), so it is simulated; equipment IO: owns its IO points; commands Idle=0, Tare=1, Measure=2">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="Weight_Backend" />
        <With Var="Weight_Modbus" />
        <With Var="Weight_Io" />
        <With Var="Weight_Sim" />
        <With Var="Weight_Scale" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;Scale&quot;" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" />
      <VarDeclaration Name="UaEnable" Type="BOOL" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" />
      <VarDeclaration Name="Weight_Backend" Type="USINT" InitialValue="2" />
      <VarDeclaration Name="Weight_Modbus" Type="WSTRING" />
      <VarDeclaration Name="Weight_Io" Type="STRING" />
      <VarDeclaration Name="Weight_Sim" Type="LREAL" InitialValue="2.0" />
      <VarDeclaration Name="Weight_Scale" Type="LREAL" InitialValue="0.001" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <FB Name="Logic" Type="filling::EL_Scale" x="400" y="200" />
    <FB Name="Mode" Type="modlib::MOD_StateView" x="4000" y="200" />
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="7600" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_2" x="11200" y="200">
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_1" x="14800" y="200" />
    <FB Name="In_Weight" Type="modlib::IO_AI" x="18400" y="200" />
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="22000" y="200" />
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="25600" y="200" />
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="PubUa.INIT" />
      <Connection Source="PubUa.INITO" Destination="In_Weight.INIT" />
      <Connection Source="In_Weight.INITO" Destination="Cycle.START" />
      <Connection Source="In_Weight.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="In_Weight.REQ" />
      <Connection Source="In_Weight.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.STATE" Destination="PubUa.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Logic.DRIVEN" />
      <Connection Source="Logic.PHASE_START" Destination="PhaseT.START" />
      <Connection Source="Logic.PHASE_STOP" Destination="PhaseT.STOP" />
      <Connection Source="PhaseT.EO" Destination="Logic.PHASE_T" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="UaRoot" Destination="Logic.UaRoot" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="Logic.IdPub" Destination="PubUa.ID" />
      <Connection Source="UaEnable" Destination="PubUa.QI" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Command" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Arg" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Release" />
      <Connection Source="Mode.State" Destination="Logic.ModState" />
      <Connection Source="Weight_Backend" Destination="In_Weight.Backend" />
      <Connection Source="Weight_Modbus" Destination="In_Weight.ModbusId" />
      <Connection Source="Weight_Io" Destination="In_Weight.IoName" />
      <Connection Source="Weight_Sim" Destination="In_Weight.SimValue" />
      <Connection Source="Weight_Scale" Destination="In_Weight.Scale" />
      <Connection Source="In_Weight.IN" Destination="Logic.I_Weight" />
      <Connection Source="Logic.Weight" Destination="PubState.SD_1" />
      <Connection Source="Logic.Weight" Destination="PubUa.SD_1" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_2" />
      <Connection Source="Logic.PhaseDT" Destination="PhaseT.DT" />
    </DataConnections>
  </FBNetwork>
</FBType>