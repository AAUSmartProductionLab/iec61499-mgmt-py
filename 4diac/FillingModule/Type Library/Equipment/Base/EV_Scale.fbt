<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EV_Scale" Comment="Typed view of Scale's state channel (inputs and holder)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filling" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event">
        <With Var="I_Weight" />
        <With Var="I_Holder" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="Weight" />
        <With Var="Holder" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="I_Weight" Type="LREAL" />
      <VarDeclaration Name="I_Holder" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Weight" Type="LREAL" />
      <VarDeclaration Name="Holder" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="REQ">
      <ECAction Algorithm="REQ" Output="CNF" />
    </ECState>
    <Algorithm Name="REQ">
      <ST>Weight := I_Weight;
Holder := I_Holder;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>