<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_Fill_v3" targetNamespace="https://smartproductionlab.aau.dk/processes">
  <process id="Fill_v3" isExecutable="false">
    <startEvent id="Start"/>
    <serviceTask id="MoveDown" name="MoveDown"/>
    <serviceTask id="Dose" name="Dose">
      <multiInstanceLoopCharacteristics isSequential="true"/>
    </serviceTask>
    <serviceTask id="MoveUp" name="MoveUp"/>
    <serviceTask id="Stopper" name="Stopper"/>
    <serviceTask id="Inspect" name="Inspect"/>
    <endEvent id="End"/>
    <sequenceFlow id="f1" sourceRef="Start" targetRef="MoveDown"/>
    <sequenceFlow id="f2" sourceRef="MoveDown" targetRef="Dose"/>
    <sequenceFlow id="f3" sourceRef="Dose" targetRef="MoveUp"/>
    <sequenceFlow id="f4" sourceRef="MoveUp" targetRef="Stopper"/>
    <sequenceFlow id="f5" sourceRef="Stopper" targetRef="Inspect"/>
    <sequenceFlow id="f6" sourceRef="Inspect" targetRef="End"/>
  </process>
</definitions>
