        "Molding of granular or powder material"@en ;
    rdfs:comment "Gruppe 1.4" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Urformen> .

<http://www.w3id.org/hsu-aut/DIN8580#Urformen_aus_dem_span-_oder_faserfoermigen_Zustand> a owl:Class ;
    rdfs:label "Urformen aus dem span- oder faserfoermigen Zustand"@de,
        "Molding of fibrous material"@en ;
    rdfs:comment "Gruppe 1.5" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Urformen> .

<http://www.w3id.org/hsu-aut/DIN8580#Zugumformen> a owl:Class ;
    rdfs:label "Zugumformen"@de,
        "Forming under tensile conditions"@en ;
    rdfs:comment """Gruppe 2.3
DIN 8585-1""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Umformen> .

<http://www.w3id.org/hsu-aut/DIN8580#Verfestigen_durch_Umformen> a owl:Class ;
    rdfs:label "Verfestigen durch Umformen"@de,
        "Hardening by forming"@en ;
    rdfs:comment "Gruppe 6.1" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Stoffeigenschaft_aendern> .

<http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> a owl:Class ;
    rdfs:label "Fertigungsverfahren"@de,
        "Manufacturing process"@en ;
    rdfs:comment """alle Verfahren zur Herstellung von geometrisch bestimmten festen Koerpern; 
sie schliessen die Verfahren zur Gewinnung erster Formen aus dem formlosen Zustand, zur Veraenderung dieser Form sowie zur Veraenderung der Stoffeigenschaften ein""" .

<http://www.w3id.org/hsu-aut/DIN8580#Umformen> a owl:Class ;
    rdfs:label "Umformen"@de,
        "Forming"@en ;
    rdfs:comment """Hauptgruppe 2: Fertigen durch bildsames (plastisches) aendern der Form eines festen Koerpers; 
dabei werden sowohl die Masse als auch der Zusammenhalt beibehalten
DIN 8582""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> .

<http://www.w3id.org/hsu-aut/DIN8580#Fuegen_durch_Urformen> a owl:Class ;
    rdfs:label "Fuegen durch Urformen"@de,
        "Joining by molding"@en ;
    rdfs:comment """Gruppe 4.4
DIN 8593-4""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fuegen> .

<http://www.w3id.org/hsu-aut/DIN8580#Reinigen> a owl:Class ;
    rdfs:label "Reinigen"@de,
        "Cleaning"@en ;
    rdfs:comment """Gruppe 3.6 
DIN 8592""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Trennen> .

<http://www.w3id.org/hsu-aut/DIN8580#Trennen> a owl:Class ;
    rdfs:label "Trennen"@de,
        "Separating"@en ;
    rdfs:comment "Hauptgruppe 3: Fertigen durch Aufheben des Zusammenhaltens von Koerpern, wobei der Zusammenhalt teilweise oder im Ganzen vermindert wird" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> .

<http://www.w3id.org/hsu-aut/DIN8580#Zerteilen> a owl:Class ;
    rdfs:label "Zerteilen"@de,
        "Cutting"@en ;
    rdfs:comment """Gruppe 3.1 
DIN 8588""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Trennen> .

<http://www.w3id.org/hsu-aut/DIN8580#Zugdruckumformen> a owl:Class ;
    rdfs:label "Zugdruckumformen"@de,
        "Forming under combination of tensile and compressive stress"@en ;
    rdfs:comment """Gruppe 2.2
DIN 8584-1""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Umformen> .

<http://www.w3id.org/hsu-aut/DIN8580#Zusammensetzen> a owl:Class ;
    rdfs:label "Zusammensetzen"@de,
        "Assembling "@en ;
    rdfs:comment """Gruppe 4.1
DIN 8593-1""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fuegen> .

<http://www.w3id.org/hsu-aut/DIN8580#An-_und_Einpressen> a owl:Class ;
    rdfs:label "An- und Einpressen"@de,
        "Pressing on and pressing in"@en ;
    rdfs:comment """Gruppe 4.3
DIN 8593-3""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fuegen> .

<http://www.w3id.org/hsu-aut/DIN8580#Beschichten_aus_dem_fluessigen_Zustand> a owl:Class ;
    rdfs:label "Beschichten aus dem fluessigen Zustand"@de,
        "Coating with a liquid material"@en ;
    rdfs:comment "Gruppe 5.1" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Beschichten> .

<http://www.w3id.org/hsu-aut/DIN8580#Druckumformen> a owl:Class ;
    rdfs:label "Druckumformen"@de,
        "Forming under compressive conditions"@en ;
    rdfs:comment """Gruppe 2.1
DIN 8583-1""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Umformen> .

<http://www.w3id.org/hsu-aut/DIN8580#Spanen_mit_geometrisch_unbestimmten_Schneiden> a owl:Class ;
    rdfs:label "Spanen mit geometrisch unbestimmten Schneiden"@de,
        "Machining with geometrically undefined cutting edges"@en ;
    rdfs:comment """Gruppe 3.3 
DIN 8589-0""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Trennen> .

<http://www.w3id.org/hsu-aut/DIN8580#Stoffeigenschaft_aendern> a owl:Class ;
    rdfs:label "Stoffeigenschaft aendern"@de,
        "Changing material properties"@en ;
    rdfs:comment """Hauptgruppe 6: Fertigen durch Veraendern der Eigenschaften des Werkstoffes, aus dem ein Werkstueck besteht; 
dies geschieht u. a. durch Veraenderungen im submikroskopischen bzw. atomaren Bereich, z. B. durch Diffusion von Atomen, Erzeugung und Bewegung von Versetzungen im Atomgitter, chemische Reaktionen. Unvermeidbar auftretende Formaenderungen gehoeren nicht zum Wesen dieser Verfahren""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> .

<http://www.w3id.org/hsu-aut/DIN8580#Urformen> a owl:Class ;
    rdfs:label "Urformen"@de,
        "Molding"@en ;
    rdfs:comment """Hauptgruppe 1: Fertigen eines festen Koerpers aus formlosem Stoff durch Schaffen des Zusammenhaltes; 
hierbei treten die Stoffeigenschaften des Werkstueckes bestimmbar in Erscheinung""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> .

<http://www.w3id.org/hsu-aut/DIN8580#Beschichten> a owl:Class ;
    rdfs:label "Beschichten"@de,
        "Coating"@en ;
    rdfs:comment """Hauptgruppe 5: Fertigen durch Aufbringen einer fest haftenden Schicht aus formlosem Stoff auf ein Werkstueck;
massgebend ist der unmittelbar vor dem Beschichten herrschende Zustand des Beschichtungsstoffes""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> .

<http://www.w3id.org/hsu-aut/DIN8580#Urformen_aus_dem_plastischen_Zustand> a owl:Class ;
    rdfs:label "Urformen aus dem plastischen Zustand"@de,
        "Molding of plastic material"@en ;
    rdfs:comment "Gruppe 1.2" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Urformen> .

<http://www.w3id.org/hsu-aut/DIN8580#Waermebehandeln> a owl:Class ;
    rdfs:label "Waermebehandeln"@de,
        "Heat treating"@en ;
    rdfs:comment """Gruppe 6.2
DIN EN 10052""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Stoffeigenschaft_aendern> .

<http://www.w3id.org/hsu-aut/DIN8580#Zerlegen> a owl:Class ;
    rdfs:label "Zerlegen"@de,
        "Disassembling"@en ;
    rdfs:comment """Gruppe 3.5 
DIN 8591""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Trennen> .

<http://www.w3id.org/hsu-aut/DIN8580#Fuegen> a owl:Class ;
    rdfs:label "Fuegen"@de,
        "Joining"@en ;
    rdfs:comment """Hauptgruppe 4: auf Dauer angelegtes Verbinden oder sonstiges Zusammenbringen von zwei oder mehreren Werkstuecken geometrisch bestimmter fester Form oder von eben solchen Werkstuecken mit formlosem Stoff;
dabei wird der Zusammenhalt oertlich geschaffen und im Ganzen vermehrt
DIN 8593-0""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Fertigungsverfahren> .

<http://www.w3id.org/hsu-aut/DIN8580#Spanen_mit_geometrisch_bestimmten_Schneiden> a owl:Class ;
    rdfs:label "Spanen mit geometrisch bestimmten Schneiden"@de,
        "Machining with geometrically defined cutting edges"@en ;
    rdfs:comment """Gruppe 3.2 
DIN 8589-0""" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Trennen> .

<http://www.w3id.org/hsu-aut/DIN8580#Urformen_aus_dem_fluessigen_Zustand> a owl:Class ;
    rdfs:label "Urformen aus dem fluessigen Zustand"@de,
        "Molding of liquid material"@en ;
    rdfs:comment "Gruppe 1.1" ;
    rdfs:subClassOf <http://www.w3id.org/hsu-aut/DIN8580#Urformen> .

