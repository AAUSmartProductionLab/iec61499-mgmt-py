@prefix arso: <https://w3id.org/2025/arso#> .
@prefix aas:  <https://admin-shell.io/aas/3/1/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SMT STRUCTURE OVERVIEW
#################################################################
# HierarchicalStructures (Submodel)
#   ├─ EntryNode [Entity, 1] — root of BoM tree
#   │    ├─ Node [Entity, 1..*] (recursive)
#   │    │    └─ Frame [SMC, 0..1] — where the part is in its parent (v0.12): X, Y, Z, RX, RY, RZ
#   │    ├─ SameAs [RelationshipElement, 0..*]
#   │    ├─ IsPartOf [RelationshipElement, 0..*] XOR
#   │    └─ HasPart [RelationshipElement, 0..*]
#   └─ ArcheType [Property, xs:string, 1] — Full | OneDown | OneUp
# Additional non-OWL checks: self-managed constraints and HasPart/IsPartOf exclusivity.

#################################################################
# ONTOLOGY METADATA
#################################################################

<https://w3id.org/2025/arso/modules/hierarchical-structures>
  rdf:type owl:Ontology ;
  owl:imports <https://admin-shell.io/aas/3/1/> ;
  rdfs:comment """ARSO module: Hierarchical Structures enabling Bills of Material (IDTA 02011-1-1, June 2024).

  Submodel semanticId: https://admin-shell.io/idta/HierarchicalStructures/1/1/Submodel""" .


#################################################################
# SUBMODEL TYPE
#################################################################

arso:HierarchicalStructuresSubmodel rdf:type owl:Class ;
  rdfs:subClassOf aas:Submodel ;
  rdfs:label "Hierarchical Structures Submodel" ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/1/1/Submodel" ;
  rdfs:comment "IDTA 02011-1-1 — Hierarchical Structures enabling Bills of Material." .


#################################################################
# ELEMENT TYPES — Entity nodes
#################################################################

arso:EntryNodeEntity rdf:type owl:Class ;
  rdfs:subClassOf aas:Entity ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/EntryNode/1/0" ;
  rdfs:comment "Entity EntryNode — root of the BoM tree. Must be SelfManagedEntity reflecting the asset administered by this AAS. Exactly one per submodel." .

arso:NodeEntity rdf:type owl:Class ;
  rdfs:subClassOf aas:Entity ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/Node/1/0" ;
  rdfs:comment "Entity Node — a BoM node at any level below EntryNode. Can be Co-managed or Self-managed. Recursive: may contain further NodeEntity instances in its statements." .


#################################################################
# ELEMENT TYPES — Submodel-level properties
#################################################################

arso:ArcheTypeProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/ArcheType/1/0" ;
  rdfs:comment "Property ArcheType (xs:string) — hierarchy archetype: 'Full', 'OneDown', or 'OneUp'. The value enumeration is enforced by arso:ArcheTypeValueShape in arso-rules.shacl.ttl, NOT by the owl:oneOf restriction below: the owl2shacl ruleset does not translate owl:oneOf into sh:in (verified -- zero sh:in in the generated shapes), so the restriction alone is inert." .

# OWL constraints to allow owl->shacl conversion for ArcheType and SelfManaged entities
arso:ArcheTypeProperty rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ;
  owl:allValuesFrom [
    a rdfs:Datatype ;
    owl:oneOf ( "Full" "OneDown" "OneUp" )
  ]
] , [
  a owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ;
  owl:minCardinality 1
] , [
  a owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Property/value> ;
  owl:maxCardinality 1
] .

# Self-managed entity class requiring globalAssetId when entityType indicates SelfManagedEntity
arso:SelfManagedBomEntity
  a owl:Class ;
  rdfs:subClassOf aas:Entity ;
  rdfs:comment "Entity with entityType SelfManagedEntity that must have a globalAssetId." ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <https://admin-shell.io/aas/3/1/Entity/entityType> ;
    owl:hasValue <https://admin-shell.io/aas/3/1/EntityType/SelfManagedEntity>
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <https://admin-shell.io/aas/3/1/Entity/globalAssetId> ;
    owl:minCardinality 1
  ] .


#################################################################
# ELEMENT TYPES — Relationships (used in both EntryNode and Node statements)
#################################################################

arso:HasPartRelationship rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/HasPart/1/0" ;
  rdfs:comment "RelationshipElement HasPart — parent→child logical connection. Mutually exclusive with IsPartOf per entity. Both first and second must reference an EntryNodeEntity or NodeEntity in the same submodel." .

arso:IsPartOfRelationship rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/IsPartOf/1/0" ;
  rdfs:comment "RelationshipElement IsPartOf — child→parent logical connection. Mutually exclusive with HasPart per entity. Both first and second must reference an EntryNodeEntity or NodeEntity in the same submodel." .

arso:SameAsRelationship rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/SameAs/1/0" ;
  rdfs:comment "RelationshipElement SameAs — links two entities representing the same asset, within or across submodels. Both first and second must reference an EntryNodeEntity or NodeEntity." .


#################################################################
# ELEMENT TYPES — Node-only elements
#################################################################

arso:BulkCountProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:semanticId "https://admin-shell.io/idta/HierarchicalStructures/BulkCount/1/0" ;
  rdfs:comment "Property BulkCount (xs:unsignedLong) — count of identical bulk items represented by this node. Only valid on NodeEntity; presence implies the node represents a type-level asset, not a specific instance." .


#################################################################
# ELEMENT TYPES — Where a part is (v0.12; docs/locations-and-layout.md)
#
# A Node says where its part is in the frame of what it is a part of (the EntryNode's asset): a
# module's components in the module, a line's modules in the line. A Node of the entity type
# CoManagedEntity with a meaning (supplemental semanticId: a point of the vocabulary) and a Frame
# is a point of interest: where a shuttle stands to have its container filled, where a robot picks.
# Poses compose along the tree, so a point is known in any frame the tree reaches.
#################################################################

arso:FrameSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:parentClass arso:NodeEntity ;
  arso:idShort "Frame" ;
  arso:semanticId "https://smartproductionlab.aau.dk/ARSO/Frame/1/0" ;
  rdfs:comment "SMC Frame — in a Node's statements: the pose of the part's frame in its parent's frame, as AutomationML's Frame attribute (IEC 62714): a translation X, Y, Z and rotations RX, RY, RZ about the parent's axes, each Property with its unit (qualifier Unit: mm, deg)." .

arso:FrameXProperty rdf:type owl:Class ; rdfs:subClassOf aas:Property ; arso:parentClass arso:FrameSMC ;
  arso:idShort "X" ; arso:semanticId "https://admin-shell.io/idta/cds/xframe/1" ;
  rdfs:comment "Property X (xs:double) — the translation along the parent's X axis (IDTA 02075 xframe)." .

arso:FrameYProperty rdf:type owl:Class ; rdfs:subClassOf aas:Property ; arso:parentClass arso:FrameSMC ;
  arso:idShort "Y" ; arso:semanticId "https://admin-shell.io/idta/cds/yframe/1" ;
  rdfs:comment "Property Y (xs:double) — the translation along the parent's Y axis (IDTA 02075 yframe)." .

arso:FrameZProperty rdf:type owl:Class ; rdfs:subClassOf aas:Property ; arso:parentClass arso:FrameSMC ;
  arso:idShort "Z" ; arso:semanticId "https://admin-shell.io/idta/cds/zframe/1" ;
  rdfs:comment "Property Z (xs:double) — the translation along the parent's Z axis (IDTA 02075 zframe)." .

arso:FrameRXProperty rdf:type owl:Class ; rdfs:subClassOf aas:Property ; arso:parentClass arso:FrameSMC ;
  arso:idShort "RX" ; arso:semanticId "https://admin-shell.io/idta/cds/rxframe/1" ;
  rdfs:comment "Property RX (xs:double) — the rotation about the parent's X axis (IDTA 02075 rxframe)." .

arso:FrameRYProperty rdf:type owl:Class ; rdfs:subClassOf aas:Property ; arso:parentClass arso:FrameSMC ;
  arso:idShort "RY" ; arso:semanticId "https://admin-shell.io/idta/cds/ryframe/1" ;
  rdfs:comment "Property RY (xs:double) — the rotation about the parent's Y axis (IDTA 02075 ryframe)." .

arso:FrameRZProperty rdf:type owl:Class ; rdfs:subClassOf aas:Property ; arso:parentClass arso:FrameSMC ;
  arso:idShort "RZ" ; arso:semanticId "https://admin-shell.io/idta/cds/rzframe/1" ;
  rdfs:comment "Property RZ (xs:double) — the rotation about the parent's Z axis (IDTA 02075 rzframe)." .


#################################################################
# CONTAINMENT CONSTRAINTS
#################################################################

# HierarchicalStructuresSubmodel must contain exactly 1 EntryNode and exactly 1 ArcheType
arso:HierarchicalStructuresSubmodel rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:EntryNodeEntity ] .

arso:HierarchicalStructuresSubmodel rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:ArcheTypeProperty ] .

# EntryNode must have at least 1 Node in its statements
arso:EntryNodeEntity rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Entity/statements> ;
  owl:someValuesFrom arso:NodeEntity ] .

# NodeEntity may have BulkCount (at most 1)
arso:NodeEntity rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Entity/statements> ;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:BulkCountProperty ] .

# ... and one Frame at most (v0.12), which has each of its six values once
arso:NodeEntity rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Entity/statements> ;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:FrameSMC ] .

arso:FrameSMC rdfs:subClassOf
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:FrameXProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:FrameYProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:FrameZProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:FrameRXProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:FrameRYProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arso:FrameRZProperty ] .
