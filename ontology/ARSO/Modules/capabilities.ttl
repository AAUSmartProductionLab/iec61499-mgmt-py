@prefix arso: <https://w3id.org/2025/arso#> .
@prefix aas:  <https://admin-shell.io/aas/3/1/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SMT STRUCTURE OVERVIEW
#################################################################
# CapabilityDescription (Submodel)
#   └─ CapabilitySet [SMC, 1..*]
#        └─ CapabilityContainer [SMC, 1..*]
#             ├─ Capability [Capability, 1]
#             ├─ CapabilityComment [MLP, 0..1]
#             ├─ PropertySet [SMC, 0..*]
#             │    └─ PropertyContainer [SMC, 1..*]
#             │         ├─ SameProperty [RelationshipElement, 0..*]
#             │         ├─ PropertyComment [MLP, 0..1]
#             │         └─ CapabilityPropertyType [abstract, 1]
#             └─ CapabilityRelations [SMC, 0..1]
#                  ├─ CapabilityRealizedBy [RelationshipElement, 0..*]
#                  ├─ ComposedOfSet [SMC, 0..1]
#                  ├─ GeneralizedBySet [SMC, 0..1]
#                  └─ ConstraintSet [SMC, 0..*]
#                       ├─ PropertyConstraintContainer [SMC, 0..*]
#                       │    ├─ ConstraintType [Property, 1] — BasicConstraint here
#                       │    ├─ BasicConstraint [Property, 1] — the expression (below)
#                       │    ├─ PropertyConditionalType [Property, 1] — Pre, Post, Invariant, ...
#                       │    └─ ConstraintPropertyRelations [SMC, 1]
#                       │         └─ ConstraintHasProperty [RelationshipElement, 1..*]
#                       └─ TransitionConstraintContainer [SMC, 0..*]
#                            ├─ TransitionConstrainedBy [RelationshipElement, 1]
#                            └─ TransitionConditionalType [Property, 1]
# Cross-submodel note: CapabilityRealizedBy.second references a Skill in the Skills submodel of
# the same AAS or of an AAS that is a part of it in HierarchicalStructures (downward only), as a
# step's Skill does (v0.11).
#
# How a resource uses it (v0.11; docs/skill-planning.md): a module's Capability Description is
# what new skills of it are planned from, so everything the planner reads is in this one
# submodel (IDTA 02020 keeps ComposedOf, ConstraintHasProperty and TransitionConstrainedBy inside
# one submodel).
# - CapabilitySet OfferedCapabilities: the module's process capabilities, role Offered, each
#   realized by a composite skill of the module if one exists.
# - One CapabilitySet per component, named like it: the component's capabilities, role
#   NotAssigned (no product asks for them), each realized by one of its primitives. They are parts
#   of the module's capabilities (ComposedOf), never offered on their own.
# - A property constraint is a BasicConstraint: an expression over the properties of its own
#   capability, about the property its ConstraintHasProperty names. "<op> <operand>", op one of
#   = != < <= > >= +=, the operand a value or the idShort of another property of the capability;
#   or a word: given (Post: it ends at the value it was given), measured (Post: at what it
#   measured), unchanged (Invariant: nothing else changes it meanwhile). A planner achieves = and
#   +=; it checks the others.
# - A property is a state: the data point its SameProperty names (second: a Property of the
#   module's Operational Data), the same for every capability that names it; without one, the
#   product's if its meaning is a property of the product, else the component's whose set holds it.
# - A transition constraint orders capabilities where no state does; its Invariant means the other
#   capability runs at the same time (IDTA 02020: "supplying lubricant during a milling operation").

#################################################################
# ONTOLOGY METADATA
#################################################################

<https://w3id.org/2025/arso/modules/capabilities>
  rdf:type owl:Ontology ;
  owl:imports <https://admin-shell.io/aas/3/1/> ;
  rdfs:comment """ARSO module: Capability Description (IDTA 02020-1-0).

  Submodel semanticId: https://admin-shell.io/idta/SubmodelTemplate/CapabilityDescription/1/0
  Cross-submodel: CapabilityRealizedBy.second references a Skill in the Skills SM of the same AAS or of an AAS that is a part of it in HierarchicalStructures (downward only); SameProperty.second a Property of the module's Operational Data.""" .


#################################################################
# SUBMODEL TYPE
#################################################################

arso:CapabilitiesSubmodel rdf:type owl:Class ;
  rdfs:subClassOf aas:Submodel ;
  rdfs:label "Capability Description Submodel" ;
  arso:semanticId "https://admin-shell.io/idta/SubmodelTemplate/CapabilityDescription/1/0" ,
                  "https://admin-shell.io/idta/CapabilityDescription/1/0" ;
  rdfs:comment "IDTA 02020 — Capability Description." .


#################################################################
# ELEMENT TYPES — CapabilitySet / CapabilityContainer
#################################################################

arso:CapabilitySetSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://smartfactory.de/aas/submodel/OfferedCapabilityDescription/CapabilitySet#1/0",
    "https://admin-shell.io/idta/CapabilityDescription/CapabilitySet/1/0" ;
  rdfs:comment "SMC CapabilitySet — groups CapabilityContainers for one use case of the asset." .

arso:CapabilityContainerSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://smartfactory.de/aas/submodel/OfferedCapabilityDescription/CapabilitySet/CapabilityContainer#1/0",
    "https://admin-shell.io/idta/CapabilityDescription/CapabilityContainer/1/0" ;
  rdfs:comment "SMC CapabilityContainer — holds exactly one Capability element plus optional descriptive elements." .

arso:CapabilityElement rdf:type owl:Class ;
  rdfs:subClassOf aas:Capability ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/Capability/1/0" ;
  arso:unconditionalAasType <https://admin-shell.io/aas/3/1/Capability> ;
  rdfs:comment "Capability element — implementation-independent specification of a function in industrial production. semanticId: https://admin-shell.io/idta/CapabilityDescription/Capability/1/0. Qualified by CapabilityRoleQualifier (Required|Offered|NotAssigned). aas:Capability is a modelType specific to this one concept, so any node of that type anywhere is typed as this class even without a matching semanticId (real fixtures typically use a project-specific Capability URI instead)." .

arso:CapabilityCommentMLP rdf:type owl:Class ;
  rdfs:subClassOf aas:MultiLanguageProperty ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityComment/1/0" ;
  rdfs:comment "MLP CapabilityComment — individual human-readable comment for the capability." .


#################################################################
# ELEMENT TYPES — PropertySet / PropertyContainer
#################################################################

arso:PropertySetSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertySet/1/0" ;
  rdfs:comment "SMC PropertySet — set of properties describing the capability in more detail." .

arso:PropertyContainerSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertyContainer/1/0" ;
  rdfs:comment "SMC PropertyContainer — holds one CapabilityPropertyType instance plus SameProperty and PropertyComment." .

arso:SamePropertyRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/SameProperty/1/0" ;
  rdfs:comment "RelationshipElement SameProperty — links the property in this PropertyContainer (first) to an identical property in another Submodel or external source (second). For a state of the resource (v0.11): the data point of Operational Data it is; capabilities whose properties name the same data point talk about the same state." .

arso:PropertyCommentMLP rdf:type owl:Class ;
  rdfs:subClassOf aas:MultiLanguageProperty ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertyComment/1/0" ;
  rdfs:comment "MLP PropertyComment — general human-readable description of the property." .


#################################################################
# ELEMENT TYPES — CapabilityRelations
#################################################################

arso:CapabilityRelationsSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityRelations/1/0" ;
  rdfs:comment "SMC CapabilityRelations — optional container for all relationships of a capability." .

arso:CapabilityRealizedBySML rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementList ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityRealizedBy/1/0" ;
  rdfs:comment "SML CapabilityRealizedBy — the realizedBy list itself, holding one RelationshipElement per realizing Skill." .

arso:CapabilityRealizedByRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:parentClass arso:CapabilityRealizedBySML ;
  rdfs:comment "RelationshipElement CapabilityRealizedBy — first: Capability in this SM; second: Skill in the Skills Submodel of the same AAS or of an AAS that is a part of it in HierarchicalStructures (downward only): a component's primitive realizes the component's capability (v0.11). Applied unconditionally to every direct child of a CapabilityRealizedBySML (no idShort — SML entries are unnamed list items)." .


#################################################################
# ELEMENT TYPES — ComposedOfSet
#################################################################

arso:ComposedOfSetSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ComposedOfSet/1/0" ;
  rdfs:comment "SMC ComposedOfSet — created when the capability is composed of sub-capabilities." .

arso:ComposedOfContainerSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ComposedOfContainer/1/0" ;
  rdfs:comment "SMC ComposedOfContainer — one composition record; must contain at least 2 CapabilityComposedOf relationships." .

arso:CapabilityComposedOfRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityComposedOf/1/0" ;
  rdfs:comment "RelationshipElement CapabilityComposedOf — first: composed capability; second: one of its sub-capabilities. Minimum 2 per ComposedOfContainer." .

arso:ComposedOfCommentMLP rdf:type owl:Class ;
  rdfs:subClassOf aas:MultiLanguageProperty ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ComposedOfComment/1/0" ;
  rdfs:comment "MLP ComposedOfComment — human-readable description of the composition." .


#################################################################
# ELEMENT TYPES — GeneralizedBySet
#################################################################

arso:GeneralizedBySetSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/GeneralizedBySet/1/0" ;
  rdfs:comment "SMC GeneralizedBySet — created when generalizations of the capability exist." .

arso:CapabilityGeneralizedByRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/CapabilityGeneralizedBy/1/0" ;
  rdfs:comment "RelationshipElement CapabilityGeneralizedBy — first: this capability (to be generalized); second: a more general capability." .


#################################################################
# ELEMENT TYPES — ConstraintSet
#################################################################

arso:ConstraintSetSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ConstraintSet/1/0" ;
  rdfs:comment "SMC ConstraintSet — created when constraints on the capability exist. Must contain at least one PropertyConstraintContainer or TransitionConstraintContainer (SM-CapabilityDescription-2)." .

arso:PropertyConstraintContainerSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertyConstraintContainer/1/0" ;
  rdfs:comment "SMC PropertyConstraintContainer — one property constraint record. Contains: PropertyConstraintType (abstract, 1), PropertyConditionalType (1), ConstraintPropertyRelations (1)." .

arso:TransitionConstraintContainerSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/TransitionConstraintContainer/1/0" ;
  rdfs:comment "SMC TransitionConstraintContainer — one transition constraint record. Contains: TransitionConstrainedBy (1), TransitionConditionalType (1)." .

arso:ConstraintPropertyRelationsSMC rdf:type owl:Class ;
  rdfs:subClassOf aas:SubmodelElementCollection ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ConstraintPropertyRelations/1/0" ;
  rdfs:comment "SMC ConstraintPropertyRelations — contains all ConstraintHasProperty relationships for a PropertyConstraintContainer." .

arso:ConstraintHasPropertyRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ConstraintHasProperty/1/0" ;
  rdfs:comment "RelationshipElement ConstraintHasProperty — first: PropertyConstraint; second: Property from a PropertyContainer." .

arso:TransitionConstrainedByRel rdf:type owl:Class ;
  rdfs:subClassOf aas:RelationshipElement ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/TransitionConstrainedBy/1/0" ;
  rdfs:comment "RelationshipElement TransitionConstrainedBy — first: constrained Capability; second: constraining Capability from another CapabilityContainer." .

arso:ConstraintTypeProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/ConstraintType/1/0" ;
  rdfs:comment "Property ConstraintType (xs:string) — the form of a PropertyConstraintContainer's constraint: BasicConstraint, CustomConstraint, OCLConstraint or OperationConstraint, the one element of that name it holds (SM-CapabilityDescription-3). A resource's are BasicConstraint (v0.11)." .

arso:BasicConstraintProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertyConstraintType/BasicConstraint/1/0" ;
  rdfs:comment "Property BasicConstraint (xs:string) — the constraint as an expression over the properties of its capability, about the property its ConstraintHasProperty names (v0.11): '<op> <operand>', op one of = != < <= > >= +=, the operand a value or the idShort of another property of the capability ('= 40.0', '= FillPosition', '+= Volume'); or a word: given or measured (Post), unchanged (Invariant)." .

arso:PropertyConditionalTypeProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/PropertyConditionalType/1/0" ;
  rdfs:comment "Property PropertyConditionalType (xs:string) — when the constraint holds: Pre (before the capability is applied), Post (after it), Invariant (while it runs), or PrePost, PreInvariant, InvariantPost, PrePostInvariant." .

arso:TransitionConditionalTypeProperty rdf:type owl:Class ;
  rdfs:subClassOf aas:Property ;
  arso:semanticId "https://admin-shell.io/idta/CapabilityDescription/TransitionConditionalType/1/0" ;
  rdfs:comment "Property TransitionConditionalType (xs:string) — when the constraining capability (second) is applied: Pre (before the constrained one, first), Post (after it), Invariant (during it, at the same time), or PrePost, PreInvariant, InvariantPost, PrePostInvariant." .


#################################################################
# CONTAINMENT CONSTRAINTS
#################################################################

# CapabilitiesSubmodel must contain at least one CapabilitySet
arso:CapabilitiesSubmodel rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/Submodel/submodelElements> ;
  owl:someValuesFrom arso:CapabilitySetSMC ] .

# CapabilitySet must contain at least one CapabilityContainer
arso:CapabilitySetSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:CapabilityContainerSMC ] .

# CapabilityContainer must contain exactly one Capability element (mandatory)
arso:CapabilityContainerSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:CapabilityElement ] .

# CapabilityContainer must contain at most one CapabilityRelations
arso:CapabilityContainerSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:CapabilityRelationsSMC ] .

# PropertySet must contain at least one PropertyContainer
arso:PropertySetSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:PropertyContainerSMC ] .

# CapabilityRelations.ComposedOfSet: at most one
arso:CapabilityRelationsSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:ComposedOfSetSMC ] .

# CapabilityRelations.GeneralizedBySet: at most one
arso:CapabilityRelationsSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  owl:onClass arso:GeneralizedBySetSMC ] .

# ComposedOfSet must contain at least one ComposedOfContainer
arso:ComposedOfSetSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:ComposedOfContainerSMC ] .

# GeneralizedBySet must contain at least one CapabilityGeneralizedBy
arso:GeneralizedBySetSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:CapabilityGeneralizedByRel ] .

# ConstraintSet must contain PropertyConstraintContainer or TransitionConstraintContainer (SM-CapabilityDescription-2)
arso:ConstraintSetSMC rdfs:subClassOf [
  rdf:type owl:Class ;
  owl:unionOf (
    [ rdf:type owl:Restriction ;
      owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
      owl:someValuesFrom arso:PropertyConstraintContainerSMC ]
    [ rdf:type owl:Restriction ;
      owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
      owl:someValuesFrom arso:TransitionConstraintContainerSMC ] ) ] .

# PropertyConstraintContainer must have ConstraintPropertyRelations (mandatory, exactly 1)
arso:PropertyConstraintContainerSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:ConstraintPropertyRelationsSMC ] .

# ... and says what form its constraint has and when it holds (both mandatory, v0.11)
arso:PropertyConstraintContainerSMC rdfs:subClassOf
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:someValuesFrom arso:ConstraintTypeProperty ],
  [ rdf:type owl:Restriction ; owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
    owl:someValuesFrom arso:PropertyConditionalTypeProperty ] .

# ConstraintPropertyRelations must contain at least one ConstraintHasProperty
arso:ConstraintPropertyRelationsSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:ConstraintHasPropertyRel ] .

# TransitionConstraintContainer must contain TransitionConstrainedBy (1) and its TransitionConditionalType (1, v0.11)
arso:TransitionConstraintContainerSMC rdfs:subClassOf [
  rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:TransitionConstrainedByRel ] ,
  [ rdf:type owl:Restriction ;
  owl:onProperty <https://admin-shell.io/aas/3/1/SubmodelElementCollection/value> ;
  owl:someValuesFrom arso:TransitionConditionalTypeProperty ] .
