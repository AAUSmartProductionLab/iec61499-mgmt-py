+
+namespace forte::eclipse4diac::io::pwmsysfs {
+
+  /*! @brief PWMChip: configures one Linux PWM channel and registers it as the handle VALUE.
+   *
+   * A QW whose PARAMS is VALUE then sets the duty cycle as a fraction of the period (0..65535).
+   */
+  class FORTE_PWMChip : public forte::io::IOConfigFBController {
+      DECLARE_FIRMWARE_FB(FORTE_PWMChip)
+
+    private:
+      static const TEventID scmEventINITOID = 0;
+      static const TEventID scmEventINDID = 1;
+      static const TEventID scmEventINITID = 0;
+
+      void readInputData(TEventID paEIID) override;
+      void writeOutputData(TEventID paEIID) override;
+      void setInitialValues() override;
+
+    public:
+      FORTE_PWMChip(const forte::StringId paInstanceNameId, CFBContainer &paContainer);
+
+      CIEC_BOOL var_QI;
+      CIEC_WSTRING var_VALUE;
+      CIEC_UINT var_ChipNumber;
+      CIEC_UINT var_Channel;
+      CIEC_UDINT var_PeriodNs;
+      CIEC_BOOL var_Inversed;
+      CIEC_WSTRING var_SysfsRoot;
+
+      CIEC_BOOL var_QO;
+      CIEC_WSTRING var_STATUS;
+
+      CEventConnection conn_INITO;
+      CEventConnection conn_IND;
+
+      CDataConnection *conn_QI;
+      CDataConnection *conn_VALUE;
+      CDataConnection *conn_ChipNumber;
+      CDataConnection *conn_Channel;
+      CDataConnection *conn_PeriodNs;
+      CDataConnection *conn_Inversed;
+      CDataConnection *conn_SysfsRoot;
+
+      COutDataConnection<CIEC_BOOL> conn_QO;
+      COutDataConnection<CIEC_WSTRING> conn_STATUS;
+
+      CIEC_ANY *getDI(size_t) override;
+      CIEC_ANY *getDO(size_t) override;
+      CEventConnection *getEOConUnchecked(TPortId) override;
+      CDataConnection **getDIConUnchecked(TPortId) override;
+      CDataConnection *getDOConUnchecked(TPortId) override;
+
+    protected:
+      forte::io::IODeviceController *createDeviceController(CDeviceExecution &paDeviceExecution) override;
+
+      void setConfig() override;
+
+      void onStartup(CEventChainExecutionThread *const paECET) override;
+  };
+} // namespace forte::eclipse4diac::io::pwmsysfs
diff --git a/modules/pwmsysfs/pwmsysfs_controller.cpp b/modules/pwmsysfs/pwmsysfs_controller.cpp
new file mode 100644
index 0000000..6c7afbe
--- /dev/null
+++ b/modules/pwmsysfs/pwmsysfs_controller.cpp
@@ -0,0 +1,136 @@
+/*******************************************************************************
+ * Copyright (c) 2026 Aalborg University
+ * This program and the accompanying materials are made available under the
+ * terms of the Eclipse Public License 2.0 which is available at
+ * http://www.eclipse.org/legal/epl-2.0.
+ *
+ * SPDX-License-Identifier: EPL-2.0
+ *
+ * Contributors:
+ *   Martin Jensen - initial implementation
+ *******************************************************************************/
+
+#include "pwmsysfs_controller.h"
+
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "forte/datatypes/forte_word.h"
+#include "forte/util/devlog.h"
+
+namespace forte::eclipse4diac::io::pwmsysfs {
+
+  const char *const PWMSysfsController::scmFailedToExport = "Failed to export the PWM channel";
+  const char *const PWMSysfsController::scmFailedToConfigure = "Failed to configure the PWM channel";
+  const char *const PWMSysfsController::scmFailedToWrite = "Failed to write the PWM duty cycle";
+
+  namespace {
+    bool exists(const std::string &paPath) {
+      struct stat info{};
+      return stat(paPath.c_str(), &info) == 0;
+    }
+  } // namespace
+
+  std::string PWMSysfsController::channelPath() const {
+    return mConfig.mRoot + "/pwmchip" + std::to_string(mConfig.mChipNumber) + "/pwm" + std::to_string(mConfig.mChannel);
+  }
+
+  bool PWMSysfsController::writeFile(const std::string &paFile, const std::string &paValue) const {
+    int fd = open(paFile.c_str(), O_WRONLY);
+    if (fd < 0) {
+      DEVLOG_ERROR("[PWMSysfsController] Could not open %s: %s\n", paFile.c_str(), strerror(errno));
+      return false;
+    }
+    bool ok = write(fd, paValue.c_str(), paValue.size()) == static_cast<ssize_t>(paValue.size());
+    if (!ok) {
+      DEVLOG_ERROR("[PWMSysfsController] Could not write '%s' to %s: %s\n", paValue.c_str(), paFile.c_str(),
+                   strerror(errno));
+    }
+    close(fd);
+    return ok;
+  }
+
+  const char *PWMSysfsController::init() {
+    const std::string chip = mConfig.mRoot + "/pwmchip" + std::to_string(mConfig.mChipNumber);
+    const std::string channel = channelPath();
+    if (!exists(channel)) {
+      if (!writeFile(chip + "/export", std::to_string(mConfig.mChannel))) {
+        return scmFailedToExport;
+      }
+      // udev may need a moment to create the channel and hand its files to the gpio group.
+      for (int i = 0; i < 20 && !exists(channel + "/period"); ++i) {
+        sleepThread(50);
+      }
+    }
+    // The duty cycle must never exceed the period: clear it before changing the period.
+    writeFile(channel + "/duty_cycle", "0");
+    if (!writeFile(channel + "/period", std::to_string(mConfig.mPeriodNs)) ||
+        (mConfig.mInversed && !writeFile(channel + "/polarity", "inversed")) ||
+        !writeFile(channel + "/enable", "1")) {
+      return scmFailedToConfigure;
+    }
+    mDutyFd = open((channel + "/duty_cycle").c_str(), O_WRONLY);
+    if (mDutyFd < 0) {
+      DEVLOG_ERROR("[PWMSysfsController] Could not open %s/duty_cycle: %s\n", channel.c_str(), strerror(errno));
+      return scmFailedToConfigure;
+    }
+    DEVLOG_INFO("[PWMSysfsController] PWM chip %u channel %u ready, period %lu ns\n", mConfig.mChipNumber,
+                mConfig.mChannel, mConfig.mPeriodNs);
+    return nullptr;
+  }
+
+  void PWMSysfsController::deInit() {
+    if (mDutyFd >= 0) {
+      close(mDutyFd);
+      mDutyFd = -1;
+      const std::string channel = channelPath();
+      writeFile(channel + "/duty_cycle", "0");
+      writeFile(channel + "/enable", "0");
+    }
+    DEVLOG_INFO("[PWMSysfsController] PWM chip %u channel %u shut down\n", mConfig.mChipNumber, mConfig.mChannel);
+  }
+
+  void PWMSysfsController::runLoop() {
+    // Output only: values are written directly when a QW sets the handle.
+    while (isAlive() && !hasError()) {
+      sleepThread(100);
+    }
+  }
+
+  void PWMSysfsController::handleChangeEvent(forte::io::IOHandle *paHandle) {
+    if (mDutyFd < 0) {
+      return;
+    }
+    auto value = static_cast<PWMSysfsHandle *>(paHandle)->value();
+    auto duty = static_cast<unsigned long long>(mConfig.mPeriodNs) * value / 65535ULL;
+    const std::string text = std::to_string(duty);
+    if (pwrite(mDutyFd, text.c_str(), text.size(), 0) != static_cast<ssize_t>(text.size())) {
+      DEVLOG_ERROR("[PWMSysfsController] Could not write duty cycle %s to PWM chip %u channel %u: %s\n", text.c_str(),
+                   mConfig.mChipNumber, mConfig.mChannel, strerror(errno));
+      mError = scmFailedToWrite;
+    }
+  }
+
+  ::forte::io::IOHandle *PWMSysfsController::createIOHandle(HandleDescriptor &paHandleDescriptor) {
+    return new PWMSysfsHandle(this, paHandleDescriptor.mDirection);
+  }
+
+  PWMSysfsHandle::PWMSysfsHandle(forte::io::IODeviceController *paController,
+                                 forte::io::IOMapper::Direction paDirection) :
+      IOHandle(paController, paDirection, CIEC_ANY::e_WORD) {
+  }
+
+  void PWMSysfsHandle::set(const CIEC_ANY &paValue) {
+    mValue = static_cast<TForteWord>(static_cast<const CIEC_WORD &>(paValue));
+    mController->handleChangeEvent(this);
+  }
+
+  void PWMSysfsHandle::get(CIEC_ANY &paValue) {
+    static_cast<CIEC_WORD &>(paValue) = CIEC_WORD(mValue);
+  }
+
+} // namespace forte::eclipse4diac::io::pwmsysfs
