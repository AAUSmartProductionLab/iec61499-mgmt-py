+#include "pwmsysfs_config_fb.h"
+#include "pwmsysfs_controller.h"
+
+using namespace forte::literals;
+
+namespace forte::eclipse4diac::io::pwmsysfs {
+
+  namespace {
+    const auto cEventInputNames = std::array{"INIT"_STRID};
+    const auto cEventOutputNames = std::array{"INITO"_STRID, "IND"_STRID};
+    const auto cDataInputNames = std::array{"QI"_STRID,       "VALUE"_STRID,    "ChipNumber"_STRID, "Channel"_STRID,
+                                            "PeriodNs"_STRID, "Inversed"_STRID, "SysfsRoot"_STRID};
+    const auto cDataOutputNames = std::array{"QO"_STRID, "STATUS"_STRID};
+    const SFBInterfaceSpec cFBInterfaceSpec = {
+        .mEINames = cEventInputNames,
+        .mEITypeNames = {},
+        .mEONames = cEventOutputNames,
+        .mEOTypeNames = {},
+        .mDINames = cDataInputNames,
+        .mDONames = cDataOutputNames,
+        .mDIONames = {},
+        .mSocketNames = {},
+        .mPlugNames = {},
+    };
+  } // namespace
+
+  DEFINE_FIRMWARE_FB(FORTE_PWMChip, "eclipse4diac::io::pwmsysfs::PWMChip"_STRID)
+
+  FORTE_PWMChip::FORTE_PWMChip(const forte::StringId paInstanceNameId, CFBContainer &paContainer) :
+      IOConfigFBController(paContainer, cFBInterfaceSpec, paInstanceNameId),
+      var_QI(0_BOOL),
+      var_VALUE(u""_WSTRING),
+      var_ChipNumber(0_UINT),
+      var_Channel(0_UINT),
+      var_PeriodNs(1000000_UDINT),
+      var_Inversed(0_BOOL),
+      var_SysfsRoot(u""_WSTRING),
+      var_QO(0_BOOL),
+      var_STATUS(u""_WSTRING),
+      conn_INITO(*this, 0),
+      conn_IND(*this, 1),
+      conn_QI(nullptr),
+      conn_VALUE(nullptr),
+      conn_ChipNumber(nullptr),
+      conn_Channel(nullptr),
+      conn_PeriodNs(nullptr),
+      conn_Inversed(nullptr),
+      conn_SysfsRoot(nullptr),
+      conn_QO(*this, 0, var_QO),
+      conn_STATUS(*this, 1, var_STATUS) {
+  }
+
+  void FORTE_PWMChip::setInitialValues() {
+    CFunctionBlock::setInitialValues();
+    var_QI = 0_BOOL;
+    var_VALUE = u""_WSTRING;
+    var_ChipNumber = 0_UINT;
+    var_Channel = 0_UINT;
+    var_PeriodNs = 1000000_UDINT;
+    var_Inversed = 0_BOOL;
+    var_SysfsRoot = u""_WSTRING;
+    var_QO = 0_BOOL;
+    var_STATUS = u""_WSTRING;
+  }
+
+  void FORTE_PWMChip::readInputData(const TEventID paEIID) {
+    switch (paEIID) {
+      case scmEventINITID: {
+        readData(0, var_QI, conn_QI);
+        readData(1, var_VALUE, conn_VALUE);
+        readData(2, var_ChipNumber, conn_ChipNumber);
+        readData(3, var_Channel, conn_Channel);
+        readData(4, var_PeriodNs, conn_PeriodNs);
+        readData(5, var_Inversed, conn_Inversed);
+        readData(6, var_SysfsRoot, conn_SysfsRoot);
+        break;
+      }
+      default: break;
+    }
+  }
+
+  void FORTE_PWMChip::writeOutputData(const TEventID paEIID) {
+    switch (paEIID) {
+      case scmEventINITOID:
+      case scmEventINDID: {
+        writeData(7, var_QO, conn_QO);
+        writeData(8, var_STATUS, conn_STATUS);
+        break;
+      }
+      default: break;
+    }
+  }
+
+  CIEC_ANY *FORTE_PWMChip::getDI(const size_t paIndex) {
+    switch (paIndex) {
+      case 0: return &var_QI;
+      case 1: return &var_VALUE;
+      case 2: return &var_ChipNumber;
+      case 3: return &var_Channel;
+      case 4: return &var_PeriodNs;
+      case 5: return &var_Inversed;
+      case 6: return &var_SysfsRoot;
+    }
+    return nullptr;
+  }
+
+  CIEC_ANY *FORTE_PWMChip::getDO(const size_t paIndex) {
+    switch (paIndex) {
+      case 0: return &var_QO;
+      case 1: return &var_STATUS;
+    }
+    return nullptr;
+  }
+
+  CEventConnection *FORTE_PWMChip::getEOConUnchecked(const TPortId paIndex) {
+    switch (paIndex) {
+      case 0: return &conn_INITO;
+      case 1: return &conn_IND;
+    }
+    return nullptr;
+  }
+
+  CDataConnection **FORTE_PWMChip::getDIConUnchecked(const TPortId paIndex) {
+    switch (paIndex) {
+      case 0: return &conn_QI;
+      case 1: return &conn_VALUE;
+      case 2: return &conn_ChipNumber;
+      case 3: return &conn_Channel;
+      case 4: return &conn_PeriodNs;
+      case 5: return &conn_Inversed;
+      case 6: return &conn_SysfsRoot;
+    }
+    return nullptr;
+  }
+
+  CDataConnection *FORTE_PWMChip::getDOConUnchecked(const TPortId paIndex) {
+    switch (paIndex) {
+      case 0: return &conn_QO;
+      case 1: return &conn_STATUS;
+    }
+    return nullptr;
+  }
+
+  forte::io::IODeviceController *FORTE_PWMChip::createDeviceController(CDeviceExecution &paDeviceExecution) {
+    return new PWMSysfsController(paDeviceExecution);
+  }
+
+  void FORTE_PWMChip::setConfig() {
+    PWMSysfsController::Config config;
+    std::string root(var_SysfsRoot.getValue());
+    if (!root.empty()) {
+      config.mRoot = root;
+    }
+    config.mChipNumber = TForteUInt16(var_ChipNumber);
+    config.mChannel = TForteUInt16(var_Channel);
+    config.mPeriodNs = TForteUInt32(var_PeriodNs);
+    config.mInversed = var_Inversed;
+    getDeviceController()->setConfig(&config);
+  }
+
+  void FORTE_PWMChip::onStartup(CEventChainExecutionThread *const paECET) {
+    // Keep the id alive for the handle registration (see the HandleDescriptor fix in forte-patches).
+    std::string id(var_VALUE.getValue());
+    PWMSysfsController::HandleDescriptor desc(id, forte::io::IOMapper::Out);
+    initHandle(desc);
+    started(paECET);
+  }
+
+} // namespace forte::eclipse4diac::io::pwmsysfs
