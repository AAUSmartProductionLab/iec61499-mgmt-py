+/*******************************************************************************
+ * Copyright (c) 2026 Aalborg University
+ * This program and the accompanying materials are made available under the
+ * terms of the Eclipse Public License 2.0 which is available at
+ * http://www.eclipse.org/legal/epl-2.0.
+ *
+ * SPDX-License-Identifier: EPL-2.0
+ *
+ * Contributors:
+ *   Martin Jensen - initial implementation
+ *******************************************************************************/
+
+#pragma once
+
+#include <string>
+
+#include "forte/io/device/io_controller.h"
+
+namespace forte::eclipse4diac::io::pwmsysfs {
+
+  /*! @brief One Linux PWM channel (/sys/class/pwm/pwmchip<N>/pwm<M>).
+   *
+   * The channel is exported, set to its period and enabled at start. Its handle is a WORD:
+   * 0..65535 is the fraction of the period the output is high (duty_cycle = period * value / 65535),
+   * written whenever a QW sets it. At the end the duty cycle is set to 0 and the channel disabled.
+   * Works for the Raspberry Pi's hardware PWM (dtoverlay=pwm-2chan) and any other PWM driver,
+   * e.g. a PCA9685 board through pwm-pca9685.
+   */
+  class PWMSysfsController : public forte::io::IODeviceController {
+    public:
+      explicit PWMSysfsController(CDeviceExecution &paDeviceExecution) : IODeviceController(paDeviceExecution) {};
+
+      struct Config : IODeviceController::Config {
+          std::string mRoot = "/sys/class/pwm";
+          unsigned int mChipNumber = 0;
+          unsigned int mChannel = 0;
+          unsigned long mPeriodNs = 1000000;
+          bool mInversed = false;
+      };
+
+      using IODeviceController::HandleDescriptor;
+
+      void setConfig(struct IODeviceController::Config *paConfig) override {
+        mConfig = *static_cast<Config *>(paConfig);
+      }
+
+      bool isHandleValueEqual(forte::io::IOHandle &) override {
+        return true;
+      }
+
+      void handleChangeEvent(forte::io::IOHandle *paHandle) override;
+      ::forte::io::IOHandle *createIOHandle(HandleDescriptor &paHandleDescriptor) override;
+
+    protected:
+      const char *init() override;
+      void deInit() override;
+      void runLoop() override;
+
+    private:
+      std::string channelPath() const;
+      bool writeFile(const std::string &paFile, const std::string &paValue) const;
+
+      int mDutyFd = -1;
+      Config mConfig;
+
+      static const char *const scmFailedToExport;
+      static const char *const scmFailedToConfigure;
+      static const char *const scmFailedToWrite;
+  };
+
+  /*! @brief WORD handle of a PWM channel: the fraction of the period (0..65535). */
+  class PWMSysfsHandle : public forte::io::IOHandle {
+    public:
+      PWMSysfsHandle(forte::io::IODeviceController *paController, forte::io::IOMapper::Direction paDirection);
+
+      void set(const CIEC_ANY &paValue) override;
+      void get(CIEC_ANY &paValue) override;
+
+      TForteWord value() const {
+        return mValue;
+      }
+
+    private:
+      TForteWord mValue = 0;
+  };
+
+} // namespace forte::eclipse4diac::io::pwmsysfs
