<?xml version="1.0" encoding="UTF-8"?>
<System Name="PubSubDemo" Comment="Two publishers, one subscriber: two counters on two FORTEs, their sum on a third">
  <Identification Standard="61499-2" />
  <Application Name="CountAndAdd" Comment="Counter 1 and Counter 2 each publish (source, count) to the same UDP address; the Adder's one subscriber keeps each source's count and adds them">
    <SubAppNetwork>
      <Group Name="Counter1" Comment="On FORTE_1: counts every second and publishes (1, count)" x="1000" y="1000" width="18800" height="2600" locked="false" />
      <Group Name="Counter2" Comment="On FORTE_2: counts every two seconds and publishes (2, count)" x="1000" y="4400" width="18800" height="2600" locked="false" />
      <Group Name="Adder" Comment="On FORTE_3: one subscriber for both; the source number picks which count to keep, the sum is Sum.OUT, Blink.Q toggles with every new sum" x="1000" y="7800" width="29800" height="3600" locked="false" />
      <FB Name="Boot1" Type="iec61499::events::E_RESTART" x="3000" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Counter1" />
      </FB>
      <FB Name="Pub1" Type="iec61499::net::PUBLISH_2" Comment="SD_1: the source number, SD_2: the count" x="6200" y="500">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="ID" Value="&quot;127.0.0.1:61550&quot;" />
        <Parameter Name="SD_1" Value="UINT#1" />
        <Attribute Name="GroupName" Type="STRING" Value="Counter1" />
      </FB>
      <FB Name="Clock1" Type="iec61499::events::E_CYCLE" x="10200" y="500">
        <Parameter Name="DT" Value="T#1s" />
        <Attribute Name="GroupName" Type="STRING" Value="Counter1" />
      </FB>
      <FB Name="Count1" Type="iec61499::events::E_CTU" x="13800" y="500">
        <Parameter Name="PV" Value="65535" />
        <Attribute Name="GroupName" Type="STRING" Value="Counter1" />
      </FB>
      <FB Name="Boot2" Type="iec61499::events::E_RESTART" x="3000" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Counter2" />
      </FB>
      <FB Name="Pub2" Type="iec61499::net::PUBLISH_2" Comment="SD_1: the source number, SD_2: the count" x="6200" y="500">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="ID" Value="&quot;127.0.0.1:61550&quot;" />
        <Parameter Name="SD_1" Value="UINT#2" />
        <Attribute Name="GroupName" Type="STRING" Value="Counter2" />
      </FB>
      <FB Name="Clock2" Type="iec61499::events::E_CYCLE" x="10200" y="500">
        <Parameter Name="DT" Value="T#2s" />
        <Attribute Name="GroupName" Type="STRING" Value="Counter2" />
      </FB>
      <FB Name="Count2" Type="iec61499::events::E_CTU" x="13800" y="500">
        <Parameter Name="PV" Value="65535" />
        <Attribute Name="GroupName" Type="STRING" Value="Counter2" />
      </FB>
      <FB Name="Boot3" Type="iec61499::events::E_RESTART" x="3000" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <FB Name="Subscriber" Type="iec61499::net::SUBSCRIBE_2" Comment="Receives from both publishers: RD_1 the source number, RD_2 its count" x="6200" y="500">
        <Parameter Name="QI" Value="TRUE" />
        <Parameter Name="ID" Value="&quot;127.0.0.1:61550&quot;" />
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <FB Name="BySource" Type="iec61499::events::E_DEMUX" Comment="EO1 for source 1, EO2 for source 2" x="10200" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <FB Name="Count1In" Type="iec61131::conversion::F_UINT_TO_DINT" Comment="Keeps the last count of source 1" x="13800" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <FB Name="Count2In" Type="iec61131::conversion::F_UINT_TO_DINT" Comment="Keeps the last count of source 2" x="13800" y="2100">
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <FB Name="Sum" Type="iec61131::arithmetic::F_ADD" Comment="OUT: the sum of both counts" x="18600" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <FB Name="Blink" Type="iec61499::events::E_T_FF" Comment="Q toggles with every new sum" x="23400" y="500">
        <Attribute Name="GroupName" Type="STRING" Value="Adder" />
      </FB>
      <EventConnections>
        <Connection Source="Boot1.COLD" Destination="Pub1.INIT" />
        <Connection Source="Boot1.WARM" Destination="Pub1.INIT" />
        <Connection Source="Pub1.INITO" Destination="Clock1.START" />
        <Connection Source="Clock1.EO" Destination="Count1.CU" />
        <Connection Source="Count1.CUO" Destination="Pub1.REQ" />
        <Connection Source="Boot2.COLD" Destination="Pub2.INIT" />
        <Connection Source="Boot2.WARM" Destination="Pub2.INIT" />
        <Connection Source="Pub2.INITO" Destination="Clock2.START" />
        <Connection Source="Clock2.EO" Destination="Count2.CU" />
        <Connection Source="Count2.CUO" Destination="Pub2.REQ" />
        <Connection Source="Boot3.COLD" Destination="Subscriber.INIT" />
        <Connection Source="Boot3.WARM" Destination="Subscriber.INIT" />
        <Connection Source="Subscriber.IND" Destination="BySource.EI" />
        <Connection Source="BySource.EO1" Destination="Count1In.REQ" />
        <Connection Source="BySource.EO2" Destination="Count2In.REQ" />
        <Connection Source="Count1In.CNF" Destination="Sum.REQ" />
        <Connection Source="Count2In.CNF" Destination="Sum.REQ" />
        <Connection Source="Sum.CNF" Destination="Blink.CLK" />
      </EventConnections>
      <DataConnections>
        <Connection Source="Count1.CV" Destination="Pub1.SD_2" />
        <Connection Source="Count2.CV" Destination="Pub2.SD_2" />
        <Connection Source="Subscriber.RD_1" Destination="BySource.K" />
        <Connection Source="Subscriber.RD_2" Destination="Count1In.IN" />
        <Connection Source="Subscriber.RD_2" Destination="Count2In.IN" />
        <Connection Source="Count1In.OUT" Destination="Sum.IN1" />
        <Connection Source="Count2In.OUT" Destination="Sum.IN2" />
      </DataConnections>
    </SubAppNetwork>
  </Application>
  <Device Name="FORTE_1" Type="iec61499::system::FORTE_PC" x="1000" y="1000">
    <Parameter Name="MGR_ID" Comment="Device manager socket ID" Value="&quot;localhost:61501&quot;" />
    <Attribute Name="Profile" Type="STRING" Value="HOLOBLOC" />
    <Attribute Name="Color" Type="STRING" Value="111,190,255" />
    <Resource Name="RES" Type="iec61499::system::EMB_RES" x="0" y="0">
      <FBNetwork />
    </Resource>
  </Device>
  <Device Name="FORTE_2" Type="iec61499::system::FORTE_PC" x="4000" y="1000">
    <Parameter Name="MGR_ID" Comment="Device manager socket ID" Value="&quot;localhost:61502&quot;" />
    <Attribute Name="Profile" Type="STRING" Value="HOLOBLOC" />
    <Attribute Name="Color" Type="STRING" Value="140,220,140" />
    <Resource Name="RES" Type="iec61499::system::EMB_RES" x="0" y="0">
      <FBNetwork />
    </Resource>
  </Device>
  <Device Name="FORTE_3" Type="iec61499::system::FORTE_PC" x="7000" y="1000">
    <Parameter Name="MGR_ID" Comment="Device manager socket ID" Value="&quot;localhost:61503&quot;" />
    <Attribute Name="Profile" Type="STRING" Value="HOLOBLOC" />
    <Attribute Name="Color" Type="STRING" Value="255,190,111" />
    <Resource Name="RES" Type="iec61499::system::EMB_RES" x="0" y="0">
      <FBNetwork />
    </Resource>
  </Device>
  <Mapping From="CountAndAdd.Boot1" To="FORTE_1.RES" />
  <Mapping From="CountAndAdd.Pub1" To="FORTE_1.RES" />
  <Mapping From="CountAndAdd.Clock1" To="FORTE_1.RES" />
  <Mapping From="CountAndAdd.Count1" To="FORTE_1.RES" />
  <Mapping From="CountAndAdd.Boot2" To="FORTE_2.RES" />
  <Mapping From="CountAndAdd.Pub2" To="FORTE_2.RES" />
  <Mapping From="CountAndAdd.Clock2" To="FORTE_2.RES" />
  <Mapping From="CountAndAdd.Count2" To="FORTE_2.RES" />
  <Mapping From="CountAndAdd.Boot3" To="FORTE_3.RES" />
  <Mapping From="CountAndAdd.Subscriber" To="FORTE_3.RES" />
  <Mapping From="CountAndAdd.BySource" To="FORTE_3.RES" />
  <Mapping From="CountAndAdd.Count1In" To="FORTE_3.RES" />
  <Mapping From="CountAndAdd.Count2In" To="FORTE_3.RES" />
  <Mapping From="CountAndAdd.Sum" To="FORTE_3.RES" />
  <Mapping From="CountAndAdd.Blink" To="FORTE_3.RES" />
</System>
