<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_TemplateTimed" Comment="TEMPLATE for your primitive, SK_&lt;Primitive&gt;: copy it under that name, then change what says YOUR OWN, and this comment; keep the rest as it is. A skill primitive: one action of one piece of equipment (move the axis, run the pump, weigh). It can be called on its own over OPC UA, or be a step of a bigger skill. Inside: SKILL_Core (state machine and OPC UA methods), a parameter block per parameter, SC_ (its contract: what this skill does and when it is done), SKILL_Run (one run, the same for every primitive) and EP_ (the equipment as the skill sees it). Technical: Skill primitive TemplateTimed: A primitive to make your own: MyCommand for the time MyParameter gives (parameters: MyParameter [s] 0.0..5.0, default 1.0). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="capping" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: its OPC UA nodes and its equipment's channels">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Holder" />
        <With Var="ReleaseAfter" />
        <With Var="MyParameter" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start a run, from the parent (a step of a sequence): no session check">
        <With Var="MyParameter" />
      </Event>
      <Event Name="HALT" Type="Event" Comment="Stop the run, from the parent" />
      <Event Name="ABORT" Type="Event" Comment="Abort: everything off at once" />
      <Event Name="RESET" Type="Event" Comment="Reset from Failed or Aborted to Idle" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
      <Event Name="SUCCESS" Type="Event" Comment="The run succeeded (the results are set)" />
      <Event Name="FAILURE" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="Methods" Type="BOOL" Comment="Offer the OPC UA methods Start, Stop, Abort, Reset (FALSE: a step, run by its parent)" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="The name the equipment is held under: the skill's own, or for a step the skill it belongs to" />
      <VarDeclaration Name="ReleaseAfter" Type="BOOL" InitialValue="TRUE" Comment="Give up the equipment when the run ends (FALSE: the next step keeps it)" />
      <VarDeclaration Name="MyParameter" Type="LREAL" InitialValue="1.0" Comment="YOUR OWN, one per parameter. Parameter MyParameter s, 0.0 to 5.0: How long it runs" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" Comment="Skill state: 0 Idle, 1 Running, 2 Stopping, 3 Succeeded, 4 Failed, 5 Aborted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with the range check, Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="7390" height="4380" locked="false" />
    <Group Name="Execution" Comment="What the skill is (its contract) and one run of it, the same for every primitive" x="1000" y="5680" width="6655" height="1780" locked="false" />
    <Group Name="Equipment" Comment="The equipment as the skill sees it: its state in, the command out" x="7955" y="5680" width="2790" height="1480" locked="false" />
    <FB Name="Control" Type="modlib::SKILL_Core" x="1390" y="150" Comment="The skill's state machine (SKILL_Core): checks a client's Start, publishes State and ErrorID, offers Stop, Abort and Reset over OPC UA, and starts the run when it may begin.">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Contract" Type="capping::SC_TemplateTimed" x="1270" y="150" Comment="YOUR OWN, Change Type to your SC_&lt;Primitive&gt;. What this skill is (its SC_ type): the command it sends, how long it may run, and when it may start, is done, and must stop.">
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="UaStart" Type="iec61499::net::SERVER_2_2" x="5290" y="150" Comment="YOUR OWN, its size: SERVER_2_&lt;1 + parameters&gt;. The OPC UA method Start: a client's call arrives here with its session id and the parameters; Control's answer (Accepted, ErrorID) goes back to the client.">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Par_MyParameter" Type="modlib::SKILL_Param_LREAL" x="1230" y="2650" Comment="YOUR OWN, one per parameter: SKILL_Param_&lt;its type&gt;. The parameter MyParameter: its default, the check of a client's value against its limits, and the value held for the run.">
      <Parameter Name="Lower" Value="0.0" />
      <Parameter Name="Upper" Value="5.0" />
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="PubParams" Type="iec61499::net::PUBLISH_1" x="5290" y="2650" Comment="YOUR OWN, its size: PUBLISH_&lt;parameters&gt;; without parameters there is no PubParams. Writes the parameter values of the current run to OPC UA (Parameters/...).">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Run" Type="modlib::SKILL_Run" x="4200" y="150" Comment="One run (SKILL_Run, the same in every primitive): waits for the equipment, checks the contract's precondition, sends the command and watches the conditions until the skill is done.">
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="Port" Type="capping::EP_Template" x="950" y="150" Comment="YOUR OWN, Change Type to your equipment's EP_&lt;Equipment&gt; (it is the same in every primitive of that equipment). The equipment as this skill sees it (EP_): its state in (to the contract), the commands from the run (over the adapter AEquipment).">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
