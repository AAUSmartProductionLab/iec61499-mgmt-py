ock;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=1;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="464" y="185"/></Array></mxGeometry></mxCell><mxCell id="c139" value="writes the binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#41484B;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=0.7609;exitY=1;exitDx=0;exitDy=0;entryX=0.8333;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c140" value="reads capabilities, skills" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6E777B;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=1;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1994" y="185"/></Array></mxGeometry></mxCell><mxCell id="c141" value="The product AAS names no equipment (ISA-88's general recipe); one product has a process AAS per line. The binding follows the step to a resource's skill, and hands the skill's parameter the process parameter of the same meaning.&lt;br&gt;Today the planner keeps the binding in the product's step (Resource, Skill, Bindings); the example line's process AAS is made from it (a draft, no template yet), and the planner writes it there with next-steps F6. A reconfiguration changes the resource AAS and at most the process AAS." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="2000" height="70" as="geometry"/></mxCell><mxCell id="c142" value="" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#DFEAF3;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="1121" width="44" height="18" as="geometry"/></mxCell><mxCell id="c143" value="IDTA template" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="146" y="1121" width="260" height="18" as="geometry"/></mxCell><mxCell id="c144" value="" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1121" width="44" height="18" as="geometry"/></mxCell><mxCell id="c145" value="our template" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="386" y="1121" width="260" height="18" as="geometry"/></mxCell><mxCell id="c146" value="" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.25;dashed=1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="1121" width="44" height="18" as="geometry"/></mxCell><mxCell id="c147" value="draft: no template yet