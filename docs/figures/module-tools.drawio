Cell id="c92" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1720" y="1148.1" width="680" height="176" as="geometry"/></mxCell><mxCell id="c93" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1738" y="1164.1" width="46" height="46" as="geometry"/></mxCell><mxCell id="c94" value="Coordination  ·  AAS models, agents, orchestrator" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1796" y="1164.1" width="588" height="28" as="geometry"/></mxCell><mxCell id="c95" value="The AAS models: what a module offers and how its skills run, the product's recipe and its bindings. The orchestrator runs the bound steps on the modules; agents (planned) bid for the steps of an order" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=13.5;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1742" y="1214.1" width="640" height="104" as="geometry"/></mxCell><mxCell id="c96" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1720" y="1517.1" width="680" height="176" as="geometry"/></mxCell><mxCell id="c97" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1738" y="1533.1" width="46" height="46" as="geometry"/></mxCell><mxCell id="c98" value="Control  ·  IEC 61499" style="text;html=1;wh