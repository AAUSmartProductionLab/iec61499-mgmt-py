" parent="1"><mxGeometry x="1702" y="664.8" width="640" height="80" as="geometry"/></mxCell><mxCell id="c88" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1680" y="943.1999999999998" width="680" height="150" as="geometry"/></mxCell><mxCell id="c89" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1698" y="959.1999999999998" width="46" height="46" as="geometry"/></mxCell><mxCell id="c90" value="Information  ·  the AASs" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1756" y="959.1999999999998" width="588" height="28" as="geometry"/></mxCell><mxCell id="c91" value="Product AAS: what it is and its recipe. Process AAS: each step bound to a module's skill. Resource AASs: the line, every module and component, with skills, capabilities, interface, program" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=13.5;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1702" y="1009.1999999999998" width="640" height="80" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1680" y="1222.0" width="680" height="150" as="geometry"/></mxCell><mxCell id="c93" value="" style="shape=image;aspect=fixed;imageAspect=0;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1698" y="1238.0" width="46" he