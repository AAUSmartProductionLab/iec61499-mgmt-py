77B"&gt;Branches/Branch_0000: Home  ‖  Branch_0001: Tare&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#DFEAF3;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="1030" height="44" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;before&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;SUCCESS&lt;/font&gt;' style="rounded=0;fillColor=#F3F4F3;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="300" width="190" height="64" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Both&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;modlib::SKILL_Join2&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="470" width="200" height="80" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Home&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;SK_Home&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="300" width="200" height="70" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Tare&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;SK_Tare&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="600" width="200" height="70" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;next&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;START&lt;/font&gt;' style="rounded=0;fillColor=#F3F4F3;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2210" y="478" width="110" height="64" as="geometry"/></mxCell><mxCell id="c21" value="1: START" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="332"/><mxPoint x="1540" y="450"/><mxPoint x="2030" y="450"/></Array></mxGeometry></mxCell><mxCell id="c22" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="332"/><mxPoint x="1560" y="635"/></Array></mxGeometry></mxCell><mxCell id="c24" value="SUCCESS → DONE_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="335"/><mxPoint x="1890" y="490"/></Array></mxGeometry></mxCell><mxCell id="c25" value="SUCCESS → DONE_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1890" y="635"/><mxPoint x="1890" y="530"/></Array></mxGeometry></mxCell><mxCell id="c26" value="DONE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="HALT (a branch failed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0504D;strokeWidth=1.2;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=1;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=1;entryY=0.2;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2030" y="314"/></Array></mxGeometry></mxCell><mxCell id="c28" value="The join forgets the last run first, then every branch starts. It answers DONE when all are done; on a failure it halts the others and answers FAILED when all have ended. Branches use different components." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1280" y="400" width="210" height="260" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#252B2D;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="1110" height="560" as="geometry"/></mxCell><mxCell id="c30" value="A decision (and a conditional step)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="72" y="524" width="547" height="32" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;decision Light&lt;/b&gt;  &lt;font color="#6E777B"&gt;Condition: Weigh.Weight lt 2.5 g;  Branches: TopUp | Fine&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#DFEAF3;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="590" width="1030" height="44" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b&gt;Weigh&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;SUCCESS&lt;/font&gt;' style="rounded=0;fillColor=#F3F4F3;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="690" width="170" height="64" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;Light_C1&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;modlib::SKILL_Condition_LREAL&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="250" height="80" as="geometry"/></mxCell><mxCell id="c34" value='&lt;b&gt;TopUp&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;SK_Dispense&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="640" width="190" height="70" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b&gt;Fine&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;SK_Weigh&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="800" width="190" height="70" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b&gt;Light&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;modlib::SKILL_Merge&lt;/font&gt;' style="rounded=0;fillColor=#F4F9FC;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="720" width="200" height="70" as="geometry"/></mxCell><mxCell id="c37" value="EVAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="EI1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c34" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="EI2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="Weigh.R_Weight → Light_C1.Operand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C91B2;strokeWidth=1.4;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=1;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="830"/><mxPoint x="455" y="830"/></Array></mxGeometry></mxCell><mxCell id="c43" value="Expected 2.5 and Operator 'lt' are values of the condition block. A conditional step has no second branch: NO goes straight to EI2. The merge's EO starts what follows. A condition compares a parameter of the skill or a result of a step that has run on every path to it." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="900" width="1040" height="80" as="geometry"/></mxCell><mxCell id="c44" value="Names: the merge is called like the decision, its comparisons &amp;lt;decision&amp;gt;_C1, _C2, …" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#252B2D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="990" width="1040" height="60" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#252B2D;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1240" y="760" width="1110" height="340" as="geometry"/></mxCell><mxCell id="c46" value="Groups of conditions: chains, no new type" style="text;html=1;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1262" y="744" width="637" height="32" as="geometry"/></mxCell><mxCell id="c47" value="all (c1, c2)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1280" y="792" width="300" height="28" as="geometry"/></mxCell><mxCell id="c48" value='&lt;b&gt;c1&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;Condition&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="850" width="150" height="60" as="geometry"/></mxCell><mxCell id="c49" value='&lt;b&gt;c2&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;Condition&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="850" width="150" height="60" as="geometry"/></mxCell><mxCell id="c50" value="first branch" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1690" y="830" width="90" height="34" as="geometry"/></mxCell><mxCell id="c51" value="second" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#F3DDD6;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1690" y="900" width="90" height="34" as="geometry"/></mxCell><mxCell id="c52" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c48" target="c51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="960"/><mxPoint x="1735" y="960"/></Array></mxGeometry></mxCell><mxCell id="c55" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c49" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="any (c1, c2)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1820" y="792" width="300" height="28" as="geometry"/></mxCell><mxCell id="c57" value='&lt;b&gt;c1&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;Condition&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1820" y="850" width="150" height="60" as="geometry"/></mxCell><mxCell id="c58" value='&lt;b&gt;c2&lt;/b&gt;&lt;br&gt;&lt;font color="#6C91B2" style="font-size:11px"&gt;Condition&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2040" y="850" width="150" height="60" as="geometry"/></mxCell><mxCell id="c59" value="first branch" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="830" width="90" height="34" as="geometry"/></mxCell><mxCell id="c60" value="second" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#F3DDD6;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="900" width="90" height="34" as="geometry"/></mxCell><mxCell id="c61" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c57" target="c59"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1895" y="830"/><mxPoint x="2275" y="830"/></Array></mxGeometry></mxCell><mxCell id="c63" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c58" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c58" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="All: each YES evaluates the next, every NO leads to the second branch. Any: each NO evaluates the next, every YES leads to the first. Groups nest; read back, a group is told by the chain it makes." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1280" y="990" width="1040" height="80" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F3F4F3;strokeColor=#41484B;strokeWidth=1.3;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="1150" width="2300" height="300" as="geometry"/></mxCell><mxCell id="c67" value="Why three library types are enough" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1168" width="900" height="30" as="geometry"/></mxCell><mxCell id="c68" value="•  A flow is only instances of library types and of the module's primitives: FORTE creates it online, no build." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1215" width="2200" height="44" as="geometry"/></mxCell><mxCell id="c69" value="•  The blocks hold no resources: no INIT, nothing to set up; the steps keep the skill's equipment, Control releases it at the end." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1267" width="2200" height="44" as="geometry"/></mxCell><mxCell id="c70" value="•  The same function builds a flow when a module is generated and when a skill is created online." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1319" width="2200" height="44" as="geometry"/></mxCell><mxCell id="c71" value="•  Read back from the program by the same patterns, the flow is the one the AAS describes (a test, for every shape)." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1371" width="2200" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mapping-2" name="The AAS as the target"><mxGraphModel dx="1414" dy="1007" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The AAS is the target state of the module" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=36;fontColor=#252B2D;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="38" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="modsync reconfigure: what the AAS describes and what runs are read into one structure and compared; what may change online is changed, checked and written down" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="87" width="1500" height="20" as="geometry"/></mxCell><mxCell id="c3" value="modsync" style="text;html=1;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1740" y="54" width="600" height="19" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;AAS&lt;/b&gt; (module + components)&lt;br&gt;&lt;font style="font-size:14px" color="#6E777B"&gt;Skills: what is wanted&lt;br&gt;Deployment: built or described&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DFEAF3;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="420" height="150" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;FORTE&lt;/b&gt; on the module&lt;br&gt;&lt;font style="font-size:14px" color="#6E777B"&gt;the running program&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="420" height="150" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;What is wanted&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#6E777B"&gt;a module spec without wiring&lt;br&gt;(described: refused if the module cannot carry it out)&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="380" height="150" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;What runs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#6E777B"&gt;read back by the module rules&lt;br&gt;(instances, connections, values, hashes)&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="760" width="380" height="150" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Compare&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#6E777B"&gt;one structure each, compared&lt;br&gt;and sorted into&lt;/font&gt;' style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F3F4F3;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#252B2D;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="470" width="360" height="190" as="geometry"/></mxCell><mxCell id="c9" value="read (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="QUERY, READ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;create&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="400" width="140" height="50" as="geometry"/></mxCell><mxCell id="c14" value="a skill that is described, not built" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1755" y="400" width="560" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;write&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#D9EEE5;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="480" width="140" height="50" as="geometry"/></mxCell><mxCell id="c16" value="a constant, a default, a limit" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1755" y="480" width="560" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;restart&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#F3DDD6;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="560" width="140" height="50" as="geometry"/></mxCell><mxCell id="c18" value="another flow, a removed skill: refused" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1755" y="560" width="560" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;record&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=40;fillColor=#F3DDD6;strokeColor=#41484B;strokeWidth=1.25;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#252B2D;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="640" width="140" height="50" as="geometry"/></mxCell><mxCell id="c20" value="the record is wrong: refused" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#6E777B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1755" y="640" width="560" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Apply online&lt;/b&gt; (guarded: values only when nobody runs or occupies the module)&lt;br&gt;1&amp;nbsp;&amp;nbsp;WRITE the changed values&lt;br&gt;2&amp;nbsp;&amp;nbsp;CREATE the new instances&lt;br&gt;3&amp;nbsp;&amp;nbsp;WRITE their values&lt;br&gt;4&amp;nbsp;&amp;nbsp;CONNECT them, and the INIT chain's end to the new skill&lt;br&gt;5&amp;nbsp;&amp;nbsp;START them&lt;br&gt;6&amp;nbsp;&amp;nbsp;WRITE $e at that INIT link: INIT runs once through the new skill" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1600" y="760" width="720" height="190" as="geometry"/></mxCell><mxCell id="c22" value="create, write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.3;" edge="1" parent="1" source="c8" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="603"/><mxPoint x="1560" y="835"/></Array></mxGeometry></mxCell><mxCell id="c23" value="commands over the management protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;" edge="1" parent="1" source="c21" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1744" y="1080"/><mxPoint x="290" y="1080"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Verify, keep, write down.&lt;/b&gt; Read back and compare again: nothing may be left over. Add the commands to the boot file (a restart keeps the change). In the AAS: Deployment = Built, the new skill's interface (actions, data points, mappings), the capabilities derived anew. In the integrator's record: the instances with types and hashes, the change log." style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F3F4F3;strokeColor=#41484B;strokeWidth=1.2;dashed=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#252B2D;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="640" y="1150" width="1680" height="170" as="geometry"/></mxCell><mxCell id="c25" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#252B2D;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;entryX=0.98;entryY=0;" edge="1" parent="1" source="c21" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2248" y="1120"/></Array></mxGeometry></mxCell><mxCell id="c26" value="recorded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B963B;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;dashed=0;fontFamily=Arial;fontSize=13;fontColor=#6E777B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="1235"/><mxPoint x="60" y="300"/></Array></mxGeometry></mxCell><mxCell id="c27" value="The tools never need the spec the program was generated from: the AAS says what is wanted, the module rules say how it looks in a program, the program says what is." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#252B2D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="460" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
