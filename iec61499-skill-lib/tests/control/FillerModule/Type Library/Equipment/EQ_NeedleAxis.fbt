<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_NeedleAxis" Comment="An equipment block: the only block that touches this equipment's pins. Skills send it what to switch over a local channel; it switches the outputs (off first, then on), reads the inputs every cycle and reports them to the skills and to OPC UA. One skill holds it at a time; on release or when the module aborts it switches everything off. Technical: Needle lift with down/up valves, end switches and a position sensor; equipment IO: owns its IO points, writes the output values its holder sends, reads its inputs every cycle and reports changes">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="AtTop_Address" />
        <With Var="AtTop_Sim" />
        <With Var="AtBottom_Address" />
        <With Var="AtBottom_Sim" />
        <With Var="Position_Address" />
        <With Var="Position_Sim" />
        <With Var="Position_Scale" />
        <With Var="Down_Address" />
        <With Var="Up_Address" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;NeedleAxis&quot;" Comment="The equipment item's name: its local channels and OPC UA folder" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" Comment="How often the inputs are read" />
      <VarDeclaration Name="AtTop_Address" Type="STRING" Comment="Where AtTop is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="AtTop_Sim" Type="BOOL" InitialValue="FALSE" Comment="The value of AtTop when simulated (address 'sim')" />
      <VarDeclaration Name="AtBottom_Address" Type="STRING" Comment="Where AtBottom is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="AtBottom_Sim" Type="BOOL" InitialValue="FALSE" Comment="The value of AtBottom when simulated (address 'sim')" />
      <VarDeclaration Name="Position_Address" Type="STRING" Comment="Where Position is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Position_Sim" Type="LREAL" InitialValue="0.0" Comment="The value of Position when simulated (address 'sim')" />
      <VarDeclaration Name="Position_Scale" Type="LREAL" InitialValue="0.1" Comment="Engineering value per raw count of Position" />
      <VarDeclaration Name="Down_Address" Type="STRING" Comment="Where Down is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Up_Address" Type="STRING" Comment="Where Up is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <Group Name="Core" Comment="One holder at a time, break before make, all off on release or abort; scanned every CycleTime" x="1000" y="1000" width="4650" height="2880" locked="false" />
    <Group Name="Channels" Comment="Local channels to and from the skills (cmd, release, state), the module's state, and the inputs over OPC UA" x="1000" y="4180" width="7770" height="3080" locked="false" />
    <Group Name="Inputs" Comment="The equipment's sensors: read every cycle, one block per IO point" x="1000" y="7560" width="8805" height="1480" locked="false" />
    <Group Name="Outputs" Comment="The equipment's actuators: written on a change and every cycle, one block per IO point" x="1000" y="9340" width="5000" height="1380" locked="false" />
    <FB Name="Logic" Type="filler::EL_NeedleAxis" x="950" y="150" Comment="The equipment's logic (EL_): takes commands from one holder at a time, switches the outputs (off first, then on), switches all off on release or module abort, and reports input changes.">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="3690" y="150" Comment="Ticks every cycle so the inputs are read and the outputs refreshed.">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="950" y="150" Comment="Watches the module's PackML state, to switch everything off when the module aborts.">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="3500" y="150" Comment="Receives the commands skills send on this equipment's command channel.">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubRelease" Type="iec61499::net::SUBSCRIBE_1" x="6050" y="150" Comment="Hears the module's release channel: when its holder gives up, everything goes off.">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_4" x="990" y="1450" Comment="Publishes the inputs and the holder on this equipment's state channel, for the skills.">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_3" x="3740" y="1450" Comment="Writes the inputs (and a position, if it keeps one) to OPC UA, below Equipment/&lt;item&gt;.">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="In_AtTop" Type="modlib::IO_DI" x="1230" y="150" Comment="The pin AtTop: reads the input at AtTop_Address (a Pi pin, Modbus, or simulated).">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="In_AtBottom" Type="modlib::IO_DI" x="4055" y="150" Comment="The pin AtBottom: reads the input at AtBottom_Address (a Pi pin, Modbus, or simulated).">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="In_Position" Type="modlib::IO_AI" x="7005" y="150" Comment="The pin Position: reads the input at Position_Address (a Pi pin, Modbus, or simulated).">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="Out_Down" Type="modlib::IO_DO" x="1190" y="150" Comment="The pin Down: switches the output at Down_Address (a Pi pin, Modbus, or simulated).">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Up" Type="modlib::IO_DO" x="3530" y="150" Comment="The pin Up: switches the output at Up_Address (a Pi pin, Modbus, or simulated).">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
