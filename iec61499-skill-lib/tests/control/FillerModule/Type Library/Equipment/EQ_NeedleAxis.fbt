<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EQ_NeedleAxis" Comment="Needle lift with down/up valves, end switches and a position sensor; equipment IO: owns its IO points, writes the output values its holder sends, reads its inputs every cycle and reports changes">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="Name" />
        <With Var="UaRoot" />
        <With Var="UaEnable" />
        <With Var="CycleTime" />
        <With Var="AtTop_Address" />
        <With Var="AtTop_Sim" />
        <With Var="AtBottom_Address" />
        <With Var="AtBottom_Sim" />
        <With Var="Position_Address" />
        <With Var="Position_Sim" />
        <With Var="Position_Scale" />
        <With Var="Down_Address" />
        <With Var="Up_Address" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Name" Type="WSTRING" InitialValue="&quot;NeedleAxis&quot;" Comment="The equipment item's name: its local channels and OPC UA folder" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="CycleTime" Type="TIME" InitialValue="T#50ms" Comment="How often the inputs are read" />
      <VarDeclaration Name="AtTop_Address" Type="STRING" Comment="Where AtTop is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="AtTop_Sim" Type="BOOL" InitialValue="FALSE" Comment="The value of AtTop when simulated (address 'sim')" />
      <VarDeclaration Name="AtBottom_Address" Type="STRING" Comment="Where AtBottom is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="AtBottom_Sim" Type="BOOL" InitialValue="FALSE" Comment="The value of AtBottom when simulated (address 'sim')" />
      <VarDeclaration Name="Position_Address" Type="STRING" Comment="Where Position is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Position_Sim" Type="LREAL" InitialValue="0.0" Comment="The value of Position when simulated (address 'sim')" />
      <VarDeclaration Name="Position_Scale" Type="LREAL" InitialValue="0.1" Comment="Engineering value per raw count of Position" />
      <VarDeclaration Name="Down_Address" Type="STRING" Comment="Where Down is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
      <VarDeclaration Name="Up_Address" Type="STRING" Comment="Where Up is: 'gpio[chip:line(:pull_up|:pull_down)(:active_low)]', 'pwm[chip:channel:period_ns]', 'modbus[...]', 'sim', or an IO handle's name; empty: not connected" />
    </InputVars>
    <OutputVars />
  </InterfaceList>
  <FBNetwork>
    <Group Name="Core" Comment="One holder at a time, break before make, all off on release or abort; scanned every CycleTime" x="1000" y="1000" width="2370" height="2900" locked="false" />
    <Group Name="Channels" Comment="Local channels to and from the skills (cmd, release, state), the module's state, and the inputs over OPC UA" x="3670" y="1000" width="4010" height="3100" locked="false" />
    <Group Name="Inputs" Comment="The equipment's sensors: read every cycle, one block per IO point" x="7980" y="1000" width="3405" height="1500" locked="false" />
    <Group Name="Outputs" Comment="The equipment's actuators: written on a change and every cycle, one block per IO point" x="1000" y="4400" width="2080" height="1400" locked="false" />
    <FB Name="Logic" Type="filler::EL_NeedleAxis" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Cycle" Type="iec61499::events::E_CYCLE" x="1600" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Core" />
    </FB>
    <FB Name="Mode" Type="modlib::MOD_StateView" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubCmd" Type="iec61499::net::SUBSCRIBE_4" x="1710" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="SubRelease" Type="iec61499::net::SUBSCRIBE_1" x="3000" y="500">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubState" Type="iec61499::net::PUBLISH_4" x="480" y="1800">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="PubUa" Type="iec61499::net::PUBLISH_3" x="1530" y="1800">
      <Attribute Name="GroupName" Type="STRING" Value="Channels" />
    </FB>
    <FB Name="In_AtTop" Type="modlib::IO_DI" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="In_AtBottom" Type="modlib::IO_DI" x="1285" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="In_Position" Type="modlib::IO_AI" x="2395" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Inputs" />
    </FB>
    <FB Name="Out_Down" Type="modlib::IO_DO" x="300" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <FB Name="Out_Up" Type="modlib::IO_DO" x="1240" y="500">
      <Attribute Name="GroupName" Type="STRING" Value="Outputs" />
    </FB>
    <EventConnections>
      <Connection Source="INIT" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="Mode.INIT" />
      <Connection Source="Mode.INITO" Destination="SubCmd.INIT" />
      <Connection Source="SubCmd.INITO" Destination="SubRelease.INIT" />
      <Connection Source="SubRelease.INITO" Destination="PubState.INIT" />
      <Connection Source="PubState.INITO" Destination="PubUa.INIT" />
      <Connection Source="PubUa.INITO" Destination="In_AtTop.INIT" />
      <Connection Source="In_AtTop.INITO" Destination="In_AtBottom.INIT" />
      <Connection Source="In_AtBottom.INITO" Destination="In_Position.INIT" />
      <Connection Source="In_Position.INITO" Destination="Out_Down.INIT" />
      <Connection Source="Out_Down.INITO" Destination="Out_Up.INIT" />
      <Connection Source="Out_Up.INITO" Destination="Cycle.START" />
      <Connection Source="Out_Up.INITO" Destination="INITO" />
      <Connection Source="SubCmd.IND" Destination="Logic.CMD" />
      <Connection Source="SubRelease.IND" Destination="Logic.RELEASE" />
      <Connection Source="Mode.CHG" Destination="Logic.MOD_CHG" />
      <Connection Source="Cycle.EO" Destination="Logic.REFRESH" />
      <Connection Source="Cycle.EO" Destination="In_AtTop.REQ" />
      <Connection Source="In_AtTop.CNF" Destination="In_AtBottom.REQ" />
      <Connection Source="In_AtBottom.CNF" Destination="In_Position.REQ" />
      <Connection Source="In_Position.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.STATE" Destination="PubState.REQ" />
      <Connection Source="Logic.STATE" Destination="PubUa.REQ" />
      <Connection Source="Logic.DRIVE" Destination="Out_Down.REQ" />
      <Connection Source="Out_Down.CNF" Destination="Out_Up.REQ" />
      <Connection Source="Out_Up.CNF" Destination="Logic.DRIVEN" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="Logic.Module" />
      <Connection Source="Name" Destination="Logic.Name" />
      <Connection Source="UaRoot" Destination="Logic.UaRoot" />
      <Connection Source="Module" Destination="Mode.Module" />
      <Connection Source="Logic.IdCmd" Destination="SubCmd.ID" />
      <Connection Source="Logic.IdRelease" Destination="SubRelease.ID" />
      <Connection Source="Logic.IdState" Destination="PubState.ID" />
      <Connection Source="Logic.IdPub" Destination="PubUa.ID" />
      <Connection Source="UaEnable" Destination="PubUa.QI" />
      <Connection Source="CycleTime" Destination="Cycle.DT" />
      <Connection Source="SubCmd.RD_1" Destination="Logic.C_Holder" />
      <Connection Source="SubCmd.RD_2" Destination="Logic.C_Release" />
      <Connection Source="SubCmd.RD_3" Destination="Logic.C_Down" />
      <Connection Source="SubCmd.RD_4" Destination="Logic.C_Up" />
      <Connection Source="SubRelease.RD_1" Destination="Logic.R_Holder" />
      <Connection Source="Mode.State" Destination="Logic.ModuleState" />
      <Connection Source="AtTop_Address" Destination="In_AtTop.Address" />
      <Connection Source="AtTop_Sim" Destination="In_AtTop.SimValue" />
      <Connection Source="In_AtTop.IN" Destination="Logic.I_AtTop" />
      <Connection Source="Logic.AtTop" Destination="PubState.SD_1" />
      <Connection Source="Logic.AtTop" Destination="PubUa.SD_1" />
      <Connection Source="AtBottom_Address" Destination="In_AtBottom.Address" />
      <Connection Source="AtBottom_Sim" Destination="In_AtBottom.SimValue" />
      <Connection Source="In_AtBottom.IN" Destination="Logic.I_AtBottom" />
      <Connection Source="Logic.AtBottom" Destination="PubState.SD_2" />
      <Connection Source="Logic.AtBottom" Destination="PubUa.SD_2" />
      <Connection Source="Position_Address" Destination="In_Position.Address" />
      <Connection Source="Position_Sim" Destination="In_Position.SimValue" />
      <Connection Source="Position_Scale" Destination="In_Position.Scale" />
      <Connection Source="In_Position.IN" Destination="Logic.I_Position" />
      <Connection Source="Logic.Position" Destination="PubState.SD_3" />
      <Connection Source="Logic.Position" Destination="PubUa.SD_3" />
      <Connection Source="Logic.Holder" Destination="PubState.SD_4" />
      <Connection Source="Down_Address" Destination="Out_Down.Address" />
      <Connection Source="Logic.O_Down" Destination="Out_Down.OUT" />
      <Connection Source="Up_Address" Destination="Out_Up.Address" />
      <Connection Source="Logic.O_Up" Destination="Out_Up.OUT" />
    </DataConnections>
  </FBNetwork>
</FBType>