<?xml version='1.0' encoding='utf-8'?>
<FBType Name="EP_NeedleAxis" Comment="The equipment as its skills see it, the same in every skill that uses it: plays a command (its output values, phase by phase) on the equipment's command channel, and gives the equipment's newest state. Technical: NeedleAxis as its skills see it: a command on the socket Skill (AEquipment: SEND, PLAYED when all phases are out) goes out on its command channel; STATE gives its inputs and holder">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: name the equipment's channels and listen to its state">
        <With Var="Module" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
      <Event Name="STATE" Type="Event" Comment="The equipment's newest state: its inputs and who holds it">
        <With Var="AtTop" />
        <With Var="AtBottom" />
        <With Var="Position" />
        <With Var="EqHolder" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="AtTop" Type="BOOL" Comment="NeedleAxis: AtTop, an input" />
      <VarDeclaration Name="AtBottom" Type="BOOL" Comment="NeedleAxis: AtBottom, an input" />
      <VarDeclaration Name="Position" Type="LREAL" Comment="NeedleAxis: Position (mm), an input" />
      <VarDeclaration Name="EqHolder" Type="WSTRING" Comment="Who holds the equipment now (empty: free)" />
    </OutputVars>
    <Sockets>
      <AdapterDeclaration Name="Skill" Type="modlib::AEquipment" x="-2600" y="1000" Comment="From a skill's run (AEquipment): the commands to play, PLAYED back" />
    </Sockets>
  </InterfaceList>
  <FBNetwork>
    <Group Name="StateIn" Comment="The equipment's state in: its inputs and who holds it, from its state channel" x="1000" y="1000" width="5580" height="1780" locked="false" />
    <Group Name="CommandOut" Comment="A command out: its output values, phase by phase (the command table), on the command channel" x="1000" y="3080" width="7610" height="1880" locked="false" />
    <FB Name="EqView" Type="filler::EV_NeedleAxis" x="1070" y="150" Comment="Names the equipment's channels, and unpacks its state into named values.">
      <Attribute Name="GroupName" Type="STRING" Value="StateIn" />
    </FB>
    <FB Name="EqState" Type="iec61499::net::SUBSCRIBE_4" x="3740" y="150" Comment="Listens to the equipment's state channel: its inputs and who holds it.">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="StateIn" />
    </FB>
    <FB Name="Driver" Type="filler::EC_NeedleAxis" x="990" y="150" Comment="The equipment's command table (EC_): turns a command into output values, phase by phase.">
      <Attribute Name="GroupName" Type="STRING" Value="CommandOut" />
    </FB>
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="3740" y="150" Comment="Times the phases of a command.">
      <Attribute Name="GroupName" Type="STRING" Value="CommandOut" />
    </FB>
    <FB Name="EqCmd" Type="iec61499::net::PUBLISH_4" x="6010" y="150" Comment="Sends the output values and the holder's name to the equipment block on its command channel.">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="CommandOut" />
    </FB>
    <EventConnections>
      <Connection Source="INIT" Destination="EqView.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.INITO" Destination="EqState.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqState.INITO" Destination="EqCmd.INIT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqCmd.INITO" Destination="INITO">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqState.IND" Destination="EqView.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.CNF" Destination="STATE">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Skill.SEND" Destination="Driver.PLAY">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.OUT" Destination="EqCmd.REQ">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.PHASE_START" Destination="PhaseT.START">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.PHASE_STOP" Destination="PhaseT.STOP">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="PhaseT.EO" Destination="Driver.PHASE_T">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.PLAYED" Destination="Skill.PLAYED">
        <Attribute Name="Visible" Value="false" />
      </Connection>
    </EventConnections>
    <DataConnections>
      <Connection Source="Module" Destination="EqView.Module">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.IdState" Destination="EqState.ID">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.IdCmd" Destination="EqCmd.ID">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqState.RD_1" Destination="EqView.I_AtTop">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqState.RD_2" Destination="EqView.I_AtBottom">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqState.RD_3" Destination="EqView.I_Position">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqState.RD_4" Destination="EqView.I_Holder">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.AtTop" Destination="AtTop">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.AtBottom" Destination="AtBottom">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.Position" Destination="Position">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="EqView.Holder" Destination="EqHolder">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Skill.Holder" Destination="Driver.Holder">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Skill.Command" Destination="Driver.Command">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Skill.Release" Destination="Driver.Release">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.O_Holder" Destination="EqCmd.SD_1">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.O_Release" Destination="EqCmd.SD_2">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.N_Down" Destination="EqCmd.SD_3">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.N_Up" Destination="EqCmd.SD_4">
        <Attribute Name="Visible" Value="false" />
      </Connection>
      <Connection Source="Driver.PhaseDT" Destination="PhaseT.DT">
        <Attribute Name="Visible" Value="false" />
      </Connection>
    </DataConnections>
  </FBNetwork>
</FBType>