<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SKILL_Control" Comment="The skill's state machine inside SKILL_Core: what Start, Stop, Abort and Reset do in each state, and the answer a client gets. Technical: Skill state machine: Start/Stop/Abort/Reset over OPC UA (owner only, Start only in module Execute) and START/HALT/ABORT from a parent; Idle 0, Running 1, Stopping 2, Succeeded 3, Failed 4, Aborted 5; RUN starts the execution (CalledByClient: with the Start arguments, else with the parent's values)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise, once at start-up (the INIT chain); takes the values given with it">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
      </Event>
      <Event Name="START_REQ" Type="Event" Comment="Start(Session, parameters) was called: check Session, ParamsInRange, EquipmentFree">
        <With Var="Session" />
        <With Var="ParamsInRange" />
        <With Var="EquipmentFree" />
      </Event>
      <Event Name="STOP_REQ" Type="Event" Comment="Stop(Session) was called">
        <With Var="StopSession" />
      </Event>
      <Event Name="ABORT_REQ" Type="Event" Comment="Abort(Session) was called">
        <With Var="AbortSession" />
      </Event>
      <Event Name="RESET_REQ" Type="Event" Comment="Reset(Session) was called">
        <With Var="ResetSession" />
      </Event>
      <Event Name="OWNER_CHG" Type="Event" Comment="The module's owner changed">
        <With Var="Owner" />
      </Event>
      <Event Name="MOD_CHG" Type="Event" Comment="The module's state changed (its Stopping halts, its Aborting aborts the skill)">
        <With Var="ModuleState" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start a run, from the parent (a step of a sequence): no session check" />
      <Event Name="HALT" Type="Event" Comment="Stop the run, from the parent" />
      <Event Name="ABORT" Type="Event" Comment="Abort: everything off at once" />
      <Event Name="RESET" Type="Event" Comment="Reset from Failed or Aborted to Idle" />
      <Event Name="EXECUTE_DONE" Type="Event" Comment="The execution ended successfully" />
      <Event Name="EXECUTE_FAILED" Type="Event" Comment="The execution failed (ExecuteError)">
        <With Var="ExecuteError" />
      </Event>
      <Event Name="STOPPING_DONE" Type="Event" Comment="The stop sequence ended" />
      <Event Name="TO_IDLE" Type="Event" Comment="Succeeded long enough: back to Idle" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on">
        <With Var="StartMethodId" />
        <With Var="StopMethodId" />
        <With Var="AbortMethodId" />
        <With Var="ResetMethodId" />
        <With Var="StateId" />
        <With Var="ActivityId" />
        <With Var="ReleaseId" />
      </Event>
      <Event Name="START_RSP" Type="Event" Comment="Answer to Start">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="STOP_RSP" Type="Event" Comment="Answer to Stop">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="ABORT_RSP" Type="Event" Comment="Answer to Abort">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="RESET_RSP" Type="Event" Comment="Answer to Reset">
        <With Var="Accepted" />
        <With Var="ResponseError" />
      </Event>
      <Event Name="PUB" Type="Event" Comment="Publish State and ErrorID">
        <With Var="State" />
        <With Var="ErrorID" />
      </Event>
      <Event Name="RUN" Type="Event" Comment="Run: latch the parameters, start the execution">
        <With Var="CalledByClient" />
      </Event>
      <Event Name="HALT_SEQ" Type="Event" Comment="Halt the execute sequence" />
      <Event Name="ABORT_SEQ" Type="Event" Comment="Abort the sequences" />
      <Event Name="RESET_SEQ" Type="Event" Comment="Reset the sequences" />
      <Event Name="RUN_STOPPING" Type="Event" Comment="Run the stop sequence (the skill was stopped)" />
      <Event Name="SUCCESS" Type="Event" Comment="The run succeeded (the results are set)" />
      <Event Name="FAILURE" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
      <Event Name="RELEASE" Type="Event" Comment="A run ended: give up what the skill holds (published if ReleaseAll)" />
      <Event Name="ACT" Type="Event" Comment="Count the module's activity (ActivityDelta)">
        <With Var="ActivityDelta" />
      </Event>
      <Event Name="TO_IDLE_START" Type="Event" Comment="Start the timer back to Idle" />
      <Event Name="TO_IDLE_STOP" Type="Event" Comment="Stop the timer back to Idle" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="Session" Type="WSTRING" Comment="Session ID of the caller of Start (must be the module's owner)" />
      <VarDeclaration Name="ParamsInRange" Type="BOOL" Comment="Every Start argument lies within its limits" />
      <VarDeclaration Name="EquipmentFree" Type="BOOL" Comment="The equipment is free, or held by this skill" />
      <VarDeclaration Name="StopSession" Type="WSTRING" Comment="Session ID of the caller of Stop" />
      <VarDeclaration Name="AbortSession" Type="WSTRING" Comment="Session ID of the caller of Abort" />
      <VarDeclaration Name="ResetSession" Type="WSTRING" Comment="Session ID of the caller of Reset" />
      <VarDeclaration Name="Owner" Type="WSTRING" Comment="Session ID of the module's owner (empty: free)" />
      <VarDeclaration Name="ModuleState" Type="USINT" Comment="PackML state: 1 Clearing, 2 Stopped, 3 Starting, 4 Idle, 6 Execute, 7 Stopping, 8 Aborting, 9 Aborted, 15 Resetting" />
      <VarDeclaration Name="ExecuteError" Type="UINT" Comment="Why the execution failed" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="StartMethodId" Type="WSTRING" Comment="OPC UA ID of the Start method, for its SERVER block" />
      <VarDeclaration Name="StopMethodId" Type="WSTRING" Comment="OPC UA ID of the Stop method" />
      <VarDeclaration Name="AbortMethodId" Type="WSTRING" Comment="OPC UA ID of the Abort method" />
      <VarDeclaration Name="ResetMethodId" Type="WSTRING" Comment="OPC UA ID of the Reset method" />
      <VarDeclaration Name="StateId" Type="WSTRING" Comment="OPC UA ID of the published State and ErrorID" />
      <VarDeclaration Name="ActivityId" Type="WSTRING" Comment="Local channel of the module's activity count" />
      <VarDeclaration Name="ReleaseId" Type="WSTRING" Comment="Local channel the module's equipment is released on" />
      <VarDeclaration Name="Accepted" Type="BOOL" Comment="The call was accepted" />
      <VarDeclaration Name="ResponseError" Type="UINT" Comment="Why a call was refused (error code)" />
      <VarDeclaration Name="State" Type="USINT" Comment="Skill state: 0 Idle, 1 Running, 2 Stopping, 3 Succeeded, 4 Failed, 5 Aborted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
      <VarDeclaration Name="ActivityDelta" Type="INT" Comment="+1 when the run starts, -1 when it ends" />
      <VarDeclaration Name="CalledByClient" Type="BOOL" Comment="Started over OPC UA (take the Start arguments), not by a parent (take the defaults)" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Owned" Type="BOOL" />
      <VarDeclaration Name="Here" Type="USINT" />
      <VarDeclaration Name="Active" Type="BOOL" />
    </InternalVars>
    <ECC>
