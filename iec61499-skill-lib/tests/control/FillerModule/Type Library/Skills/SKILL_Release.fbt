<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SKILL_Release" Comment="Names the holder that gives up the equipment a module level skill holds after a failure or abort, for the equipment's release channels (all outputs off, free again)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="modlib" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event">
        <With Var="Token" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="Holder" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Token" Type="WSTRING" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Holder" Type="WSTRING" />
    </OutputVars>
  </InterfaceList>
  <SimpleFB>
    <ECState Name="REQ">
      <ECAction Algorithm="REQ" Output="CNF" />
    </ECState>
    <Algorithm Name="REQ">
      <ST>Holder := Token;</ST>
    </Algorithm>
  </SimpleFB>
</FBType>