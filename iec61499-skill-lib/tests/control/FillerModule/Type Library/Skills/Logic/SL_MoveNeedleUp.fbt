<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SL_MoveNeedleUp" Comment="What a skill primitive does: wait until the equipment is free, check the precondition, send the command, then watch the equipment's signals (or a timer) until the skill is done, has failed or has timed out, and send the closing command. Technical: MoveNeedleUp: Precondition TRUE; holds NeedleAxis.Up until AtTop; Invariant NOT (AtTop AND AtBottom)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: name the channels and OPC UA variables">
        <With Var="Module" />
        <With Var="Equipment" />
        <With Var="Holder" />
        <With Var="ReleaseAfter" />
        <With Var="Timeout" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start the run with the parameters (checks the Precondition first)" />
      <Event Name="HALT" Type="Event" Comment="Stop the run (ErrorID Interrupted)" />
      <Event Name="ABORT" Type="Event" Comment="Abort the run: the equipment off and given up" />
      <Event Name="TIMER" Type="Event" Comment="The run's timer expired" />
      <Event Name="SAMPLE" Type="Event" Comment="The equipment's state arrived">
        <With Var="AtTop" />
        <With Var="AtBottom" />
        <With Var="EqHolder" />
      </Event>
      <Event Name="WAIT_OVER" Type="Event" Comment="Waited long enough for another holder to let go" />
      <Event Name="PLAYED" Type="Event" Comment="The command's phases were played" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on">
        <With Var="IdEqState" />
        <With Var="IdEqCmd" />
      </Event>
      <Event Name="DONE" Type="Event" Comment="The run succeeded (results set)" />
      <Event Name="FAILED" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
      <Event Name="HALTED" Type="Event" Comment="The run was stopped">
        <With Var="ErrorID" />
      </Event>
      <Event Name="TIMER_START" Type="Event" Comment="Start the timer (TimerDT)">
        <With Var="TimerDT" />
      </Event>
      <Event Name="TIMER_STOP" Type="Event" Comment="Stop the timer" />
      <Event Name="WAIT_START" Type="Event" Comment="Start waiting for the equipment" />
      <Event Name="WAIT_STOP" Type="Event" Comment="Stop waiting" />
      <Event Name="CMD" Type="Event" Comment="Send a command to the equipment">
        <With Var="C_Holder" />
        <With Var="C_Command" />
        <With Var="C_Arg" />
        <With Var="C_Release" />
      </Event>
      <Event Name="EQ_FREE" Type="Event" Comment="EquipmentFree is updated">
        <With Var="EquipmentFree" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="Equipment" Type="WSTRING" Comment="The equipment item it drives" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="The name the equipment is held under: the skill's own, or for a step the skill it belongs to" />
      <VarDeclaration Name="ReleaseAfter" Type="BOOL" Comment="Give up the equipment with the run's last command" />
      <VarDeclaration Name="Timeout" Type="TIME" Comment="How long the run may take before it fails with Timeout (3)" />
      <VarDeclaration Name="AtTop" Type="BOOL" Comment="NeedleAxis: AtTop, an input" />
      <VarDeclaration Name="AtBottom" Type="BOOL" Comment="NeedleAxis: AtBottom, an input" />
      <VarDeclaration Name="EqHolder" Type="WSTRING" Comment="Who holds the equipment now (empty: free)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
      <VarDeclaration Name="TimerDT" Type="TIME" Comment="How long the timer runs" />
      <VarDeclaration Name="IdEqState" Type="WSTRING" Comment="Local channel of the equipment's state" />
      <VarDeclaration Name="IdEqCmd" Type="WSTRING" Comment="Local channel of the equipment's commands" />
      <VarDeclaration Name="C_Holder" Type="WSTRING" Comment="Sent with the command: who holds the equipment" />
      <VarDeclaration Name="C_Command" Type="USINT" Comment="Sent with the command: the command's code" />
      <VarDeclaration Name="C_Arg" Type="LREAL" Comment="Sent with the command: its argument (e.g. a position)" />
      <VarDeclaration Name="C_Release" Type="BOOL" Comment="Sent with the command: give up the equipment after it" />
      <VarDeclaration Name="EquipmentFree" Type="BOOL" Comment="The equipment is free, or held under Holder" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="Outcome" Type="USINT" />
    </InternalVars>
    <ECC>
      <ECState Name="Idle" x="7465" y="0" />
      <ECState Name="Init" x="5542" y="1260">
        <ECAction Algorithm="Alg_Init" Output="INITO" />
      </ECState>
      <ECState Name="Check" x="7308" y="1260" />
      <ECState Name="Reject" x="4345" y="2520">
        <ECAction Algorithm="Alg_Reject" Output="FAILED" />
      </ECState>
      <ECState Name="Sample" x="8332" y="1260">
        <ECAction Algorithm="Alg_Sample" Output="EQ_FREE" />
      </ECState>
      <ECState Name="Busy" x="0" y="5140">
        <ECAction Algorithm="Alg_Busy" Output="FAILED" />
      </ECState>
      <ECState Name="WaitFree" x="6335" y="2520">
        <ECAction Output="WAIT_START" />
      </ECState>
      <ECState Name="WaitW" x="6885" y="3880" />
      <ECState Name="Recheck" x="1810" y="5140">
        <ECAction Output="WAIT_STOP" />
      </ECState>
      <ECState Name="AlreadyDone" x="8045" y="2520">
        <ECAction Output="DONE" />
      </ECState>
      <ECState Name="Run" x="9620" y="2520">
        <ECAction Algorithm="Alg_Run" Output="CMD" />
        <ECAction Output="TIMER_START" />
      </ECState>
      <ECState Name="RunSample" x="3430" y="5140">
        <ECAction Algorithm="Alg_RunSample" Output="EQ_FREE" />
      </ECState>
      <ECState Name="Unsafe" x="5735" y="5140">
        <ECAction Algorithm="Alg_Unsafe" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Lost" x="7905" y="5140">
        <ECAction Algorithm="Alg_Lost" Output="TIMER_STOP" />
        <ECAction Output="FAILED" />
      </ECState>
      <ECState Name="Done" x="9895" y="5140">
        <ECAction Algorithm="Alg_Done" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="TimedOut" x="11885" y="5140">
        <ECAction Algorithm="Alg_TimedOut" Output="CMD" />
      </ECState>
      <ECState Name="Halt" x="13920" y="5140">
        <ECAction Algorithm="Alg_Halt" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Abort" x="9188" y="7760">
        <ECAction Algorithm="Alg_Abort" Output="CMD" />
        <ECAction Output="TIMER_STOP" />
      </ECState>
      <ECState Name="Ending" x="7420" y="6500" />
      <ECState Name="EndDone" x="4642" y="7760">
        <ECAction Output="DONE" />
      </ECState>
      <ECState Name="EndFailed" x="6038" y="7760">
        <ECAction Output="FAILED" />
      </ECState>
      <ECState Name="EndHalted" x="7612" y="7760">
        <ECAction Output="HALTED" />
      </ECState>
      <ECState Name="Running" x="7910" y="3880" />
      <ECTransition Source="Idle" Destination="Init" Condition="INIT" x="6840" y="710" />
      <ECTransition Source="Init" Destination="Idle" Condition="1" x="7320" y="870" />
      <ECTransition Source="Idle" Destination="Check" Condition="START" x="7538" y="710" />
      <ECTransition Source="Check" Destination="Reject" Condition="[NOT (TRUE)]" x="6230" y="1970" />
      <ECTransition Source="Idle" Destination="Sample" Condition="SAMPLE" x="8302" y="710" />
      <ECTransition Source="Sample" Destination="Idle" Condition="1" x="8782" y="870" />
      <ECTransition Source="Check" Destination="WaitFree" Condition="[(EqHolder &lt;&gt; &quot;&quot;) AND (EqHolder &lt;&gt; Holder)]" x="7155" y="1970" />
      <ECTransition Source="WaitFree" Destination="WaitW" Condition="1" x="6944" y="3280" />
      <ECTransition Source="WaitW" Destination="Recheck" Condition="SAMPLE[NOT ((EqHolder &lt;&gt; &quot;&quot;) AND (EqHolder &lt;&gt; Holder))]" x="4659" y="4590" />
      <ECTransition Source="WaitW" Destination="Busy" Condition="WAIT_OVER" x="3801" y="4590" />
      <ECTransition Source="WaitW" Destination="Idle" Condition="HALT" x="8726" y="2020" />
      <ECTransition Source="WaitW" Destination="Idle" Condition="ABORT" x="5926" y="2020" />
      <ECTransition Source="Recheck" Destination="Check" Condition="1" x="7250" y="3440" />
      <ECTransition Source="Check" Destination="AlreadyDone" Condition="[AtTop]" x="7976" y="1970" />
      <ECTransition Source="Running" Destination="Unsafe" Condition="SAMPLE[NOT (NOT (AtTop AND AtBottom))]" x="7294" y="4615" />
      <ECTransition Source="Running" Destination="Lost" Condition="SAMPLE[(EqHolder &lt;&gt; &quot;&quot;) AND (EqHolder &lt;&gt; Holder)]" x="8334" y="4615" />
      <ECTransition Source="Running" Destination="Done" Condition="SAMPLE[AtTop]" x="9329" y="4615" />
      <ECTransition Source="Running" Destination="TimedOut" Condition="TIMER" x="10335" y="4590" />
      <ECTransition Source="Running" Destination="RunSample" Condition="SAMPLE" x="6175" y="4590" />
      <ECTransition Source="RunSample" Destination="Running" Condition="1" x="6655" y="4750" />
      <ECTransition Source="Busy" Destination="Idle" Condition="1" x="2180" y="2650" />
      <ECTransition Source="Lost" Destination="Idle" Condition="1" x="10478" y="2675" />
      <ECTransition Source="AlreadyDone" Destination="Idle" Condition="1" x="5644" y="1340" />
      <ECTransition Source="Unsafe" Destination="Ending" Condition="1" x="7038" y="5925" />
      <ECTransition Source="Done" Destination="Ending" Condition="1" x="9072" y="5925" />
      <ECTransition Source="Halt" Destination="Ending" Condition="1" x="11085" y="5925" />
      <ECTransition Source="Abort" Destination="Ending" Condition="1" x="8742" y="7235" />
      <ECTransition Source="TimedOut" Destination="Ending" Condition="1" x="10079" y="5900" />
      <ECTransition Source="Ending" Destination="EndDone" Condition="PLAYED[Outcome = 1]" x="6297" y="7210" />
      <ECTransition Source="Ending" Destination="EndFailed" Condition="PLAYED[Outcome = 2]" x="7040" y="7210" />
      <ECTransition Source="Ending" Destination="EndHalted" Condition="PLAYED[Outcome = 3]" x="7827" y="7210" />
      <ECTransition Source="Ending" Destination="Idle" Condition="PLAYED" x="10505" y="3330" />
      <ECTransition Source="Ending" Destination="Abort" Condition="ABORT" x="9222" y="7395" />
      <ECTransition Source="EndDone" Destination="Idle" Condition="1" x="3397" y="3960" />
      <ECTransition Source="EndFailed" Destination="Idle" Condition="1" x="10440" y="3960" />
      <ECTransition Source="EndHalted" Destination="Idle" Condition="1" x="4427" y="3960" />
      <ECTransition Source="Check" Destination="Run" Condition="1" x="9336" y="2155" />
      <ECTransition Source="Run" Destination="Running" Condition="1" x="9180" y="3305" />
      <ECTransition Source="Running" Destination="Halt" Condition="HALT" x="11341" y="4615" />
      <ECTransition Source="Running" Destination="Abort" Condition="ABORT" x="12898" y="5925" />
      <ECTransition Source="Reject" Destination="Idle" Condition="1" x="2398" y="1340" />
    </ECC>
    <Algorithm Name="Alg_Init">
      <ST>IdEqState := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Module), "/"), Equipment), "/state]");
IdEqCmd := CONCAT(CONCAT(CONCAT(CONCAT("loc[", Module), "/"), Equipment), "/cmd]");</ST>
    </Algorithm>
    <Algorithm Name="Alg_Reject">
      <ST>ErrorID := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Sample">
      <ST>EquipmentFree := (EqHolder = "") OR (EqHolder = Holder);</ST>
    </Algorithm>
    <Algorithm Name="Alg_Busy">
      <ST>ErrorID := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Run">
      <ST>C_Holder := Holder;
C_Command := 2;
C_Arg := 0.0;
C_Release := FALSE;
TimerDT := Timeout;</ST>
    </Algorithm>
    <Algorithm Name="Alg_RunSample">
      <ST>EquipmentFree := (EqHolder = "") OR (EqHolder = Holder);</ST>
    </Algorithm>
    <Algorithm Name="Alg_Unsafe">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
ErrorID := 2;
Outcome := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Lost">
      <ST>ErrorID := 6;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Done">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
Outcome := 1;</ST>
    </Algorithm>
    <Algorithm Name="Alg_TimedOut">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
ErrorID := 3;
Outcome := 2;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Halt">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := ReleaseAfter;
ErrorID := 7;
Outcome := 3;</ST>
    </Algorithm>
    <Algorithm Name="Alg_Abort">
      <ST>C_Holder := Holder;
C_Command := 0;
C_Arg := 0.0;
C_Release := TRUE;
Outcome := 0;</ST>
    </Algorithm>
  </BasicFB>
</FBType>