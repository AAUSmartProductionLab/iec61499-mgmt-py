<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SK_MoveNeedleDown" Comment="Skill primitive MoveNeedleDown: Lower the needle to Distance mm below the top; the default is all the way down (parameters: Distance [mm] 0.0..50.0, default 50.0). OPC UA Start(Session, parameters...)/Stop/Abort/Reset(Session) -&gt; [Accepted, ErrorID]; START/HALT/ABORT/RESET from a parent -&gt; SUCCESS or FAILURE(ErrorID)">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="AAU Smart Production Lab" Version="0.1" Author="Project contributors" Date="2026-09-28" />
  <CompilerInfo packageName="filler" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="EInit" Comment="Initialise: its OPC UA nodes and its equipment's channels">
        <With Var="Module" />
        <With Var="UaRoot" />
        <With Var="UaPath" />
        <With Var="UaEnable" />
        <With Var="Methods" />
        <With Var="Holder" />
        <With Var="ReleaseAfter" />
        <With Var="Timeout" />
        <With Var="Distance" />
      </Event>
      <Event Name="START" Type="Event" Comment="Start a run, from the parent (a step of a sequence): no session check">
        <With Var="Distance" />
      </Event>
      <Event Name="HALT" Type="Event" Comment="Stop the run, from the parent" />
      <Event Name="ABORT" Type="Event" Comment="Abort: everything off at once" />
      <Event Name="RESET" Type="Event" Comment="Reset from Failed or Aborted to Idle" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="EInit" Comment="Initialised: the next block of the INIT chain goes on" />
      <Event Name="SUCCESS" Type="Event" Comment="The run succeeded (the results are set)" />
      <Event Name="FAILURE" Type="Event" Comment="The run failed (ErrorID)">
        <With Var="ErrorID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Module" Type="WSTRING" Comment="The module's name; its local channels are named after it (loc[&lt;Module&gt;/...])" />
      <VarDeclaration Name="UaRoot" Type="WSTRING" Comment="The module's OPC UA folder, e.g. /Objects/Filling" />
      <VarDeclaration Name="UaPath" Type="WSTRING" Comment="This skill's OPC UA folder below UaRoot, e.g. /Skills/Dispensing" />
      <VarDeclaration Name="UaEnable" Type="BOOL" Comment="Publish on OPC UA" />
      <VarDeclaration Name="Methods" Type="BOOL" Comment="Offer the OPC UA methods Start, Stop, Abort, Reset (FALSE: a step, run by its parent)" />
      <VarDeclaration Name="Holder" Type="WSTRING" Comment="The name the equipment is held under: the skill's own, or for a step the skill it belongs to" />
      <VarDeclaration Name="ReleaseAfter" Type="BOOL" InitialValue="TRUE" Comment="Give up the equipment when the run ends (FALSE: the next step keeps it)" />
      <VarDeclaration Name="Timeout" Type="TIME" InitialValue="T#5000ms" Comment="How long the run may take before it fails with Timeout (3)" />
      <VarDeclaration Name="Distance" Type="LREAL" InitialValue="50.0" Comment="Parameter Distance mm, 0.0 to 50.0: Target depth below the top position" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="State" Type="USINT" Comment="Skill state: 0 Idle, 1 Running, 2 Stopping, 3 Succeeded, 4 Failed, 5 Aborted" />
      <VarDeclaration Name="ErrorID" Type="UINT" Comment="Error code: 0 none, 1 PreconditionViolated, 2 InvariantViolated, 3 Timeout, 4 NotReady, 5 NotPermitted, 6 Busy, 7 Interrupted, 8 OutOfRange" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <Group Name="SkillControl" Comment="State machine and OPC UA: Start(Session, parameters) with the range check, Stop, Abort, Reset; State, parameters and results published" x="1000" y="1000" width="7030" height="4380" locked="false" />
    <Group Name="Execution" Comment="One run: the contract, the command to the equipment and the end condition" x="1000" y="5680" width="8145" height="3180" locked="false" />
    <Group Name="Equipment" Comment="The equipment's state in, the command as output values out (the command table and its timed phases are in Driver)" x="1000" y="9160" width="7770" height="3180" locked="false" />
    <FB Name="Control" Type="modlib::SKILL_Core" x="1270" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Logic" Type="filler::SL_MoveNeedleDown" x="1190" y="150">
      <Parameter Name="Equipment" Value="&quot;NeedleAxis&quot;" />
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="UaStart" Type="iec61499::net::SERVER_2_2" x="5050" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="Par_Distance" Type="modlib::SKILL_Param_LREAL" x="1230" y="2650">
      <Parameter Name="Lower" Value="0.0" />
      <Parameter Name="Upper" Value="50.0" />
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="PubParams" Type="iec61499::net::PUBLISH_1" x="4930" y="2650">
      <Attribute Name="GroupName" Type="STRING" Value="SkillControl" />
    </FB>
    <FB Name="EqState" Type="iec61499::net::SUBSCRIBE_4" x="950" y="150">
      <Parameter Name="QI" Value="TRUE" />
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="EqView" Type="filler::EV_NeedleAxis" x="3420" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="WaitT" Type="iec61499::events::E_DELAY" x="4435" y="150">
      <Parameter Name="DT" Value="T#500ms" />
      <Attribute Name="GroupName" Type="STRING" Value="Execution" />
    </FB>
    <FB Name="Driver" Type="filler::EC_NeedleAxis" x="6010" y="150">
      <Attribute Name="GroupName" Type="STRING" Value="Equipment" />
    </FB>
    <FB Name="PhaseT" Type="iec61499::events::E_DELAY" x="1070" y="1550">
