      <Connection Source="Control.Accepted" Destination="UaStart.SD_1" />
      <Connection Source="Control.StartError" Destination="UaStart.SD_2" />
      <Connection Source="UaStart.RD_2" Destination="Par_Distance.Requested" />
      <Connection Source="Control.CalledByClient" Destination="Par_Distance.CalledByClient" />
      <Connection Source="Par_Distance.Value" Destination="PubParams.SD_1" />
      <Connection Source="Par_Distance.AllInRange" Destination="Control.ParamsInRange" />
