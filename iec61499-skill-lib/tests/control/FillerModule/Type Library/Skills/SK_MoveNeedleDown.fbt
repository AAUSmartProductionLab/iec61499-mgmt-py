      <Connection Source="Logic.FAILED" Destination="Control.EXECUTE_FAILED" />
      <Connection Source="Logic.HALTED" Destination="Control.EXECUTE_FAILED" />
      <Connection Source="EqState.IND" Destination="EqView.REQ" />
      <Connection Source="EqView.CNF" Destination="Logic.SAMPLE" />
      <Connection Source="Logic.CMD" Destination="Driver.PLAY" />
      <Connection Source="Driver.OUT" Destination="EqCmd.REQ" />
      <Connection Source="Driver.PHASE_START" Destination="PhaseT.START" />
      <Connection Source="Driver.PHASE_STOP" Destination="PhaseT.STOP" />
      <Connection Source="PhaseT.EO" Destination="Driver.PHASE_T" />
      <Connection Source="Driver.PLAYED" Destination="Logic.PLAYED" />
