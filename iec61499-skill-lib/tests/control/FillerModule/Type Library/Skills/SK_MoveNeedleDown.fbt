      <Connection Source="Par_Distance.LATCHED" Destination="PubParams.REQ" />
      <Connection Source="PubParams.INITO" Destination="PubParams.REQ" />
      <Connection Source="INIT" Destination="Control.INIT" />
      <Connection Source="Control.INITO" Destination="Logic.INIT" />
      <Connection Source="Logic.INITO" Destination="UaStart.INIT" />
